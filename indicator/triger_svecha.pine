//@version=5
// ══════════════════════════════════════════════════════════════════════
//  ТРИГГЕРНАЯ СВЕЧА · v0.4 · 05.11.2026
//
//  ОТДЕЛЬНЫЙ ИНДИКАТОР, БЕЗ СЛОЁВ. Слово владельца 03.11.2026:
//  «да, вноси подсветку в пайн, только сделай отдельный пайн без слоёв,
//   когда сделаем качественно просто туда перенесём».
//
//  Здесь НЕТ ни колен, ни счёта (0)-(5), ни тренда, ни уровня, ни сломов.
//  Только одна свеча и её соседи.
//
//  ПРАВИЛО ИЗ ДВУХ УСЛОВИЙ, его слово 03.11.2026:
//    ФОРМА  — симметричная: длина фитилей одинаковая. Тело ЛЮБОЕ —
//             очень маленькое, среднее или большое. Фитили могут быть
//             короткими.
//    РАЗМЕР — свеча НЕ должна быть большой относительно цены и свечей
//             рядом. Его пример: «если у свечей рядом средняя шкала
//             0.3%, а свеча 0.8% — я такую пропускаю».
//
//  ТРИ ЧИСЛА согласованы его словом «давай так»:
//    соседей 20 · порог размера 2x · разница фитилей до 8 п.п.
//    Порог 8 п.п. взят не с потолка: это медиана разницы фитилей его
//    собственных 40 шаблонов (7.7 п.п.) против 20.5 у обычной свечи.
//
//  ЗАМЕР Н60: правило ловит 20.1% баров и на 1H, и на 5m — доля совпала
//  до десятой. Фильтр размера при 2x режет лишь 8.8% формы, потому что
//  симметричная свеча обычно МЕНЬШЕ обычной (медиана 0.91x).
//
//  ⚠️ СВЕЧА НЕ ДЕЛАЕТ ВХОД. Его слово: «не делает автоматический вход,
//  не отвечает за риск, и её автоматическое появление без остальных
//  критериев, которые формируют вход, бессмысленно». Это ОРИЕНТИР.
//
//  v0.4 · З66 · У ТЁМНОЙ ПОДСВЕТКИ ТЕПЕРЬ ТОТ ЖЕ НАБОР РУЧЕК.
//  Его слово: «для удобства сделай в настройках для тёмного фона,
//  чтобы его тоже можно было отключать, и ставить метку под свечой, и
//  выбирать размеры». У оранжевой было пять ручек, у тёмной две.
//  Добавлены: прозрачность срезанных, метка под срезанной, размер этой
//  метки. ПОВЕДЕНИЕ ПО УМОЛЧАНИЮ НЕ ИЗМЕНИЛОСЬ: прозрачность 88 была
//  вшита в код, теперь она же стоит по умолчанию в ручке; метка по
//  умолчанию ВЫКЛЮЧЕНА, как и у оранжевой.
//  Счёт свечей НЕ ТРОНУТ ни в одной строке.
//
//  v0.3 · З65 · ДОБАВЛЕН ПОТОЛОК ПО ЦЕНЕ. Правило стало из ТРЁХ условий.
//  Его слово 03.11 было «не должны быть большие относительно ЦЕНЫ И
//  свечей рядом» — ДВЕ меры. Я построил одну, и он нашёл дыру своим
//  примером 05.11: «когда возрастает волатильность и средний размер
//  всех свечей увеличивается, он такие свечи пропускает».
//  ЗАМЕР подтвердил: в штиль пропущенная свеча 0.195% цены, в бурю
//  0.481%, максимум 2.938% — разрыв 2.48 раза при одинаковом числе
//  свечей в каждом режиме. Варианты «долгая средняя» и «средняя по
//  триггерным» (его мысль) дыру НЕ чинят: 2.20x и 2.23-2.51x. Чинит
//  только потолок в % от цены: 1.52x при 0.40%.
//  ИМЯ ЗАКРЕПЛЕНО его словом: ТРИГГЕРНАЯ СВЕЧА. «Симметричная» —
//  слово внутри описания формы, именем не становится.
//  ДОБАВЛЕНА строка табло «средняя за N» — по ней выставлять потолок
//  при переходе на другой таймфрейм. На отбор свечей не влияет.
//  Ничего не убрано: все 10 прежних строк табло на месте.
//
//  v0.2 · З64 · ПОЧИНЕН ПОКАЗ, СЧЁТ НЕ ТРОНУТ.
//  В v0.1 число красилось в color.white, КОГДА УСЛОВИЕ ПРОЙДЕНО, а у
//  двух ячеек нет своего фона — белым по светлому графику. Владелец
//  открыл на графике: строка «размер к обычному» ПУСТАЯ, хотя число
//  там было (0.37x при пороге 2x). Хуже обычной опечатки тем, что
//  число исчезало РОВНО когда оно нужно.
//  Заменено на chart.fg_color — цвет текста самого графика, он идёт
//  за светлой и тёмной темой. Шесть ячеек табло.
//  Белый на МЕТКЕ оставлен: у неё свой цветной фон, она читается.
// ══════════════════════════════════════════════════════════════════════
indicator("Триггерная свеча · v0.4", overlay = true, max_labels_count = 500)

// ─────────────────────────── ПРАВИЛО ─────────────────────────────────
gP = "Правило"
trOn   = input.bool(true,  "Искать триггерные свечи", group = gP)
simMax = input.float(8.0,  "Фитили: разница не больше, % высоты свечи", minval = 0.0, maxval = 50.0, step = 0.5, group = gP, tooltip = "Насколько «одинаковые» фитили. 8 — согласованное значение: медиана разницы фитилей у ваших 40 шаблонов 7.7, у обычной свечи 20.5.")
okno   = input.int(20,     "Соседей для обычного размера", minval = 2, maxval = 200, group = gP, tooltip = "Сколько ПРЕДЫДУЩИХ свечей брать, чтобы понять обычный размер. Текущая свеча в среднее не входит.")
porog  = input.float(2.0,  "Пропускать, если свеча больше средней в N раз", minval = 1.0, maxval = 10.0, step = 0.1, group = gP, tooltip = "Ваш пример 0.8% против 0.3% — это 2.7 раза. При 2.0 отсекается 8.8% формы на 1H.")
capMax = input.float(0.40, "Потолок: свеча не выше, % от цены", minval = 0.01, maxval = 5.0, step = 0.01, group = gP, tooltip = "ВТОРАЯ половина вашей фразы «не должны быть большие относительно ЦЕНЫ и свечей рядом». Порог выше смотрит на соседей и слепнет, когда растёт вся волатильность: в штиль пропущенная свеча 0.195% цены, в бурю 0.481%, разрыв 2.48 раза. Потолок в процентах от цены не подстраивается ни под что и закрывает дыру: разрыв падает до 1.52. Число СВОЁ на каждом таймфрейме — смотрите строку «средняя за N» в табло.")

// ─────────────────────────── ПОКАЗ ───────────────────────────────────
gS = "Показ"
svOn  = input.bool(true,   "Подсвечивать фон свечи", group = gS)
svCol = input.color(color.new(color.orange, 0), "Цвет подсветки", group = gS)
svPrz = input.int(80,      "Прозрачность подсветки", minval = 0, maxval = 95, group = gS)
mtOn  = input.bool(false,  "Ставить метку под свечой", group = gS)
mtSz  = input.string("Обычный", "Размер метки", options = ["Крошечный", "Мелкий", "Обычный", "Крупный"], group = gS)
rzOn  = input.bool(false,  "Помечать срезанные размером", group = gS, tooltip = "Свечи, которые подошли по ФОРМЕ, но оказались слишком большими рядом с соседями. Нужно, чтобы увидеть, что именно отсекает фильтр.")
rzCol = input.color(color.new(color.gray, 0), "Цвет срезанных", group = gS)
rzPrz = input.int(88,      "Прозрачность срезанных", minval = 0, maxval = 95, group = gS, tooltip = "Было жёстко вшито 88. Значение по умолчанию то же, картинка не меняется.")
rzMt  = input.bool(false,  "Ставить метку под срезанной", group = gS)
rzMSz = input.string("Обычный", "Размер метки срезанных", options = ["Крошечный", "Мелкий", "Обычный", "Крупный"], group = gS)

gT = "Табло"
tbOn  = input.bool(true,   "Показывать табло", group = gT)
tbPos = input.string("Справа вверху", "Где табло", options = ["Справа вверху", "Справа внизу", "Слева вверху", "Слева внизу"], group = gT)
tbSz  = input.string("Обычный", "Размер текста табло", options = ["Крошечный", "Мелкий", "Обычный", "Крупный"], group = gT)
srOkn = input.int(500,     "Средняя высота за сколько баров", minval = 10, maxval = 2000, group = gT, tooltip = "Только для ТАБЛО, на отбор свечей не влияет. Показывает, какой высоты свеча на этом инструменте и таймфрейме вообще бывает, и во сколько раз потолок её больше. По этой строке удобно выставлять потолок при переходе на другой таймфрейм.")

// ══════════════════════════ СЧЁТ ФОРМЫ ═══════════════════════════════
// Доли считаются от ВЫСОТЫ свечи. Три доли всегда дают в сумме 100.
rng = high - low
bod = math.abs(close - open)
upS = open > close ? high - open  : high - close
loS = open > close ? close - low  : open - low

float bodP = 0.0
float uppP = 0.0
float lowP = 0.0
if rng > 0
    bodP := bod / rng * 100.0
    uppP := upS / rng * 100.0
    lowP := loS / rng * 100.0

// РАЗНИЦА ФИТИЛЕЙ — это и есть «симметричность» словами владельца
razn = math.abs(uppP - lowP)

// ══════════════════════════ СЧЁТ РАЗМЕРА ═════════════════════════════
// Высота свечи в процентах ОТ ЦЕНЫ — ровно как в его примере «0.3%».
float shk = 0.0
if close > 0
    shk := rng / close * 100.0

// Средняя высота по ПРЕДЫДУЩИМ okno свечам. Сдвиг [1] убирает текущую.
sredShk = ta.sma(shk, okno)
float sredPred = na
if bar_index >= okno
    sredPred := sredShk[1]

// Во сколько раз эта свеча больше обычной
float otn = 0.0
if not na(sredPred)
    if sredPred > 0
        otn := shk / sredPred

// Средняя высота за ДОЛГИЙ период. Только для табло, на отбор не влияет.
sredDlg = ta.sma(shk, srOkn)
float sredPok = na
if bar_index >= srOkn
    sredPok := sredDlg[1]

// ══════════════════════════ ВЕРДИКТ ══════════════════════════════════
// Сторожа пишутся через if, а не через логическую связку: пайн считает
// обе половины `and` всегда, обрыва нет.
bool formaOk = false
if rng > 0
    if razn <= simMax
        formaOk := true

bool razmOk = false
if otn > 0
    if otn <= porog
        razmOk := true

// ПОТОЛОК ПО ЦЕНЕ — вторая половина условия РАЗМЕРА, замечание З65.
// Он НЕ подстраивается под рынок, и этим чинит дыру: средняя по соседям
// растёт вместе с волатильностью, а процент от цены — нет.
bool capOk = false
if rng > 0
    if shk <= capMax
        capOk := true

// Размер проходит, только когда верны ОБЕ половины
bool razmVse = false
if razmOk
    if capOk
        razmVse := true

bool trig = false
bool srez = false
if trOn
    if formaOk
        if razmVse
            trig := true
        else
            if otn > 0
                srez := true

// ══════════════════════════ СЧЁТЧИКИ ═════════════════════════════════
// Считаем только на ЗАКРЫТЫХ барах: последний бар пересчитывается много
// раз, и без этого сторожа счётчик врал бы.
var int nTrig  = 0
var int nForma = 0
var int nSrez  = 0
var int nVsego = 0
var int lastTB = na
if barstate.isconfirmed
    nVsego := nVsego + 1
    if formaOk
        nForma := nForma + 1
    if trig
        nTrig := nTrig + 1
        lastTB := bar_index
    if srez
        nSrez := nSrez + 1

// ══════════════════════════ ГРАФИК ═══════════════════════════════════
bgcolor(trig and svOn ? color.new(svCol, svPrz) : na, title = "Подсветка триггерной свечи")
bgcolor(srez and rzOn ? color.new(rzCol, rzPrz) : na, title = "Подсветка срезанных размером")

mSz = mtSz == "Крошечный" ? size.tiny : mtSz == "Мелкий" ? size.small : mtSz == "Крупный" ? size.large : size.normal
if mtOn and trig
    label.new(bar_index, low, "⟡", style = label.style_label_up, color = color.new(svCol, 20), textcolor = color.white, size = mSz, yloc = yloc.belowbar)

// Метка под СРЕЗАННОЙ — точное зеркало метки выше, свой цвет и размер
rSz = rzMSz == "Крошечный" ? size.tiny : rzMSz == "Мелкий" ? size.small : rzMSz == "Крупный" ? size.large : size.normal
if rzMt and srez
    label.new(bar_index, low, "⟡", style = label.style_label_up, color = color.new(rzCol, 20), textcolor = color.white, size = rSz, yloc = yloc.belowbar)

// ══════════════════════════ ТАБЛО ════════════════════════════════════
tPos = tbPos == "Справа внизу" ? position.bottom_right : tbPos == "Слева вверху" ? position.top_left : tbPos == "Слева внизу" ? position.bottom_left : position.top_right
tSz  = tbSz == "Крошечный" ? size.tiny : tbSz == "Мелкий" ? size.small : tbSz == "Крупный" ? size.large : size.normal
var table TBL = table.new(tPos, 2, 11, border_width = 1)

cZag = color.new(color.gray, 70)
cOk  = color.new(color.green, 70)
cNet = color.new(color.gray, 85)

if tbOn and barstate.islast
    table.cell(TBL, 0, 0, "ТРИГГЕРНАЯ СВЕЧА", text_color = chart.fg_color, text_size = tSz, bgcolor = cZag)
    table.cell(TBL, 1, 0, "v0.4", text_color = color.gray, text_size = tSz, bgcolor = cZag)

    table.cell(TBL, 0, 1, "сейчас", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 1, trig ? "ДА" : srez ? "срезана размером" : "нет", text_color = trig ? chart.fg_color : color.gray, text_size = tSz, bgcolor = trig ? cOk : cNet)

    table.cell(TBL, 0, 2, "фитили: разница", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 2, rng > 0 ? str.tostring(razn, "#.#") + " из " + str.tostring(simMax, "#.#") : "—", text_color = formaOk ? chart.fg_color : color.gray, text_size = tSz)

    table.cell(TBL, 0, 3, "размер к обычному", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 3, otn > 0 ? str.tostring(otn, "#.##") + "x из " + str.tostring(porog, "#.#") + "x" : "—", text_color = razmOk ? chart.fg_color : color.gray, text_size = tSz)

    table.cell(TBL, 0, 4, "обычная высота", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 4, na(sredPred) ? "—" : str.tostring(sredPred, "#.###") + "%", text_color = color.gray, text_size = tSz)

    table.cell(TBL, 0, 5, "эта свеча", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 5, str.tostring(shk, "#.###") + "% из " + str.tostring(capMax, "#.##") + "%  тело " + str.tostring(bodP, "#") + "%", text_color = capOk ? chart.fg_color : color.gray, text_size = tSz)

    table.cell(TBL, 0, 6, "средняя за " + str.tostring(srOkn), text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 6, na(sredPok) ? "—" : str.tostring(sredPok, "#.###") + "%  потолок " + str.tostring(capMax / sredPok, "#.##") + "x", text_color = color.gray, text_size = tSz)

if tbOn and barstate.islast
    table.cell(TBL, 0, 7, "НАЙДЕНО", text_color = chart.fg_color, text_size = tSz, bgcolor = cZag)
    table.cell(TBL, 1, 7, str.tostring(nTrig) + (nVsego > 0 ? "  " + str.tostring(100.0 * nTrig / nVsego, "#.#") + "%" : ""), text_color = chart.fg_color, text_size = tSz, bgcolor = cZag)

    table.cell(TBL, 0, 8, "подошло по форме", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 8, str.tostring(nForma) + (nVsego > 0 ? "  " + str.tostring(100.0 * nForma / nVsego, "#.#") + "%" : ""), text_color = color.gray, text_size = tSz)

    table.cell(TBL, 0, 9, "срезано размером", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 9, str.tostring(nSrez) + (nForma > 0 ? "  " + str.tostring(100.0 * nSrez / nForma, "#.#") + "% формы" : ""), text_color = color.gray, text_size = tSz)

    table.cell(TBL, 0, 10, "последняя была", text_color = color.gray, text_size = tSz)
    table.cell(TBL, 1, 10, na(lastTB) ? "—" : str.tostring(bar_index - lastTB) + " баров назад", text_color = color.gray, text_size = tSz)
