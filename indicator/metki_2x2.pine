//@version=5
// ═══════════════════════════════════════════════════════════════════
// МЕТКИ 2/2 · v3.0      ОДИН СЛОЙ, ВСЕ ПРАВИЛА
// 10.10.2026
//
// Слово владельца 10.10.2026: «сейчас нужно сделать новый пайн только
// со слоем 2/2, у [со] всеми правилами. Когда сделаем как хочу, будем
// добавлять логику 3/3 и потом 5/5. Три слоя сразу сильно много».
//
// ── ЧТО ЭТО ЗА ФАЙЛ ──
//
// Это НЕ новая версия эталона и не замена ему. Эталон v2.3 заморожен в
// indicator/ЭТАЛОН_v2.3.pine и не тронут. Здесь из него вынут ОДИН слой
// 2/2 с обоими направлениями, чтобы разбирать правила на одной
// структуре, а не на трёх сразу.
//
// ДВИЖОК ВЗЯТ ИЗ ЭТАЛОНА ДОСЛОВНО. Функции f_lab, f_relabel, f_absorb,
// f_push, f_avgLeg, f_lvlSet, f_seqNow, f_match, f_trend, f_slom,
// f_nearest и вся отрисовка скопированы, а не переписаны. Переписать
// движок заново значило бы получить третий, несуществующий движок, —
// этим проект уже обжигался.
//
// ── ЧТО ИСЧЕЗЛО И ПОЧЕМУ. Правило 4, разбор до единой строки ──
//
// У слоя 2/2 НЕТ СОСЕДА СНИЗУ. Занимать не у кого. Отсюда исчезает не
// по моему выбору, а по построению:
//
//   ⑧ ВСТАВКИ, весь раздел     у 2/2 донора нет, дозу ставить некуда
//   ОТКАЗ «не свой», ST_REF    отказаться нечем: слою нечего не хватать
//   ПРЕДВАРИТЕЛЬНОЕ КОЛЕНО     живой край занимать не у кого. З31
//   ДОРИСОВКА пропущенных      то же самое, ② две галочки
//   метки ·LH с точкой         их ставила дорисовка
//   строка табло «вставок»     считать нечего
//   цвет «отказ слоя» ⑥        состояния больше нет
//   ① слой на графике,         выбирать не из чего
//     наложить сверху,
//     у наложенного всё
//   ② подписи меток списком    слой один, накладываться не на что
//
// ВСЁ ОСТАЛЬНОЕ НА МЕСТЕ И БЕЗ ИЗМЕНЕНИЙ: рождение на (1), отмена
// касанием, подтверждение по HL, счёт до пяти, манипуляция, уровень на
// любом низе, три вида линии уровня, смерть по телу на 0.20
// скользящего колена, архив, продолжение, запасное подтверждение У7,
// справочник из восьми форм, сломы, старшие ТФ, «авто», поглощённые
// метки, настройка «счёт, дошедший до (5)».
//
// Состояний стало ШЕСТЬ вместо семи — ушло только «не свой».
// Концов тренда ТРИ вместо четырёх — ушёл только ОТКАЗ.
//
// ── ЧТО В ЭТОМ ФАЙЛЕ ОСТАЁТСЯ ОТКРЫТЫМ ──
//
// З39: колено счёта ПЕРЕЕЗЖАЕТ, а нарисовано сплошным. Владелец
// 09.10.2026: «переезда не должно быть». Какое из двух прочтений —
// не выбрано, поэтому здесь поведение ЭТАЛОННОЕ, без изменений.
// У 2/2 вставок нет вовсе, значит переезд тут бывает ровно один:
// своё колено сменило своё же. Это и есть самое чистое место, где
// правило можно решить, ничем больше не мешаясь.
//
// ── ПРОВЕРКА ──
// Сверка с эталоном по условиям показа:
//   python3 research/sverka.py indicator/ЭТАЛОН_v2.3.pine indicator/metki_2x2.pine
// Исчезнувшее в ней — ровно список выше, и ничего сверх него.
// ═══════════════════════════════════════════════════════════════════
indicator("Метки 2/2 · v3.0", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 3000)

// ═══════════════════════════════════════════════════════════════════
//                        ПОЛОВИНА  ·  ВИД
//          Меняет только картинку. Числа движка те же.
// ═══════════════════════════════════════════════════════════════════

g1 = "① ЧТО РИСУЕМ"
trWho   = input.string("авто", "Режим", options = ["авто", "только восходящий", "только нисходящий"], group = g1, tooltip = "Колена у обоих трендов ОДНИ И ТЕ ЖЕ — один зиг-заг, те же бары, те же цены. Отличается только прочтение. Поэтому одна нога не может быть двух цветов, а одно колено не может нести два номера.\n\n«авто» — рисуется тот, кто жив. Живы оба — тот, чей НОЛЬ БЛИЖЕ к сегодняшнему дню: свежая структура это то, что рынок строит сейчас, старая уже контекст и всё равно видна в табло.\n\nОстальные два варианта — чтобы сравнить глазами.\n\nСчёт обоих направлений идёт ВСЕГДА, им управляют галочки в ⑦. Этот список решает только, кого НАРИСОВАТЬ.\n\nВыбора СЛОЯ здесь больше нет: слой один, 2/2.")
winBars = input.int(400, "Рисовать за последние N баров", minval = 100, maxval = 2000, group = g1, tooltip = "Чем больше окно, тем ближе к пределу TradingView в 500 линий. Если разметка обрывается — уменьшите окно.\n\nСлой один, поэтому линий тратится заметно меньше, чем в версии с тремя.")

g2 = "② МЕТКИ И КОЛЕНА"
labOn  = input.bool(true, "Подписи меток", group = g2, tooltip = "Подписи HH / LH / HL / LL у колен слоя. Снять — останется чистый зиг-заг с номерами счёта.\n\nВ версии с тремя слоями здесь был список из трёх значений: слои накладывались друг на друга и подписывали обычно один. Слой один — выбирать не из чего.")
showZZ = input.bool(true, "Зиг-заг по коленам", group = g2)
zzW    = input.int(1, "Толщина зиг-зага", minval = 1, maxval = 4, group = g2, tooltip = "Нога ПОДТВЕРЖДЁННОГО счёта рисуется толще на два: при толщине 1 это 1 против 3. Так виден момент подтверждения тренда.")
absOn  = input.bool(true, "Показывать поглощённые метки", group = g2, tooltip = "Когда два пивота одной стороны идут подряд, они схлопываются в одно колено, и подпись проигравшего прежде исчезала с графика. Теперь она остаётся на своём месте — бледная, мелкая, с короткой точкой на своём уровне. Около 21% колен. Линии уровня у неё нет, только метка.\n\nЗАМЕЧАНИЕ З39, открыто: само колено при этом ПЕРЕЕЗЖАЕТ на новый экстремум, и номер счёта уезжает вместе с ним, хотя нарисован сплошным. Владелец сказал «переезда не должно быть», прочтение не выбрано. Здесь поведение пока эталонное.")

g3 = "③ ЛИНИИ УРОВНЕЙ"
lvOn   = input.bool(true, "Показывать линии слоя", group = g3, tooltip = "Линия живёт, пока цена её не коснулась; коснулась — пропадает совсем. Сама метка при этом остаётся.")
lvLH   = input.bool(true, "Линии для LH и HL тоже", group = g3, tooltip = "HH и LL — пунктир, LH и HL — точки.\n\nЭто ЖИВЫЕ УРОВНИ СЛОЯ, они тянутся вправо до касания. Не путать с КОРОТКОЙ линией уровня тренда из ⑦: та тоже бывает точечной и штрих-пунктирной, но она длиной 12 баров и покрашена в цвет тренда.")
lv_n   = input.int(3, "Ближайших к цене с каждой стороны", minval = 1, maxval = 10, group = g3)
lvTr   = input.int(45, "Прозрачность линий", minval = 0, maxval = 90, group = g3)
slLine = input.bool(false, "Линии ближайших сломов", group = g3, tooltip = "Ближайший непробитый уровень сверху и снизу рисуется толще остальных и получает подпись с ценой. Это две цены, между которыми сейчас находится рынок, и обе видны заранее.\n\nВЫКЛЮЧЕНО по умолчанию: слово владельца 06.10.2026 — «снял галочку, смотрю, легче».")
lvLab  = input.string("короткие", "Подписи на линиях", options = ["полные", "короткие", "нет"], group = g3, tooltip = "Что писать у линии уровня тренда и у линий ближайших сломов.\n\n· полные — «держит HL 4165.690», «слом ↑ 4219.415 1.39%»;\n· короткие — только цена;\n· нет — линии без подписей.\n\nСовпавшие по цене линии СКЛЕИВАЮТСЯ в одну, обе роли через точку.")

g4 = "④ СЧЁТ НА ГРАФИКЕ"
trNum   = input.bool(true, "Номера точек (0)-(5)", group = g4)
keep5   = input.string("оставлять", "Счёт, дошедший до (5)", options = ["оставлять", "стирать вместе с трендом"], group = g4, tooltip = "Прямое требование владельца 28.09.2026: «когда по любому тренду счёт доходит от 0 до 5, этот тренд, как бы цена себя дальше ни вела, нельзя перерисовывать».\n\n· оставлять — номера завершённого счёта остаются на графике бледными, даже когда тренд ушёл в архив или умер;\n· стирать вместе с трендом — прежнее поведение.")
trCntSw = input.string("весь, набранный в фоне", "Счёт при переключении", options = ["весь, набранный в фоне", "фоновую часть бледнее", "только с момента переключения"], group = g4, tooltip = "Только для режима «авто». Движок НЕ трогается: оба направления считают всегда. Меняется только то, какие номера счёта видит глаз.\n\nЗачем: когда «авто» переключается на другой тренд, тот появляется уже со счётом, набранным пока был невидим — сразу (2) или (3).")
swMark  = input.bool(true, "Отмечать, где авто передумало", group = g4, tooltip = "Метка ⇄ на баре, где режим «авто» сменил рисуемый тренд.")
slNum   = input.bool(true, "Номера серии сломов", group = g4, tooltip = "На каждом сломе ТЕКУЩЕЙ серии встаёт метка с его номером: ↑1, ↑2, ↑3. Сменилось направление — счёт с единицы, метки прошлой серии стираются.\n\nПрошлые серии не рисуются намеренно: на 2/2 слом случается раз в 5.4 бара.")
trBirth = input.bool(false, "Показывать рождение тренда", group = g4, tooltip = "Короткая чёрточка с подписью «слом ↑» на цене вершины, которую цена перебила по дороге от нуля.\n\nВЫКЛЮЧЕНО по умолчанию, решение владельца 07.10.2026. МЕХАНИЗМ при этом работает всегда: от перебитой вершины считается запасное подтверждение У7. Выключена только картинка.")

g5 = "⑤ ТАБЛО"
trTbl   = input.bool(true, "Табло состояния", group = g5, tooltip = "Что движок думает прямо сейчас. Колонка одна — слой 2/2.")
tblPos  = input.string("справа вверху", "Угол экрана", options = ["справа вверху", "справа внизу", "слева вверху", "слева внизу"], group = g5)
tblSize = input.string("мелкий", "Размер", options = ["мелкий", "обычный"], group = g5)
blkUp   = input.bool(true, "восходящий", inline = "blk", group = g5)
blkDn   = input.bool(true, "нисходящий", inline = "blk", group = g5)
blkSl   = input.bool(true, "сломы",      inline = "blk", group = g5, tooltip = "Три блока табло, каждый со своей галочкой.")

g6 = "⑥ ЦВЕТА"
c2H    = input.color(#7e57c2, "Вершина / низ слоя", inline = "c2", group = g6)
c2L    = input.color(#4fc3f7, "",                   inline = "c2", group = g6)
cTrUp  = input.color(#00c853, "Восходящий тренд", group = g6)
cTrDn  = input.color(#ff1744, "Нисходящий тренд", group = g6)
cTrLeg = input.color(#ff1744, "Ноги вниз внутри счёта", group = g6, tooltip = "Спуски зиг-зага внутри восходящего счёта.")
cTrDie = input.color(#ff1744, "Смерть тренда", group = g6, tooltip = "Чёрточка «умер» и ячейка табло «прошлая смерть». Та же настройка красит ячейку «запас», когда она ушла в минус.\n\nПравило цвета и формы: ЦВЕТ говорит, хорошо это для цены или плохо; ФОРМА — начало это или конец.")
cSlUp  = input.color(#26a69a, "Слом вверх / вниз", inline = "cs", group = g6)
cSlDn  = input.color(#ef5350, "",                  inline = "cs", group = g6)
cHiH   = input.color(color.green, "Уровни 4H / 1D  верх / низ", inline = "hc", group = g6)
cLoH   = input.color(color.red,   "",                           inline = "hc", group = g6)

// ═══════════════════════════════════════════════════════════════════
//                      ПОЛОВИНА  ·  ПРАВИЛА
//     Здесь живёт ЭТАЛОН. Всё ниже этой черты меняет ЧИСЛА:
//     покрутил — прежние скрины и замеры сравнивать с новыми нельзя.
// ═══════════════════════════════════════════════════════════════════
//
// РАЗДЕЛА «ВСТАВКИ» ЗДЕСЬ НЕТ. У слоя 2/2 нет соседа снизу — занимать
// не у кого, дозу ставить некуда, отказаться от тренда он не может.
// Раздел вернётся вместе со слоем 3/3.

g7 = "⑦ ПРАВИЛА ТРЕНДА · ВОСХОДЯЩИЙ"
trOn    = input.bool(true, "Считать", group = g7, tooltip = "ЖИЗНЕННЫЙ ЦИКЛ, девять подразделов:\n\n· РОЖДЕНИЕ — ноль ставится на низ LL, и первая же вершина после него — HH или LH всё равно — объявляет (1). Состояние «возможен»;\n· ПОДТВЕРЖДЕНИЕ — пришёл HL. Состояние «ВОСХ», ноги счёта становятся толстыми;\n· СЧЁТ — чередование колен от нуля, нечётная точка вершина, чётная низ, потолок пять. Встречная подпись счёт НЕ обрывает, она помечает точку как манипуляционную;\n· УРОВЕНЬ — последний появившийся НИЗ от нуля, ЛЮБОЙ подписи. Храповика нет. Манипуляционный низ уровень ДЕРЖИТ, но рисуется штрих-пунктиром. Уровень на самом нуле — точками, и он рубится касанием;\n· СМЕРТЬ — тело свечи ушло ниже уровня на 0.20 скользящего колена слоя;\n· ПОСЛЕ (5) — продолжение, архив или смерть.\n\nПРОДОЛЖЕНИЕ требует (5), а НЕ (3), и только у ЖИВОГО тренда. Умерший тренд продолжиться не может — он рождается заново, и ноль у него LL.\n\nЧЕТВЁРТОГО ИСХОДА, ОТКАЗА, у слоя 2/2 нет: отказ случался, когда слою не хватало чужих колен, а у 2/2 чужих колен не бывает.")
trDepth = input.float(0.20, "Глубина, долей колена", minval = 0.0, maxval = 2.0, step = 0.01, group = g7, tooltip = "Порог смерти: уровень − ЭТА ДОЛЯ × скользящее среднее колено слоя (окно 20 ног).\n\nОТКУДА 0.20. Замер Н28 на 11 383 заходах за девять лет: тело уходило за уровень на 0.04–0.09 колена, когда тренд оправлялся, и на 0.25–0.33, когда слабел. Разделение в 4–6 раз. По тени только 2.3–2.7 раза — поэтому считается ПО ТЕЛУ, min(открытие, закрытие), и тень тренд не убивает.\n\nЦЕНА, Н38, девять лет: убивает по делу 78%, зря 22%, пропускает 32% слабеющих. Базовая доля ослаблений 63%.\n\nОПТИМУМА НЕТ — кривая монотонная, это размен строгости на терпение:\n   0.10   по делу 73%, пропускает 23%\n   0.20   по делу 78%, пропускает 32%   ← эталон\n   0.30   по делу 81%, пропускает 40%\n   0.40   по делу 83%, пропускает 48%\n\nОкно 20 зашито: Н30 показал, что при 10, 20 и 50 результат не меняется.\n\nЧИСЛА ПОСЧИТАНЫ НА ТРЁХ СЛОЯХ СРАЗУ. Для слоя 2/2 отдельно они не пересчитывались — замер не заказан.")
trBrk   = input.string("выше вершины на 0.20 колена", "Запасное подтверждение, когда низ пришёл манипуляционным", options = ["выше вершины на 0.20 колена", "4 закрытия выше вершины"], group = g7, tooltip = "ОСНОВНОЕ правило подтверждения не меняется и в ручку не входит: пришёл HL — тренд подтверждён, всегда и в первую очередь.\n\nЭта ручка — ЗАПАСНОЕ правило, и оно СПИТ, пока в счёте не появился низ с подписью LL.\n\nКАК ЧАСТО ОНО МОЖЕТ СРАБОТАТЬ: низ (2) приходит манипуляционным в 18% счётов слоя 2/2 — 297 из 1688 за девять лет часовика.\n\nПроснувшись, запасное подтверждает ПО ЦЕНЕ от перебитой вершины:\n· «выше вершины на 0.20 колена» — та же мерка, что у смерти. Одно число на весь движок;\n· «4 закрытия выше вершины» — столько закрытий подряд.\n\nУРОВЕНЬ при этом ПЕРЕЕЗЖАЕТ на манипуляционный низ. Появляется состояние «тренд подтверждён, но опора у него ещё временная»: сплошные ноги счёта плюс ШТРИХ-ПУНКТИРНЫЙ уровень без подписи.")

g8 = "⑦ ПРАВИЛА ТРЕНДА · НИСХОДЯЩИЙ"
trDn    = input.bool(true, "Считать", group = g8, tooltip = "Нисходящий считается ТЕМ ЖЕ движком на ПЕРЕВЁРНУТЫХ свечах. Идея владельца 22.09.2026: не переводить сорок правил руками, а перевернуть цены. Перевёрнутая свеча — знак меняется, максимум и минимум местами. Тогда пивот-вершина на перевёрнутых это пивот-низ на настоящих, HH это LL, HL это LH, а ВОСХОДЯЩИЙ на перевёрнутых это НИСХОДЯЩИЙ на настоящих.\n\nВторого набора правил не существует: зеркало точное ПО ПОСТРОЕНИЮ, а не потому, что я аккуратно переписал условия.")
dnSame  = input.bool(true, "Правила как у восходящего", group = g8, tooltip = "Пока галочка стоит, нисходящий берёт значения восходящего, и ПРОВЕРКА ЗЕРКАЛА ОСТАЁТСЯ МЕХАНИЧЕСКОЙ: любой замер по нисходящему проверяется прогоном восходящего на перевёрнутых данных.\n\nСнять — у нисходящего заработают свои значения из двух строк ниже.\n\nЧЕСТНАЯ ЦЕНА ОТЛИЧИЙ: бесплатная проверка умирает. Поэтому правило — отличие заводится не на всякий случай, а когда владелец УВИДЕЛ разницу на графике или её показал замер.")
dnDepth = input.float(0.20, "Глубина, долей колена (своя)", minval = 0.0, maxval = 2.0, step = 0.01, group = g8, tooltip = "Работает только когда снята галочка «Правила как у восходящего».")
dnBrk   = input.string("выше вершины на 0.20 колена", "Запасное подтверждение (своё)", options = ["выше вершины на 0.20 колена", "4 закрытия выше вершины"], group = g8, tooltip = "Работает только когда снята галочка «Правила как у восходящего». В перевёрнутом мире «выше вершины» читается как «ниже низа» на настоящем графике.")

g9 = "⑧ ПРАВИЛА СЛОМОВ"
slOn    = input.bool(true, "Считать сломы", group = g9, tooltip = "Слом — цена взяла ближайший НЕПРОБИТЫЙ пивот слоя. Это тот самый момент, когда живой уровень из ③ перестаёт быть живым.\n\nКолено становится известно задним числом, через два бара. Слом известен ЗАРАНЕЕ — цена, которую надо пробить, уже нарисована на графике.\n\nЗамер Н14, девять лет часовика: сломы НЕ независимы, они слипаются. После серии в одну сторону следующий идёт туда же чаще собственной базовой доли на 7-20 процентных пунктов.\n\nСлом засчитывается по КАСАНИЮ: хватает тени.")
slNoCap = input.bool(true, "Счёт без потолка", group = g9, tooltip = "У счёта по коленам потолок пять. У сломов серии доходят до 16-24, и потолок отрезал бы самые длинные десять процентов. Поэтому счёт растёт, сколько идёт.")

g10 = "⑨ СТАРШИЕ ТФ"
hOn    = input.bool(true, "Показывать", inline = "h", group = g10)
h_tf4  = input.bool(true, "4H",         inline = "h", group = g10)
h_tfd  = input.bool(true, "1D",         inline = "h", group = g10)
hLB    = input.int(3, "Глубина пивота старших ТФ", minval = 1, maxval = 8, group = g10, tooltip = "Уровни 4H и 1D не зависят от нашего движка вообще — это единственное на графике, что считается не им. Цвета — в ⑥.")

// ══════════════ ПРОИЗВОДНЫЕ ОТ НАСТРОЕК ══════════════
// глубина смерти и запасное подтверждение: у нисходящего либо своё, либо
// как у восходящего. ОТЛИЧИЕ — ЭТО ЗНАЧЕНИЕ, А НЕ ВТОРАЯ ВЕТКА КОДА:
// движок один, ему подаются разные числа
float depthU = trDepth
float depthD = dnSame ? trDepth : dnDepth
string brkU  = trBrk
string brkD  = dnSame ? trBrk : dnBrk
// сколько отличий от зеркала завёл владелец — для строки табло
int mirDiff = (dnSame ? 0 : (dnDepth != trDepth ? 1 : 0) + (dnBrk != trBrk ? 1 : 0))

// окно скользящего среднего колена. Зашито: Н30 показал, что при 10, 20
// и 50 результат не меняется — разброс ≤ 0.03 в двенадцати парах из
// двенадцати. Ручку заводить не из чего
LEGWIN = 20
// сколько закрытий подряд для варианта «4 закрытия выше вершины»
NBAR = 4

MAXK = 100
// «нуля счёта нет». Пайн не принимает na в параметр функции, у которого
// тип выводится из вызова, — ни голый, ни через int-переменную. Поэтому
// сторож обычным числом: бар-индекс никогда не бывает отрицательным.
NOZERO = -1

// ── СОСТОЯНИЯ ТРЕНДА. Шесть значений ──
// У тренда ТРИ КОНЦА, и табло пишет, ЧЕМ КОНЧИЛОСЬ.
//
// В эталоне v2.3 состояний семь, а концов четыре: там есть ещё ОТКАЗ
// «не свой» — слою не хватило чужих колен. У слоя 2/2 чужих колен не
// бывает, значит и отказа быть не может. Состояние убрано целиком, а не
// оставлено недостижимым: мёртвый код в движке уже дорого обходился.
ST_NO   = 0     // нет тренда
ST_MAY  = 1     // ВОЗМОЖЕН: есть (0) LL и пришла (1). Не подтверждён
ST_LIVE = 2     // ВОСХ / НИСХ: пришёл HL, тренд подтверждён
ST_ARC  = 3     // АРХИВ: после (5) пришёл низ LL
ST_CAN  = 4     // НЕ БЫЛО: ОТМЕНА, цена коснулась нуля до подтверждения
ST_DEAD = 5     // УМЕР: тело ушло ниже порога

// ══════════════ КОЛЕНА ══════════════
// Колено — пивот; подряд идущие одной стороны схлопываются в экстремум.
var float[]  P2 = array.new_float()
var int[]    B2 = array.new_int()
var bool[]   H2 = array.new_bool()
var string[] L2 = array.new_string()
var int[]    M2 = array.new_int()
var float[]  G2 = array.new_float()
var int[]    Y2 = array.new_int()
var bool[]   Z2 = array.new_bool()
var string[] W2 = array.new_string()

// ── ПЕРЕВЁРНУТЫЕ КОЛЕНА ──
// Те же пивоты, поданные в ту же f_push с МИНУС-ЦЕНОЙ и перевёрнутой
// стороной. Слияние и подписи получаются зеркальными сами: HH здесь
// значит LL там, HL значит LH. Отдельного кода нет и не будет.
var float[]  P2n = array.new_float()
var int[]    B2n = array.new_int()
var bool[]   H2n = array.new_bool()
var string[] L2n = array.new_string()
var int[]    M2n = array.new_int()
var float[]  G2n = array.new_float()
var int[]    Y2n = array.new_int()
var bool[]   Z2n = array.new_bool()
var string[] W2n = array.new_string()
// ПОЧИНКА ЗЕРКАЛА, З36, 07.10.2026.
//
// У вершины сравнение строгое, у низа — НЕСТРОГОЕ. Это не опечатка и не
// вторая ветка кода: `>` не симметрично при перевороте знака, когда
// значения РАВНЫ. Неравенство переворачивается, равенство — нет.
//
//   настоящий мир:   вершина равна прошлой  →  не перебила  →  LH
//   перевёрнутый:    низ равен прошлому     →  удержал      →  HL
//
// А HL и есть зеркало LH. Поставь один оператор на обе стороны — и
// зеркало сломается с той или с другой: `>` везде даёт LH/LL, `>=`
// везде даёт HH/HL. Нужно, чтобы ничья у ВЕРШИНЫ и ничья у НИЗА
// читались зеркально, а зеркало меняет СТОРОНУ — значит и оператор
// обязан зависеть от стороны. Сторона это не направление, поэтому
// запрет «второй ветки кода» от 01.10.2026 не нарушен.
//
// По-человечески: ничья значит «ничего не произошло». Равная вершина
// НЕ ПЕРЕБИЛА, равный низ УДЕРЖАЛ.
//
// Проверено research/zerkalo_check.py: было 2–5 расхождений на
// 7–11 тысяч колен, стало 0 на всех трёх слоях и на всех данных.
f_lab(_hi, _cur, _prev) =>
    na(_prev) ? "?" : _hi ? (_cur > _prev ? "HH" : "LH") : (_cur >= _prev ? "HL" : "LL")

f_relabel(_P, _H, _L) =>
    array.clear(_L)
    n = array.size(_P)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(_H, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(_H, j) == hi
                    prev := array.get(_P, j)
                    break
                j -= 1
            array.push(_L, f_lab(hi, array.get(_P, i), prev))
    n

// Метка, которая проявилась, не должна пропадать. При слиянии двух
// пивотов одной стороны проигравший уходит в список поглощённых и
// остаётся видимым на своём месте. Подпись считается от ПРЕДЫДУЩЕГО
// колена той же стороны, а не от того, в которое метка влилась.
// Метка, которая проявилась, не должна пропадать. При слиянии двух
// пивотов одной стороны проигравший уходит в список поглощённых и
// остаётся видимым на своём месте. Подпись считается от ПРЕДЫДУЩЕГО
// колена той же стороны, а не от того, в которое метка влилась.
f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi) =>
    n = array.size(_P)
    float prev = na
    j = n - 2
    while j >= 0
        if array.get(_H, j) == _hi
            prev := array.get(_P, j)
            break
        j -= 1
    array.push(_G, _price)
    array.push(_Y, _bar)
    array.push(_Z, _hi)
    array.push(_W, f_lab(_hi, _price, prev))
    if array.size(_G) > MAXK
        array.shift(_G)
        array.shift(_Y)
        array.shift(_Z)
        array.shift(_W)
    0
f_push(_P, _B, _H, _L, _M, _G, _Y, _Z, _W, _price, _bar, _hi) =>
    n = array.size(_P)
    bool same = false
    if n > 0
        same := array.get(_H, n - 1) == _hi
    if same
        old = array.get(_P, n - 1)
        oldB = array.get(_B, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(_M, n - 1, array.get(_M, n - 1) + 1)
        if better
            a1 = f_absorb(_G, _Y, _Z, _W, _P, _H, old, oldB, _hi)
            array.set(_P, n - 1, _price)
            array.set(_B, n - 1, _bar)
        else
            a2 = f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi)
    else
        array.push(_P, _price)
        array.push(_B, _bar)
        array.push(_H, _hi)
        array.push(_M, 1)
        if array.size(_P) > MAXK
            array.shift(_P)
            array.shift(_B)
            array.shift(_H)
            array.shift(_M)
    d = f_relabel(_P, _H, _L)
    not same
// ══════════════ СКОЛЬЗЯЩЕЕ СРЕДНЕЕ КОЛЕНО СЛОЯ ══════════════
// Новая величина, §41. Средняя длина последних LEGWIN ног цепочки слоя.
//
// ЗАЧЕМ. Прежний порог смерти считался от ИМПУЛЬСА — последнего
// выросшего колена. Замер Н29: эта величина нигде не измерялась и гуляла
// в ШЕСТЬ раз, от 0.12 до 0.70 колена. Среднее колено ровнее и честнее.
//
// ПОЧЕМУ СКОЛЬЗЯЩЕЕ. Колено выросло в 10–14 раз за девять лет: 5.4
// пункта в начале, 77 в конце. Фиксированное число в пунктах к концу
// истории перестало бы что-либо значить.
//
// ПОЧЕМУ СВОЁ У КАЖДОГО СЛОЯ. Колена у слоёв разного размера по
// построению: 5/5 видит крупную структуру, 2/2 мелкую.
//
// ЗЕРКАЛО ЦЕЛО: берётся МОДУЛЬ разницы, а у перевёрнутых цен он тот же.
f_avgLeg(_P) =>
    n = array.size(_P)
    float s = 0.0
    int c = 0
    if n >= 2
        int from = math.max(1, n - LEGWIN)
        for i = from to n - 1
            s += math.abs(array.get(_P, i) - array.get(_P, i - 1))
            c += 1
    c > 0 ? s / c : 0.0
// ══════════════ ТРЕНД: ОДИН СЛОЙ, ДВА НАПРАВЛЕНИЯ ══════════════
// Ячейка 0 — ВОСХОДЯЩИЙ, ячейка 1 — НИСХОДЯЩИЙ, посчитанный ТЕМ ЖЕ
// движком на ПЕРЕВЁРНУТЫХ коленах. Сама f_trend об этом не знает и не
// должна: она работает по индексу, ей всё равно, какой мир ей подали.
//
// ВНИМАНИЕ: цены в ячейке 1 ОТРИЦАТЕЛЬНЫЕ — это перевёрнутый мир.
// Всё, что идёт на экран и в табло, переворачивается обратно.
//
// Бары держим числом, -1 значит «нет»: пайн капризен с na в массивах.
var int[]    tTR  = array.new_int(2, 0)        // состояние, ST_*
var int[]    tZB  = array.new_int(2, -1)       // бар колена-нуля
var float[]  tZP  = array.new_float(2, na)     // его цена
var string[] tZL  = array.new_string(2, "")    // его подпись
var float[]  tLVL = array.new_float(2, na)     // уровень — последний HL
var int[]    tLVB = array.new_int(2, -1)
var bool[]   tLHL = array.new_bool(2, false)   // уровень на настоящем HL
// СТУПЕНЬ СТРОГОСТИ. true — уровень всё ещё стоит на НУЛЕ, и тогда
// его рубит КАСАНИЕ без всякого запаса: «тренда не было». false —
// уровень съехал на низ счёта, и работает мягкое правило по телу.
// §31, прочтение 1: «граница терпения проходит СРАЗУ ПОСЛЕ НОЛЯ»
var bool[]   tONZ = array.new_bool(2, true)
var int[]    tCNT = array.new_int(2, -1)       // номер последней точки
var int[]    tMAX = array.new_int(2, -1)       // докуда счёт дошёл
var float[]  tLEG = array.new_float(2, 0.0)    // скользящее среднее колено
var int[]    tRST = array.new_int(2, 0)        // полных счётов: сколько раз дошёл до (5) и продолжился
var bool[]   tLL  = array.new_bool(2, false)   // в счёте был низ LL — разбудил запасное подтверждение
var int[]    tEB  = array.new_int(2, -1)       // бар события, которым тренд кончился
// ЧЕТЫРЕ МЁРТВЫХ МАССИВА УБРАНЫ 08.10.2026, слово владельца «сделать
// оба сейчас». Это tBEL (закрытий подряд ниже уровня), tIMP (импульс),
// tPUP и tPMX (заводились под правило «продолжение с (3)»). Все четыре
// СЧИТАЛИСЬ и НЕ ЧИТАЛИСЬ НИГДЕ: правила, под которые они заводились,
// отменены — Н31, Н29 и путь А по З33.
//
// Держались в коде по правилу 4, пока владелец не сказал убрать. На
// графике их не было видно никогда: они ничего не рисовали.
var float[]  tDP  = array.new_float(2, na)     // цена смерти
var int[]    tDB  = array.new_int(2, -1)       // бар смерти
var int[]    tBB  = array.new_int(2, -1)       // бар рождения
var int[]    tPZB = array.new_int(2, -1)       // ноль ПРОШЛОГО счёта
// перебитая вершина — от неё считается ЗАПАСНОЕ подтверждение У7
var float[]  tBP  = array.new_float(2, na)
var int[]    tBB2 = array.new_int(2, -1)
var int[]    tBAB = array.new_int(2, 0)        // закрытий подряд выше вершины

// ИСТОРИЯ СОБЫТИЙ, плоскими списками: бар, цена, слой.
// RD* — СМЕРТЬ. Красная чёрточка ставится ТОЛЬКО сюда: у отмены,
// отказа и архива следа на графике нет (§44, слово владельца «да,
// красная чёрточка только у смерти»).
// GD* — РОЖДЕНИЕ. Цена перебитой вершины. С графика убрана под галочку
// «Показывать рождение тренда», механизм работает всегда
var int[]   RDB = array.new_int()
var float[] RDP = array.new_float()
var int[]   RDL = array.new_int()
var int[]   GDB = array.new_int()
var float[] GDP = array.new_float()
var int[]   GDL = array.new_int()
var bool[]  GOK = array.new_bool()
MAXSL = 600

// ── ПЕРЕКЛЮЧЕНИЯ «АВТО» ──
// Счёт обоих направлений идёт ВСЕГДА, им управляют галочки в ⑦.
// Режим из ① выбирает только, кого НАРИСОВАТЬ. Поэтому тренд, на который
// «авто» переключилось, появляется уже со счётом, набранным пока был
// невидим. Здесь запоминается бар, на котором решение поменялось.
//
// В версии с тремя слоями это были массивы по слоям. Слой один —
// обычные переменные.
var int  swB = -1
var bool swD = false
var bool swI = false
// РЕЖИМ, а не флаг: 0 веду восходящий, 1 веду нисходящий, -1 никого.
// -2 значит «ещё не считали ни разу»
var int  SWM = -2
var int[]   AWB = array.new_int()
var bool[]  AWD = array.new_bool()
var float[] AWP = array.new_float()
// ══════════════ СПРАВОЧНИК ПОСЛЕДОВАТЕЛЬНОСТЕЙ ══════════════
// Перепись 9 лет часовика, слой 2/2. Низы в восходящем всегда HL — иначе это не
// восходящий, — поэтому свободны только вершины и вариантов ровно
// восемь. Ноль пишется первым: LL у рождения, HL у продолжения.
// Индикатор НЕ предсказывает: он узнаёт форму и называет её номером,
// как шаблон триггерной свечи.
var string[] PAT = array.from("LH·HL·HH·HL·HH","LH·HL·HH·HL·LH","HH·HL·HH·HL·HH","HH·HL·HH·HL·LH","HH·HL·LH·HL·HH","LH·HL·LH·HL·HH","HH·HL·LH·HL·LH","LH·HL·LH·HL·LH")
var string[] PNM = array.from("П1","П5","П6","П12","П16","П20","П25","П29")
// [рождения 2/2, продолжения 2/2]. Колонки 5/5 и 3/3 из
// эталона v2.3 убраны вместе со слоями — числа целы, они в эталоне
// ПЕРЕСЧИТАНО 07.10.2026 на движке v2.1 — замечание З27 закрыто
// замером Н35. Прежние числа посчитаны без вставок и по старым
// правилам; половина «продолжения» просела в разы, потому что по
// решению З32 продолжение теперь разрешено только на ПЕРВОМ новом
// колене после (5), а прежде HL можно было ждать сколько угодно
var int[] PFR = array.from(154,93,73,63,56,54,23,22,  21,12,41,40,26,4,4,0)
// Нумерация нисходящего ЗЕРКАЛЬНАЯ: С1 это зеркало П1. Строки PAT
// подходят как есть — в перевёрнутом мире нисходящий это буквально
// восходящий. Переводится обратно только то, что идёт на экран
var string[] SNM = array.from("С1","С5","С6","С12","С16","С20","С25","С29")
// то же, пересчитано на движке v2.1
var int[] SFR = array.from(139,89,60,62,79,53,35,10,  20,12,20,30,18,2,9,3)

// подпись из перевёрнутого мира в настоящий: HH<->LL, HL<->LH
f_swap1(_x) =>
    _x == "HH" ? "LL" : _x == "LL" ? "HH" : _x == "HL" ? "LH" : _x == "LH" ? "HL" : _x

f_swapSeq(_s) =>
    string r = ""
    arr = str.split(_s, "·")
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            r := r + (i == 0 ? "" : "·") + f_swap1(array.get(arr, i))
    r

// Табло: ДВЕ колонки — название и значение. В эталоне их четыре, по
// колонке на слой. Строк 22: в эталоне 23, ушла «вставок в коленах».
var table TBL = table.new(tblPos == "справа вверху" ? position.top_right : tblPos == "справа внизу" ? position.bottom_right : tblPos == "слева вверху" ? position.top_left : position.bottom_left, 2, 22, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 80))
tSz = tblSize == "мелкий" ? size.tiny : size.small
// последнее рождение слоя _i в истории, -1 если нет
f_lastG(_i) =>
    int r = -1
    n = array.size(GDL)
    if n > 0
        for k = n - 1 to 0
            if array.get(GDL, k) == _i
                r := k
                break
    r
// ══════════════ УРОВЕНЬ ══════════════
// Уровень считается ОТ НУЛЯ ЗАНОВО на каждом новом колене, а не
// доставляется по шагу. Это и есть правило У1 плюс З0 одной функцией:
//
//   уровень = ПОСЛЕДНИЙ HL в цепочке, начиная с нуля включительно.
//   Такого нет — уровень на самом нуле, и он ВРЕМЕННЫЙ.
//
// Что это даёт даром:
// · У1 — новый HL заменяет прежний безусловно, храповика нет;
// · У2 — при рождении ноль это LL, HL ещё нет, уровень стоит на нуле и
//   помечен временным: тренду надо за что-то держаться с первой минуты,
//   иначе его нечем убить. Бессмертный тренд хуже опоры на LL;
// · У3 и М3 — манипуляционный низ LL уровень не обновляет: он не HL;
// · З0 и У4 — ВОЗВРАТ. Колено было HL, уровень на него переехал, потом
//   пришёл более низкий низ, колена слились, и колено стало LL. По
//   правилу владельца манипуляционное колено НИЧЕГО НЕ ДЕРЖИТ, значит
//   уровень обязан вернуться на предыдущий HL. При пересчёте от нуля
//   это происходит само, без отдельной ветки;
// · У9 — предварительное колено живого края уровнем не становится: его
//   в цепочке нет, он живёт отдельно;
// · У10 — продолжение после (5) получает НАСТОЯЩИЙ уровень сразу: его
//   ноль и есть HL.
//
// Уровень — ЖИВАЯ линия, указатель «держимся здесь», а не запись
// истории. Поэтому он имеет право и вернуться назад.
// Пишет результат прямо в tLVL / tLVB / tLHL, кортеж не возвращает:
// кортеж из тела функции — лишний риск там, где он не нужен.
f_lvlSet(_i, _P, _B, _H, _L, _zb) =>
    n = array.size(_P)
    int zi = -1
    if n > 0
        for k = 0 to n - 1
            if array.get(_B, k) >= _zb and not array.get(_H, k)
                zi := k
                break
    if zi >= 0
        float lp = array.get(_P, zi)
        int   lx = array.get(_B, zi)
        bool  real = array.get(_L, zi) == "HL"
        bool  moved = false
        // РАЗВИЛКА А, решение владельца 07.10.2026: «пусть съезжает на
        // манипуляционный низ». Уровень переезжает на низ ЛЮБОЙ подписи,
        // а не только на HL. Отличие осталось в ЛИНИИ: `real` решает,
        // рисовать сплошную или штрих-пунктирную, — буквально правило М3
        // «манипуляционное колено ДЕРЖИТ, отличие не в силе, а в линии».
        //
        // Это же сняло отдельную работу: линия манипуляционного сторожа
        // больше не нужна, уровень и ЕСТЬ эта линия.
        for k = zi to n - 1
            if not array.get(_H, k)
                if k > zi
                    lp := array.get(_P, k)
                    lx := array.get(_B, k)
                    real := array.get(_L, k) == "HL"
                    moved := true
        array.set(tLVL, _i, lp)
        array.set(tLVB, _i, lx)
        array.set(tLHL, _i, real)
        // СТУПЕНЬ СТРОГОСТИ, и она привязана не к номеру точки, а к ТОМУ,
        // ЧЕМ НАРИСОВАНА ЛИНИЯ. Строго — только пока уровень стоит на
        // нуле И этот ноль не настоящий HL, то есть пока линия
        // ШТРИХ-ПУНКТИРНАЯ, то есть пока она ПРЕДПОЛОЖЕНИЕ. Это общее
        // правило показа от 05.10: штрих-пунктир можно стереть, сплошная
        // остаётся.
        //
        // ПОЧЕМУ НЕ ПРОСТО «уровень на нуле». Так я и написал сначала, и
        // это была ошибка: у ПРОДОЛЖЕНИЯ ноль — настоящий HL (У10), а
        // низов после него ещё нет, и строгая ступень включалась снова.
        // Тренд, трижды прошедший путь до (5), мог умереть от одного
        // касания своего нуля. «Тренда не было» про такой тренд —
        // бессмыслица: он был, и это видно по номерам на графике.
        array.set(tONZ, _i, (not moved) and (not real))
    zi
// Текущая последовательность слоя _i: подпись нуля и хвост от (1).
// Показывается у живого тренда и у АРХИВА: форма счёта состоялась, её
// номер — итог (§47)
f_seqNow(_P, _B, _H, _L, _i) =>
    string zlab = ""
    string tail = ""
    int np = 0
    s = array.get(tTR, _i)
    if (s == ST_MAY or s == ST_LIVE or s == ST_ARC) and array.get(tZB, _i) >= 0
        n = array.size(_P)
        int zi = -1
        if n > 0
            for k = 0 to n - 1
                // ноль ищется не только по бару, но и ПО СТОРОНЕ. Он всегда
                // НИЗ: LL при рождении, HL при продолжении. Большая свеча
                // умеет сделать и вершину, и низ сразу — тогда два колена
                // сидят на одном баре, и поиск «по бару» хватал вершину
                if array.get(_B, k) >= array.get(tZB, _i) and not array.get(_H, k)
                    zi := k
                    break
        if zi >= 0
            zlab := array.get(_L, zi)
            int last = math.min(zi + 5, n - 1)
            if last >= zi + 1
                for k = zi + 1 to last
                    tail := tail + (np == 0 ? "" : "·") + array.get(_L, k)
                    np += 1
    [zlab, tail, np]

// Сколько эталонов ещё подходят под этот хвост и как они называются
f_match(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(PNM, p)
    [cnt, idx, nms]

// То же, но имена из справочника НИСХОДЯЩЕГО. Строки PAT одни и те же
f_matchS(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(SNM, p)
    [cnt, idx, nms]
// ══════════════ ОДИН ШАГ ДВИЖКА ══════════════
// _o, _h, _l, _c — открытие, верх, низ и закрытие ЭТОГО мира. Нисходящий
// зовёт функцию с минус-ценами, и верх с низом у него МЕНЯЮТСЯ МЕСТАМИ:
// «верх свечи» в перевёрнутом мире это минус настоящий минимум. Иначе он
// на перевёрнутых коленах брал бы настоящую свечу и сравнивал её с
// перевёрнутым уровнем.
//
// Низ свечи нужен с 07.10.2026: отмена считается по КАСАНИЮ.
// _leg  — скользящее среднее колено ЭТОЙ цепочки.
// _ref  — слою понадобилась лишняя чужая метка (§33).
// _depth, _brk — глубина смерти и запасное подтверждение. У нисходящего
//   это ЗНАЧЕНИЯ, а не вторая ветка кода: движок один.
//
// ПОРЯДОК ВНУТРИ БАРА ВАЖЕН И ЗАДАН НАРОЧНО:
//   отказ → смерть и отмена → запасное подтверждение → колена.
// Смерть проверяется ДО колен, поэтому ничья «смерть или архив на одном
// баре» разрешается в пользу смерти — §36, правило детерминированное.
f_trend(_i, _P, _B, _H, _L, _nw, _fr, _o, _h, _l, _c, _leg, _depth, _brk) =>
    n = array.size(_P)
    // в ИСТОРИЮ событий цена кладётся НАСТОЯЩЕЙ: ячейка 1 живёт в
    // перевёрнутом мире, и без этого чёрточки уехали бы под график
    float sg = _i >= 1 ? -1.0 : 1.0
    int st = array.get(tTR, _i)

    // ── 1. СМЕРТЬ и ОТМЕНА. Каждый бар, а не только на колене ──
    //
    // СТУПЕНЕЙ РОВНО ДВЕ, и граница между ними проходит СРАЗУ ПОСЛЕ
    // НОЛЯ. Слово владельца, §31, прочтение 1, подтверждённое им же
    // 06.10.2026: «если ЦЕНА перебивает сторожа ноля даже касанием —
    // тренда не было... если счёт дошёл до 2 HL, тут допускается
    // манипуляция, но вступает в силу правило глубины».
    //
    //    уровень стоит на НУЛЕ   →  КАСАНИЕ рубит, без всякого запаса
    //    уровень съехал на низ   →  тело ниже уровня на долю колена
    //
    // Ступень выбирается по tONZ — по тому, ГДЕ СТОИТ УРОВЕНЬ, а не по
    // подтверждению и не по номеру точки. Так сказано у владельца:
    // «граница терпения проходит сразу после ноля», не после (3) и не
    // после HL.
    //
    // ИСПРАВЛЕНИЕ 07.10.2026. В v2.0 здесь стояло ЗАКРЫТИЕ, взятое из
    // ответа §15 В-а, и ступень выбиралась по состоянию «возможен».
    // Владелец поймал подмену: «мы же вроде договорились, что счёт 0,
    // если цена его касается до отображения 2 — отказ от тренда. Куда
    // это пропало?» Его правило лежало в §31 всё это время.
    if (st == ST_MAY or st == ST_LIVE) and not na(array.get(tLVL, _i))
        lv = array.get(tLVL, _i)
        if array.get(tONZ, _i)
            // СТРОГАЯ СТУПЕНЬ: касание сторожа ноля. Это НЕ смерть —
            // «тренда не было», поэтому красной чёрточки здесь нет
            if _l <= lv
                array.set(tTR,  _i, ST_CAN)
                array.set(tEB,  _i, bar_index)
                array.set(tCNT, _i, -1)
                array.set(tLVL, _i, na)
                array.set(tRST, _i, 0)
                array.set(tLL,  _i, false)
                st := ST_CAN
        else
            // МЯГКАЯ СТУПЕНЬ: манипуляция прощается, убивает глубина.
            // ПО ТЕЛУ, min(открытие, закрытие). Тень тренд НЕ убивает:
            // замер Н28, тело разделяет исходы в 4–6 раз, тень в 2.3–2.7
            bLo = math.min(_o, _c)
            if bLo < lv - _depth * _leg
                array.set(tDP,  _i, lv)
                array.set(tDB,  _i, bar_index)
                array.set(tTR,  _i, ST_DEAD)
                array.set(tEB,  _i, bar_index)
                array.set(tCNT, _i, -1)
                array.set(tLVL, _i, na)
                array.set(tBAB, _i, 0)
                array.set(tRST, _i, 0)
                array.set(tLL,  _i, false)
                st := ST_DEAD
                // КРАСНАЯ ЧЁРТОЧКА — только здесь. Метку рождения НЕ
                // гасим: она отмечает событие, которое БЫЛО, а событие
                // не отменяется тем, что тренд потом умер (С8)
                array.push(RDB, bar_index)
                array.push(RDP, lv * sg)
                array.push(RDL, _i)
                if array.size(RDB) > MAXSL
                    array.shift(RDB)
                    array.shift(RDP)
                    array.shift(RDL)

    // ── 2. ЗАПАСНОЕ ПОДТВЕРЖДЕНИЕ, У7. Тоже каждый бар ──
    // СПИТ, пока в счёте не появился низ с подписью LL. До этого
    // подтверждает только HL, основным правилом.
    if st == ST_MAY and array.get(tLL, _i) and not na(array.get(tBP, _i))
        bp = array.get(tBP, _i)
        array.set(tBAB, _i, _c > bp ? array.get(tBAB, _i) + 1 : 0)
        bool bA = math.max(_o, _c) > bp + _depth * _leg
        bool bB = array.get(tBAB, _i) >= NBAR
        if (_brk == "выше вершины на 0.20 колена" and bA) or (_brk == "4 закрытия выше вершины" and bB)
            array.set(tTR, _i, ST_LIVE)
            st := ST_LIVE
            gi = f_lastG(_i)
            if gi >= 0
                array.set(GOK, gi, true)

    // ── 3. НОВОЕ КОЛЕНО: счёт, уровень, рождение, архив, продолжение ──
    if _fr and n >= 2
        lb  = array.get(_L, n - 1)
        hiK = array.get(_H, n - 1)
        prK = array.get(_P, n - 1)
        bbK = array.get(_B, n - 1)
        ppK = array.get(_P, n - 2)
        if st == ST_MAY or st == ST_LIVE
            int cnt = array.get(tCNT, _i)
            if _nw and cnt >= 5 and not hiK
                // ── ПОСЛЕ (5): решает ПЕРВЫЙ новый низ, и только он ──
                // Точка (5) всегда ВЕРШИНА — это следует из чередования.
                // Значит следующее колено всегда НИЗ, и он бывает ровно
                // двух видов. Третьего не дано, поэтому строгое и мягкое
                // прочтения З32 оказались одним правилом.
                if lb == "HL"
                    // ПРОДОЛЖЕНИЕ. Единственное, что умеет сделать тренд
                    // долгим: остальные три исхода его заканчивают
                    array.set(tPZB, _i, array.get(tZB, _i))
                    array.set(tZB,  _i, bbK)
                    array.set(tZP,  _i, prK)
                    array.set(tZL,  _i, lb)
                    array.set(tCNT, _i, 0)
                    array.set(tMAX, _i, 0)
                    array.set(tRST, _i, array.get(tRST, _i) + 1)
                    array.set(tLL,  _i, false)
                    // У10: уровень СРАЗУ настоящий, ноль и есть HL, —
                    // поэтому продолжение не проходит через «возможен».
                    // И строгой ступени здесь НЕТ: касанием такой тренд
                    // не рубится, его ноль не предположение, а
                    // подтверждённый HL
                    array.set(tLVL, _i, prK)
                    array.set(tLVB, _i, bbK)
                    array.set(tLHL, _i, true)
                    array.set(tONZ, _i, false)
                    array.set(tTR,  _i, ST_LIVE)
                    st := ST_LIVE
                else
                    // АРХИВ. Низы перестали расти, продолжения нет.
                    // Тренд не умер — он ОТРАБОТАЛ, поэтому красной
                    // чёрточки здесь НЕТ, а номера счёта остаются
                    array.set(tTR,  _i, ST_ARC)
                    array.set(tEB,  _i, bar_index)
                    array.set(tLVL, _i, na)
                    st := ST_ARC
            else
                if _nw and cnt < 5
                    array.set(tCNT, _i, cnt + 1)
                    array.set(tMAX, _i, math.max(array.get(tMAX, _i), array.get(tCNT, _i)))
                // ПОДТВЕРЖДЕНИЕ, подраздел 2, одно правило: пришёл HL —
                // тренд подтверждён. СВОЙ или ВСТАВЛЕННЫЙ — разницы нет,
                // движок их не различает и не должен. Важна только
                // подпись: HL, и ничто другое
                if _nw and not hiK
                    if lb == "HL"
                        if st == ST_MAY
                            array.set(tTR, _i, ST_LIVE)
                            st := ST_LIVE
                            gj = f_lastG(_i)
                            if gj >= 0
                                array.set(GOK, gj, true)
                    else
                        // низ пришёл манипуляционным — просыпается
                        // запасное подтверждение У7
                        array.set(tLL, _i, true)
            // УРОВЕНЬ пересчитывается ОТ НУЛЯ на каждом колене. Отсюда
            // даром берутся У1, У2, У3, У9, У10 и возврат по З0.
            //
            // Вызов стоит ПОСЛЕ всей развилки нарочно: продолжение ставит
            // новый ноль HL, и по правилу У10 уровень обязан стать
            // НАСТОЯЩИМ сразу, в тот же бар. Стой вызов только в ветке
            // счёта — продолжение жило бы на уровне прошлого счёта до
            // следующего колена. У АРХИВА этого пересчёта быть не должно:
            // там уровень погашен, держать больше нечего, — поэтому
            // сторож по состоянию, а не безусловно
            if array.get(tTR, _i) == ST_MAY or array.get(tTR, _i) == ST_LIVE
                zq = f_lvlSet(_i, _P, _B, _H, _L, array.get(tZB, _i))
        else if st == ST_NO or st == ST_DEAD or st == ST_CAN or st == ST_ARC
            // ── РОЖДЕНИЕ ОБЪЯВЛЯЕТ (1), §14 ──
            // Любая первая вершина после LL — HH или LH всё равно.
            // Счёт начинается с (1), состояние «возможен». Приход HL на
            // (2) — это уже ПОДТВЕРЖДЕНИЕ, не рождение.
            //
            // Поиск нуля назад (back = 3, до пяти колен, перешагивая HL)
            // был ОБХОДНЫМ ПУТЁМ: его завели 21.09.2026 ровно потому,
            // что рождение объявляла только HH, а ноль к тому времени
            // оказывался далеко позади. Теперь обходить нечего — ноль
            // стоит ВПЛОТНУЮ перед (1) всегда. Проверено на двух
            // цепочках: там, где тренд состоялся, итог ОДИНАКОВЫЙ, а
            // владелец видит счёт по дороге, а не узнаёт задним числом.
            //
            // Колена чередуются, поэтому n-2 — всегда низ. Сторона
            // всё равно проверяется: сторож дешевле отладки
            if _nw and hiK and not array.get(_H, n - 2) and array.get(_L, n - 2) == "LL"
                int j = n - 2
                array.set(tTR,  _i, ST_MAY)
                array.set(tBB,  _i, bar_index)
                array.set(tZB,  _i, array.get(_B, j))
                array.set(tZP,  _i, array.get(_P, j))
                array.set(tZL,  _i, array.get(_L, j))
                array.set(tCNT, _i, 1)
                array.set(tMAX, _i, 1)
                array.set(tPZB, _i, -1)
                array.set(tRST, _i, 0)
                array.set(tLL,  _i, false)
                // У2: ноль становится ВРЕМЕННОЙ опорой. Тренду надо за
                // что-то держаться с первой минуты, иначе его нечем
                // убить, а бессмертный тренд хуже опоры на LL. Помечен
                // честно: tLHL = false, на графике штрих-пунктир без
                // подписи
                array.set(tLVL, _i, array.get(_P, j))
                array.set(tLVB, _i, array.get(_B, j))
                array.set(tLHL, _i, false)
                // СТРОГАЯ СТУПЕНЬ включена: пока ни один низ счёта не
                // пришёл, ноль рубится КАСАНИЕМ без запаса
                array.set(tONZ, _i, true)
                st := ST_MAY
                // ПЕРЕБИТАЯ ВЕРШИНА — та, которую цена взяла по дороге к
                // нулю. От неё считается запасное подтверждение У7.
                // На графике это чёрточка рождения, спрятанная под
                // галочку: механизм работает всегда, видимость — нет
                int v = j - 1
                while v >= 0
                    if array.get(_H, v)
                        break
                    v -= 1
                if v >= 0
                    array.set(tBP,  _i, array.get(_P, v))
                    array.set(tBB2, _i, bar_index)
                    array.set(tBAB, _i, 0)
                    array.push(GDB, bar_index)
                    array.push(GDP, array.get(_P, v) * sg)
                    array.push(GDL, _i)
                    array.push(GOK, false)
                    if array.size(GDB) > MAXSL
                        array.shift(GDB)
                        array.shift(GDP)
                        array.shift(GDL)
                        array.shift(GOK)
                else
                    array.set(tBP,  _i, na)
                    array.set(tBB2, _i, -1)
                    array.set(tBAB, _i, 0)
    0

ph2 = ta.pivothigh(high, 2, 2)
pl2 = ta.pivotlow (low,  2, 2)

if barstate.isconfirmed
    // nw2 — родилось ли НОВОЕ колено. Счёт двигается по коленам, а не по
    // сырым пивотам: слияние пивота в уже стоящее колено счёт не двигает
    bool nw2 = false
    if not na(ph2)
        q5 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, high[2], bar_index - 2, true)
        nw2 := nw2 or q5
    if not na(pl2)
        q6 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, low[2],  bar_index - 2, false)
        nw2 := nw2 or q6

    // ── ПЕРЕВЁРНУТЫЕ КОЛЕНА: та же f_push, минус-цена, сторона наоборот ──
    bool mw2 = false
    if not na(ph2)
        r5 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -high[2], bar_index - 2, false)
        mw2 := mw2 or r5
    if not na(pl2)
        r6 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -low[2],  bar_index - 2, true)
        mw2 := mw2 or r6

    bool fr2 = not na(ph2) or not na(pl2)

    // ── СКОЛЬЗЯЩЕЕ СРЕДНЕЕ КОЛЕНО: своё у каждой цепочки ──
    float leg2  = f_avgLeg(P2)
    float leg2n = f_avgLeg(P2n)
    array.set(tLEG, 0, leg2)
    array.set(tLEG, 1, leg2n)

    // ── шаг тренда: один слой, два направления ──
    // ВСТАВОК И ОТКАЗА ЗДЕСЬ НЕТ: у 2/2 соседа снизу нет, занимать не у
    // кого, и не хватать ему тоже нечего
    if trOn
        e2 = f_trend(0, P2,  B2,  H2,  L2,  nw2, fr2, open, high, low, close, leg2, depthU, brkU)
    // тот же движок, перевёрнутый мир. Второго набора правил нет.
    // ВЕРХ И НИЗ МЕНЯЮТСЯ МЕСТАМИ: «верх свечи» в перевёрнутом мире это
    // минус настоящий минимум. Зеркало меняет знак и сторону
    if trDn
        n2 = f_trend(1, P2n, B2n, H2n, L2n, mw2, fr2, -open, -low, -high, -close, leg2n, depthD, brkD)

    // ── кого «авто» рисует ПРЯМО СЕЙЧАС ──
    // Правило то же самое, что в блоке отрисовки ниже, слово в слово.
    // Здесь оно считается каждый бар только ради одного: запомнить бар,
    // на котором решение поменялось
    //
    // РАНГ: подтверждённый тренд сильнее «возможного». Это развязка
    // РИСКА 2 из §14 и ответ В-г из §15: «возможный восходящий не
    // показывается, пока жив подтверждённый нисходящий». Иначе в
    // устойчивом падении восходящий рождался бы на каждом отскоке и
    // «авто» металось бы
    int rU0 = not trOn ? 0 : array.get(tTR, 0) == ST_LIVE ? 2 : array.get(tTR, 0) == ST_MAY ? 1 : 0
    int rD0 = not trDn ? 0 : array.get(tTR, 1) == ST_LIVE ? 2 : array.get(tTR, 1) == ST_MAY ? 1 : 0
    int mD = -1
    if trWho == "только восходящий"
        mD := rU0 > 0 ? 0 : -1
    else if trWho == "только нисходящий"
        mD := rD0 > 0 ? 1 : -1
    else
        if rU0 == 0 and rD0 == 0
            mD := -1
        else if rU0 > rD0
            mD := 0
        else if rD0 > rU0
            mD := 1
        else
            // ранги равны — тот, чей НОЛЬ СВЕЖЕЕ: свежая структура это
            // то, что рынок строит сейчас, старая уже контекст
            mD := array.get(tZB, 1) > array.get(tZB, 0) ? 1 : 0
    bool dD = mD == 1
    if not swI or mD != SWM
        swB := bar_index
        SWM := mD
        swD := dD
        // метка ⇄ ставится, только когда переключились НА тренд.
        // Уход в «никого» метки не получает: там и рисовать нечего
        if swI and mD >= 0
            array.push(AWB, bar_index)
            array.push(AWD, dD)
            array.push(AWP, close)
            if array.size(AWB) > MAXSL
                array.shift(AWB)
                array.shift(AWD)
                array.shift(AWP)
        swI := true
// ══════════════ ЖИВЫЕ УРОВНИ СЛОЯ ══════════════
// Уровень — СЫРОЙ пивот, лежит в списке, при касании ценой
// ВЫЧЁРКИВАЕТСЯ. Пивоты не переезжают, поэтому пробитый уровень мёртв
// навсегда. Если брать уровень из КОЛЕНА, он при слиянии переезжает на
// новый экстремум, и пробитая линия оживает — так было в первых версиях.
var float[]  V2P = array.new_float()
var int[]    V2B = array.new_int()
var bool[]   V2H = array.new_bool()
var string[] V2L = array.new_string()

f_lvPush(_p, _b, _h, _l, _v, _off, _isHi, _lab) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - _off)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

// уровень существует, пока не пробит. Коснулась цена — удаляем совсем
f_purgeL(_p, _b, _h, _l) =>
    i = 0
    while i < array.size(_p)
        pr = array.get(_p, i)
        bool dead = array.get(_h, i) ? high >= pr : low <= pr
        if dead
            array.remove(_p, i)
            array.remove(_b, i)
            array.remove(_h, i)
            array.remove(_l, i)
        else
            i += 1
    0

// жив ли уровень с такой ценой — для линий у сырых меток
f_alive(_p, _v) =>
    bool r = false
    n = array.size(_p)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(_p, i) - _v) <= syminfo.mintick
                r := true
                break
    r
// ══════════════ СЧЁТ ПО СЛОМАМ ══════════════
// Слом = цена взяла ближайший НЕПРОБИТЫЙ пивот слоя. Своего механизма
// это не требует: живые уровни выше уже так и устроены, момент
// вычёркивания и есть слом.
//
// Почему это сильнее колена: колено известно ЗАДНИМ ЧИСЛОМ, на 2/2
// через два бара, на 5/5 через пять. Слом известен ЗАРАНЕЕ — цена, до
// которой надо дойти, уже стоит на графике.
//
// Замер Н14, девять лет часовика: сломы НЕ независимы, они слипаются.
var int[]   sDIR = array.new_int(1, 0)
var int[]   sRUN = array.new_int(1, 0)
var int[]   sLB  = array.new_int(1, -1)
var float[] sLP  = array.new_float(1, na)
var int[]   SB = array.new_int()
var float[] SP = array.new_float()
var int[]   SL = array.new_int()
var int[]   SN = array.new_int()

// Н14: доля случаев, когда следующий слом пошёл в ТУ ЖЕ сторону.
// Порядок: сторона вверх, вниз × длина серии 1..5,
// где пятая клетка значит «пять и больше». Девять лет часовика.
var float[] SFQ = array.from(61.4, 62.3, 59.1, 64.4, 65.5,   56.8, 59.2, 63.1, 61.6, 62.1)
var int[]   SFN = array.from(1893, 1163, 724, 427, 798,   1892, 1074, 636, 401, 651)
var float[] SFB = array.from(51.8)

f_slomOne(_i, _dir, _price) =>
    if array.get(sDIR, _i) != _dir
        int k = 0
        while k < array.size(SL)
            if array.get(SL, k) == _i
                array.remove(SB, k)
                array.remove(SP, k)
                array.remove(SL, k)
                array.remove(SN, k)
            else
                k += 1
        array.set(sDIR, _i, _dir)
        array.set(sRUN, _i, 1)
    else
        if slNoCap or array.get(sRUN, _i) < 5
            array.set(sRUN, _i, array.get(sRUN, _i) + 1)
    array.set(sLB, _i, bar_index)
    array.set(sLP, _i, _price)
    array.push(SB, bar_index)
    array.push(SP, _price)
    array.push(SL, _i)
    array.push(SN, array.get(sRUN, _i))
    if array.size(SB) > MAXSL
        array.shift(SB)
        array.shift(SP)
        array.shift(SL)
        array.shift(SN)
    0

// Ищет сломы этого бара по живым уровням слоя. Берётся БЛИЖАЙШИЙ
// пробитый с каждой стороны. Вызывается ДО того, как в список попадут
// уровни текущего бара, — ровно так считалось в замере Н14
f_slom(_i, _p, _h) =>
    if slOn
        n = array.size(_p)
        float bu = na
        float bd = na
        if n > 0
            for k = 0 to n - 1
                pr = array.get(_p, k)
                if array.get(_h, k)
                    if high >= pr
                        bu := na(bu) ? pr : math.min(bu, pr)
                else
                    if low <= pr
                        bd := na(bd) ? pr : math.max(bd, pr)
        if not na(bu)
            z1 = f_slomOne(_i, 1, bu)
        if not na(bd)
            z2 = f_slomOne(_i, -1, bd)
    0

// ближайший НЕПРОБИТЫЙ уровень слоя сверху и снизу от цены — это и есть
// две цены, на которых случится следующий слом
f_nearest(_p, _h) =>
    float up = na
    float dn = na
    n = array.size(_p)
    if n > 0
        for k = 0 to n - 1
            pr = array.get(_p, k)
            if array.get(_h, k)
                if pr > close
                    up := na(up) ? pr : math.min(up, pr)
            else
                if pr < close
                    dn := na(dn) ? pr : math.max(dn, pr)
    [up, dn]
// подпись СЫРОГО пивота: сравнение с предыдущим пивотом той же стороны.
//
// ЗДЕСЬ НАРОЧНО НИЧЕГО НЕ ТРОНУТО. Починка зеркала З36 касалась подписи
// КОЛЕНА — строки 305 прежнего файла, то есть f_relabel. Сырые подписи
// ниже на точной ничьей не дают НИ ОДНОЙ метки: оба условия ложны, и
// пивот в список живых уровней не попадает. Так было всегда.
//
// Привести их к тому же правилу я могу, но это ДОБАВИТ линий уровня там,
// где их не было, а правка такого размера владельцем не согласована.
// Вопрос вынесен ему вместе с остальными.

a21 = ta.valuewhen(not na(ph2), high[2], 1)
a22 = ta.valuewhen(not na(ph2), high[2], 0)
hh2 = na(ph2) ? na : a21 < a22 ? ph2 : na
lh2 = na(ph2) ? na : a21 > a22 ? ph2 : na
a23 = ta.valuewhen(not na(pl2), low[2], 1)
a24 = ta.valuewhen(not na(pl2), low[2], 0)
ll2 = na(pl2) ? na : a23 > a24 ? pl2 : na
hl2 = na(pl2) ? na : a23 < a24 ? pl2 : na

// сломы ищутся ПО ПРОШЛЫМ уровням, до того как добавятся сегодняшние
s03 = f_slom(0, V2P, V2H)

u09 = f_lvPush(V2P, V2B, V2H, V2L, hh2, 2, true,  "HH")
u10 = f_lvPush(V2P, V2B, V2H, V2L, lh2, 2, true,  "LH")
u11 = f_lvPush(V2P, V2B, V2H, V2L, hl2, 2, false, "HL")
u12 = f_lvPush(V2P, V2B, V2H, V2L, ll2, 2, false, "LL")

v03 = f_purgeL(V2P, V2B, V2H, V2L)

// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()
f_lvlLayer(_p, _b, _h, _l, _cHi, _cLo) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? _cHi : _cLo, lvTr), width = 1, style = st, extend = extend.right))
    n
// Поглощённые метки: бледная подпись на своём месте плюс короткая точка
// на своём уровне. Линии уровня у них нет — только метка.
f_drawAbs(_G, _Y, _Z, _W, _cHi, _cLo, _tag) =>
    n = array.size(_G)
    if n > 0
        for i = 0 to n - 1
            yb = array.get(_Y, i)
            if last_bar_index - yb <= winBars
                pr = array.get(_G, i)
                hi = array.get(_Z, i)
                lb = array.get(_W, i)
                array.push(LNS, line.new(yb, pr, yb + 3, pr, color = color.new(hi ? _cHi : _cLo, 50), width = 1, style = line.style_dotted))
                array.push(LBS, label.new(yb, pr, lb, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(hi ? _cHi : _cLo, 50), size = size.tiny, tooltip = "ПОГЛОЩЁННАЯ метка слоя " + _tag + "\n" + lb + "  " + str.tostring(pr, format.mintick) + "\nэта метка проявилась, потом цена ушла дальше и колено переехало на новый экстремум. Сама метка никуда не делась.\n\nПереездов стало заметно меньше: при дозе вставок 1 их 36 против 299 на 5/5 и 232 против 487 на 3/3 за два года. Остальные — случаи, где низа между двумя вершинами не увидел НИКТО, брать нечего."))
    n
f_draw(_P, _B, _H, _L, _M, _cHi, _cLo, _tag, _lab, _tzB, _tpzB, _st, _dn, _swB) =>
    // _swB — бар, с которого этот тренд стал РИСОВАТЬСЯ. Нужен только
    // настройке «Счёт при переключении». При значении по умолчанию
    // ничего не меняет: swFull гасит всю ветку
    bool swFull = trCntSw == "весь, набранный в фоне"
    bool swPale = trCntSw == "фоновую часть бледнее"
    bool conf   = _st == ST_LIVE
    bool pale   = _st == ST_ARC
    bool shows  = _st == ST_MAY or _st == ST_LIVE or _st == ST_ARC
    n = array.size(_P)
    // колено-ноль действующего счёта: первый НИЗ, чей бар не раньше нуля.
    //
    // Сторона здесь обязательна. Ноль всегда низ — LL при рождении, HL при
    // продолжении, — а большая свеча умеет сделать и вершину, и низ сразу:
    // 6 янв 2026, 07:00 на 2/2 колена 4474.265 и 4449.510 сели на один бар.
    // Поиск «по бару» хватал вершину, и весь счёт на экране съезжал на
    // единицу: на графике (5), в таблице (4). За два года часовика такая
    // свеча-накрышка встречается 49 раз на 2565 колен 2/2, 21 на 1827 у
    // 3/3, 5 на 1221 у 5/5
    int zi = -1
    if shows and _tzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tzB and array.get(_H, i) == _dn
                zi := i
                break
    // ноль ПРОШЛОГО счёта: его номера и ноги остаются, но бледными
    int pzi = -1
    if shows and _tpzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tpzB and array.get(_H, i) == _dn
                pzi := i
                break
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(_B, i - 1)
            x2 = array.get(_B, i)
            p1 = array.get(_P, i - 1)
            p2 = array.get(_P, i)
            if last_bar_index - x1 <= winBars
                s1 = array.get(_H, i - 1)
                s2 = array.get(_H, i)
                // нога ДЕЙСТВУЮЩЕГО счёта. ВОСХОДЯЩИЙ.md §6: цвет по НОГЕ,
                // чередованием (0)-(1) зелёная, (1)-(2) красная и дальше.
                // Колена чередуются вершина/низ, поэтому направление ноги и
                // чётность её номера — одно и то же.
                bool inCnt = zi >= 0 and i > zi and i - zi <= 5
                bool inPrv = not inCnt and pzi >= 0 and i > pzi and i - pzi <= 5
                cOwn = _dn ? cTrDn : cTrLeg
                col0 = inCnt ? (pale ? color.new(p2 > p1 ? cTrUp : cOwn, 55) : (p2 > p1 ? cTrUp : cOwn)) : inPrv ? color.new(p2 > p1 ? cTrUp : cOwn, 55) : (p2 > p1 ? _cHi : _cLo)
                // §5: точка (5) может быть LH вместо HH. Счёт от этого не
                // ломается, но нога (4)-(5) с такой вершиной рисуется
                // ШТРИХ-ПУНКТИРОМ — зелёным, цвет не меняется
                bool weak5 = (inCnt and i - zi == 5 or inPrv and i - pzi == 5) and array.get(_L, i) == (_dn ? "HL" : "LH")
                // 22.09.2026, слово владельца: то же правило на ЛЮБУЮ
                // встречную подпись в счёте, «чтобы глаз видел — восходящий,
                // но через манипуляцию». Идеал: вершина HH, низ HL. Ноль не
                // проверяется, у него законны и LL, и HL. Счёт не ломается,
                // цвет остаётся зелёным, меняется только стиль ноги.
                //
                // ШТРИХ-ПУНКТИР у ноги счёта означает ровно ОДНО:
                // МАНИПУЛЯЦИЮ. В версии с тремя слоями им рисовалась ещё и
                // дорисовка чужими коленами, и их различали по точке спереди
                // у метки. Здесь соседа нет, дорисовки нет, и путаницы нет
                int kLeg = inCnt ? i - zi : inPrv ? i - pzi : -1
                bool manip = kLeg >= 1 and (array.get(_H, i) ? array.get(_L, i) != (_dn ? "LH" : "HH") : array.get(_L, i) != (_dn ? "LL" : "HL"))
                // Пока тренд не ПОДТВЕРЖДЁН, нога счёта ТОНКАЯ. Состояние
                // «возможен» на графике видно именно этим.
                //
                // З29, 02.10.2026. Было «плюс один пиксель»: при толщине
                // зиг-зага 1 это 1 против 2, и владелец за всё время ни разу
                // не сказал, что видит момент подтверждения, — его просто не
                // было видно. Стало ПЛЮС ДВА: 1 против 3, разница втрое.
                //
                // Владелец просил штрих-пунктир против сплошной. ЭТОГО СДЕЛАТЬ
                // НЕЛЬЗЯ: у ноги счёта штрих-пунктир уже занят и означает
                // МАНИПУЛЯЦИЮ — строка ниже, `weak5 or manip`. Совпали бы
                // ровно там, где это больнее всего: нога (0)-(1) и не
                // подтверждена, и может нести слабую вершину LH.
                int wCnt = inCnt and conf ? zzW + 2 : zzW
                if showZZ
                    array.push(LNS, line.new(x1, p1, x2, p2, color = color.new(col0, inCnt and not pale ? 0 : 55), width = wCnt, style = weak5 or manip ? line.style_dashed : line.style_solid))
                if _lab
                    lb = array.get(_L, i)
                    hi = array.get(_H, i)
                    mc = array.get(_M, i)
                    // колено действующего счёта: номер спереди, зелёным
                    int k = -1
                    if zi >= 0 and i >= zi
                        kk = i - zi
                        if kk <= 5
                            k := kk
                    // номер ПРОШЛОГО счёта — остаётся, но бледным
                    int pk = -1
                    if k < 0 and pzi >= 0 and i >= pzi
                        kk2 = i - pzi
                        if kk2 <= 5
                            pk := kk2
                    kk3 = k >= 0 ? k : pk
                    bool ideal = kk3 < 0 ? false : hi ? lb == (_dn ? "LH" : "HH") : (kk3 == 0 ? (_dn ? lb == "HH" or lb == "LH" : lb == "LL" or lb == "HL") : lb == (_dn ? "LL" : "HL"))
                    // колено, чей номер набран ДО переключения «авто».
                    // При настройке по умолчанию swOld всегда false
                    bool swOld  = not swFull and _swB >= 0 and array.get(_B, i) < _swB and kk3 >= 0
                    bool swHide = swOld and not swPale
                    txt = kk3 >= 0 and trNum and not swHide ? "(" + str.tostring(kk3) + ") " + lb : lb
                    cCnt = _dn ? cTrDn : cTrUp
                    col1 = swHide ? (hi ? _cHi : _cLo) : k >= 0 ? (pale or swOld ? color.new(cCnt, pale ? 55 : 70) : cCnt) : pk >= 0 ? color.new(cCnt, 55) : (hi ? _cHi : _cLo)
                    tipK = kk3 < 0 ? "" : "\nточка (" + str.tostring(kk3) + ") из 5 · " + (ideal ? "подпись идеальная" : "подпись встречная — МАНИПУЛЯЦИЯ, счёт продолжается, нога к ней нарисована штрих-пунктиром") + (pk >= 0 ? "\nПРОШЛЫЙ счёт. Он дошёл до (5), после чего пришёл " + (_dn ? "LH" : "HL") + " и начался новый счёт с нуля на нём." : "") + (k == 0 and _tpzB >= 0 ? "\nНОВЫЙ счёт: это первый " + (_dn ? "LH" : "HL") + " после (5) прошлого счёта. Тренд не умирал, он ПРОДОЛЖАЕТСЯ — единственное, что умеет сделать тренд долгим." : "") + (pale ? "\n\nАРХИВ: счёт прошёл весь путь до (5), а следующий низ пришёл " + (_dn ? "HH" : "LL") + " — низы перестали расти, продолжения нет. Тренд не умер, он ОТРАБОТАЛ, поэтому красной чёрточки здесь нет." : "")
                    array.push(LBS, label.new(x2, p2, txt, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = col1, size = size.small, tooltip = "слой " + _tag + ", счёт " + (_dn ? "НИСХОДЯЩЕГО" : "ВОСХОДЯЩЕГО") + "   " + lb + "  " + str.tostring(p2, format.mintick) + "\n" + (hi ? "вершина" : "низ") + tipK + (mc >= 2 ? "\nслилось сырых меток: " + str.tostring(mc) : "") + (swOld ? "\n\nЭтот номер набран, пока тренд НЕ рисовался: «авто» переключилось на него позже, на баре " + str.tostring(_swB) + "." : "")))
    n
// ══════════════ УРОВНИ 4H и 1D — ОБЩИЕ ══════════════
ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[hLB], lookahead = barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[hLB],  lookahead = barmerge.lookahead_off)
b41 = ta.valuewhen(not na(ph4), ph4v, 1)
b42 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b41 < b42 ? ph4 : na
lh4 = na(ph4) ? na : b41 > b42 ? ph4 : na
b43 = ta.valuewhen(not na(pl4), pl4v, 1)
b44 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b43 > b44 ? pl4 : na
hl4 = na(pl4) ? na : b43 < b44 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[hLB], lookahead = barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[hLB],  lookahead = barmerge.lookahead_off)
bd1 = ta.valuewhen(not na(phd), phdv, 1)
bd2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : bd1 < bd2 ? phd : na
lhd = na(phd) ? na : bd1 > bd2 ? phd : na
bd3 = ta.valuewhen(not na(pld), pldv, 1)
bd4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : bd3 > bd4 ? pld : na
hld = na(pld) ? na : bd3 < bd4 ? pld : na

var float[]  V4P = array.new_float()
var int[]    V4B = array.new_int()
var bool[]   V4H = array.new_bool()
var string[] V4L = array.new_string()
var float[]  VDP = array.new_float()
var int[]    VDB = array.new_int()
var bool[]   VDH = array.new_bool()
var string[] VDL = array.new_string()

f_lvPushHTF(_p, _b, _h, _l, _v, _prev, _isHi, _lab) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

w01 = f_lvPushHTF(V4P, V4B, V4H, V4L, hh4, nz(hh4[1]), true,  "HH")
w02 = f_lvPushHTF(V4P, V4B, V4H, V4L, lh4, nz(lh4[1]), true,  "LH")
w03 = f_lvPushHTF(V4P, V4B, V4H, V4L, hl4, nz(hl4[1]), false, "HL")
w04 = f_lvPushHTF(V4P, V4B, V4H, V4L, ll4, nz(ll4[1]), false, "LL")
w05 = f_lvPushHTF(VDP, VDB, VDH, VDL, hhd, nz(hhd[1]), true,  "HH")
w06 = f_lvPushHTF(VDP, VDB, VDH, VDL, lhd, nz(lhd[1]), true,  "LH")
w07 = f_lvPushHTF(VDP, VDB, VDH, VDL, hld, nz(hld[1]), false, "HL")
w08 = f_lvPushHTF(VDP, VDB, VDH, VDL, lld, nz(lld[1]), false, "LL")

w09 = f_purgeL(V4P, V4B, V4H, V4L)
w10 = f_purgeL(VDP, VDB, VDH, VDL)

f_lvlHTF(_p, _b, _h, _l, _w) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? cHiH : cLoH, lvTr), width = _w, style = st, extend = extend.right))
    n
// ══════════════ СЛОВО СОСТОЯНИЯ ══════════════
// §48, слово владельца: «да, не вводим "переход", пишем чем кончилось».
// «Идёт переход» не говорит ничего: это слово про время, а не про рынок.
// «Умер» и «не было» — это РАЗНЫЕ рынки, и смотреть на них надо
// по-разному. Одно слово на четыре случая стирало бы ровно ту разницу,
// ради которой весь список концов и выстраивался.
f_stWord(_i, _dn) =>
    s = array.get(tTR, _i)
    bool stale = array.get(tEB, _i) < 0 or last_bar_index - array.get(tEB, _i) > winBars
    s == ST_LIVE ? (_dn ? "НИСХ" : "ВОСХ") : s == ST_MAY ? "возможен" : s == ST_ARC ? (stale ? "нет" : "архив") : s == ST_CAN ? (stale ? "нет" : "не было") : s == ST_DEAD ? (stale ? "нет" : "умер") : "нет"

f_stColor(_i, _dn) =>
    s = array.get(tTR, _i)
    color cDir = _dn ? cTrDn : cTrUp
    s == ST_LIVE ? cDir : s == ST_MAY ? color.new(cDir, 45) : s == ST_ARC ? color.new(cDir, 45) : s == ST_DEAD ? (_dn ? cTrUp : cTrDie) : color.gray

f_stTip(_i, _dn) =>
    s = array.get(tTR, _i)
    base = "У тренда ТРИ КОНЦА, и здесь написано, ЧЕМ КОНЧИЛОСЬ. Слова «переход» нет — это слово про время, а не про рынок.\n\n· возможен — есть ноль " + (_dn ? "HH" : "LL") + " и пришла (1). Любая первая вершина после нуля объявляет рождение, HH или LH всё равно. Опора ещё временная, на нуле, ноги счёта тонкие;\n· " + (_dn ? "НИСХ" : "ВОСХ") + " — пришёл " + (_dn ? "LH" : "HL") + ", тренд ПОДТВЕРЖДЁН, ноги толстые;\n· умер — тело свечи ушло ниже порога. Единственный конец с красной чёрточкой;\n· архив — счёт дошёл до (5), а следующий низ пришёл " + (_dn ? "HH" : "LL") + ": низы перестали расти, продолжения нет. Тренд не умер, он ОТРАБОТАЛ;\n· не было — ОТМЕНА: цена КОСНУЛАСЬ нуля прежде, чем тренд подтвердился. Касания хватает, запаса нет — слово владельца 07.10.2026. Линия нуля нарисована ТОЧКАМИ: это предположение, его стирают легко;\n· нет — всё перечисленное уехало за окно, показывать нечего."
    s == ST_ARC ? "АРХИВ. Счёт прошёл весь путь от (0) до (5), а следующий низ пришёл " + (_dn ? "HH" : "LL") + ".\n\nСчёт остаётся (5)/5 с галочкой намеренно: архив это не «ничего нет», а «было и закончилось хорошо». Смени его прочерком — и на табло станет не отличить тренд, отработавший полностью, от тренда, которого не было.\n\nУровень и запас гаснут: они отвечают на вопрос «что будет дальше с ЭТИМ трендом», а дальше с ним ничего не будет.\n\nАрхив по подписи СТРОЖЕ, чем смерть по цене: низ мог прийти всего на пункт ниже, уровень цел, запас положительный — и всё равно архив. Это сознательный выбор: после (5) манипуляций больше нет, для них не осталось точки счёта.\n\n" + base : base

// подпись у линии уровня: полная, короткая или никакой (З7)
f_lvTxt(_full, _short) =>
    lvLab == "полные" ? _full : lvLab == "короткие" ? _short : ""

// ══════════════ РИСУЕМ ══════════════
if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))

    if hOn and h_tf4
        e1 = f_lvlHTF(V4P, V4B, V4H, V4L, 2)
    if hOn and h_tfd
        e2 = f_lvlHTF(VDP, VDB, VDH, VDL, 3)

    // ── КАКОЙ ИЗ ДВУХ ТРЕНДОВ РИСУЕМ ──
    // Колена у обоих ОДНИ И ТЕ ЖЕ, поэтому счёт на графике может быть
    // только один: одна нога не бывает двух цветов, одно колено не несёт
    // двух номеров. Замер на девяти годах: оба живы 21.8% баров на 2/2 —
    // пятая часть времени, не краевой случай.
    int rU = not trOn ? 0 : array.get(tTR, 0) == ST_LIVE ? 2 : array.get(tTR, 0) == ST_MAY ? 1 : 0
    int rD = not trDn ? 0 : array.get(tTR, 1) == ST_LIVE ? 2 : array.get(tTR, 1) == ST_MAY ? 1 : 0
    // Ответ ТРЁХЗНАЧНЫЙ:
    //     0  веду восходящий
    //     1  веду нисходящий
    //    -1  не веду никого, счёта на графике нет
    // Один флаг на два значения сказать «не рисую никого» не умел —
    // отсюда было З23
    int drawMode = -1
    if trWho == "только восходящий"
        drawMode := rU > 0 ? 0 : -1
    else if trWho == "только нисходящий"
        drawMode := rD > 0 ? 1 : -1
    else
        if rU == 0 and rD == 0
            drawMode := -1
        else if rU > rD
            drawMode := 0
        else if rD > rU
            drawMode := 1
        else
            drawMode := array.get(tZB, 1) > array.get(tZB, 0) ? 1 : 0
    bool dnDraw = drawMode == 1
    // чья СТОРОНА на графике, даже когда никого не ведём: иначе в режиме
    // «только нисходящий» чёрточки брались бы у восходящего
    bool dnSide = trWho == "только нисходящий" ? true : trWho == "только восходящий" ? false : dnDraw
    int drawIdx = dnSide ? 1 : 0
    int stRaw = array.get(tTR, drawIdx)
    // что из счёта показываем на графике
    int drawSt = 0
    if drawMode >= 0
        drawSt := stRaw
    else if stRaw == ST_ARC
        drawSt := ST_ARC
    else if keep5 == "оставлять" and stRaw == ST_DEAD and array.get(tMAX, drawIdx) >= 5
        // З18 и требование владельца 28.09.2026: «когда по любому тренду
        // счёт доходит от 0 до 5, этот тренд, как бы цена себя дальше ни
        // вела, нельзя перерисовывать». Номера остаются бледными
        drawSt := ST_ARC

    // ближайшие непробитые уровни считаем ЗДЕСЬ, до блока уровня тренда:
    // без этого нельзя СКЛЕИТЬ совпавшие по цене линии — вторая половина
    // З7. Пайн не умеет ни тернарник по массивам, ни разбор кортежа в цикле
    [mUp, mDn] = f_nearest(V2P, V2H)
    // ── СКЛЕЙКА СОВПАВШИХ ПО ЦЕНЕ ЛИНИЙ — вторая половина З7 ──
    // Совпадение не случайное: уровень нисходящего — последняя LH, и
    // ближайший непробитый уровень сверху — тоже она, пока цена её не
    // коснулась. Совпали — рисуется ОДНА линия и ОДНА подпись, обе роли
    // через точку.
    float mSg0 = dnSide ? -1.0 : 1.0
    float lvlNow = array.get(tLVL, drawIdx) * mSg0
    bool lvlShown = (drawSt == ST_MAY or drawSt == ST_LIVE) and not na(lvlNow)
    bool glueUp = false
    bool glueDn = false
    if lvlShown
        if not na(mUp)
            glueUp := math.abs(mUp - lvlNow) <= syminfo.mintick
        if not na(mDn)
            glueDn := math.abs(mDn - lvlNow) <= syminfo.mintick
    string glueTxt = (glueUp ? " · слом ↑" : "") + (glueDn ? " · слом ↓" : "")

    int zbM  = array.get(tZB,  drawIdx)
    int pzbM = array.get(tPZB, drawIdx)

    if lvOn
        r2 = f_lvlLayer(V2P, V2B, V2H, V2L, c2H, c2L)
    if absOn and labOn
        gg2 = f_drawAbs(G2, Y2, Z2, W2, c2H, c2L, "2/2")
    d2 = f_draw(P2, B2, H2, L2, M2, c2H, c2L, "2/2", labOn, zbM, pzbM, drawSt, dnSide, swB)

    // ── УРОВЕНЬ и ЧЁРТОЧКИ ──
    if trOn or trDn
        // цена ячейки 1 живёт в перевёрнутом мире — знак назад
        float mSg  = dnSide ? -1.0 : 1.0
        float mLvl = array.get(tLVL, drawIdx) * mSg
        mHL  = array.get(tLHL, drawIdx)
        color cDir = dnSide ? cTrDn : cTrUp
        if (drawSt == ST_MAY or drawSt == ST_LIVE) and not na(mLvl)
            x0 = array.get(tLVB, drawIdx) < 0 ? bar_index - 30 : array.get(tLVB, drawIdx)
            // ТРИ РАЗНЫЕ ЛИНИИ, и это не оформление, а смысл.
            // Решение владельца 09.10.2026: «по линии для LL и зеркало
            // сделай не штрих-пунктир, а точки, а для манипуляции
            // штрих-пунктир». Форма линии и правило совпадают:
            //
            //   ТОЧКИ        уровень на САМОМ НУЛЕ (LL, в зеркале HH).
            //                Рубится КАСАНИЕМ, без запаса → «не было»
            //   ШТРИХ-ПУНКТИР  уровень съехал на МАНИПУЛЯЦИОННЫЙ низ.
            //                Держит: рубится глубиной по телу → «умер»
            //   СПЛОШНАЯ     настоящая опора, уровень на HL. Толстая,
            //                с подписью. Рубится глубиной → «умер»
            //
            // ОБЕ ВРЕМЕННЫЕ — тонкие, КОРОТКИЕ, без подписи. Длина 12
            // баров от своего колена, как у чёрточек смерти и рождения
            int x1 = math.min(x0 + 12, bar_index)
            // форма берётся из ТЕХ ЖЕ величин, по которым движок решает
            // судьбу тренда: tLHL — настоящая ли опора, tONZ — стоит ли
            // она на самом нуле. Третьего источника нет нарочно
            bool mZero = array.get(tONZ, drawIdx)
            array.push(LNS, line.new(x0, mLvl, x1, mLvl, color = cDir, width = mHL ? 2 : 1, style = mHL ? line.style_solid : mZero ? line.style_dotted : line.style_dashed))
            if mHL and lvLab != "нет"
                array.push(LBS, label.new(x1, mLvl, f_lvTxt("держит " + (dnSide ? "LH " : "HL ") + str.tostring(mLvl, format.mintick) + glueTxt, str.tostring(mLvl, format.mintick) + glueTxt), style = label.style_label_right, color = color.new(color.black, 100), textcolor = cDir, size = size.small, tooltip = "Уровень " + (dnSide ? "нисходящего — последняя появившаяся ВЕРШИНА" : "восходящего — последний появившийся НИЗ") + " от нуля, ЛЮБОЙ подписи. Заменяет прежний БЕЗУСЛОВНО, ниже тот или выше: храповика здесь нет намеренно.\n\nМАНИПУЛЯЦИОННОЕ КОЛЕНО ДЕРЖИТ, и уровень на него СЪЕЗЖАЕТ — правило М3: «отличие не в силе, а в линии». Такой уровень рисуется ШТРИХ-ПУНКТИРОМ без подписи, а эта линия сплошная, значит опора настоящая.\n\nИ уровень имеет право ВЕРНУТЬСЯ назад: колена слились, прежнее стало манипуляционным — пересчёт от нуля отводит уровень сам. Замечание З0.\n\nОт уровня считается смерть: тело свечи ниже уровня на " + str.tostring(dnSide ? depthD : depthU) + " скользящего среднего колена слоя."))
        // ── СМЕРТЬ: красная чёрточка ──
        // ТОЛЬКО У СМЕРТИ. У отмены и архива следа на графике нет.
        // Цвет говорит про НАПРАВЛЕНИЕ движения цены, а не про событие:
        // смерть нисходящего и рождение восходящего — одно и то же
        // движение рынка, прочитанное с двух сторон.
        nR = array.size(RDB)
        if nR > 0
            for k = 0 to nR - 1
                lr = array.get(RDL, k)
                if lr == drawIdx and last_bar_index - array.get(RDB, k) <= winBars
                    rb = array.get(RDB, k)
                    rp = array.get(RDP, k)
                    bool rDn = lr == 1
                    color cR = rDn ? cTrUp : cTrDie
                    array.push(LNS, line.new(rb - 12, rp, rb + 12, rp, color = cR, width = 2))
                    array.push(LBS, label.new(rb, rp, rDn ? "умер ↓" : "умер ↑", style = rDn ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = cR, size = size.tiny, tooltip = (rDn ? "НИСХОДЯЩИЙ умер" : "ВОСХОДЯЩИЙ умер") + " на уровне " + str.tostring(rp, format.mintick) + "\n\nПРАВИЛО СМЕРТИ ОДНО: тело свечи ушло ниже\n   уровень − " + str.tostring(rDn ? depthD : depthU) + " × скользящее среднее колено слоя\nОкно 20 ног. Проверяется КАЖДЫЙ бар. Тень тренд НЕ убивает.\n\nСчитается ПО ТЕЛУ: замер Н28 на 11 383 заходах — тело разделяет исходы в 4–6 раз, тень только в 2.3–2.7.\n\nЭто ЕДИНСТВЕННЫЙ конец тренда с чёрточкой. Отмена и архив следа не оставляют.\n\nСлой 2/2."))
        // ── РОЖДЕНИЕ: цена перебитой вершины ──
        // С ГРАФИКА УБРАНА под галочку. Механизм работает всегда: от этой
        // цены считается запасное подтверждение У7
        if trBirth
            nG = array.size(GDB)
            if nG > 0
                for k = 0 to nG - 1
                    lg = array.get(GDL, k)
                    if lg == drawIdx and last_bar_index - array.get(GDB, k) <= winBars
                        gb = array.get(GDB, k)
                        gp = array.get(GDP, k)
                        bool gok = array.get(GOK, k)
                        bool gDn = lg == 1
                        color cGc = gDn ? cTrDn : cTrUp
                        array.push(LNS, line.new(gb - 12, gp, gb + 12, gp, color = cGc, width = gok ? 2 : 1))
                        array.push(LBS, label.new(gb, gp, (gDn ? "слом ↓" : "слом ↑") + (gok ? "" : " ?"), style = gDn ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cGc, size = size.tiny, tooltip = (gDn ? "РОЖДЕНИЕ НИСХОДЯЩЕГО: сломали восходящую структуру на " : "РОЖДЕНИЕ ВОСХОДЯЩЕГО: сломали нисходящую структуру на ") + str.tostring(gp, format.mintick) + ".\n" + (gok ? "Тренд ПОДТВЕРЖДЁН." : "Тренд ещё НЕ подтверждён.") + "\n\nЭто ОТМЕТКА СОБЫТИЯ, а не состояние, и она не гаснет: событие было, а событие не отменяется тем, что тренд потом умер.\n\nОт этой цены считается ЗАПАСНОЕ подтверждение У7."))

    // ── СЛОМЫ: номера текущей серии ──
    if slOn
        if slLine
            if not na(mUp) and not glueUp
                array.push(LNS, line.new(bar_index - 60, mUp, bar_index, mUp, color = cSlUp, width = 2, extend = extend.right))
                if lvLab != "нет"
                    array.push(LBS, label.new(bar_index, mUp, f_lvTxt("слом ↑ " + str.tostring(mUp, format.mintick) + "   " + str.tostring(100 * (mUp - close) / close, "#.##") + "%", str.tostring(mUp, format.mintick)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlUp, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя 2/2 сверху.\nДойдёт сюда цена — будет слом вверх.\n\nЭта цена известна ЗАРАНЕЕ, в отличие от колена: колено становится видно только через два бара после того, как оно случилось.\n\nСлом засчитывается по КАСАНИЮ — хватает тени.\n\nМедиана расстояния за девять лет: 0.40%."))
            if not na(mDn) and not glueDn
                array.push(LNS, line.new(bar_index - 60, mDn, bar_index, mDn, color = cSlDn, width = 2, extend = extend.right))
                if lvLab != "нет"
                    array.push(LBS, label.new(bar_index, mDn, f_lvTxt("слом ↓ " + str.tostring(mDn, format.mintick) + "   " + str.tostring(100 * (close - mDn) / close, "#.##") + "%", str.tostring(mDn, format.mintick)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlDn, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя 2/2 снизу.\nДойдёт сюда цена — будет слом вниз.\n\nМедиана за девять лет: 0.44%."))
        if slNum
            int dirM = array.get(sDIR, 0)
            nS = array.size(SB)
            if nS > 0
                for k = 0 to nS - 1
                    sb = array.get(SB, k)
                    if last_bar_index - sb <= winBars
                        sp = array.get(SP, k)
                        sn = array.get(SN, k)
                        // ── «РАНЬШЕ ШЛО ТУДА ЖЕ» ──
                        // З34: из табло строка убрана по слову владельца
                        // «он предсказывает, а в торговле это плохо».
                        // Число НЕ потеряно: оно здесь, и смотрят его
                        // теперь нарочно. Клетка «5 и больше» для всего,
                        // что длиннее пяти
                        int rk = sn > 5 ? 5 : sn
                        int fi = (dirM > 0 ? 0 : 5) + rk - 1
                        float fq = array.get(SFQ, fi)
                        int   fn = array.get(SFN, fi)
                        float bs = dirM > 0 ? array.get(SFB, 0) : 100 - array.get(SFB, 0)
                        string ftip = "\n\nРАНЬШЕ ШЛО ТУДА ЖЕ: после " + str.tostring(rk) + (sn > 5 ? " и более" : "") + " сломов подряд " + (dirM > 0 ? "вверх" : "вниз") + " следующий уходил туда же в " + str.tostring(fq, "#.#") + "% случаев.\nВыборка: " + str.tostring(fn) + " случаев.\nБазовая доля по слою: " + str.tostring(bs, "#.#") + "%.\nНадбавка: " + (fq - bs >= 0 ? "+" : "") + str.tostring(fq - bs, "#.#") + " процентных пункта.\n\nЗамер Н14, девять лет часовика. Надбавка считается НЕ от 50%: на растущем золоте без этой поправки цифра говорила бы про рост, а не про сломы.\n\nЭто НЕ предсказание. Это частота, снятая с истории, — как шаблон триггерной свечи."
                        array.push(LBS, label.new(sb, sp, (dirM > 0 ? "↑" : "↓") + str.tostring(sn), style = dirM > 0 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = dirM > 0 ? cSlUp : cSlDn, size = size.tiny, tooltip = "Слом " + (dirM > 0 ? "ВВЕРХ" : "ВНИЗ") + " номер " + str.tostring(sn) + " в текущей серии.\nЦена взяла непробитый уровень " + str.tostring(sp, format.mintick) + " слоя 2/2.\n\nПоказывается только ТЕКУЩАЯ серия. Сменится направление — эти метки уйдут и счёт начнётся с единицы." + ftip))

    // ── ГДЕ «АВТО» ПЕРЕДУМАЛО ──
    if swMark and trWho == "авто"
        nA = array.size(AWB)
        if nA > 0
            for k = 0 to nA - 1
                ab = array.get(AWB, k)
                if last_bar_index - ab <= winBars
                    bool aDn = array.get(AWD, k)
                    ap = array.get(AWP, k)
                    color cA = aDn ? cTrDn : cTrUp
                    array.push(LBS, label.new(ab, ap, aDn ? "⇄ НИСХ" : "⇄ ВОСХ", style = label.style_label_center, color = color.new(color.black, 100), textcolor = cA, size = size.tiny, tooltip = "Здесь режим «авто» сменил рисуемый тренд на " + (aDn ? "НИСХОДЯЩИЙ" : "ВОСХОДЯЩИЙ") + ".\n\nСчёт обоих направлений идёт ВСЕГДА, независимо от того, кто нарисован. Поэтому тренд появляется здесь уже с тем счётом, который набрал, пока был невидим.\n\n«Авто» предпочитает ПОДТВЕРЖДЁННЫЙ тренд «возможному»: иначе в устойчивом падении восходящий рождался бы на каждом отскоке и метка стояла бы через бар."))

    // ══════════════ ТАБЛО ══════════════
    // Колонка одна: слой 2/2. В версии с тремя слоями их было три, и
    // верхняя строка «рисует» отвечала на вопрос «на какой слой
    // перейти». Здесь переходить некуда, но строка оставлена: она
    // показывает счёт ВМЕСТЕ с предварительным коленом — хотя у 2/2
    // предварительного колена не бывает, и значит она просто повторяет
    // строку «счёт». Уйдёт, если владелец скажет.
    if trTbl
        table.cell(TBL, 0, 0, "рисует", text_color = color.gray, text_size = tSz, tooltip = "Что индикатор рисует ПРЯМО СЕЙЧАС, с учётом режима из ①.\n\n«нет» значит, что не нарисовался бы никто: либо оба направления мертвы, либо режим запрещает то, что живо.")
        int ix = SWM == 1 ? 1 : 0
        int cc = array.get(tCNT, ix)
        int sx = array.get(tTR, ix)
        string dtxt = SWM < 0 ? "нет" : (SWM == 1 ? "НИСХ" : "ВОСХ") + (sx == ST_ARC ? " (5)/5 ✓" : cc >= 0 ? " (" + str.tostring(cc) + ")/5" : "")
        table.cell(TBL, 1, 0, dtxt, text_color = SWM < 0 ? color.gray : SWM == 1 ? cTrDn : cTrUp, text_size = tSz)

    if trTbl and blkUp
        // строку последовательности считаем ДО ячеек: пайн не умеет
        // тернарник, возвращающий кортеж
        [zlC, tlC, npC] = f_seqNow(P2, B2, H2, L2, 0)
        table.cell(TBL, 0, 1, "восходящий", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 1, 1, "2/2", text_color = cTrUp, text_size = tSz)
        int    sU  = array.get(tTR, 0)
        bool   liv = sU == ST_MAY or sU == ST_LIVE
        float  lv  = array.get(tLVL, 0)
        float  leg = array.get(tLEG, 0)
        float  thr = na(lv) ? na : lv - depthU * leg
        color  cG  = f_stColor(0, false)
        table.cell(TBL, 1, 2, f_stWord(0, false), text_color = cG, text_size = tSz, tooltip = f_stTip(0, false))
        int cntRaw = array.get(tCNT, 0)
        string cntTxt = sU == ST_ARC ? "(5)/5 ✓" : liv ? "(" + str.tostring(cntRaw) + ")/5" : "—"
        table.cell(TBL, 1, 3, cntTxt, text_color = cG, text_size = tSz, tooltip = (sU == ST_ARC ? "АРХИВ. Счёт прошёл весь путь до (5) — галочка про это. Он остаётся на месте намеренно: это РЕЗУЛЬТАТ, а не «ничего нет».\n\n" : "") + "Счёт чередует колена от нуля: нечётная точка вершина, чётная низ. Потолок пять. Встречная подпись счёт НЕ обрывает — она помечает точку как манипуляционную, и нога к ней рисуется штрих-пунктиром.\n\nПРЕДВАРИТЕЛЬНОГО КОЛЕНА (⋯) здесь не бывает: его брали у соседнего слоя, а у 2/2 соседа снизу нет. Поэтому счёт всегда окончательный на момент показа.\n\nПосле (5) решает ПЕРВЫЙ новый низ, и больше ничего: HL — продолжение, счёт пойдёт с нуля; LL — архив. Одно колено решает судьбу тренда.")
        table.cell(TBL, 1, 4, liv or sU == ST_ARC ? str.tostring(array.get(tRST, 0)) : "—", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 1, 5, not liv ? "—" : na(lv) ? "нет" : (array.get(tLHL, 0) ? "HL " : "LL ") + str.tostring(lv, format.mintick), text_color = liv and not na(lv) ? (array.get(tLHL, 0) ? cTrUp : color.new(cTrUp, 45)) : color.gray, text_size = tSz)
        float zap = na(thr) ? na : math.min(open, close) - thr
        bool  neg = not na(zap) and zap < 0
        table.cell(TBL, 1, 6, na(zap) or not liv ? "—" : str.tostring(zap, format.mintick), text_color = not liv ? color.gray : neg ? cTrDie : color.gray, text_size = tSz)
        table.cell(TBL, 1, 7, liv and array.get(tZB, 0) >= 0 ? str.tostring(last_bar_index - array.get(tZB, 0)) : "—", text_color = color.gray, text_size = tSz)
        db = array.get(tDB, 0)
        table.cell(TBL, 1, 8, db < 0 ? "—" : str.tostring(last_bar_index - db) + " / " + str.tostring(array.get(tDP, 0), format.mintick), text_color = db < 0 ? color.gray : cTrDie, text_size = tSz)
        [mc, mi, mn] = f_match(tlC)
        bool rojd = zlC == "LL"
        // индекс считается отдельно и никогда не уходит в минус: при
        // mi = -1 голое выражение дало бы -1 и обращение за границу массива
        int fiU = mi >= 0 ? mi + (rojd ? 0 : 8) : 0
        int fr = mi >= 0 and npC >= 5 ? array.get(PFR, fiU) : -1
        // З28: не подошёл НИ ОДИН эталон — в ячейку клалась ПУСТОТА.
        // Самый сильный признак индикатора показывался пустым местом
        string nmU = mc > 0 ? mn : "вне справ."
        bool showsU = liv or sU == ST_ARC
        string cell = not showsU ? "—" : npC < 5 ? (mc <= 3 ? nmU : str.tostring(mc) + " вар.") : nmU
        string tip = not showsU ? "Тренда нет." : "Слой 2/2, " + (rojd ? "РОЖДЕНИЕ, ноль LL" : "ПРОДОЛЖЕНИЕ, ноль HL") + "\n\nсейчас на графике:  " + zlC + (npC > 0 ? "·" + tlC : "") + "\n" + (mc == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВсе восемь требуют HL на местах (2) и (4) — значит низ оказался LL, была МАНИПУЛЯЦИЯ.\n\nЗамер Н39: это ТОЖДЕСТВО, а не совпадение. Счёт без манипуляции обязан попасть в справочник, счёт с манипуляцией обязан не попасть. Проверено в обе стороны на 8 909 счётах, ноль исключений.\n\nЗначит «вне справ.» читается просто: внутри счёта рынок сходил ниже предыдущего низа. Такой счёт доходит до (5) в 53–60% против 81–91% у чистого (Н35)." : npC < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mc) + " из 8 — " + mn : "это " + mn + ", за 9 лет часовика встретилась " + str.tostring(fr) + " раз") + "\n\nИндикатор ничего не предсказывает. Он узнаёт форму и называет её номером, как шаблон триггерной свечи."
        table.cell(TBL, 1, 9, cell, text_color = showsU ? (mc == 0 ? color.orange : npC >= 5 ? cTrUp : color.gray) : color.gray, text_size = tSz, tooltip = tip)
        table.cell(TBL, 0, 2, "состояние", text_color = color.gray, text_size = tSz, tooltip = "Чем кончилось: умер · архив · не было · нет. Плюс два живых: возможен и ВОСХ.\n\nСлова «переход» здесь нет и не будет — решение владельца 07.10.2026.\n\nСлова «не свой» здесь тоже нет: ОТКАЗ случался, когда слою не хватало чужих колен, а у 2/2 чужих колен не бывает.")
        table.cell(TBL, 0, 3, "счёт", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 4, "полных счётов", text_color = color.gray, text_size = tSz, tooltip = "Сколько раз ЭТОТ тренд дошёл до (5) и продолжился, не умирая.\n\n0 — тренд молодой, ни разу не прошёл весь путь. 3 — трижды отработал и жив до сих пор. Такой тренд не просто жив, он СИЛЁН, а по остальным строкам табло отличить его от молодого нельзя.\n\nОбнуляется вместе с трендом: при смерти, отмене и архиве.")
        table.cell(TBL, 0, 5, "уровень", text_color = color.gray, text_size = tSz, tooltip = "Последний появившийся НИЗ от нуля — ЛЮБОЙ подписи, не только HL. Замена безусловная, храповика нет.\n\nТРИ ВИДА ЛИНИИ, и по ней видно, чем тренд рубится:\n· ТОЧКИ — уровень на САМОМ НУЛЕ, ни одного низа ещё не было. Рубится КАСАНИЕМ, без буфера → «тренда не было»;\n· ШТРИХ-ПУНКТИР — уровень съехал на МАНИПУЛЯЦИОННЫЙ низ. Держит: рубится глубиной по телу → «умер»;\n· СПЛОШНАЯ с подписью — уровень на HL, настоящая опора. Тоже глубиной.\n\nВ ячейке стоит подпись того колена, на котором уровень сейчас: HL у настоящей опоры, LL у временной.")
        table.cell(TBL, 0, 6, "запас " + str.tostring(depthU) + " кол.", text_color = color.gray, text_size = tSz, tooltip = "Сколько осталось телу свечи до порога смерти:\n   запас = min(открытие, закрытие) − (уровень − " + str.tostring(depthU) + " × скользящее колено)\n\nМИНУС ЗНАЧИТ РОВНО ОДНО: эта НЕЗАКРЫТАЯ свеча уже за порогом. Закроется так — тренд умрёт.\n\nПоломки здесь нет. Движок проверяет смерть только на ЗАКРЫТЫХ свечах, а табло пересчитывается каждый тик по текущей. Это ЕДИНСТВЕННАЯ клетка табло, которая смотрит ВПЕРЁД — и смотрит честно: говорит не «что будет», а «что уже есть на незакрытой свече».")
        table.cell(TBL, 0, 7, "баров от (0)", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 8, "прошлая смерть", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров назад умер прошлый тренд и на какой цене.\n\nСлово «слом» здесь не употребляется: оно значит ОДНО — цена взяла непробитый пивот слоя, блок ниже. Смерть тренда это другое событие, и путать их в одном табло нельзя (З35).")
        table.cell(TBL, 0, 9, "посл-ть", text_color = color.gray, text_size = tSz, tooltip = "Номер последовательности из справочника на девяти годах часовика, слой 2/2.\n\nВосходящий всегда начинается с LL — это ноль (0). В СПРАВОЧНИКЕ низы всегда HL, поэтому свободны только вершины, и вариантов ровно восемь.\n\nЗАМЕР Н39: «вне справ.» и «была манипуляция» — ОДНО И ТО ЖЕ СОБЫТИЕ, тождество. Счёт до (5) это три вершины и два низа; без манипуляции оба низа HL, и свободных комбинаций ровно восемь — столько же, сколько эталонов. Круг замкнут.\n\nПока счёт не дошёл до (5), показано, сколько эталонов ещё подходят.\n\nПродолжение отличается нулём: у него он HL, а не LL, и свои частоты.")

    // ── НИСХОДЯЩИЙ: те же девять строк, ячейка 1 ──
    // Цены в ней отрицательные — перевёрнутый мир. Всё, что идёт в
    // табло, переворачивается обратно знаком.
    if trTbl and blkDn
        [zlF, tlF, npF] = f_seqNow(P2n, B2n, H2n, L2n, 1)
        table.cell(TBL, 0, 10, "нисходящий", text_color = color.gray, text_size = tSz, tooltip = "Нисходящий считается ТЕМ ЖЕ движком на перевёрнутых свечах. Второго набора правил не существует — зеркало точное по построению." + (mirDiff > 0 ? "\n\nВНИМАНИЕ: у нисходящего заведено ОТЛИЧИЙ от восходящего: " + str.tostring(mirDiff) + ". Зеркало как тождество больше не держится, и бесплатная проверка прогоном на перевёрнутых данных по этим строкам умерла." : "\n\nзеркало: цело — все правила нисходящего стоят на значениях восходящего."))
        table.cell(TBL, 1, 10, "2/2", text_color = cTrDn, text_size = tSz)
        int    sD   = array.get(tTR, 1)
        bool   livD = sD == ST_MAY or sD == ST_LIVE
        float  lvD  = array.get(tLVL, 1)
        float  legD = array.get(tLEG, 1)
        float  thrD = na(lvD) ? na : lvD - depthD * legD
        color  cD   = f_stColor(1, true)
        table.cell(TBL, 1, 11, f_stWord(1, true), text_color = cD, text_size = tSz, tooltip = f_stTip(1, true))
        int cntRawD = array.get(tCNT, 1)
        table.cell(TBL, 1, 12, sD == ST_ARC ? "(5)/5 ✓" : livD ? "(" + str.tostring(cntRawD) + ")/5" : "—", text_color = cD, text_size = tSz)
        table.cell(TBL, 1, 13, livD or sD == ST_ARC ? str.tostring(array.get(tRST, 1)) : "—", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 1, 14, not livD ? "—" : na(lvD) ? "нет" : (array.get(tLHL, 1) ? "LH " : "HH ") + str.tostring(-lvD, format.mintick), text_color = livD and not na(lvD) ? (array.get(tLHL, 1) ? cTrDn : color.new(cTrDn, 45)) : color.gray, text_size = tSz)
        float zapD = na(thrD) ? na : math.min(-open, -close) - thrD
        bool  negD = not na(zapD) and zapD < 0
        table.cell(TBL, 1, 15, na(zapD) or not livD ? "—" : str.tostring(zapD, format.mintick), text_color = not livD ? color.gray : negD ? cTrDie : color.gray, text_size = tSz)
        table.cell(TBL, 1, 16, livD and array.get(tZB, 1) >= 0 ? str.tostring(last_bar_index - array.get(tZB, 1)) : "—", text_color = color.gray, text_size = tSz)
        dbD = array.get(tDB, 1)
        table.cell(TBL, 1, 17, dbD < 0 ? "—" : str.tostring(last_bar_index - dbD) + " / " + str.tostring(-array.get(tDP, 1), format.mintick), text_color = dbD < 0 ? color.gray : cTrUp, text_size = tSz)
        [mcN, miN, mnN] = f_matchS(tlF)
        bool rojdN = zlF == "LL"
        int fiN = miN >= 0 ? miN + (rojdN ? 0 : 8) : 0
        int frN = miN >= 0 and npF >= 5 ? array.get(SFR, fiN) : -1
        string nmD2 = mcN > 0 ? mnN : "вне справ."
        bool showsN = livD or sD == ST_ARC
        string cellN = not showsN ? "—" : npF < 5 ? (mcN <= 3 ? nmD2 : str.tostring(mcN) + " вар.") : nmD2
        string tipN = not showsN ? "Тренда нет." : "Слой 2/2, " + (rojdN ? "РОЖДЕНИЕ, ноль HH" : "ПРОДОЛЖЕНИЕ, ноль LH") + "\n\nсейчас на графике:  " + f_swap1(zlF) + (npF > 0 ? "·" + f_swapSeq(tlF) : "") + "\n" + (mcN == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВ нисходящем все восемь требуют LH на местах (2) и (4) — значит вершина оказалась HH, была МАНИПУЛЯЦИЯ. Это тождество, замер Н39." : npF < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mcN) + " из 8 — " + mnN : "это " + mnN + ", за 9 лет часовика встретилась " + str.tostring(frN) + " раз") + "\n\nНумерация ЗЕРКАЛЬНАЯ: С1 это зеркало П1."
        table.cell(TBL, 1, 18, cellN, text_color = showsN ? (mcN == 0 ? color.orange : npF >= 5 ? cTrDn : color.gray) : color.gray, text_size = tSz, tooltip = tipN)
        table.cell(TBL, 0, 11, "состояние", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 12, "счёт", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 13, "полных счётов", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 14, "уровень", text_color = color.gray, text_size = tSz, tooltip = "Уровень нисходящего — последняя появившаяся ВЕРШИНА от нуля, ЛЮБОЙ подписи, не только LH.\n\nЗеркало восходящего, строка выше: HH читается как LL, LH как HL. Манипуляционную вершину уровень ДЕРЖИТ и на неё съезжает.\n\nБледная подпись значит ВРЕМЕННУЮ опору: уровень на нуле (линия точками, рубится касанием) или на манипуляционной вершине (линия штрих-пунктиром, рубится глубиной).")
        table.cell(TBL, 0, 15, "запас " + str.tostring(depthD) + " кол.", text_color = color.gray, text_size = tSz, tooltip = "То же, что у восходящего, зеркально. МИНУС значит: закроется так — тренд умрёт.")
        table.cell(TBL, 0, 16, "баров от (0)", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 17, "прошлая смерть", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 18, "посл-ть", text_color = color.gray, text_size = tSz, tooltip = "Номер последовательности из справочника нисходящего, перепись девяти лет часовика, слой 2/2.\n\nНисходящий всегда начинается с HH — это ноль (0). В СПРАВОЧНИКЕ вершины всегда LH, поэтому свободны только низы, и вариантов ровно восемь.\n\nКак и у восходящего: счёт с манипуляционной вершиной HH живёт дальше, но ни одному эталону не соответствует и получает «вне справ.». Это тождество, Н39.")

    // ── СЛОМЫ В ТАБЛО: три строки ──
    if slOn and blkSl
        table.cell(TBL, 0, 19, "сломов подряд", text_color = color.gray, text_size = tSz, tooltip = "Сколько сломов подряд ушло в одну сторону. Слом — цена взяла ближайший непробитый пивот слоя, по касанию.\n\nПотолка у этого счёта нет: за девять лет серии доходили до 16-24 сломов.\n\nЧастота «раньше шло туда же» живёт в подсказке метки слома на графике — наведите на ↑N.")
        table.cell(TBL, 0, 20, "последний слом", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров назад случился последний слом и на какой цене.")
        table.cell(TBL, 0, 21, "ближе слом", text_color = color.gray, text_size = tSz, tooltip = "Какой из двух ближайших непробитых уровней БЛИЖЕ к цене — сверху или снизу, — и сколько до него в процентах.\n\nМедианы за девять лет на 2/2: сверху 0.40%, снизу 0.44%.")
        int dr = array.get(sDIR, 0)
        int rn = array.get(sRUN, 0)
        color cS = dr > 0 ? cSlUp : dr < 0 ? cSlDn : color.gray
        table.cell(TBL, 1, 19, dr == 0 ? "—" : (dr > 0 ? "↑" : "↓") + str.tostring(rn), text_color = cS, text_size = tSz)
        int lbS = array.get(sLB, 0)
        table.cell(TBL, 1, 20, lbS < 0 ? "—" : str.tostring(last_bar_index - lbS) + " / " + str.tostring(array.get(sLP, 0), format.mintick), text_color = color.gray, text_size = tSz)
        float du = na(mUp) ? 1.0e18 : mUp - close
        float dd = na(mDn) ? 1.0e18 : close - mDn
        string nearTxt = "—"
        color  nearCol = color.gray
        if du < dd
            nearTxt := "↑ " + str.tostring(mUp, format.mintick) + "  " + str.tostring(100 * du / close, "#.##") + "%"
            nearCol := cSlUp
        else if dd < 1.0e17
            nearTxt := "↓ " + str.tostring(mDn, format.mintick) + "  " + str.tostring(100 * dd / close, "#.##") + "%"
            nearCol := cSlDn
        table.cell(TBL, 1, 21, nearTxt, text_color = nearCol, text_size = tSz)
