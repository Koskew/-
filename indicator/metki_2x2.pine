hLB    = input.int(3, "Глубина пивота старших ТФ", minval = 1, maxval = 8, group = g10, tooltip = "Уровни 4H и 1D не зависят от нашего движка вообще — это единственное на графике, что считается не им. Цвета — в ⑥.")

// ══════════════ ПРОИЗВОДНЫЕ ОТ НАСТРОЕК ══════════════
// глубина смерти и запасное подтверждение: у нисходящего либо своё, либо
// как у восходящего. ОТЛИЧИЕ — ЭТО ЗНАЧЕНИЕ, А НЕ ВТОРАЯ ВЕТКА КОДА:
// движок один, ему подаются разные числа
float depthU = trDepth
float depthD = dnSame ? trDepth : dnDepth
string brkU  = trBrk
string brkD  = dnSame ? trBrk : dnBrk
// сколько отличий от зеркала завёл владелец — для строки табло
int mirDiff = (dnSame ? 0 : (dnDepth != trDepth ? 1 : 0) + (dnBrk != trBrk ? 1 : 0))

// окно скользящего среднего колена. Зашито: Н30 показал, что при 10, 20
// и 50 результат не меняется — разброс ≤ 0.03 в двенадцати парах из
// двенадцати. Ручку заводить не из чего
LEGWIN = 20
// сколько закрытий подряд для варианта «4 закрытия выше вершины»
NBAR = 4

MAXK = 100
// «нуля счёта нет». Пайн не принимает na в параметр функции, у которого
// тип выводится из вызова, — ни голый, ни через int-переменную. Поэтому
// сторож обычным числом: бар-индекс никогда не бывает отрицательным.
NOZERO = -1

// ── СОСТОЯНИЯ ТРЕНДА. Шесть значений ──
// У тренда ТРИ КОНЦА, и табло пишет, ЧЕМ КОНЧИЛОСЬ.
//
// В эталоне v2.3 состояний семь, а концов четыре: там есть ещё ОТКАЗ
// «не свой» — слою не хватило чужих колен. У слоя 2/2 чужих колен не
// бывает, значит и отказа быть не может. Состояние убрано целиком, а не
// оставлено недостижимым: мёртвый код в движке уже дорого обходился.
ST_NO   = 0     // нет тренда
ST_MAY  = 1     // ВОЗМОЖЕН: есть (0) LL и пришла (1). Не подтверждён
ST_LIVE = 2     // ВОСХ / НИСХ: пришёл HL, тренд подтверждён
ST_ARC  = 3     // АРХИВ: после (5) пришёл низ LL
ST_CAN  = 4     // НЕ БЫЛО: ОТМЕНА, цена коснулась нуля до подтверждения
ST_DEAD = 5     // УМЕР: тело ушло ниже порога

// ══════════════ КОЛЕНА ══════════════
// Колено — пивот; подряд идущие одной стороны схлопываются в экстремум.
var float[]  P2 = array.new_float()
var int[]    B2 = array.new_int()
var bool[]   H2 = array.new_bool()
var string[] L2 = array.new_string()
var int[]    M2 = array.new_int()
var float[]  G2 = array.new_float()
var int[]    Y2 = array.new_int()
var bool[]   Z2 = array.new_bool()
var string[] W2 = array.new_string()

// ── ПЕРЕВЁРНУТЫЕ КОЛЕНА ──
// Те же пивоты, поданные в ту же f_push с МИНУС-ЦЕНОЙ и перевёрнутой
// стороной. Слияние и подписи получаются зеркальными сами: HH здесь
// значит LL там, HL значит LH. Отдельного кода нет и не будет.
var float[]  P2n = array.new_float()
var int[]    B2n = array.new_int()
var bool[]   H2n = array.new_bool()
var string[] L2n = array.new_string()
var int[]    M2n = array.new_int()
var float[]  G2n = array.new_float()
var int[]    Y2n = array.new_int()
var bool[]   Z2n = array.new_bool()
var string[] W2n = array.new_string()
// ПОЧИНКА ЗЕРКАЛА, З36, 07.10.2026.
//
// У вершины сравнение строгое, у низа — НЕСТРОГОЕ. Это не опечатка и не
// вторая ветка кода: `>` не симметрично при перевороте знака, когда
// значения РАВНЫ. Неравенство переворачивается, равенство — нет.
//
//   настоящий мир:   вершина равна прошлой  →  не перебила  →  LH
//   перевёрнутый:    низ равен прошлому     →  удержал      →  HL
//
// А HL и есть зеркало LH. Поставь один оператор на обе стороны — и
// зеркало сломается с той или с другой: `>` везде даёт LH/LL, `>=`
// везде даёт HH/HL. Нужно, чтобы ничья у ВЕРШИНЫ и ничья у НИЗА
// читались зеркально, а зеркало меняет СТОРОНУ — значит и оператор
// обязан зависеть от стороны. Сторона это не направление, поэтому
// запрет «второй ветки кода» от 01.10.2026 не нарушен.
//
// По-человечески: ничья значит «ничего не произошло». Равная вершина
// НЕ ПЕРЕБИЛА, равный низ УДЕРЖАЛ.
//
// Проверено research/zerkalo_check.py: было 2–5 расхождений на
// 7–11 тысяч колен, стало 0 на всех трёх слоях и на всех данных.
f_lab(_hi, _cur, _prev) =>
    na(_prev) ? "?" : _hi ? (_cur > _prev ? "HH" : "LH") : (_cur >= _prev ? "HL" : "LL")

f_relabel(_P, _H, _L) =>
    array.clear(_L)
    n = array.size(_P)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(_H, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(_H, j) == hi
                    prev := array.get(_P, j)
                    break
                j -= 1
            array.push(_L, f_lab(hi, array.get(_P, i), prev))
    n

// Метка, которая проявилась, не должна пропадать. При слиянии двух
// пивотов одной стороны проигравший уходит в список поглощённых и
// остаётся видимым на своём месте. Подпись считается от ПРЕДЫДУЩЕГО
// колена той же стороны, а не от того, в которое метка влилась.
// Метка, которая проявилась, не должна пропадать. При слиянии двух
// пивотов одной стороны проигравший уходит в список поглощённых и
// остаётся видимым на своём месте. Подпись считается от ПРЕДЫДУЩЕГО
// колена той же стороны, а не от того, в которое метка влилась.
f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi) =>
    n = array.size(_P)
    float prev = na
    j = n - 2
    while j >= 0
        if array.get(_H, j) == _hi
            prev := array.get(_P, j)
            break
        j -= 1
    array.push(_G, _price)
    array.push(_Y, _bar)
    array.push(_Z, _hi)
    array.push(_W, f_lab(_hi, _price, prev))
    if array.size(_G) > MAXK
        array.shift(_G)
        array.shift(_Y)
        array.shift(_Z)
        array.shift(_W)
    0
f_push(_P, _B, _H, _L, _M, _G, _Y, _Z, _W, _price, _bar, _hi) =>
    n = array.size(_P)
    bool same = false
    if n > 0
        same := array.get(_H, n - 1) == _hi
    if same
        old = array.get(_P, n - 1)
        oldB = array.get(_B, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(_M, n - 1, array.get(_M, n - 1) + 1)
        if better
            a1 = f_absorb(_G, _Y, _Z, _W, _P, _H, old, oldB, _hi)
            array.set(_P, n - 1, _price)
            array.set(_B, n - 1, _bar)
        else
            a2 = f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi)
    else
        array.push(_P, _price)
        array.push(_B, _bar)
        array.push(_H, _hi)
        array.push(_M, 1)
        if array.size(_P) > MAXK
            array.shift(_P)
            array.shift(_B)
            array.shift(_H)
            array.shift(_M)
    d = f_relabel(_P, _H, _L)
    not same
// ══════════════ СКОЛЬЗЯЩЕЕ СРЕДНЕЕ КОЛЕНО СЛОЯ ══════════════
// Новая величина, §41. Средняя длина последних LEGWIN ног цепочки слоя.
//
// ЗАЧЕМ. Прежний порог смерти считался от ИМПУЛЬСА — последнего
// выросшего колена. Замер Н29: эта величина нигде не измерялась и гуляла
// в ШЕСТЬ раз, от 0.12 до 0.70 колена. Среднее колено ровнее и честнее.
//
// ПОЧЕМУ СКОЛЬЗЯЩЕЕ. Колено выросло в 10–14 раз за девять лет: 5.4
// пункта в начале, 77 в конце. Фиксированное число в пунктах к концу
// истории перестало бы что-либо значить.
//
// ПОЧЕМУ СВОЁ У КАЖДОГО СЛОЯ. Колена у слоёв разного размера по
// построению: 5/5 видит крупную структуру, 2/2 мелкую.
//
// ЗЕРКАЛО ЦЕЛО: берётся МОДУЛЬ разницы, а у перевёрнутых цен он тот же.
f_avgLeg(_P) =>
    n = array.size(_P)
    float s = 0.0
    int c = 0
    if n >= 2
        int from = math.max(1, n - LEGWIN)
        for i = from to n - 1
            s += math.abs(array.get(_P, i) - array.get(_P, i - 1))
            c += 1
    c > 0 ? s / c : 0.0
// ══════════════ ТРЕНД: ОДИН СЛОЙ, ДВА НАПРАВЛЕНИЯ ══════════════
// Ячейка 0 — ВОСХОДЯЩИЙ, ячейка 1 — НИСХОДЯЩИЙ, посчитанный ТЕМ ЖЕ
// движком на ПЕРЕВЁРНУТЫХ коленах. Сама f_trend об этом не знает и не
// должна: она работает по индексу, ей всё равно, какой мир ей подали.
//
// ВНИМАНИЕ: цены в ячейке 1 ОТРИЦАТЕЛЬНЫЕ — это перевёрнутый мир.
// Всё, что идёт на экран и в табло, переворачивается обратно.
//
// Бары держим числом, -1 значит «нет»: пайн капризен с na в массивах.
var int[]    tTR  = array.new_int(2, 0)        // состояние, ST_*
var int[]    tZB  = array.new_int(2, -1)       // бар колена-нуля
var float[]  tZP  = array.new_float(2, na)     // его цена
var string[] tZL  = array.new_string(2, "")    // его подпись
var float[]  tLVL = array.new_float(2, na)     // уровень — последний HL
var int[]    tLVB = array.new_int(2, -1)
var bool[]   tLHL = array.new_bool(2, false)   // уровень на настоящем HL
// СТУПЕНЬ СТРОГОСТИ. true — уровень всё ещё стоит на НУЛЕ, и тогда
// его рубит КАСАНИЕ без всякого запаса: «тренда не было». false —
// уровень съехал на низ счёта, и работает мягкое правило по телу.
// §31, прочтение 1: «граница терпения проходит СРАЗУ ПОСЛЕ НОЛЯ»
var bool[]   tONZ = array.new_bool(2, true)
var int[]    tCNT = array.new_int(2, -1)       // номер последней точки
var int[]    tMAX = array.new_int(2, -1)       // докуда счёт дошёл
var float[]  tLEG = array.new_float(2, 0.0)    // скользящее среднее колено
var int[]    tRST = array.new_int(2, 0)        // полных счётов: сколько раз дошёл до (5) и продолжился
var bool[]   tLL  = array.new_bool(2, false)   // в счёте был низ LL — разбудил запасное подтверждение
var int[]    tEB  = array.new_int(2, -1)       // бар события, которым тренд кончился
// ЧЕТЫРЕ МЁРТВЫХ МАССИВА УБРАНЫ 08.10.2026, слово владельца «сделать
// оба сейчас». Это tBEL (закрытий подряд ниже уровня), tIMP (импульс),
// tPUP и tPMX (заводились под правило «продолжение с (3)»). Все четыре
// СЧИТАЛИСЬ и НЕ ЧИТАЛИСЬ НИГДЕ: правила, под которые они заводились,
// отменены — Н31, Н29 и путь А по З33.
//
// Держались в коде по правилу 4, пока владелец не сказал убрать. На
// графике их не было видно никогда: они ничего не рисовали.
var float[]  tDP  = array.new_float(2, na)     // цена смерти
var int[]    tDB  = array.new_int(2, -1)       // бар смерти
var int[]    tBB  = array.new_int(2, -1)       // бар рождения
// бар нуля ПЕРВОГО счёта. Пишется только рождением, продолжением НЕ
// переписывается — поэтому даёт возраст ВСЕГО тренда. Величина
// ТОЛЬКО ДЛЯ ПОКАЗА: ни одно правило её не читает
var int[]    tZB0 = array.new_int(2, -1)
var int[]    tPZB = array.new_int(2, -1)       // ноль ПРОШЛОГО счёта
// перебитая вершина — от неё считается ЗАПАСНОЕ подтверждение У7
var float[]  tBP  = array.new_float(2, na)
var int[]    tBB2 = array.new_int(2, -1)
var int[]    tBAB = array.new_int(2, 0)        // закрытий подряд выше вершины

// ИСТОРИЯ СОБЫТИЙ, плоскими списками: бар, цена, слой.
// RD* — СМЕРТЬ. Красная чёрточка ставится ТОЛЬКО сюда: у отмены,
// отказа и архива следа на графике нет (§44, слово владельца «да,
// красная чёрточка только у смерти»).
// GD* — РОЖДЕНИЕ. Цена перебитой вершины. С графика убрана под галочку
// «Показывать рождение тренда», механизм работает всегда
var int[]   RDB = array.new_int()
var float[] RDP = array.new_float()
var int[]   RDL = array.new_int()
var int[]   GDB = array.new_int()
var float[] GDP = array.new_float()
var int[]   GDL = array.new_int()
var bool[]  GOK = array.new_bool()
MAXSL = 600

// ── ПЕРЕКЛЮЧЕНИЯ «АВТО» ──
// Счёт обоих направлений идёт ВСЕГДА, им управляют галочки в ⑦.
// Режим из ① выбирает только, кого НАРИСОВАТЬ. Поэтому тренд, на который
// «авто» переключилось, появляется уже со счётом, набранным пока был
// невидим. Здесь запоминается бар, на котором решение поменялось.
//
// В версии с тремя слоями это были массивы по слоям. Слой один —
// обычные переменные.
var int  swB = -1
var bool swD = false
var bool swI = false
// РЕЖИМ, а не флаг: 0 веду восходящий, 1 веду нисходящий, -1 никого.
// -2 значит «ещё не считали ни разу»
var int  SWM = -2
// ── О2. ЧТО НА САМОМ ДЕЛЕ НАРИСОВАНО. Внесено 20.10.2026 по аудиту,
//        слово владельца «да, вносим О2. Оставляем так».
//
// SWM выше — это ответ режима «авто», и строка табло «рисует» брала его.
// Но «авто» не считает архив ни за что, поэтому в режиме «оба» табло
// писало «нет», когда архив на графике нарисован. После правки О1 таких
// случаев стало БОЛЬШЕ: мы как раз научили индикатор показывать архив
// там, где он раньше пропадал.
//
// Здесь лежит ответ на другой вопрос — не «кого выбрал бы авто», а
// «что видно на экране». Считается в ПЕРВОМ блоке if barstate.islast и
// читается во ВТОРОМ: переменные первого блока во второй не переходят,
// это грабля З46, из-за которой блок и поделен надвое.
//
// SWM НЕ ТРОГАЕТСЯ и дальше работает для метки ⇄.
var int  drwIdx  = -1          // -1 никого, 0 восходящий, 1 нисходящий
var int  drwSt   = 0           // ST_NO: что из счёта показано
var bool drwBoth = false       // на графике сразу оба
var int[]   AWB = array.new_int()
var bool[]  AWD = array.new_bool()
var float[] AWP = array.new_float()
// ══════════════ СПРАВОЧНИК ПОСЛЕДОВАТЕЛЬНОСТЕЙ ══════════════
// Перепись 9 лет часовика, слой 2/2. Низы в восходящем всегда HL — иначе это не
// восходящий, — поэтому свободны только вершины и вариантов ровно
// восемь. Ноль пишется первым: LL у рождения, HL у продолжения.
// Индикатор НЕ предсказывает: он узнаёт форму и называет её номером,
// как шаблон триггерной свечи.
var string[] PAT = array.from("LH·HL·HH·HL·HH","LH·HL·HH·HL·LH","HH·HL·HH·HL·HH","HH·HL·HH·HL·LH","HH·HL·LH·HL·HH","LH·HL·LH·HL·HH","HH·HL·LH·HL·LH","LH·HL·LH·HL·LH")
var string[] PNM = array.from("П1","П5","П6","П12","П16","П20","П25","П29")
// [рождения 2/2, продолжения 2/2]. Колонки 5/5 и 3/3 из
// эталона v2.3 убраны вместе со слоями — числа целы, они в эталоне
// ПЕРЕСЧИТАНО 07.10.2026 на движке v2.1 — замечание З27 закрыто
// замером Н35. Прежние числа посчитаны без вставок и по старым
// правилам; половина «продолжения» просела в разы, потому что по
// решению З32 продолжение теперь разрешено только на ПЕРВОМ новом
// колене после (5), а прежде HL можно было ждать сколько угодно
var int[] PFR = array.from(154,93,73,63,56,54,23,22,  21,12,41,40,26,4,4,0)
// Нумерация нисходящего ЗЕРКАЛЬНАЯ: С1 это зеркало П1. Строки PAT
// подходят как есть — в перевёрнутом мире нисходящий это буквально
// восходящий. Переводится обратно только то, что идёт на экран
var string[] SNM = array.from("С1","С5","С6","С12","С16","С20","С25","С29")
// то же, пересчитано на движке v2.1
var int[] SFR = array.from(139,89,60,62,79,53,35,10,  20,12,20,30,18,2,9,3)

// подпись из перевёрнутого мира в настоящий: HH<->LL, HL<->LH
f_swap1(_x) =>
    _x == "HH" ? "LL" : _x == "LL" ? "HH" : _x == "HL" ? "LH" : _x == "LH" ? "HL" : _x

f_swapSeq(_s) =>
    string r = ""
    arr = str.split(_s, "·")
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            r := r + (i == 0 ? "" : "·") + f_swap1(array.get(arr, i))
    r

// Табло: ДВЕ колонки — название и значение. В эталоне их четыре, по
// колонке на слой. Строк 22: в эталоне 23, ушла «вставок в коленах».
// 23 СТРОКИ, А НЕ 22: Т1 от 13.10.2026 добавил ЗАГОЛОВОК блоку сломов.
// Раньше его три строки стояли вплотную под нисходящим и читались как
// его продолжение — отсюда вопрос владельца «есть отличия между
// трендами по строкам». Отличий в подписях нет, это был третий блок
var table TBL = table.new(tblPos == "справа вверху" ? position.top_right : tblPos == "справа внизу" ? position.bottom_right : tblPos == "слева вверху" ? position.top_left : position.bottom_left, 2, 27, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 80))
// Фон строки-заголовка блока. Прозрачность 88 — полоска видна, а текст
// читается так же, как раньше. Правило показа: ЦВЕТ полоски говорит,
// чей это блок
cBlkU = color.new(cTrUp, 88)
cBlkD = color.new(cTrDn, 88)
cBlkS = color.new(color.gray, 88)
tSz = tblSize == "мелкий" ? size.tiny : size.small
// последнее рождение слоя _i в истории, -1 если нет
f_lastG(_i) =>
    int r = -1
    n = array.size(GDL)
    if n > 0
        for k = n - 1 to 0
            if array.get(GDL, k) == _i
                r := k
                break
    r
// ══════════════ УРОВЕНЬ ══════════════
// Уровень считается ОТ НУЛЯ ЗАНОВО на каждом новом колене, а не
// доставляется по шагу. Это и есть правило У1 плюс З0 одной функцией:
//
//   уровень = ПОСЛЕДНИЙ НИЗ в цепочке, начиная с нуля включительно,
//   ЛЮБОЙ ПОДПИСИ. Низов ещё не было — уровень на самом нуле.
//
// ФОРМУЛИРОВКА ИСПРАВЛЕНА 20.10.2026, находка аудита ЖПТ 16. Здесь
// стояло «уровень = последний HL», и это правило ОТМЕНЕНО 07.10.2026
// развилкой А: «пусть съезжает на манипуляционный низ». Код всё это
// время был верен — врал комментарий. HL против LL решает теперь не
// силу, а ВИД ЛИНИИ: сплошная против штрих-пунктира.
//
// Что это даёт даром:
// · У1 — новый HL заменяет прежний безусловно, храповика нет;
// · У2 — при рождении ноль это LL, HL ещё нет, уровень стоит на нуле и
//   помечен временным: тренду надо за что-то держаться с первой минуты,
//   иначе его нечем убить. Бессмертный тренд хуже опоры на LL;
// · У3 и М3 — манипуляционный низ LL уровень ОБНОВЛЯЕТ и держит; от
//   настоящей опоры он отличается только линией (штрих-пунктир против
//   сплошной). Прежняя формулировка «уровень не обновляет: он не HL»
//   описывала правило до 07.10.2026 и снята вместе с ним;
// · З0 и У4 — ВОЗВРАТ. Колено было HL, уровень на него переехал, потом
//   пришёл более низкий низ, колена слились, и колено стало LL. По
//   правилу владельца манипуляционное колено НИЧЕГО НЕ ДЕРЖИТ, значит
//   уровень обязан вернуться на предыдущий HL. При пересчёте от нуля
//   это происходит само, без отдельной ветки;
// · У9 — предварительное колено живого края уровнем не становится: его
//   в цепочке нет, он живёт отдельно;
// · У10 — продолжение после (5) получает НАСТОЯЩИЙ уровень сразу: его
//   ноль и есть HL.
//
// Уровень — ЖИВАЯ линия, указатель «держимся здесь», а не запись
// истории. Поэтому он имеет право и вернуться назад.
// Пишет результат прямо в tLVL / tLVB / tLHL, кортеж не возвращает:
// кортеж из тела функции — лишний риск там, где он не нужен.
f_lvlSet(_i, _P, _B, _H, _L, _zb) =>
    n = array.size(_P)
    int zi = -1
    if n > 0
        for k = 0 to n - 1
            if array.get(_B, k) >= _zb and not array.get(_H, k)
                zi := k
                break
    if zi >= 0
        float lp = array.get(_P, zi)
        int   lx = array.get(_B, zi)
        bool  real = array.get(_L, zi) == "HL"
        bool  moved = false
        // РАЗВИЛКА А, решение владельца 07.10.2026: «пусть съезжает на
        // манипуляционный низ». Уровень переезжает на низ ЛЮБОЙ подписи,
        // а не только на HL. Отличие осталось в ЛИНИИ: `real` решает,
        // рисовать сплошную или штрих-пунктирную, — буквально правило М3
        // «манипуляционное колено ДЕРЖИТ, отличие не в силе, а в линии».
        //
        // Это же сняло отдельную работу: линия манипуляционного сторожа
        // больше не нужна, уровень и ЕСТЬ эта линия.
        for k = zi to n - 1
            if not array.get(_H, k)
                if k > zi
                    lp := array.get(_P, k)
                    lx := array.get(_B, k)
                    real := array.get(_L, k) == "HL"
                    moved := true
        array.set(tLVL, _i, lp)
        array.set(tLVB, _i, lx)
        array.set(tLHL, _i, real)
        // СТУПЕНЬ СТРОГОСТИ, и она привязана не к номеру точки, а к ТОМУ,
        // ЧЕМ НАРИСОВАНА ЛИНИЯ. Строго — только пока уровень стоит на
        // нуле И этот ноль не настоящий HL, то есть пока линия
        // ШТРИХ-ПУНКТИРНАЯ, то есть пока она ПРЕДПОЛОЖЕНИЕ. Это общее
        // правило показа от 05.10: штрих-пунктир можно стереть, сплошная
        // остаётся.
        //
        // ПОЧЕМУ НЕ ПРОСТО «уровень на нуле». Так я и написал сначала, и
        // это была ошибка: у ПРОДОЛЖЕНИЯ ноль — настоящий HL (У10), а
        // низов после него ещё нет, и строгая ступень включалась снова.
        // Тренд, трижды прошедший путь до (5), мог умереть от одного
        // касания своего нуля. «Тренда не было» про такой тренд —
        // бессмыслица: он был, и это видно по номерам на графике.
        array.set(tONZ, _i, (not moved) and (not real))
    zi
// Текущая последовательность слоя _i: подпись нуля и хвост от (1).
// Показывается у живого тренда и у АРХИВА: форма счёта состоялась, её
// номер — итог (§47)
f_seqNow(_P, _B, _H, _L, _i) =>
    string zlab = ""
    string tail = ""
    int np = 0
    s = array.get(tTR, _i)
    if (s == ST_MAY or s == ST_LIVE or s == ST_ARC) and array.get(tZB, _i) >= 0
        n = array.size(_P)
        int zi = -1
        if n > 0
            for k = 0 to n - 1
                // ноль ищется не только по бару, но и ПО СТОРОНЕ. Он всегда
                // НИЗ: LL при рождении, HL при продолжении. Большая свеча
                // умеет сделать и вершину, и низ сразу — тогда два колена
                // сидят на одном баре, и поиск «по бару» хватал вершину
                if array.get(_B, k) >= array.get(tZB, _i) and not array.get(_H, k)
                    zi := k
                    break
        if zi >= 0
            zlab := array.get(_L, zi)
            int last = math.min(zi + 5, n - 1)
            if last >= zi + 1
                for k = zi + 1 to last
                    tail := tail + (np == 0 ? "" : "·") + array.get(_L, k)
                    np += 1
    [zlab, tail, np]

// Сколько эталонов ещё подходят под этот хвост и как они называются
f_match(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(PNM, p)
    [cnt, idx, nms]

// То же, но имена из справочника НИСХОДЯЩЕГО. Строки PAT одни и те же
f_matchS(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(SNM, p)
    [cnt, idx, nms]
// ══════════════ ОДИН ШАГ ДВИЖКА ══════════════
// _o, _h, _l, _c — открытие, верх, низ и закрытие ЭТОГО мира. Нисходящий
// зовёт функцию с минус-ценами, и верх с низом у него МЕНЯЮТСЯ МЕСТАМИ:
// «верх свечи» в перевёрнутом мире это минус настоящий минимум. Иначе он
// на перевёрнутых коленах брал бы настоящую свечу и сравнивал её с
// перевёрнутым уровнем.
//
// Низ свечи нужен с 07.10.2026: отмена считается по КАСАНИЮ.
// _leg  — скользящее среднее колено ЭТОЙ цепочки.
// _ref  — слою понадобилась лишняя чужая метка (§33).
// _depth, _brk — глубина смерти и запасное подтверждение. У нисходящего
//   это ЗНАЧЕНИЯ, а не вторая ветка кода: движок один.
//
// ПОРЯДОК ВНУТРИ БАРА ВАЖЕН И ЗАДАН НАРОЧНО:
//   отказ → смерть и отмена → запасное подтверждение → колена.
// Смерть проверяется ДО колен, поэтому ничья «смерть или архив на одном
// баре» разрешается в пользу смерти — §36, правило детерминированное.
f_trend(_i, _P, _B, _H, _L, _nwN, _fr, _o, _h, _l, _c, _leg, _depth, _brk) =>
    n = array.size(_P)
    // в ИСТОРИЮ событий цена кладётся НАСТОЯЩЕЙ: ячейка 1 живёт в
    // перевёрнутом мире, и без этого чёрточки уехали бы под график
    float sg = _i >= 1 ? -1.0 : 1.0
    int st = array.get(tTR, _i)

    // ── 1. СМЕРТЬ и ОТМЕНА. Каждый бар, а не только на колене ──
    //
    // СТУПЕНЕЙ РОВНО ДВЕ, и граница между ними проходит СРАЗУ ПОСЛЕ
    // НОЛЯ. Слово владельца, §31, прочтение 1, подтверждённое им же
    // 06.10.2026: «если ЦЕНА перебивает сторожа ноля даже касанием —
    // тренда не было... если счёт дошёл до 2 HL, тут допускается
    // манипуляция, но вступает в силу правило глубины».
    //
    //    уровень стоит на НУЛЕ   →  КАСАНИЕ рубит, без всякого запаса
    //    уровень съехал на низ   →  тело ниже уровня на долю колена
    //
    // Ступень выбирается по tONZ — по тому, ГДЕ СТОИТ УРОВЕНЬ, а не по
    // подтверждению и не по номеру точки. Так сказано у владельца:
    // «граница терпения проходит сразу после ноля», не после (3) и не
    // после HL.
    //
    // ИСПРАВЛЕНИЕ 07.10.2026. В v2.0 здесь стояло ЗАКРЫТИЕ, взятое из
    // ответа §15 В-а, и ступень выбиралась по состоянию «возможен».
    // Владелец поймал подмену: «мы же вроде договорились, что счёт 0,
    // если цена его касается до отображения 2 — отказ от тренда. Куда
    // это пропало?» Его правило лежало в §31 всё это время.
    if (st == ST_MAY or st == ST_LIVE) and not na(array.get(tLVL, _i))
        lv = array.get(tLVL, _i)
        if array.get(tONZ, _i)
            // СТРОГАЯ СТУПЕНЬ: касание сторожа ноля. Это НЕ смерть —
            // «тренда не было», поэтому красной чёрточки здесь нет
            if _l <= lv
                array.set(tTR,  _i, ST_CAN)
                array.set(tEB,  _i, bar_index)
                array.set(tCNT, _i, -1)
                array.set(tLVL, _i, na)
                array.set(tRST, _i, 0)
                array.set(tLL,  _i, false)
                st := ST_CAN
        else
            // МЯГКАЯ СТУПЕНЬ: манипуляция прощается, убивает глубина.
            // ПО ТЕЛУ, min(открытие, закрытие). Тень тренд НЕ убивает:
            // замер Н28, тело разделяет исходы в 4–6 раз, тень в 2.3–2.7
            bLo = math.min(_o, _c)
            if bLo < lv - _depth * _leg
                array.set(tDP,  _i, lv)
                array.set(tDB,  _i, bar_index)
                array.set(tTR,  _i, ST_DEAD)
                array.set(tEB,  _i, bar_index)
                array.set(tCNT, _i, -1)
                array.set(tLVL, _i, na)
                array.set(tBAB, _i, 0)
                array.set(tRST, _i, 0)
                array.set(tLL,  _i, false)
                st := ST_DEAD
                // КРАСНАЯ ЧЁРТОЧКА — только здесь. Метку рождения НЕ
                // гасим: она отмечает событие, которое БЫЛО, а событие
                // не отменяется тем, что тренд потом умер (С8)
                array.push(RDB, bar_index)
                array.push(RDP, lv * sg)
                array.push(RDL, _i)
                if array.size(RDB) > MAXSL
                    array.shift(RDB)
                    array.shift(RDP)
                    array.shift(RDL)

    // ── 2. ЗАПАСНОЕ ПОДТВЕРЖДЕНИЕ, У7. Тоже каждый бар ──
    // СПИТ, пока в счёте не появился низ с подписью LL. До этого
    // подтверждает только HL, основным правилом.
    if st == ST_MAY and array.get(tLL, _i) and not na(array.get(tBP, _i))
        bp = array.get(tBP, _i)
        array.set(tBAB, _i, _c > bp ? array.get(tBAB, _i) + 1 : 0)
        bool bA = math.max(_o, _c) > bp + _depth * _leg
        bool bB = array.get(tBAB, _i) >= NBAR
        if (_brk == "выше вершины на 0.20 колена" and bA) or (_brk == "4 закрытия выше вершины" and bB)
            array.set(tTR, _i, ST_LIVE)
            st := ST_LIVE
            gi = f_lastG(_i)
            if gi >= 0
                array.set(GOK, gi, true)

    // ── 3. НОВОЕ КОЛЕНО: счёт, уровень, рождение, архив, продолжение ──
    if _fr and n >= 2
        // ── КОЛЕНА РАЗБИРАЮТСЯ ПО ОЧЕРЕДИ, З41, 12.10.2026 ──
        //
        // Слово владельца: «да, вносим».
        //
        // ЧТО БЫЛО СЛОМАНО. Одна большая свеча умеет сделать и вершину,
        // и низ сразу — назовём её СВЕЧА-НАКРЫШКА. Тогда в цепочку
        // встают ДВА колена за один бар, а счётчик спрашивал один раз за
        // бар: «было новое колено?» — и поднимался на единицу. Цепочка
        // росла на два, счёт на один, и с этого бара табло отставало от
        // графика ровно на номер. Хуже того, ломалось чередование:
        // точка (5), которая по §3 ОБЯЗАНА быть низом у восходящего и
        // вершиной у нисходящего, садилась не на свою сторону, и правило
        // §7 «решает ПЕРВАЯ новая вершина» переставало работать
        // буквально — решало ВТОРОЕ колено, через одно.
        //
        // Разобрано на месте владельца, XAUUSD 1H, нисходящий, слой 2/2,
        // 3 октября 2017 (скрин 3). Накрышка — 02.10 14:00: вершина
        // 1277.346 и низ 1271.974 на одном баре. Продолжение случилось
        // на вершине 1272.546 вместо первой новой вершины 1273.068.
        // Замечание З41.
        //
        // ЭТО УЖЕ БЫЛО НАЙДЕНО И ВЫЛЕЧЕНО ТОЛЬКО С ОДНОЙ СТОРОНЫ.
        // Комментарий у поиска нуля для рисования (строки около 1240)
        // описывает ровно эту свечу: там номер на графике уже считается
        // правильно, потому что поиск нуля идёт по бару И ПО СТОРОНЕ.
        // Счётчик остался как был. Теперь обе стороны считают одно.
        //
        // ЧТО СТАЛО. `_nwN` — не флаг, а ЧИСЛО новых колен этого бара:
        // 0, 1 или 2. Колена разбираются ПО ОЧЕРЕДИ, в том порядке, в
        // каком легли в цепочку, каждое со своей стороной и подписью.
        // Порядок внутри накрышки НЕ ВЫДУМЫВАЕТСЯ: что было раньше
        // внутри свечи, по OHLC неизвестно, и счёт просто идёт за
        // цепочкой.
        //
        // ПРИ _nwN = 0 И 1 ВСЁ РОВНО КАК БЫЛО: один проход по последнему
        // колену, `knw` равен прежнему `_nw`. Трогается только накрышка
        int kFirst = _nwN >= 1 ? n - _nwN : n - 1
        for k = kFirst to n - 1
            bool knw = _nwN >= 1 and k >= n - _nwN
            // ИНДЕКС ПРЕДЫДУЩЕГО КОЛЕНА ДЕРЖИМ ВАЛИДНЫМ ВСЕГДА: пайн
            // считает обе половины `and` и обе ветки тернарника, поэтому
            // сторож `k >= 1` от выхода за массив НЕ СПАСАЕТ. Та же
            // причина, что у safeL и bokIdx
            int jb = k >= 1 ? k - 1 : k
            lb  = array.get(_L, k)
            hiK = array.get(_H, k)
            prK = array.get(_P, k)
            bbK = array.get(_B, k)
            ppK = array.get(_P, jb)
            if st == ST_MAY or st == ST_LIVE
                int cnt = array.get(tCNT, _i)
                if knw and cnt >= 5 and not hiK
                    // ── ПОСЛЕ (5): решает ПЕРВЫЙ новый низ, и только он ──
                    // Точка (5) всегда ВЕРШИНА — это следует из чередования.
                    // Значит следующее колено всегда НИЗ, и он бывает ровно
                    // двух видов. Третьего не дано, поэтому строгое и мягкое
                    // прочтения З32 оказались одним правилом.
                    if lb == "HL"
                        // ПРОДОЛЖЕНИЕ. Единственное, что умеет сделать тренд
                        // долгим: остальные три исхода его заканчивают
                        array.set(tPZB, _i, array.get(tZB, _i))
                        array.set(tZB,  _i, bbK)
                        array.set(tZP,  _i, prK)
                        array.set(tZL,  _i, lb)
                        array.set(tCNT, _i, 0)
                        array.set(tMAX, _i, 0)
                        array.set(tRST, _i, array.get(tRST, _i) + 1)
                        array.set(tLL,  _i, false)
                        // У10: уровень СРАЗУ настоящий, ноль и есть HL, —
                        // поэтому продолжение не проходит через «возможен».
                        // И строгой ступени здесь НЕТ: касанием такой тренд
                        // не рубится, его ноль не предположение, а
                        // подтверждённый HL
                        array.set(tLVL, _i, prK)
                        array.set(tLVB, _i, bbK)
                        array.set(tLHL, _i, true)
                        array.set(tONZ, _i, false)
                        array.set(tTR,  _i, ST_LIVE)
                        st := ST_LIVE
                    else
                        // АРХИВ. Низы перестали расти, продолжения нет.
                        // Тренд не умер — он ОТРАБОТАЛ, поэтому красной
                        // чёрточки здесь НЕТ, а номера счёта остаются
                        array.set(tTR,  _i, ST_ARC)
                        array.set(tEB,  _i, bar_index)
                        array.set(tLVL, _i, na)
                        st := ST_ARC
                else
                    if knw and cnt < 5
                        array.set(tCNT, _i, cnt + 1)
                        array.set(tMAX, _i, math.max(array.get(tMAX, _i), array.get(tCNT, _i)))
                    // ПОДТВЕРЖДЕНИЕ, подраздел 2, одно правило: пришёл HL —
                    // тренд подтверждён. СВОЙ или ВСТАВЛЕННЫЙ — разницы нет,
                    // движок их не различает и не должен. Важна только
                    // подпись: HL, и ничто другое
                    if knw and not hiK
                        if lb == "HL"
                            if st == ST_MAY
                                array.set(tTR, _i, ST_LIVE)
                                st := ST_LIVE
                                gj = f_lastG(_i)
                                if gj >= 0
                                    array.set(GOK, gj, true)
                        else
                            // низ пришёл манипуляционным — просыпается
                            // запасное подтверждение У7
                            array.set(tLL, _i, true)
                // УРОВЕНЬ пересчитывается ОТ НУЛЯ на каждом колене. Отсюда
                // даром берутся У1, У2, У3, У9, У10 и возврат по З0.
                //
                // Вызов стоит ПОСЛЕ всей развилки нарочно: продолжение ставит
                // новый ноль HL, и по правилу У10 уровень обязан стать
                // НАСТОЯЩИМ сразу, в тот же бар. Стой вызов только в ветке
                // счёта — продолжение жило бы на уровне прошлого счёта до
                // следующего колена. У АРХИВА этого пересчёта быть не должно:
                // там уровень погашен, держать больше нечего, — поэтому
                // сторож по состоянию, а не безусловно
                // ── УРОВЕНЬ НЕ ТРОГАЕТСЯ НА БАРЕ РОЖДЕНИЯ, З42, 13.10.2026 ──
                //
                // Слово владельца: «да, вносим».
                //
                // ЧТО БЫЛО СЛОМАНО. На свече-накрышке колена приходят оба
                // сразу: вершина объявляет рождение, и тут же низ того же бара
                // забирает уровень себе. Строгая ступень не жила ни одного
                // бара, и ноль — который по §1 ещё ПРЕДПОЛОЖЕНИЕ и нарисован
                // точками — переставал стеречься в тот же миг, когда встал.
                //
                // Два правила спорили за один миг, и до v3.3 встретиться не
                // могли:
                //   §1 «уровень встаёт на сам ноль, ступень СТРОГАЯ»
                //   §5 «уровень = последний появившийся низ от нуля,
                //       замена безусловная»
                //
                // Разобрано на месте владельца, XAUUSD 1H, восходящий 2/2,
                // 2-3 октября 2017. Ноль 1271.204, накрышка 02.10 14:00 UTC
                // дала вершину 1277.346 и низ 1271.974. Уровень ушёл с нуля
                // на баре рождения, а через три бара минимум был 1271.200 —
                // на 0.004 НИЖЕ нуля. Останься уровень на нуле, тренд был бы
                // отменён, и того восходящего на экране не было бы.
                // Замечание З42.
                //
                // ЧТО СТАЛО. На баре рождения уровень НЕ пересчитывается
                // вовсе: он остаётся на нуле, ступень остаётся строгой.
                // Колена того же бара считаются как обычно — номера идут,
                // подтверждение работает, — но уровня не трогают. Со
                // следующего колена всё как было.
                //
                // ПРОДОЛЖЕНИЯ ЭТО НЕ КАСАЕТСЯ: tBB пишется только рождением,
                // а у продолжения ноль — настоящий HL, и по У10 уровень
                // обязан стать настоящим сразу
                bool justBorn = array.get(tBB, _i) == bar_index
                if (array.get(tTR, _i) == ST_MAY or array.get(tTR, _i) == ST_LIVE) and not justBorn
                    zq = f_lvlSet(_i, _P, _B, _H, _L, array.get(tZB, _i))
            else if st == ST_NO or st == ST_DEAD or st == ST_CAN or st == ST_ARC
                // ── РОЖДЕНИЕ ОБЪЯВЛЯЕТ (1), §14 ──
                // Любая первая вершина после LL — HH или LH всё равно.
                // Счёт начинается с (1), состояние «возможен». Приход HL на
                // (2) — это уже ПОДТВЕРЖДЕНИЕ, не рождение.
                //
                // Поиск нуля назад (back = 3, до пяти колен, перешагивая HL)
                // был ОБХОДНЫМ ПУТЁМ: его завели 21.09.2026 ровно потому,
                // что рождение объявляла только HH, а ноль к тому времени
                // оказывался далеко позади. Теперь обходить нечего — ноль
                // стоит ВПЛОТНУЮ перед (1) всегда. Проверено на двух
                // цепочках: там, где тренд состоялся, итог ОДИНАКОВЫЙ, а
                // владелец видит счёт по дороге, а не узнаёт задним числом.
                //
                // Колена чередуются, поэтому предыдущее — всегда низ.
                // Сторона всё равно проверяется: сторож дешевле отладки
                if knw and hiK and k >= 1 and not array.get(_H, jb) and array.get(_L, jb) == "LL"
                    int j = jb
                    // ── СТОРОЖ НУЛЯ СМОТРИТ И НАЗАД, З40, 12.10.2026 ──
                    //
                    // Слово владельца: «есть правило: как появился счёт 0, от
                    // него идут точки, и если цена их касается — отказ от
                    // тренда». Правило не новое, это §31. Новое только то,
                    // что оно наконец работает ОТ САМОГО НУЛЯ, а не от бара
                    // рождения.
                    //
                    // ЧТО БЫЛО СЛОМАНО. Два правила шли не в ногу: рождение
                    // читает ЦЕПОЧКУ колен, а колено известно через два бара
                    // (на 5/5 через пять), отмена же читает ЖИВОЙ бар без
                    // задержки. За эти бары лага цена успевала уйти под ноль,
                    // и движок рождал тренд с нулём, который рынок уже снял.
                    // В табло стояло «возможен», хотя по правилу тренда не
                    // было вовсе.
                    //
                    // Разобрано на месте владельца, XAUUSD 1H, 2-3 октября
                    // 2017: ноль 1269.770 в 20:00, цена 1268.418 в 01:00 —
                    // на 1.35 ниже, — а рождение случилось в 02:00 и прожило
                    // ровно один бар. Замечание З40, разбор СИТ8.
                    //
                    // Проверяем КАЖДУЮ свечу от бара ПОСЛЕ нуля до текущей
                    // включительно. Сам бар нуля не проверяется: его минимум
                    // и ЕСТЬ цена нуля, касание было бы всегда.
                    //
                    // В перевёрнутом мире «низ свечи» — это минус настоящий
                    // максимум, поэтому сторона берётся по индексу ячейки.
                    bool zBroke = false
                    int zbar = array.get(_B, j)
                    int zoff = bar_index - zbar
                    if zoff >= 1
                        // потолок 500 — чтобы цикл не упёрся в max_bars_back.
                        // Разрыв между нулём и рождением — единицы баров,
                        // так что потолок срабатывать не должен никогда
                        int zlim = math.min(zoff - 1, 500)
                        for q = 0 to zlim
                            float zlw = _i >= 1 ? -high[q] : low[q]
                            if zlw <= array.get(_P, j)
                                zBroke := true
                                break
                    if not zBroke
                        array.set(tTR,  _i, ST_MAY)
                        array.set(tBB,  _i, bar_index)
                        array.set(tZB,  _i, array.get(_B, j))
                        // возраст ВСЕГО тренда: ноль первого счёта. Единственное
                        // место, где tZB0 пишется. Продолжение двигает tZB, а
                        // это — нет, отсюда и разница двух чисел в табло
                        array.set(tZB0, _i, array.get(_B, j))
                        array.set(tZP,  _i, array.get(_P, j))
                        array.set(tZL,  _i, array.get(_L, j))
                        array.set(tCNT, _i, 1)
                        array.set(tMAX, _i, 1)
                        array.set(tPZB, _i, -1)
                        array.set(tRST, _i, 0)
                        array.set(tLL,  _i, false)
                        // У2: ноль становится ВРЕМЕННОЙ опорой. Тренду надо за
                        // что-то держаться с первой минуты, иначе его нечем
                        // убить, а бессмертный тренд хуже опоры на LL. Помечен
                        // честно: tLHL = false, на графике штрих-пунктир без
                        // подписи
                        array.set(tLVL, _i, array.get(_P, j))
                        array.set(tLVB, _i, array.get(_B, j))
                        array.set(tLHL, _i, false)
                        // СТРОГАЯ СТУПЕНЬ включена: пока ни один низ счёта не
                        // пришёл, ноль рубится КАСАНИЕМ без запаса
                        array.set(tONZ, _i, true)
                        st := ST_MAY
                        // ПЕРЕБИТАЯ ВЕРШИНА — та, которую цена взяла по дороге к
                        // нулю. От неё считается запасное подтверждение У7.
                        // На графике это чёрточка рождения, спрятанная под
                        // галочку: механизм работает всегда, видимость — нет
                        int v = j - 1
                        while v >= 0
                            if array.get(_H, v)
                                break
                            v -= 1
                        if v >= 0
                            array.set(tBP,  _i, array.get(_P, v))
                            array.set(tBB2, _i, bar_index)
                            array.set(tBAB, _i, 0)
                            array.push(GDB, bar_index)
                            array.push(GDP, array.get(_P, v) * sg)
                            array.push(GDL, _i)
                            array.push(GOK, false)
                            if array.size(GDB) > MAXSL
                                array.shift(GDB)
                                array.shift(GDP)
                                array.shift(GDL)
                                array.shift(GOK)
                        else
                            array.set(tBP,  _i, na)
                            array.set(tBB2, _i, -1)
                            array.set(tBAB, _i, 0)
    0

ph2 = ta.pivothigh(high, 2, 2)
pl2 = ta.pivotlow (low,  2, 2)

if barstate.isconfirmed
    // nw2 — СКОЛЬКО новых колен родилось на этом баре: 0, 1 или 2. Счёт
    // двигается по коленам, а не по сырым пивотам: слияние пивота в уже
    // стоящее колено счёт не двигает.
    //
    // БЫЛО ФЛАГОМ «да/нет» — и это З41. Одна большая свеча умеет сделать
    // и вершину, и низ сразу, тогда колен становится два, а флаг отвечал
    // один раз, и счёт поднимался на единицу вместо двух. Вопрос
    // «сколько» задаётся теперь явно
    int nw2 = 0
    if not na(ph2)
        q5 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, high[2], bar_index - 2, true)
        nw2 := nw2 + (q5 ? 1 : 0)
    if not na(pl2)
        q6 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, low[2],  bar_index - 2, false)
        nw2 := nw2 + (q6 ? 1 : 0)

    // ── ПЕРЕВЁРНУТЫЕ КОЛЕНА: та же f_push, минус-цена, сторона наоборот ──
    // ПОРЯДОК ВНУТРИ НАКРЫШКИ В ПЕРЕВЁРНУТОМ МИРЕ ЗЕРКАЛЬНЫЙ САМ СОБОЙ:
    // настоящий максимум кладётся первым и в перевёрнутом мире он НИЗ,
    // настоящий минимум вторым и он ВЕРШИНА. Зеркало меняет знак и
    // сторону, а события во времени НЕ переставляет — на этом проект уже
    // обжигался 23.09.2026
    int mw2 = 0
    if not na(ph2)
        r5 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -high[2], bar_index - 2, false)
        mw2 := mw2 + (r5 ? 1 : 0)
    if not na(pl2)
        r6 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -low[2],  bar_index - 2, true)
        mw2 := mw2 + (r6 ? 1 : 0)

    bool fr2 = not na(ph2) or not na(pl2)

    // ── СКОЛЬЗЯЩЕЕ СРЕДНЕЕ КОЛЕНО: своё у каждой цепочки ──
    float leg2  = f_avgLeg(P2)
    float leg2n = f_avgLeg(P2n)
    array.set(tLEG, 0, leg2)
    array.set(tLEG, 1, leg2n)

    // ── шаг тренда: один слой, два направления ──
    // ВСТАВОК И ОТКАЗА ЗДЕСЬ НЕТ: у 2/2 соседа снизу нет, занимать не у
    // кого, и не хватать ему тоже нечего
    if trOn
        e2 = f_trend(0, P2,  B2,  H2,  L2,  nw2, fr2, open, high, low, close, leg2, depthU, brkU)
    // тот же движок, перевёрнутый мир. Второго набора правил нет.
    // ВЕРХ И НИЗ МЕНЯЮТСЯ МЕСТАМИ: «верх свечи» в перевёрнутом мире это
    // минус настоящий минимум. Зеркало меняет знак и сторону
    if trDn
        n2 = f_trend(1, P2n, B2n, H2n, L2n, mw2, fr2, -open, -low, -high, -close, leg2n, depthD, brkD)

    // ── кого «авто» рисует ПРЯМО СЕЙЧАС ──
    // Правило то же самое, что в блоке отрисовки ниже, слово в слово.
    // Здесь оно считается каждый бар только ради одного: запомнить бар,
    // на котором решение поменялось
    //
    // РАНГ: подтверждённый тренд сильнее «возможного». Это развязка
    // РИСКА 2 из §14 и ответ В-г из §15: «возможный восходящий не
    // показывается, пока жив подтверждённый нисходящий». Иначе в
    // устойчивом падении восходящий рождался бы на каждом отскоке и
    // «авто» металось бы
    int rU0 = not trOn ? 0 : array.get(tTR, 0) == ST_LIVE ? 2 : array.get(tTR, 0) == ST_MAY ? 1 : 0
    int rD0 = not trDn ? 0 : array.get(tTR, 1) == ST_LIVE ? 2 : array.get(tTR, 1) == ST_MAY ? 1 : 0
    int mD = -1
    if trWho == "только восходящий"
        mD := rU0 > 0 ? 0 : -1
    else if trWho == "только нисходящий"
        mD := rD0 > 0 ? 1 : -1
    else
        if rU0 == 0 and rD0 == 0
            mD := -1
        else if rU0 > rD0
            mD := 0
        else if rD0 > rU0
            mD := 1
        else
            // ранги равны — тот, чей НОЛЬ СВЕЖЕЕ: свежая структура это
            // то, что рынок строит сейчас, старая уже контекст
            mD := array.get(tZB, 1) > array.get(tZB, 0) ? 1 : 0
    bool dD = mD == 1
    if not swI or mD != SWM
        swB := bar_index
        SWM := mD
        swD := dD
        // метка ⇄ ставится, только когда переключились НА тренд.
        // Уход в «никого» метки не получает: там и рисовать нечего
        if swI and mD >= 0
            array.push(AWB, bar_index)
            array.push(AWD, dD)
            array.push(AWP, close)
            if array.size(AWB) > MAXSL
                array.shift(AWB)
                array.shift(AWD)
                array.shift(AWP)
        swI := true
// ══════════════ ЖИВЫЕ УРОВНИ СЛОЯ ══════════════
// Уровень — СЫРОЙ пивот, лежит в списке, при касании ценой
// ВЫЧЁРКИВАЕТСЯ. Пивоты не переезжают, поэтому пробитый уровень мёртв
// навсегда. Если брать уровень из КОЛЕНА, он при слиянии переезжает на
// новый экстремум, и пробитая линия оживает — так было в первых версиях.
var float[]  V2P = array.new_float()
var int[]    V2B = array.new_int()
var bool[]   V2H = array.new_bool()
var string[] V2L = array.new_string()

f_lvPush(_p, _b, _h, _l, _v, _off, _isHi, _lab) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - _off)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

// уровень существует, пока не пробит. Коснулась цена — удаляем совсем
f_purgeL(_p, _b, _h, _l) =>
    i = 0
    while i < array.size(_p)
        pr = array.get(_p, i)
        bool dead = array.get(_h, i) ? high >= pr : low <= pr
        if dead
            array.remove(_p, i)
            array.remove(_b, i)
            array.remove(_h, i)
            array.remove(_l, i)
        else
            i += 1
    0

// жив ли уровень с такой ценой — для линий у сырых меток
f_alive(_p, _v) =>
    bool r = false
    n = array.size(_p)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(_p, i) - _v) <= syminfo.mintick
                r := true
                break
    r
// ══════════════ СЧЁТ ПО СЛОМАМ ══════════════
// Слом = цена взяла ближайший НЕПРОБИТЫЙ пивот слоя. Своего механизма
// это не требует: живые уровни выше уже так и устроены, момент
// вычёркивания и есть слом.
//
// Почему это сильнее колена: колено известно ЗАДНИМ ЧИСЛОМ, на 2/2
// через два бара, на 5/5 через пять. Слом известен ЗАРАНЕЕ — цена, до
// которой надо дойти, уже стоит на графике.
//
// Замер Н14, девять лет часовика: сломы НЕ независимы, они слипаются.
var int[]   sDIR = array.new_int(1, 0)
var int[]   sRUN = array.new_int(1, 0)
var int[]   sLB  = array.new_int(1, -1)
var float[] sLP  = array.new_float(1, na)
var int[]   SB = array.new_int()
var float[] SP = array.new_float()
var int[]   SL = array.new_int()
var int[]   SN = array.new_int()

// Н14: доля случаев, когда следующий слом пошёл в ТУ ЖЕ сторону.
//
// 19.10.2026 ЭТИ ТРИ МАССИВА БОЛЬШЕ НИГДЕ НЕ ЧИТАЮТСЯ. Блок «раньше шло
// туда же» убран из подсказки метки слома: числа сняты Н14 без контроля
// расстояния и завышены примерно вдвое — Н17, замечание З12.
//
// Массивы ОСТАВЛЕНЫ НАРОЧНО, по правилу 4: данные не теряем. Пересчитаем
// с контролем расстояния — блок вернётся одной правкой.
// Порядок: сторона вверх, вниз × длина серии 1..5,
// где пятая клетка значит «пять и больше». Девять лет часовика.
var float[] SFQ = array.from(61.4, 62.3, 59.1, 64.4, 65.5,   56.8, 59.2, 63.1, 61.6, 62.1)
var int[]   SFN = array.from(1893, 1163, 724, 427, 798,   1892, 1074, 636, 401, 651)
var float[] SFB = array.from(51.8)

f_slomOne(_i, _dir, _price) =>
    if array.get(sDIR, _i) != _dir
        int k = 0
        while k < array.size(SL)
            if array.get(SL, k) == _i
                array.remove(SB, k)
                array.remove(SP, k)
                array.remove(SL, k)
                array.remove(SN, k)
            else
                k += 1
        array.set(sDIR, _i, _dir)
        array.set(sRUN, _i, 1)
    else
        if slNoCap or array.get(sRUN, _i) < 5
            array.set(sRUN, _i, array.get(sRUN, _i) + 1)
    array.set(sLB, _i, bar_index)
    array.set(sLP, _i, _price)
    array.push(SB, bar_index)
    array.push(SP, _price)
    array.push(SL, _i)
    array.push(SN, array.get(sRUN, _i))
    if array.size(SB) > MAXSL
        array.shift(SB)
        array.shift(SP)
        array.shift(SL)
        array.shift(SN)
    0

// Ищет сломы этого бара по живым уровням слоя. Берётся БЛИЖАЙШИЙ
// пробитый с каждой стороны. Вызывается ДО того, как в список попадут
// уровни текущего бара, — ровно так считалось в замере Н14
f_slom(_i, _p, _h) =>
    if slOn
        n = array.size(_p)
        float bu = na
        float bd = na
        if n > 0
            for k = 0 to n - 1
                pr = array.get(_p, k)
                if array.get(_h, k)
                    if high >= pr
                        bu := na(bu) ? pr : math.min(bu, pr)
                else
                    if low <= pr
                        bd := na(bd) ? pr : math.max(bd, pr)
        if not na(bu)
            z1 = f_slomOne(_i, 1, bu)
        if not na(bd)
            z2 = f_slomOne(_i, -1, bd)
    0

// ближайший НЕПРОБИТЫЙ уровень слоя сверху и снизу от цены — это и есть
// две цены, на которых случится следующий слом
f_nearest(_p, _h) =>
    float up = na
    float dn = na
    n = array.size(_p)
    if n > 0
        for k = 0 to n - 1
            pr = array.get(_p, k)
            if array.get(_h, k)
                if pr > close
                    up := na(up) ? pr : math.min(up, pr)
            else
                if pr < close
                    dn := na(dn) ? pr : math.max(dn, pr)
    [up, dn]
// подпись СЫРОГО пивота: сравнение с предыдущим пивотом той же стороны.
//
// ЗДЕСЬ НАРОЧНО НИЧЕГО НЕ ТРОНУТО. Починка зеркала З36 касалась подписи
// КОЛЕНА — строки 305 прежнего файла, то есть f_relabel. Сырые подписи
// ниже на точной ничьей не дают НИ ОДНОЙ метки: оба условия ложны, и
// пивот в список живых уровней не попадает. Так было всегда.
//
// Привести их к тому же правилу я могу, но это ДОБАВИТ линий уровня там,
// где их не было, а правка такого размера владельцем не согласована.
// Вопрос вынесен ему вместе с остальными.

a21 = ta.valuewhen(not na(ph2), high[2], 1)
a22 = ta.valuewhen(not na(ph2), high[2], 0)
hh2 = na(ph2) ? na : a21 < a22 ? ph2 : na
lh2 = na(ph2) ? na : a21 > a22 ? ph2 : na
a23 = ta.valuewhen(not na(pl2), low[2], 1)
a24 = ta.valuewhen(not na(pl2), low[2], 0)
ll2 = na(pl2) ? na : a23 > a24 ? pl2 : na
hl2 = na(pl2) ? na : a23 < a24 ? pl2 : na

// сломы ищутся ПО ПРОШЛЫМ уровням, до того как добавятся сегодняшние
s03 = f_slom(0, V2P, V2H)

u09 = f_lvPush(V2P, V2B, V2H, V2L, hh2, 2, true,  "HH")
u10 = f_lvPush(V2P, V2B, V2H, V2L, lh2, 2, true,  "LH")
u11 = f_lvPush(V2P, V2B, V2H, V2L, hl2, 2, false, "HL")
u12 = f_lvPush(V2P, V2B, V2H, V2L, ll2, 2, false, "LL")

v03 = f_purgeL(V2P, V2B, V2H, V2L)

// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()
f_lvlLayer(_p, _b, _h, _l, _cHi, _cLo) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? _cHi : _cLo, lvTr), width = 1, style = st, extend = extend.right))
    n
// Поглощённые метки: бледная подпись на своём месте плюс короткая точка
// на своём уровне. Линии уровня у них нет — только метка.
f_drawAbs(_G, _Y, _Z, _W, _cHi, _cLo, _tag) =>
    n = array.size(_G)
    if n > 0
        for i = 0 to n - 1
            yb = array.get(_Y, i)
            if last_bar_index - yb <= winBars
                pr = array.get(_G, i)
                hi = array.get(_Z, i)
                lb = array.get(_W, i)
                array.push(LNS, line.new(yb, pr, yb + 3, pr, color = color.new(hi ? _cHi : _cLo, 50), width = 1, style = line.style_dotted))
                array.push(LBS, label.new(yb, pr, lb, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(hi ? _cHi : _cLo, 50), size = size.tiny, tooltip = "ПОГЛОЩЁННАЯ метка слоя " + _tag + "\n" + lb + "  " + str.tostring(pr, format.mintick) + "\nэта метка проявилась, потом цена ушла дальше и колено переехало на новый экстремум. Сама метка никуда не делась."))
    n
// _tzB2 / _tpzB2 / _st2 — ВТОРОЙ тренд, направление противоположное _dn.
// При _st2 = ST_NO функция ведёт себя РОВНО как до 14.10.2026: один счёт,
// подпись «(2) HL» без стрелки, цвет номера прежний. Второй набор
// включается только режимом ① «оба, пока у обоих есть счёт» — решение В
// от 14.10.2026, слово владельца «В, толщина как предложил, по умолчанию
// оставь авто»
f_draw(_P, _B, _H, _L, _M, _cHi, _cLo, _tag, _lab, _tzB, _tpzB, _st, _dn, _swB, _tzB2, _tpzB2, _st2) =>
    // _swB — бар, с которого этот тренд стал РИСОВАТЬСЯ. Нужен только
    // настройке «Счёт при переключении». При значении по умолчанию
    // ничего не меняет: swFull гасит всю ветку
    bool swFull = trCntSw == "весь, набранный в фоне"
    bool swPale = trCntSw == "фоновую часть бледнее"
    bool conf   = _st == ST_LIVE
    bool pale   = _st == ST_ARC
    bool shows  = _st == ST_MAY or _st == ST_LIVE or _st == ST_ARC
    // ── ВТОРОЙ ТРЕНД ──
    bool two    = _st2 == ST_MAY or _st2 == ST_LIVE or _st2 == ST_ARC
    bool conf2  = _st2 == ST_LIVE
    bool pale2  = _st2 == ST_ARC
    n = array.size(_P)
    // колено-ноль действующего счёта: первый НИЗ, чей бар не раньше нуля.
    //
    // Сторона здесь обязательна. Ноль всегда низ — LL при рождении, HL при
    // продолжении, — а большая свеча умеет сделать и вершину, и низ сразу:
    // 6 янв 2026, 07:00 на 2/2 колена 4474.265 и 4449.510 сели на один бар.
    // Поиск «по бару» хватал вершину, и весь счёт на экране съезжал на
    // единицу: на графике (5), в таблице (4). За два года часовика такая
    // свеча-накрышка встречается 49 раз на 2565 колен 2/2, 21 на 1827 у
    // 3/3, 5 на 1221 у 5/5
    int zi = -1
    if shows and _tzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tzB and array.get(_H, i) == _dn
                zi := i
                break
    // ноль ПРОШЛОГО счёта: его номера и ноги остаются, но бледными
    int pzi = -1
    if shows and _tpzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tpzB and array.get(_H, i) == _dn
                pzi := i
                break
    // ── НОЛИ ВТОРОГО ТРЕНДА. Сторона противоположная: у восходящего ноль
    // это низ, у нисходящего вершина, и ищутся они в ОДНОЙ цепочке ──
    int zi2 = -1
    if two and _tzB2 >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tzB2 and array.get(_H, i) == (not _dn)
                zi2 := i
                break
    int pzi2 = -1
    if two and _tpzB2 >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tpzB2 and array.get(_H, i) == (not _dn)
                pzi2 := i
                break
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(_B, i - 1)
            x2 = array.get(_B, i)
            p1 = array.get(_P, i - 1)
            p2 = array.get(_P, i)
            if last_bar_index - x1 <= winBars
                s1 = array.get(_H, i - 1)
                s2 = array.get(_H, i)
                // нога ДЕЙСТВУЮЩЕГО счёта. ВОСХОДЯЩИЙ.md §6: цвет по НОГЕ,
                // чередованием (0)-(1) зелёная, (1)-(2) красная и дальше.
                // Колена чередуются вершина/низ, поэтому направление ноги и
                // чётность её номера — одно и то же.
                bool inCnt = zi >= 0 and i > zi and i - zi <= 5
                bool inPrv = not inCnt and pzi >= 0 and i > pzi and i - pzi <= 5
                // ── ТА ЖЕ НОГА ГЛАЗАМИ ВТОРОГО СЧЁТА ──
                bool inCnt2 = two and zi2 >= 0 and i > zi2 and i - zi2 <= 5
                bool inPrv2 = two and not inCnt2 and pzi2 >= 0 and i > pzi2 and i - pzi2 <= 5
                // нога участвует хотя бы в одном счёте
                bool inAny  = inCnt or inCnt2
                bool prvAny = inPrv or inPrv2
                // ТОЛЩИНА: толще, если ХОТЯ БЫ ОДИН из двух подтверждён.
                // Слово владельца 14.10.2026. Толщина продолжает значить
                // «здесь есть подтверждённый счёт», как и раньше
                bool confAny = (inCnt and conf) or (inCnt2 and conf2)
                // БЛЕДНАЯ нога только если ВСЕ счета, в которых она
                // участвует, архивные. Живой счёт держит ногу яркой
                bool paleAll = inAny and not ((inCnt and not pale) or (inCnt2 and not pale2))
                cOwn = _dn ? cTrDn : cTrLeg
                col0 = inAny ? (paleAll ? color.new(p2 > p1 ? cTrUp : cOwn, 55) : (p2 > p1 ? cTrUp : cOwn)) : prvAny ? color.new(p2 > p1 ? cTrUp : cOwn, 55) : (p2 > p1 ? _cHi : _cLo)
                // §5: точка (5) может быть LH вместо HH. Счёт от этого не
                // ломается, но нога (4)-(5) с такой вершиной рисуется
                // ШТРИХ-ПУНКТИРОМ — зелёным, цвет не меняется
                bool weak5 = (inCnt and i - zi == 5 or inPrv and i - pzi == 5) and array.get(_L, i) == (_dn ? "HL" : "LH")
                // то же для второго счёта: у него подпись (5) зеркальная
                bool weak5b = two and (inCnt2 and i - zi2 == 5 or inPrv2 and i - pzi2 == 5) and array.get(_L, i) == (_dn ? "LH" : "HL")
                // 22.09.2026, слово владельца: то же правило на ЛЮБУЮ
                // встречную подпись в счёте, «чтобы глаз видел — восходящий,
                // но через манипуляцию». Идеал: вершина HH, низ HL. Ноль не
                // проверяется, у него законны и LL, и HL. Счёт не ломается,
                // цвет остаётся зелёным, меняется только стиль ноги.
                //
                // ШТРИХ-ПУНКТИР у ноги счёта означает ровно ОДНО:
                // МАНИПУЛЯЦИЮ. В версии с тремя слоями им рисовалась ещё и
                // дорисовка чужими коленами, и их различали по точке спереди
                // у метки. Здесь соседа нет, дорисовки нет, и путаницы нет
                int kLeg = inCnt ? i - zi : inPrv ? i - pzi : -1
                bool manip = kLeg >= 1 and (array.get(_H, i) ? array.get(_L, i) != (_dn ? "LH" : "HH") : array.get(_L, i) != (_dn ? "LL" : "HL"))
                // МАНИПУЛЯЦИЯ ГЛАЗАМИ ВТОРОГО СЧЁТА. Штрих-пунктир у ноги
                // значит «тут есть сомнение». Если хоть один из двух счётов
                // считает колено манипуляционным — сомнение есть.
                // Подписи зеркальные: идеал второго — вершина (_dn ? HH : LH)
                // и низ (_dn ? HL : LL)
                int kLeg2 = inCnt2 ? i - zi2 : inPrv2 ? i - pzi2 : -1
                bool manip2 = two and kLeg2 >= 1 and (array.get(_H, i) ? array.get(_L, i) != (_dn ? "HH" : "LH") : array.get(_L, i) != (_dn ? "HL" : "LL"))
                // Пока тренд не ПОДТВЕРЖДЁН, нога счёта ТОНКАЯ. Состояние
                // «возможен» на графике видно именно этим.
                //
                // З29, 02.10.2026. Было «плюс один пиксель»: при толщине
                // зиг-зага 1 это 1 против 2, и владелец за всё время ни разу
                // не сказал, что видит момент подтверждения, — его просто не
                // было видно. Стало ПЛЮС ДВА: 1 против 3, разница втрое.
                //
                // Владелец просил штрих-пунктир против сплошной. ЭТОГО СДЕЛАТЬ
                // НЕЛЬЗЯ: у ноги счёта штрих-пунктир уже занят и означает
                // МАНИПУЛЯЦИЮ — строка ниже, `weak5 or manip`. Совпали бы
                // ровно там, где это больнее всего: нога (0)-(1) и не
                // подтверждена, и может нести слабую вершину LH.
                int wCnt = confAny ? zzW + 2 : zzW
                if showZZ
                    array.push(LNS, line.new(x1, p1, x2, p2, color = color.new(col0, inAny and not paleAll ? 0 : 55), width = wCnt, style = weak5 or manip or weak5b or manip2 ? line.style_dashed : line.style_solid))
                if _lab
                    lb = array.get(_L, i)
                    hi = array.get(_H, i)
                    // колено действующего счёта: номер спереди, зелёным
                    int k = -1
                    if zi >= 0 and i >= zi
                        kk = i - zi
                        if kk <= 5
                            k := kk
                    // номер ПРОШЛОГО счёта — остаётся, но бледным
                    int pk = -1
                    if k < 0 and pzi >= 0 and i >= pzi
                        kk2 = i - pzi
                        if kk2 <= 5
                            pk := kk2
                    kk3 = k >= 0 ? k : pk
                    // ── НОМЕР ВТОРОГО СЧЁТА НА ТОМ ЖЕ КОЛЕНЕ ──
                    int k2 = -1
                    if two and zi2 >= 0 and i >= zi2
                        kb = i - zi2
                        if kb <= 5
                            k2 := kb
                    int pk2 = -1
                    if two and k2 < 0 and pzi2 >= 0 and i >= pzi2
                        kb2 = i - pzi2
                        if kb2 <= 5
                            pk2 := kb2
                    kk32 = k2 >= 0 ? k2 : pk2
                    // ── О3. «ЭТОТ НОМЕР ОТРАБОТАЛ» — по одному флагу на счёт.
                    //        Внесено 20.10.2026 по аудиту, слово владельца
                    //        «да, вносим О3. Галочку нужно».
                    //
                    // Номер бледнеет в двух случаях, и они разные:
                    //   · счёт ДЕЙСТВУЮЩИЙ, но тренд ушёл в архив — `pale`;
                    //   · номер ПРОШЛОГО счёта — `pk >= 0`, он бледен всегда.
                    // Оба означают для глаза одно: «это уже отработало».
                    bool dimA = k >= 0 ? pale : pk >= 0
                    bool dimB = k2 >= 0 ? pale2 : pk2 >= 0
                    bool ideal = kk3 < 0 ? false : hi ? (_dn and kk3 == 0 ? (lb == "HH" or lb == "LH") : lb == (_dn ? "LH" : "HH")) : (not _dn and kk3 == 0 ? (lb == "LL" or lb == "HL") : lb == (_dn ? "LL" : "HL"))
                    // колено, чей номер набран ДО переключения «авто».
                    // При настройке по умолчанию swOld всегда false
                    bool swOld  = not swFull and _swB >= 0 and array.get(_B, i) < _swB and kk3 >= 0
                    bool swHide = swOld and not swPale
                    // ── ПОДПИСЬ. Решение владельца 14.10.2026: «понравилась
                    // идея с таким отображением (2)↑ (1)↓ HL» ──
                    //
                    // СТРЕЛКА СТАВИТСЯ ТОЛЬКО В РЕЖИМЕ «ОБА». Когда счёт на
                    // колене один, спутать не с чем, и подпись остаётся
                    // прежней, буква в букву: «(2) HL». Так ничего не
                    // меняется у того, кто режим не включал
                    string pre = ""
                    // О3. ГАЛОЧКА У ОТРАБОТАВШЕГО НОМЕРА. Ставится ТОЛЬКО в
                    // режиме «оба», там же, где стрелка, и по той же причине:
                    // цвет у ярлыка ОДИН на весь текст, и когда номера два,
                    // бледностью сказать «вот этот отработал» физически
                    // нельзя. Знак взят из табло, где архив пишется «(5)/5 ✓»,
                    // — чтобы владелец читал привычное, а не новое.
                    //
                    // Когда номер ОДИН, галочки нет: там всё говорит цвет, и
                    // картинка у того, кто режим не включал, не меняется.
                    if kk3 >= 0 and trNum and not swHide
                        pre := "(" + str.tostring(kk3) + ")" + (two ? (_dn ? "↓" : "↑") + (dimA ? "✓" : "") : "") + " "
                    if two and kk32 >= 0 and trNum
                        pre := pre + "(" + str.tostring(kk32) + ")" + (_dn ? "↑" : "↓") + (dimB ? "✓" : "") + " "
                    txt = pre + lb
                    cCnt = _dn ? cTrDn : cTrUp
                    // ЦВЕТ ПОДПИСИ. У ярлыка цвет ОДИН на весь текст, двух
                    // цветов в одной подписи пайн не умеет. Поэтому:
                    // номер один — цвет его тренда, как раньше;
                    // номера ДВА — цвет нейтральный, цветом метки слоя, а
                    // чей номер — говорят стрелки
                    cCnt2 = _dn ? cTrUp : cTrDn
                    col1 = swHide ? (hi ? _cHi : _cLo) : k >= 0 ? (pale or swOld ? color.new(cCnt, pale ? 55 : 70) : cCnt) : pk >= 0 ? color.new(cCnt, 55) : (hi ? _cHi : _cLo)
                    if two
                        bool hasA = kk3 >= 0 and not swHide
                        bool hasB = kk32 >= 0
                        if hasA and hasB
                            // О3. Здесь стояло просто `col1 := hi ? _cHi : _cLo`,
                            // и бледность архива терялась целиком: отработавший
                            // счёт выглядел как живой, вопреки правилу С6
                            // «номера бледнеют, а не стираются».
                            //
                            // Теперь нейтральный цвет БЛЕДНЕЕТ, когда отработали
                            // ОБА. Это ровно то же условие, по которому уже
                            // бледнеет НОГА под этой подписью (`paleAll` выше):
                            // нога и подпись наконец говорят одно и то же.
                            //
                            // Смешанный случай — один отработал, другой жив —
                            // цветом не выражается, и его берёт на себя галочка.
                            col1 := color.new(hi ? _cHi : _cLo, dimA and dimB ? 55 : 0)
                        else if hasB
                            col1 := k2 >= 0 ? (pale2 ? color.new(cCnt2, 55) : cCnt2) : color.new(cCnt2, 55)
                    tip2 = not two or kk32 < 0 ? "" : "\n\nВТОРОЙ СЧЁТ, " + (_dn ? "ВОСХОДЯЩИЙ" : "НИСХОДЯЩИЙ") + ": это его точка (" + str.tostring(kk32) + ") из 5" + (pk2 >= 0 ? ", прошлый счёт" : "") + ".\n\nРежим ① «оба, пока у обоих есть счёт»: одно и то же колено читают ДВА прочтения, и для каждого оно значит своё. Стрелка ↑ у номера восходящего, ↓ у нисходящего."
                    tipK = kk3 < 0 ? "" : "\nточка (" + str.tostring(kk3) + ") из 5 · " + (ideal ? "подпись идеальная" : (_dn ? hi : not hi) ? "подпись встречная — МАНИПУЛЯЦИЯ, счёт продолжается, нога к ней нарисована штрих-пунктиром" : "подпись встречная, и это НЕ манипуляция: так зовётся только встречн" + (_dn ? "ая ВЕРШИНА" : "ый НИЗ") + ". Счёт продолжается, нога штрих-пунктиром — " + (_dn ? "минимум" : "максимум") + " не обновлён, но на тренд это не влияет") + (pk >= 0 ? "\nПРОШЛЫЙ счёт. Он дошёл до (5), после чего пришёл " + (_dn ? "LH" : "HL") + " и начался новый счёт с нуля на нём." : "") + (k == 0 and _tpzB >= 0 ? "\nНОВЫЙ счёт: это первый " + (_dn ? "LH" : "HL") + " после (5) прошлого счёта. Тренд не умирал, он ПРОДОЛЖАЕТСЯ — единственное, что умеет сделать тренд долгим." : "") + (pale ? "\n\nАРХИВ: счёт прошёл весь путь до (5), а следующ" + (_dn ? "ая вершина пришла HH — вершины перестали падать" : "ий низ пришёл LL — низы перестали расти") + ", продолжения нет. Тренд не умер, он ОТРАБОТАЛ, поэтому красной чёрточки здесь нет." : "")
                    array.push(LBS, label.new(x2, p2, txt, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = col1, size = size.small, tooltip = "слой " + _tag + ", счёт " + (_dn ? "НИСХОДЯЩЕГО" : "ВОСХОДЯЩЕГО") + "   " + lb + "  " + str.tostring(p2, format.mintick) + "\n" + (hi ? "вершина" : "низ") + tipK + tip2))
    n
// ══════════════ УРОВНИ 4H и 1D — ОБЩИЕ ══════════════
ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[hLB], lookahead = barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[hLB],  lookahead = barmerge.lookahead_off)
b41 = ta.valuewhen(not na(ph4), ph4v, 1)
b42 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b41 < b42 ? ph4 : na
lh4 = na(ph4) ? na : b41 > b42 ? ph4 : na
b43 = ta.valuewhen(not na(pl4), pl4v, 1)
b44 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b43 > b44 ? pl4 : na
hl4 = na(pl4) ? na : b43 < b44 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[hLB], lookahead = barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[hLB],  lookahead = barmerge.lookahead_off)
bd1 = ta.valuewhen(not na(phd), phdv, 1)
bd2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : bd1 < bd2 ? phd : na
lhd = na(phd) ? na : bd1 > bd2 ? phd : na
bd3 = ta.valuewhen(not na(pld), pldv, 1)
bd4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : bd3 > bd4 ? pld : na
hld = na(pld) ? na : bd3 < bd4 ? pld : na

var float[]  V4P = array.new_float()
var int[]    V4B = array.new_int()
var bool[]   V4H = array.new_bool()
var string[] V4L = array.new_string()
var float[]  VDP = array.new_float()
var int[]    VDB = array.new_int()
var bool[]   VDH = array.new_bool()
var string[] VDL = array.new_string()

f_lvPushHTF(_p, _b, _h, _l, _v, _prev, _isHi, _lab) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

w01 = f_lvPushHTF(V4P, V4B, V4H, V4L, hh4, nz(hh4[1]), true,  "HH")
w02 = f_lvPushHTF(V4P, V4B, V4H, V4L, lh4, nz(lh4[1]), true,  "LH")
w03 = f_lvPushHTF(V4P, V4B, V4H, V4L, hl4, nz(hl4[1]), false, "HL")
w04 = f_lvPushHTF(V4P, V4B, V4H, V4L, ll4, nz(ll4[1]), false, "LL")
w05 = f_lvPushHTF(VDP, VDB, VDH, VDL, hhd, nz(hhd[1]), true,  "HH")
w06 = f_lvPushHTF(VDP, VDB, VDH, VDL, lhd, nz(lhd[1]), true,  "LH")
w07 = f_lvPushHTF(VDP, VDB, VDH, VDL, hld, nz(hld[1]), false, "HL")
w08 = f_lvPushHTF(VDP, VDB, VDH, VDL, lld, nz(lld[1]), false, "LL")

w09 = f_purgeL(V4P, V4B, V4H, V4L)
w10 = f_purgeL(VDP, VDB, VDH, VDL)

f_lvlHTF(_p, _b, _h, _l, _w) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? cHiH : cLoH, lvTr), width = _w, style = st, extend = extend.right))
    n
// ══════════════ СЛОВО СОСТОЯНИЯ ══════════════
// §48, слово владельца: «да, не вводим "переход", пишем чем кончилось».
// «Идёт переход» не говорит ничего: это слово про время, а не про рынок.
// «Умер» и «не было» — это РАЗНЫЕ рынки, и смотреть на них надо
// по-разному. Одно слово на четыре случая стирало бы ровно ту разницу,
// ради которой весь список концов и выстраивался.
f_stWord(_i, _dn) =>
    s = array.get(tTR, _i)
    bool stale = array.get(tEB, _i) < 0 or last_bar_index - array.get(tEB, _i) > winBars
    s == ST_LIVE ? (_dn ? "НИСХ" : "ВОСХ") : s == ST_MAY ? "возможен" : s == ST_ARC ? (stale ? "нет" : "архив") : s == ST_CAN ? (stale ? "нет" : "не было") : s == ST_DEAD ? (stale ? "нет" : "умер") : "нет"

f_stColor(_i, _dn) =>
    s = array.get(tTR, _i)
    color cDir = _dn ? cTrDn : cTrUp
    s == ST_LIVE ? cDir : s == ST_MAY ? color.new(cDir, 45) : s == ST_ARC ? color.new(cDir, 45) : s == ST_DEAD ? (_dn ? cTrUp : cTrDie) : color.gray

f_stTip(_i, _dn) =>
    s = array.get(tTR, _i)
    base = "У тренда ТРИ КОНЦА, и здесь написано, ЧЕМ КОНЧИЛОСЬ. Слова «переход» нет — это слово про время, а не про рынок.\n\n· возможен — есть ноль " + (_dn ? "HH" : "LL") + " и пришла (1). " + (_dn ? "Любой первый НИЗ после нуля объявляет рождение, LL или HL всё равно." : "Любая первая ВЕРШИНА после нуля объявляет рождение, HH или LH всё равно.") + " Опора ещё временная, на нуле, ноги счёта тонкие;\n· " + (_dn ? "НИСХ" : "ВОСХ") + " — пришёл " + (_dn ? "LH" : "HL") + ", тренд ПОДТВЕРЖДЁН, ноги толстые;\n· умер — тело свечи ушло " + (_dn ? "выше" : "ниже") + " порога. Единственный конец с красной чёрточкой;\n· архив — счёт дошёл до (5), а следующ" + (_dn ? "ая вершина пришла HH: вершины перестали падать" : "ий низ пришёл LL: низы перестали расти") + ", продолжения нет. Тренд не умер, он ОТРАБОТАЛ;\n· не было — ОТМЕНА: цена КОСНУЛАСЬ нуля, пока опора стояла на САМОМ НУЛЕ. Тренд мог успеть показаться " + (_dn ? "НИСХ" : "ВОСХ") + " и всё равно исчезнуть: решает не подтверждение, а то, съехала опора с нуля или нет. Касания хватает, запаса нет — слово владельца 07.10.2026. Линия нуля нарисована ТОЧКАМИ: это предположение, его стирают легко;\n· нет — всё перечисленное уехало за окно, показывать нечего."
    s == ST_ARC ? "АРХИВ. Счёт прошёл весь путь от (0) до (5), а следующ" + (_dn ? "ая вершина пришла HH" : "ий низ пришёл LL") + ".\n\nСчёт остаётся (5)/5 с галочкой намеренно: архив это не «ничего нет», а «было и закончилось хорошо». Смени его прочерком — и на табло станет не отличить тренд, отработавший полностью, от тренда, которого не было.\n\nУровень и запас гаснут: они отвечают на вопрос «что будет дальше с ЭТИМ трендом», а дальше с ним ничего не будет.\n\nАрхив по подписи СТРОЖЕ, чем смерть по цене: " + (_dn ? "вершина могла прийти всего на пункт выше" : "низ мог прийти всего на пункт ниже") + ", уровень цел, запас положительный — и всё равно архив. Это сознательный выбор: после (5) манипуляций больше нет, для них не осталось точки счёта.\n\n" + base : base

// подпись у линии уровня: полная, короткая или никакой (З7)
f_lvTxt(_full, _short) =>
    lvLab == "полные" ? _full : lvLab == "короткие" ? _short : ""

// ══════════════ РИСУЕМ ══════════════
if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))

    if hOn and h_tf4
        e1 = f_lvlHTF(V4P, V4B, V4H, V4L, 2)
    if hOn and h_tfd
        e2 = f_lvlHTF(VDP, VDB, VDH, VDL, 3)

    // ── КАКОЙ ИЗ ДВУХ ТРЕНДОВ РИСУЕМ ──
    // Колена у обоих ОДНИ И ТЕ ЖЕ, отличается только прочтение. Одна
    // нога не бывает двух цветов — у ярлыка цвет один на весь текст.
    // А ДВА НОМЕРА НА ОДНОМ КОЛЕНЕ БЫВАЮТ с v3.7: режим «оба» рисует
    // «(2)↑ (1)↓ HL», цвет берётся нейтральный, отработавший счёт
    // помечается галочкой ✓ (v3.15, правка О3). Прежняя фраза «одно
    // колено не несёт двух номеров» верна только для файлов без этого
    // режима — трёхслойного и эталона; здесь она была ложью, снята в
    // v3.18 по правке О6. Замер на девяти годах: оба живы 21.8% баров
    // на 2/2 — пятая часть времени, не краевой случай.
    int rU = not trOn ? 0 : array.get(tTR, 0) == ST_LIVE ? 2 : array.get(tTR, 0) == ST_MAY ? 1 : 0
    int rD = not trDn ? 0 : array.get(tTR, 1) == ST_LIVE ? 2 : array.get(tTR, 1) == ST_MAY ? 1 : 0
    // Ответ ТРЁХЗНАЧНЫЙ:
    //     0  веду восходящий
    //     1  веду нисходящий
    //    -1  не веду никого, счёта на графике нет
    // Один флаг на два значения сказать «не рисую никого» не умел —
    // отсюда было З23
    int drawMode = -1
    if trWho == "только восходящий"
        drawMode := rU > 0 ? 0 : -1
    else if trWho == "только нисходящий"
        drawMode := rD > 0 ? 1 : -1
    else
        if rU == 0 and rD == 0
            drawMode := -1
        else if rU > rD
            drawMode := 0
        else if rD > rU
            drawMode := 1
        else
            drawMode := array.get(tZB, 1) > array.get(tZB, 0) ? 1 : 0
    bool dnDraw = drawMode == 1
    // ── О1. КОГДА ВЕСТИ НЕКОГО — СТОРОНУ ВЫБИРАЕМ ПО ТОМУ, У КОГО ЕСТЬ
    //        ЧТО ПОКАЗАТЬ. Внесено 19.10.2026 по аудиту, слово владельца
    //        «начинаем с О1, со звездочки снимаем».
    //
    // Было: при drawMode == -1 получалось dnDraw = false, и сторона
    // жёстко становилась ВОСХОДЯЩЕЙ. Из-за одной этой строки пропадали
    // сразу три вещи, и каждую находили по отдельности:
    //   · номера счёта, защищённого настройкой «оставлять»;
    //   · архив НИСХОДЯЩЕГО — не показывался никогда, замечание З43-B;
    //   · чёрточка «умер ↓» того же нисходящего.
    //
    // Режимы «только восходящий» и «только нисходящий» сюда НЕ входят:
    // там сторону выбрал владелец, и спорить с ним нечему.
    int shIdx = -1
    if drawMode < 0 and trWho != "только восходящий" and trWho != "только нисходящий"
        bool shU = false
        bool shD = false
        if trOn
            int sU0 = array.get(tTR, 0)
            shU := sU0 == ST_ARC or (keep5 == "оставлять" and sU0 == ST_DEAD and array.get(tMAX, 0) >= 5)
        if trDn
            int sD0 = array.get(tTR, 1)
            shD := sD0 == ST_ARC or (keep5 == "оставлять" and sD0 == ST_DEAD and array.get(tMAX, 1) >= 5)
        // есть у обоих — берём того, чей конец СВЕЖЕЕ. Та же мерка, что
        // у «авто» на развязке: свежее — то, что рынок строил последним
        if shU and shD
            shIdx := array.get(tEB, 1) > array.get(tEB, 0) ? 1 : 0
        else if shU
            shIdx := 0
        else if shD
            shIdx := 1
    // чья СТОРОНА на графике, даже когда никого не ведём: иначе в режиме
    // «только нисходящий» чёрточки брались бы у восходящего
    bool dnSide = trWho == "только нисходящий" ? true : trWho == "только восходящий" ? false : (shIdx >= 0 ? shIdx == 1 : dnDraw)
    int drawIdx = dnSide ? 1 : 0
    int stRaw = array.get(tTR, drawIdx)
    // что из счёта показываем на графике
    int drawSt = 0
    if drawMode >= 0
        drawSt := stRaw
    else if stRaw == ST_ARC
        drawSt := ST_ARC
    else if keep5 == "оставлять" and stRaw == ST_DEAD and array.get(tMAX, drawIdx) >= 5
        // З18 и требование владельца 28.09.2026: «когда по любому тренду
        // счёт доходит от 0 до 5, этот тренд, как бы цена себя дальше ни
        // вела, нельзя перерисовывать». Номера остаются бледными
        drawSt := ST_ARC

    // ══════════ РЕЖИМ «ОБА» — решение В, 14.10.2026 ══════════
    //
    // Слово владельца: «В, толщина как предложил, по умолчанию оставь
    // авто». Повод — его сценарий из СИТ11: в затянувшейся коррекции
    // «авто» переключается на встречный тренд и тут же обратно, и то, на
    // что он смотрит, ПРОПАДАЕТ. Здесь не пропадает ничего.
    //
    // «ЕСТЬ СЧЁТ» = в табло в строке «счёт» стоит цифра, а не прочерк.
    // Это ровно три состояния: возможен, ВОСХ/НИСХ и АРХИВ. Архив
    // включён НАРОЧНО, это выбор владельца между прочтениями Б и В:
    // без архива отработавший счёт по-прежнему пропадал бы с графика,
    // как только ожил встречный, — замечание З43.
    //
    // Числа на 1H за девять лет: цифра стоит у обоих на 43.6% баров,
    // эпизодами с медианой 7 баров. Без архива было бы 37.8%.
    bool twoMode = trWho == "оба, пока у обоих есть счёт"
    int  shU = trOn ? array.get(tTR, 0) : ST_NO
    int  shD = trDn ? array.get(tTR, 1) : ST_NO
    bool hasU = shU == ST_MAY or shU == ST_LIVE or shU == ST_ARC
    bool hasD = shD == ST_MAY or shD == ST_LIVE or shD == ST_ARC
    bool bothDraw = twoMode and hasU and hasD
    // ВТОРОЙ набор для f_draw. ST_NO значит «второго нет», и тогда вся
    // отрисовка идёт ровно как до 14.10.2026
    int drawSt2 = ST_NO
    if twoMode
        if bothDraw
            // первым идёт ВОСХОДЯЩИЙ, вторым нисходящий. Порядок важен
            // только для того, чей номер стоит в подписи первым
            dnSide  := false
            drawIdx := 0
            drawSt  := shU
            drawSt2 := shD
        else if hasU
            dnSide := false
            drawIdx := 0
            drawSt  := shU
        else if hasD
            dnSide := true
            drawIdx := 1
            drawSt  := shD
        // О1. ЧЕТВЁРТОЙ ВЕТКИ БОЛЬШЕ НЕТ. Здесь стояло `drawSt := 0`, и
        // оно ЗАТИРАЛО то, что блок выше уже приготовил: архив или счёт,
        // защищённый настройкой «оставлять». Режим «оба» стоит по
        // умолчанию с v3.13 — значит настройка переставала работать у
        // всех и каждый день. Теперь приготовленное доживает до графика.

    // О2. ЗАПОМИНАЕМ, ЧТО НАРИСОВАНО — для строки табло «рисует».
    // Берётся ПОСЛЕ ветки «оба»: к этому месту сторона и счёт уже
    // окончательные, и это ровно то, что уйдёт в f_draw ниже
    drwBoth := bothDraw
    drwSt   := drawSt
    drwIdx  := drawSt == ST_NO ? -1 : drawIdx

    // ближайшие непробитые уровни считаем ЗДЕСЬ, до блока уровня тренда:
    // без этого нельзя СКЛЕИТЬ совпавшие по цене линии — вторая половина
    // З7. Пайн не умеет ни тернарник по массивам, ни разбор кортежа в цикле
    [mUp, mDn] = f_nearest(V2P, V2H)
    // ── СКЛЕЙКА СОВПАВШИХ ПО ЦЕНЕ ЛИНИЙ — вторая половина З7 ──
    // Совпадение не случайное: уровень нисходящего — последняя LH, и
    // ближайший непробитый уровень сверху — тоже она, пока цена её не
    // коснулась. Совпали — рисуется ОДНА линия и ОДНА подпись, обе роли
    // через точку.
    // ── О4, 20.10.2026. ДВЕ ПОЧИНКИ СКЛЕЙКИ ──
    //
    // ПЕРВАЯ. Склейка срабатывает, ТОЛЬКО ЕСЛИ У ОПОРЫ ЕСТЬ ПОДПИСЬ,
    // куда можно написать обе роли. Подпись есть у СПЛОШНОЙ опоры
    // (tLHL) и только когда подписи включены (lvLab). У точечной и
    // штрих-пунктирной подписи нет вовсе: прежде склейка всё равно
    // гасила слом, и с графика пропадала и линия, и цена, и процент, а
    // взамен не появлялось ничего. Правило З7 говорит «ОДНА линия и
    // ОДНА подпись, обе роли через точку» — подписей выходило НОЛЬ.
    //
    // ВТОРАЯ. Сравнение идёт с ОБЕИМИ опорами. В режиме «оба» у второго
    // тренда своя опора, и она в склейке не участвовала — на одной цене
    // стояли две линии. У второй опоры те же два условия, и своя
    // приписка glueTxt2: роль слома пишется в ТУ подпись, которая
    // осталась на графике.
    float mSg0 = dnSide ? -1.0 : 1.0
    float lvlNow = array.get(tLVL, drawIdx) * mSg0
    bool lvlShown = (drawSt == ST_MAY or drawSt == ST_LIVE) and not na(lvlNow) and array.get(tLHL, drawIdx) and lvLab != "нет"
    int   gIdx2   = drawIdx == 0 ? 1 : 0
    float lvl2Now = array.get(tLVL, gIdx2) * (gIdx2 == 1 ? -1.0 : 1.0)
    bool lvl2Shown = (drawSt2 == ST_MAY or drawSt2 == ST_LIVE) and not na(lvl2Now) and array.get(tLHL, gIdx2) and lvLab != "нет"
    bool glueUp = false
    bool glueDn = false
    bool glueUp2 = false
    bool glueDn2 = false
    if lvlShown
        if not na(mUp)
            glueUp := math.abs(mUp - lvlNow) <= syminfo.mintick
        if not na(mDn)
            glueDn := math.abs(mDn - lvlNow) <= syminfo.mintick
    if lvl2Shown
        if not na(mUp)
            glueUp2 := math.abs(mUp - lvl2Now) <= syminfo.mintick
        if not na(mDn)
            glueDn2 := math.abs(mDn - lvl2Now) <= syminfo.mintick
    string glueTxt  = (glueUp  ? " · слом ↑" : "") + (glueDn  ? " · слом ↓" : "")
    string glueTxt2 = (glueUp2 ? " · слом ↑" : "") + (glueDn2 ? " · слом ↓" : "")

    int zbM  = array.get(tZB,  drawIdx)
    int pzbM = array.get(tPZB, drawIdx)
    // нули ВТОРОГО тренда. При drawSt2 = ST_NO не используются
    int idx2 = drawIdx == 0 ? 1 : 0
    int zbM2  = array.get(tZB,  idx2)
    int pzbM2 = array.get(tPZB, idx2)

    if lvOn
        r2 = f_lvlLayer(V2P, V2B, V2H, V2L, c2H, c2L)
    if absOn and labOn
        gg2 = f_drawAbs(G2, Y2, Z2, W2, c2H, c2L, "2/2")
    d2 = f_draw(P2, B2, H2, L2, M2, c2H, c2L, "2/2", labOn, zbM, pzbM, drawSt, dnSide, swB, zbM2, pzbM2, drawSt2)

    // ── УРОВЕНЬ и ЧЁРТОЧКИ ──
    if trOn or trDn
        // цена ячейки 1 живёт в перевёрнутом мире — знак назад
        float mSg  = dnSide ? -1.0 : 1.0
        float mLvl = array.get(tLVL, drawIdx) * mSg
        mHL  = array.get(tLHL, drawIdx)
        color cDir = dnSide ? cTrDn : cTrUp
        if (drawSt == ST_MAY or drawSt == ST_LIVE) and not na(mLvl)
            x0 = array.get(tLVB, drawIdx) < 0 ? bar_index - 30 : array.get(tLVB, drawIdx)
            // ТРИ РАЗНЫЕ ЛИНИИ, и это не оформление, а смысл.
            // Решение владельца 09.10.2026: «по линии для LL и зеркало
            // сделай не штрих-пунктир, а точки, а для манипуляции
            // штрих-пунктир». Форма линии и правило совпадают:
            //
            //   ТОЧКИ        уровень на САМОМ НУЛЕ (LL, в зеркале HH).
            //                Рубится КАСАНИЕМ, без запаса → «не было»
            //   ШТРИХ-ПУНКТИР  уровень съехал на МАНИПУЛЯЦИОННЫЙ низ.
            //                Держит: рубится глубиной по телу → «умер»
            //   СПЛОШНАЯ     настоящая опора, уровень на HL. Толстая,
            //                с подписью. Рубится глубиной → «умер»
            //
            // ОБЕ ВРЕМЕННЫЕ — тонкие, КОРОТКИЕ, без подписи. Длина 12
            // баров от своего колена, как у чёрточек смерти и рождения
            int x1 = math.min(x0 + 12, bar_index)
            // форма берётся из ТЕХ ЖЕ величин, по которым движок решает
            // судьбу тренда: tLHL — настоящая ли опора, tONZ — стоит ли
            // она на самом нуле. Третьего источника нет нарочно
            bool mZero = array.get(tONZ, drawIdx)
            array.push(LNS, line.new(x0, mLvl, x1, mLvl, color = cDir, width = mHL ? 2 : 1, style = mHL ? line.style_solid : mZero ? line.style_dotted : line.style_dashed))
            if mHL and lvLab != "нет"
                array.push(LBS, label.new(x1, mLvl, f_lvTxt("держит " + (dnSide ? "LH " : "HL ") + str.tostring(mLvl, format.mintick) + glueTxt, str.tostring(mLvl, format.mintick) + glueTxt), style = label.style_label_right, color = color.new(color.black, 100), textcolor = cDir, size = size.small, tooltip = "Уровень " + (dnSide ? "нисходящего — последняя появившаяся ВЕРШИНА" : "восходящего — последний появившийся НИЗ") + " от нуля, ЛЮБОЙ подписи.\n\nОт уровня считается смерть: тело свечи ниже уровня на " + str.tostring(dnSide ? depthD : depthU) + " скользящего среднего колена слоя."))
        // ── ВТОРАЯ ЛИНИЯ УРОВНЯ, режим «оба». Решение В, 14.10.2026 ──
        //
        // Та же механика, что у первой, только для встречного тренда:
        // зелёная держит восходящий, красная нисходящий. Код повторён, а
        // не вынесен в функцию, нарочно: первая линия — рабочая, её
        // трогать не за чем, а повтор видно глазом при сверке.
        //
        // У АРХИВА уровень погашен (tLVL = na), поэтому второй линии у
        // него не будет — она и не нужна, держать больше нечего
        if drawSt2 == ST_MAY or drawSt2 == ST_LIVE
            float mSg2  = idx2 == 1 ? -1.0 : 1.0
            float mLvl2 = array.get(tLVL, idx2) * mSg2
            if not na(mLvl2)
                bool  mHL2  = array.get(tLHL, idx2)
                bool  mZer2 = array.get(tONZ, idx2)
                color cDir2 = idx2 == 1 ? cTrDn : cTrUp
                int   y0 = array.get(tLVB, idx2) < 0 ? bar_index - 30 : array.get(tLVB, idx2)
                int   y1 = math.min(y0 + 12, bar_index)
                array.push(LNS, line.new(y0, mLvl2, y1, mLvl2, color = cDir2, width = mHL2 ? 2 : 1, style = mHL2 ? line.style_solid : mZer2 ? line.style_dotted : line.style_dashed))
                if mHL2 and lvLab != "нет"
                    array.push(LBS, label.new(y1, mLvl2, f_lvTxt("держит " + (idx2 == 1 ? "LH " : "HL ") + str.tostring(mLvl2, format.mintick) + glueTxt2, str.tostring(mLvl2, format.mintick) + glueTxt2), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cDir2, size = size.tiny, tooltip = "Уровень ВТОРОГО тренда, " + (idx2 == 1 ? "нисходящего" : "восходящего") + ".\n\nРежим ① «оба, пока у обоих есть счёт»: на графике два тренда, и у каждого своя опора. Зелёная держит восходящий, красная нисходящий."))

        // ── СМЕРТЬ: красная чёрточка ──
        // ТОЛЬКО У СМЕРТИ. У отмены и архива следа на графике нет.
        // Цвет говорит про НАПРАВЛЕНИЕ движения цены, а не про событие:
        // смерть нисходящего и рождение восходящего — одно и то же
        // движение рынка, прочитанное с двух сторон.
        //
        // ── З51, 20.10.2026. ЧЁРТОЧКА БОЛЬШЕ НЕ ЖДЁТ ПОКАЗА ──
        //
        // Было: рисуется только у тренда, который СЕЙЧАС нарисован. А
        // умерший тренд рисоваться перестаёт — счёта у него нет. Выходил
        // замкнутый круг: чёрточка нужна, чтобы показать смерть, а
        // показывали её только живым. На графике она всплывала через
        // десяток баров, когда тренд рождался заново.
        //
        // Правило С7 и обе `ПРАВИЛА-*` связывают чёрточку с СОБЫТИЕМ:
        // «смерть → красная чёрточка», без оговорки «пока рисуется».
        // Теперь так и есть: тренд в состоянии «умер» получает свою
        // чёрточку, даже когда ведут не его.
        //
        // РЕЖИМЫ «ТОЛЬКО ВОСХОДЯЩИЙ» И «ТОЛЬКО НИСХОДЯЩИЙ» НЕ ТРОГАЮТСЯ.
        // Там drawIdx и так стоит на выбранном направлении, и чёрточка
        // своей стороны показывалась вовремя всегда. Чужие смерти туда
        // пускать нельзя: владелец выбрал одну сторону.
        //
        // Галочки ⑦ учтены: направление, которое не считают, чёрточки не
        // получает.
        bool oneSide = trWho == "только восходящий" or trWho == "только нисходящий"
        nR = array.size(RDB)
        if nR > 0
            for k = 0 to nR - 1
                lr = array.get(RDL, k)
                bool rOwn  = lr == drawIdx or (drawSt2 != ST_NO and lr == idx2)
                bool rDead = false
                if not oneSide and (lr == 0 ? trOn : trDn)
                    rDead := array.get(tTR, lr) == ST_DEAD
                if (rOwn or rDead) and last_bar_index - array.get(RDB, k) <= winBars
                    rb = array.get(RDB, k)
                    rp = array.get(RDP, k)
                    bool rDn = lr == 1
                    color cR = rDn ? cTrUp : cTrDie
                    array.push(LNS, line.new(rb - 12, rp, rb + 12, rp, color = cR, width = 2))
                    array.push(LBS, label.new(rb, rp, rDn ? "умер ↓" : "умер ↑", style = rDn ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = cR, size = size.tiny, tooltip = (rDn ? "НИСХОДЯЩИЙ умер" : "ВОСХОДЯЩИЙ умер") + " на уровне " + str.tostring(rp, format.mintick) + "\n\nПРАВИЛО СМЕРТИ ОДНО: тело свечи ушло ниже\n   уровень − " + str.tostring(rDn ? depthD : depthU) + " × скользящее среднее колено слоя\nПроверяется КАЖДЫЙ бар. Тень тренд НЕ убивает — считается по ТЕЛУ свечи.\n\nЭто ЕДИНСТВЕННЫЙ конец тренда с чёрточкой. Отмена и архив следа не оставляют."))
        // ── РОЖДЕНИЕ: цена перебитой вершины ──
        // С ГРАФИКА УБРАНА под галочку. Механизм работает всегда: от этой
        // цены считается запасное подтверждение У7
        if trBirth
            nG = array.size(GDB)
            if nG > 0
                for k = 0 to nG - 1
                    lg = array.get(GDL, k)
                    if (lg == drawIdx or (drawSt2 != ST_NO and lg == idx2)) and last_bar_index - array.get(GDB, k) <= winBars
                        gb = array.get(GDB, k)
                        gp = array.get(GDP, k)
                        bool gok = array.get(GOK, k)
                        bool gDn = lg == 1
                        color cGc = gDn ? cTrDn : cTrUp
                        array.push(LNS, line.new(gb - 12, gp, gb + 12, gp, color = cGc, width = gok ? 2 : 1))
                        array.push(LBS, label.new(gb, gp, (gDn ? "слом ↓" : "слом ↑") + (gok ? "" : " ?"), style = gDn ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cGc, size = size.tiny, tooltip = (gDn ? "РОЖДЕНИЕ НИСХОДЯЩЕГО: сломали восходящую структуру на " : "РОЖДЕНИЕ ВОСХОДЯЩЕГО: сломали нисходящую структуру на ") + str.tostring(gp, format.mintick) + ".\n" + (gok ? "Тренд ПОДТВЕРЖДЁН." : "Тренд ещё НЕ подтверждён.") + "\n\nОт этой цены считается ЗАПАСНОЕ подтверждение: оно просыпается, если низ счёта пришёл манипуляционным, и подтверждает тренд по цене, без HL."))

    // ── СЛОМЫ: номера текущей серии ──
    if slOn
        if slLine
            if not na(mUp) and not glueUp and not glueUp2
                array.push(LNS, line.new(bar_index - 60, mUp, bar_index, mUp, color = cSlUp, width = 2, extend = extend.right))
                if lvLab != "нет"
                    array.push(LBS, label.new(bar_index, mUp, f_lvTxt("слом ↑ " + str.tostring(mUp, format.mintick) + "   " + str.tostring(100 * (mUp - close) / close, "#.##") + "%", str.tostring(mUp, format.mintick)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlUp, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя 2/2 сверху.\nДойдёт сюда цена — будет слом вверх.\n\nСлом засчитывается по КАСАНИЮ — хватает тени.\n\nМедиана расстояния за девять лет: 0.40%."))
            if not na(mDn) and not glueDn and not glueDn2
                array.push(LNS, line.new(bar_index - 60, mDn, bar_index, mDn, color = cSlDn, width = 2, extend = extend.right))
                if lvLab != "нет"
                    array.push(LBS, label.new(bar_index, mDn, f_lvTxt("слом ↓ " + str.tostring(mDn, format.mintick) + "   " + str.tostring(100 * (close - mDn) / close, "#.##") + "%", str.tostring(mDn, format.mintick)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlDn, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя 2/2 снизу.\nДойдёт сюда цена — будет слом вниз.\n\nМедиана за девять лет: 0.44%."))
        if slNum
            int dirM = array.get(sDIR, 0)
            nS = array.size(SB)
            if nS > 0
                for k = 0 to nS - 1
                    sb = array.get(SB, k)
                    if last_bar_index - sb <= winBars
                        sp = array.get(SP, k)
                        sn = array.get(SN, k)
                        // ── БЛОК «РАНЬШЕ ШЛО ТУДА ЖЕ» УБРАН 19.10.2026 ──
                        //
                        // Слово владельца: «режем справку и мусор». Разметка
                        // описи ПОДСКАЗКИ.md: ❌ мусор, и не из-за длины.
                        //
                        // Блок показывал надбавку из частот SFQ, снятых
                        // замером Н14 БЕЗ контроля расстояния. Замер Н17
                        // показал: примерно половина надбавки была
                        // ГЕОГРАФИЕЙ, а не серией. На экране стояло +7.3
                        // процентных пункта, честное — около +3.5. Это
                        // замечание З12, открыто с 23.09.2026.
                        //
                        // ДАННЫЕ НЕ ПОТЕРЯНЫ: массивы SFQ, SFN и SFB стоят
                        // на месте. Пересчитаем с контролем расстояния —
                        // блок вернётся одной правкой.
                        array.push(LBS, label.new(sb, sp, (dirM > 0 ? "↑" : "↓") + str.tostring(sn), style = dirM > 0 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = dirM > 0 ? cSlUp : cSlDn, size = size.tiny, tooltip = "Слом " + (dirM > 0 ? "ВВЕРХ" : "ВНИЗ") + " номер " + str.tostring(sn) + " в текущей серии.\nЦена взяла непробитый уровень " + str.tostring(sp, format.mintick) + " слоя 2/2.\n\nПоказывается только ТЕКУЩАЯ серия. Сменится направление — эти метки уйдут и счёт начнётся с единицы."))

    // ── ГДЕ «АВТО» ПЕРЕДУМАЛО ──
    if swMark and trWho == "авто"
        nA = array.size(AWB)
        if nA > 0
            for k = 0 to nA - 1
                ab = array.get(AWB, k)
                if last_bar_index - ab <= winBars
                    bool aDn = array.get(AWD, k)
                    ap = array.get(AWP, k)
                    color cA = aDn ? cTrDn : cTrUp
                    array.push(LBS, label.new(ab, ap, aDn ? "⇄ НИСХ" : "⇄ ВОСХ", style = label.style_label_center, color = color.new(color.black, 100), textcolor = cA, size = size.tiny, tooltip = "Здесь режим «авто» сменил рисуемый тренд на " + (aDn ? "НИСХОДЯЩИЙ" : "ВОСХОДЯЩИЙ") + ".\n\nСчёт обоих направлений идёт ВСЕГДА, независимо от того, кто нарисован. Поэтому тренд появляется здесь уже с тем счётом, который набрал, пока был невидим.\n\n«Авто» предпочитает ПОДТВЕРЖДЁННЫЙ тренд «возможному»: иначе в устойчивом падении восходящий рождался бы на каждом отскоке и метка стояла бы через бар."))

    // ══════════════ ТАБЛО ══════════════
    // Колонка одна: слой 2/2. В версии с тремя слоями их было три, и
    // верхняя строка «рисует» отвечала на вопрос «на какой слой
    // перейти». Здесь переходить некуда, но строка оставлена: она
    // показывает счёт ВМЕСТЕ с предварительным коленом — хотя у 2/2
    // предварительного колена не бывает, и значит она просто повторяет
    // строку «счёт». Уйдёт, если владелец скажет.

// ═══════════════════════════════════════════════════════════════════
//                  ВТОРОЙ БЛОК «ПОСЛЕДНИЙ БАР» — ТАБЛО
// ═══════════════════════════════════════════════════════════════════
//
// РАЗДЕЛЕНО 15.10.2026, слово владельца «да, чини делением».
//
// ПОЧЕМУ. У TradingView есть предел на длину ОДНОГО блока if, и v3.9
// его перешла: в v3.8 внутри `if barstate.islast` было 281 строка кода
// и 40 346 символов — компилировалось; в v3.9 стало 302 и 44 360 —
// «The if statement is too long». Весь показ лежал в одном блоке, и
// две новые строки табло с подсказками его переполнили.
//
// ЧТО СДЕЛАНО. Один блок разбит на ДВА с тем же условием: первый рисует
// на графике, второй собирает табло. Это перестановка скобок, и больше
// ничего: ни одной цифры, ни одной линии, ни одного условия показа не
// изменилось.
//
// ЧТО ПЕРЕСЕКАЛО ГРАНИЦУ — при делении ровно три величины, проверено
// разбором всех имён блока: mUp, mDn и bothDraw. Каждая считалась одной
// строкой, и эти строки повторялись ниже. Пересчёт идёт ТОЛЬКО на
// последнем баре, поэтому цена этого решения равна нулю.
//
// С v3.17 ИХ ДВЕ. bothDraw пересчитывать больше не надо: её единственным
// потребителем была строка табло «рисует», а в v3.16 та переехала на
// drwBoth — величину `var` верхнего уровня, которую первый блок пишет из
// того, что реально ушло в показ. Повторный вывод остался без
// потребителя, и шесть строк убраны словом владельца.
//
// НА БУДУЩЕЕ: добавляя строки в табло, следить за размером обоих
// блоков. Предел лежит где-то между 281 и 302 строками кода.
if barstate.islast
    // ── две величины, пересекающие границу ──
    [mUp, mDn] = f_nearest(V2P, V2H)

    if trTbl
        table.cell(TBL, 0, 0, "рисует", text_color = color.gray, text_size = tSz, tooltip = "Что индикатор рисует ПРЯМО СЕЙЧАС, с учётом режима из ①.\n\n«нет» значит, что не нарисовался бы никто: либо оба направления мертвы, либо режим запрещает то, что живо.")
        // О2. Строка отвечает на СВОЙ вопрос — «что на экране», а не на
        // «кого выбрал бы авто». Прежде здесь стоял SWM, и табло писало
        // «нет» при нарисованном архиве. Источник теперь drwIdx/drwSt,
        // посчитанные в первом блоке ровно из того, что ушло в f_draw.
        int ix = drwIdx == 1 ? 1 : 0
        int cc = array.get(tCNT, ix)
        // состояние берём НАРИСОВАННОЕ, а не сырое: у счёта под защитой
        // «оставлять» тренд уже мёртв, но на графике стоят его бледные
        // номера, и строка должна говорить про них
        string dtxt = drwIdx < 0 ? "нет" : (drwIdx == 1 ? "НИСХ" : "ВОСХ") + (drwSt == ST_ARC ? " (5)/5 ✓" : cc >= 0 ? " (" + str.tostring(cc) + ")/5" : "")
        // в режиме «оба» эта строка говорит ОБА, а числа смотрят в своих
        // блоках ниже: одной цифрой два счёта не назвать
        if drwBoth
            dtxt := "ОБА"
        table.cell(TBL, 1, 0, dtxt, text_color = drwIdx < 0 ? color.gray : drwIdx == 1 ? cTrDn : cTrUp, text_size = tSz)

    if trTbl and blkUp
        // строку последовательности считаем ДО ячеек: пайн не умеет
        // тернарник, возвращающий кортеж
        [zlC, tlC, npC] = f_seqNow(P2, B2, H2, L2, 0)
        table.cell(TBL, 0, 1, "восходящий", text_color = cTrUp, text_size = tSz, bgcolor = cBlkU, tooltip = "ВОСХОДЯЩИЙ, слой 2/2. Восемь строк ниже — что движок думает о нём прямо сейчас.\n\nДвижок у двух направлений ОДИН: нисходящий считается тем же кодом на перевёрнутых свечах. Второго набора правил не существует, зеркало точное по построению.\n\nПОДПИСИ СТРОК У ДВУХ БЛОКОВ СОВПАДАЮТ СЛОВО В СЛОВО. Есть строка у восходящего — есть такая же у нисходящего, со своими данными. Единственное, что может разойтись, — число в подписи «запас»: каждый берёт глубину своего направления из ⑦.\n\nБлок выключается галочкой «восходящий» в ⑤." + (mirDiff > 0 ? "\n\nВНИМАНИЕ: у нисходящего заведено ОТЛИЧИЙ от восходящего: " + str.tostring(mirDiff) + ". Зеркало как тождество больше не держится." : "\n\nзеркало: цело — все правила нисходящего стоят на значениях восходящего."))
        table.cell(TBL, 1, 1, "2/2", text_color = cTrUp, text_size = tSz, bgcolor = cBlkU)
        int    sU  = array.get(tTR, 0)
        bool   liv = sU == ST_MAY or sU == ST_LIVE
        float  lv  = array.get(tLVL, 0)
        float  leg = array.get(tLEG, 0)
        float  thr = na(lv) ? na : lv - depthU * leg
        // З44. Какая ступень работает сейчас. Тот же tONZ, по которому
        // решает движок: опора на нуле — рубит касание, съехала — глубина
        bool   zOnU = array.get(tONZ, 0)
        color  cG  = f_stColor(0, false)
        table.cell(TBL, 1, 2, f_stWord(0, false), text_color = cG, text_size = tSz, tooltip = f_stTip(0, false))
        int cntRaw = array.get(tCNT, 0)
        string cntTxt = sU == ST_ARC ? "(5)/5 ✓" : liv ? "(" + str.tostring(cntRaw) + ")/5" : "—"
        table.cell(TBL, 1, 3, cntTxt, text_color = cG, text_size = tSz, tooltip = (sU == ST_ARC ? "АРХИВ. Счёт прошёл весь путь до (5) — галочка про это. Он остаётся на месте намеренно: это РЕЗУЛЬТАТ, а не «ничего нет».\n\n" : "") + "Счёт чередует колена от нуля: нечётная точка вершина, чётная низ. Потолок пять. Встречная подпись счёт НЕ обрывает — она помечает точку как манипуляционную, и нога к ней рисуется штрих-пунктиром.\n\nПРЕДВАРИТЕЛЬНОГО КОЛЕНА (⋯) здесь не бывает: его брали у соседнего слоя, а у 2/2 соседа снизу нет. Поэтому счёт всегда окончательный на момент показа.\n\nПосле (5) решает ПЕРВЫЙ новый низ, и больше ничего: HL — продолжение, счёт пойдёт с нуля; LL — архив. Одно колено решает судьбу тренда.")
        table.cell(TBL, 1, 4, liv or sU == ST_ARC ? str.tostring(array.get(tRST, 0)) : "—", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 1, 5, not liv ? "—" : na(lv) ? "нет" : (array.get(tLHL, 0) ? "HL " : "LL ") + str.tostring(lv, format.mintick), text_color = liv and not na(lv) ? (array.get(tLHL, 0) ? cTrUp : color.new(cTrUp, 45)) : color.gray, text_size = tSz)
        // ── НОВАЯ СТРОКА 6: ЧЕМ РУБИТСЯ СЕЙЧАС. З44, шаг Т4 ──
        // Движок всегда знал, какая ступень работает, а в табло этого
        // не было: видно было только по форме линии уровня на графике
        string rubU = not liv or na(lv) ? "—" : zOnU ? "касанием " + str.tostring(lv, format.mintick) : "глубиной " + str.tostring(thr, format.mintick)
        table.cell(TBL, 1, 6, rubU, text_color = not liv or na(lv) ? color.gray : zOnU ? color.orange : color.gray, text_size = tSz)
        // З44. ЗАПАС СЧИТАЕТСЯ ПО ТОЙ СТУПЕНИ, КОТОРАЯ РАБОТАЕТ СЕЙЧАС.
        // До 15.10.2026 здесь всегда стоял порог глубины, и пока опора
        // на нуле число было завышено на 0.20 колена: рубило КАСАНИЕ, а
        // показывалось расстояние до тела. Ступень выбирается тем же
        // tONZ, по которому решает движок — третьего источника нет
        float zap  = na(lv) ? na : zOnU ? low - lv : math.min(open, close) - thr
        bool  neg  = not na(zap) and zap < 0
        // З47. ПРОЦЕНТ ОТ ЦЕНЫ рядом с пунктами. Слово владельца
        // 19.10.2026: «подпись оставляем как есть и только дописываем
        // процент». Формат тот же, что в строках «ближе слом» и
        // «дальний слом» — одна мерка на всё табло. Знак сохранён:
        // у отрицательного запаса процент тоже отрицательный
        string zapTxt = na(zap) or not liv ? "—" : str.tostring(zap, format.mintick) + "  " + str.tostring(100 * zap / close, "#.##") + "%"
        table.cell(TBL, 1, 7, zapTxt, text_color = not liv ? color.gray : neg ? cTrDie : color.gray, text_size = tSz)
        string ageU = liv and array.get(tZB, 0) >= 0 ? str.tostring(last_bar_index - array.get(tZB, 0)) + (array.get(tZB0, 0) >= 0 ? "  ·  всего " + str.tostring(last_bar_index - array.get(tZB0, 0)) : "") : "—"
        table.cell(TBL, 1, 8, ageU, text_color = color.gray, text_size = tSz)
        db = array.get(tDB, 0)
        table.cell(TBL, 1, 9, db < 0 ? "—" : str.tostring(last_bar_index - db) + " / " + str.tostring(array.get(tDP, 0), format.mintick), text_color = db < 0 ? color.gray : cTrDie, text_size = tSz)
        [mc, mi, mn] = f_match(tlC)
        bool rojd = zlC == "LL"
        // индекс считается отдельно и никогда не уходит в минус: при
        // mi = -1 голое выражение дало бы -1 и обращение за границу массива
        int fiU = mi >= 0 ? mi + (rojd ? 0 : 8) : 0
        int fr = mi >= 0 and npC >= 5 ? array.get(PFR, fiU) : -1
        // З28: не подошёл НИ ОДИН эталон — в ячейку клалась ПУСТОТА.
        // Самый сильный признак индикатора показывался пустым местом
        string nmU = mc > 0 ? mn : "вне справ."
        bool showsU = liv or sU == ST_ARC
        string cell = not showsU ? "—" : npC < 5 ? (mc <= 3 ? nmU : str.tostring(mc) + " вар.") : nmU
        string tip = not showsU ? "Тренда нет." : "Слой 2/2, " + (rojd ? "РОЖДЕНИЕ, ноль LL" : "ПРОДОЛЖЕНИЕ, ноль HL") + "\n\nсейчас на графике:  " + zlC + (npC > 0 ? "·" + tlC : "") + "\n" + (mc == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВсе восемь требуют HL на местах (2) и (4) — значит низ оказался LL, была МАНИПУЛЯЦИЯ.\n\nЗамер Н39: это ТОЖДЕСТВО, а не совпадение. Счёт без манипуляции обязан попасть в справочник, счёт с манипуляцией обязан не попасть. Проверено в обе стороны на 8 909 счётах, ноль исключений.\n\nЗначит «вне справ.» читается просто: внутри счёта рынок сходил ниже предыдущего низа. Такой счёт доходит до (5) в 53–60% против 81–91% у чистого (Н35)." : npC < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mc) + " из 8 — " + mn : "это " + mn + ", за 9 лет часовика встретилась " + str.tostring(fr) + " раз") + "\n\nИндикатор ничего не предсказывает. Он узнаёт форму и называет её номером, как шаблон триггерной свечи."
        table.cell(TBL, 1, 10, cell, text_color = showsU ? (mc == 0 ? color.orange : npC >= 5 ? cTrUp : color.gray) : color.gray, text_size = tSz, tooltip = tip)
        table.cell(TBL, 0, 2, "состояние", text_color = color.gray, text_size = tSz, tooltip = "Чем кончилось: умер · архив · не было · нет. Плюс два живых: возможен и ВОСХ.\n\nСлова «переход» здесь нет и не будет — решение владельца 07.10.2026.\n\nСлова «не свой» здесь тоже нет: ОТКАЗ случался, когда слою не хватало чужих колен, а у 2/2 чужих колен не бывает.")
        table.cell(TBL, 0, 3, "счёт", text_color = color.gray, text_size = tSz, tooltip = "Счёт чередует колена от нуля. Потолок пять.\n\nУ ВОСХОДЯЩЕГО ноль — низ LL, поэтому нечётная точка ВЕРШИНА, чётная НИЗ, и (5) всегда вершина.\n\nВстречная подпись счёт НЕ обрывает — она помечает точку как манипуляционную, и нога к ней рисуется штрих-пунктиром.\n\nСЧЁТ ИДЁТ ПО КОЛЕНАМ, А НЕ ПО БАРАМ: если одна свеча сделала и вершину, и низ, то колен два и номера два. Замечание З41.\n\nЧто означает каждое состояние счёта — наведите на само значение справа." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 4, "полных счётов", text_color = color.gray, text_size = tSz, tooltip = "Сколько раз ЭТОТ тренд дошёл до (5) и продолжился, не умирая.\n\n0 — тренд молодой, ни разу не прошёл весь путь. 3 — трижды отработал и жив до сих пор. Такой тренд не просто жив, он СИЛЁН, а по остальным строкам табло отличить его от молодого нельзя.\n\nПродолжение идёт цепочкой: (5) → HL → новый счёт с нуля на этом HL → (5) → HL → … Это ОДИН тренд, а на графике видно только последний счёт и один бледный перед ним.\n\nОбнуляется вместе с трендом: при смерти, отмене и архиве." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 5, "уровень", text_color = color.gray, text_size = tSz, tooltip = "Последний появившийся НИЗ от нуля — ЛЮБОЙ подписи, не только HL. Замена безусловная, храповика нет.\n\nТРИ ВИДА ЛИНИИ, и по ней видно, чем тренд рубится:\n· ТОЧКИ — уровень на САМОМ НУЛЕ, ни одного низа ещё не было. Рубится КАСАНИЕМ, без буфера → «тренда не было»;\n· ШТРИХ-ПУНКТИР — уровень съехал на МАНИПУЛЯЦИОННЫЙ низ. Держит: рубится глубиной по телу → «умер»;\n· СПЛОШНАЯ с подписью — уровень на HL, настоящая опора. Тоже глубиной.\n\nВ ячейке стоит подпись того колена, на котором уровень сейчас: HL у настоящей опоры. LL стоит в ДВУХ РАЗНЫХ случаях — когда уровень съехал на манипуляционный низ (держит) и когда он ещё на самом нуле (не держит). Отличает их ЛИНИЯ: штрих-пунктир против точек." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 6, "рубится", text_color = color.gray, text_size = tSz, tooltip = "ЧЕМ ТРЕНД РУБИТСЯ ПРЯМО СЕЙЧАС, и по какой цене. Строка добавлена 15.10.2026, замечание З44, шаг Т4.\n\n· КАСАНИЕМ — опора стоит на САМОМ НУЛЕ, ступень СТРОГАЯ. Цена дошла до названной цифры — и всё: «тренда не было», разметка стирается без следа, красной чёрточки нет. Запаса нет вовсе, и меряется МИНИМУМОМ свечи: на строгой ступени тень рубит;\n· ГЛУБИНОЙ — опора съехала с нуля, ступень МЯГКАЯ. Рубит ТЕЛО свечи ниже названной цифры, то есть уровень минус " + str.tostring(depthU) + " скользящего колена. Тень тут НЕ убивает — замер Н28: тело разделяет исходы в 4–6 раз, тень только в 2.3–2.7.\n\nЦИФРА РЯДОМ — ТА САМАЯ ЦЕНА, на которой это случится.\n\nНА ГРАФИКЕ ЭТО И РАНЬШЕ БЫЛО ВИДНО — по форме линии уровня: точки рубятся касанием, штрих-пунктир и сплошная глубиной. Строка повторяет то же словами, чтобы не вглядываться в линию.\n\nОРАНЖЕВЫЙ ЦВЕТ значит строгую ступень: в этот момент тренд самый хрупкий. Этим кончается четверть счётов восходящего и треть нисходящего — замер Н36.\n\nСтупень выбирается по тому, ГДЕ СТОИТ ОПОРА, а не по состоянию и не по номеру точки. Слово владельца: «граница терпения проходит сразу после ноля»." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 7, "запас " + str.tostring(depthU) + " кол.", text_color = color.gray, text_size = tSz, tooltip = (zOnU ? "СЕЙЧАС РАБОТАЕТ СТРОГАЯ СТУПЕНЬ — опора стоит на САМОМ НУЛЕ, и здесь стоит расстояние ДО КАСАНИЯ:\n   запас = минимум свечи − уровень\n\nМеряется МИНИМУМОМ, а не телом: на строгой ступени тень рубит. Дошло до нуля — «тренда не было», разметка стирается.\n\nПОДПИСЬ СТРОКИ ПРИ ЭТОМ ПО-ПРЕЖНЕМУ НАЗЫВАЕТ " + str.tostring(depthU) + " КОЛЕНА — это про МЯГКУЮ ступень, она включится, когда опора съедет с нуля. Какая ступень работает сейчас, пишет строка «рубится» выше.\n\n" : "Сколько осталось телу свечи до порога смерти:\n   запас = min(открытие, закрытие) − (уровень − " + str.tostring(depthU) + " × скользящее колено)\n\n") + "ПРОЦЕНТ РЯДОМ — то же расстояние, но от цены: столько цена может пройти, прежде чем тренд умрёт. Та же мерка, что в строках «ближе слом» и «дальний слом», медианы там 0.40% и 0.44%.\n\nМИНУС ЗНАЧИТ РОВНО ОДНО: эта НЕЗАКРЫТАЯ свеча уже за порогом. Закроется так — тренд умрёт.\n\nПоломки здесь нет. Движок проверяет смерть только на ЗАКРЫТЫХ свечах, а табло пересчитывается каждый тик по текущей. Это ЕДИНСТВЕННАЯ клетка табло, которая смотрит ВПЕРЁД — и смотрит честно: говорит не «что будет», а «что уже есть на незакрытой свече».\n\nСмерть восходящего — это ход ВНИЗ." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 8, "баров от (0)", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров прошло от нуля ТЕКУЩЕГО счёта.\n\nОБНУЛЯЕТСЯ КАЖДЫМ ПРОДОЛЖЕНИЕМ: дошёл счёт до (5), пришёл HL — ноль переезжает на него, и отсчёт начинается заново. Поэтому тренд, прошедший весь путь трижды, по этой строке выглядит молодым.\n\nСколько раз он прошёл путь — строка «полных счётов» выше. Две строки читаются только вместе.\n\nВТОРОЕ ЧИСЛО, «всего» — ВОЗРАСТ ВСЕГО ТРЕНДА, от нуля ПЕРВОГО счёта. Продолжение его не обнуляет, поэтому разница между двумя числами и есть то, что тренд прожил сверх текущего круга.\n\nУ тренда без продолжений оба числа совпадают." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 9, "прошлая смерть", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров назад умер прошлый ВОСХОДЯЩИЙ тренд и на какой цене.\n\nСмерть восходящего — это ход ВНИЗ: тело свечи ушло ниже уровня на долю скользящего колена. Зеркало нисходящего, где смерть это ход вверх.\n\nЦВЕТ ячейки говорит, КУДА пошла цена: у восходящего смерть красная (ход вниз), у нисходящего зелёная (ход вверх). Красный берётся из настройки ⑥ «Смерть тренда», зелёный — из цвета восходящего тренда.\n\nСлово «слом» здесь не употребляется: оно значит ОДНО — цена взяла непробитый пивот слоя, блок ниже. Смерть тренда это другое событие, и путать их в одном табло нельзя (З35).")
        table.cell(TBL, 0, 10, "посл-ть", text_color = color.gray, text_size = tSz, tooltip = "Номер последовательности из справочника на девяти годах часовика, слой 2/2.\n\nВосходящий всегда начинается с LL — это ноль (0). В СПРАВОЧНИКЕ низы всегда HL, поэтому свободны только вершины, и вариантов ровно восемь.\n\nЗАМЕР Н39: «вне справ.» и «была манипуляция» — ОДНО И ТО ЖЕ СОБЫТИЕ, тождество. Счёт до (5) это три вершины и два низа; без манипуляции оба низа HL, и свободных комбинаций ровно восемь — столько же, сколько эталонов. Круг замкнут.\n\nПока счёт не дошёл до (5), показано, сколько эталонов ещё подходят.\n\nПродолжение отличается нулём: у него он HL, а не LL, и свои частоты.")

    // ── НИСХОДЯЩИЙ: те же девять строк, ячейка 1 ──
    // Цены в ней отрицательные — перевёрнутый мир. Всё, что идёт в
    // табло, переворачивается обратно знаком.
    if trTbl and blkDn
        [zlF, tlF, npF] = f_seqNow(P2n, B2n, H2n, L2n, 1)
        table.cell(TBL, 0, 11, "нисходящий", text_color = cTrDn, text_size = tSz, bgcolor = cBlkD, tooltip = "Нисходящий считается ТЕМ ЖЕ движком на перевёрнутых свечах. Второго набора правил не существует — зеркало точное по построению." + (mirDiff > 0 ? "\n\nВНИМАНИЕ: у нисходящего заведено ОТЛИЧИЙ от восходящего: " + str.tostring(mirDiff) + ". Зеркало как тождество больше не держится, и бесплатная проверка прогоном на перевёрнутых данных по этим строкам умерла." : "\n\nзеркало: цело — все правила нисходящего стоят на значениях восходящего."))
        table.cell(TBL, 1, 11, "2/2", text_color = cTrDn, text_size = tSz, bgcolor = cBlkD)
        int    sD   = array.get(tTR, 1)
        bool   livD = sD == ST_MAY or sD == ST_LIVE
        float  lvD  = array.get(tLVL, 1)
        float  legD = array.get(tLEG, 1)
        float  thrD = na(lvD) ? na : lvD - depthD * legD
        // З44, зеркало: та же ступень, тот же источник
        bool   zOnD = array.get(tONZ, 1)
        color  cD   = f_stColor(1, true)
        table.cell(TBL, 1, 12, f_stWord(1, true), text_color = cD, text_size = tSz, tooltip = f_stTip(1, true))
        int cntRawD = array.get(tCNT, 1)
        table.cell(TBL, 1, 13, sD == ST_ARC ? "(5)/5 ✓" : livD ? "(" + str.tostring(cntRawD) + ")/5" : "—", text_color = cD, text_size = tSz, tooltip = (sD == ST_ARC ? "АРХИВ. Счёт прошёл весь путь до (5) — галочка про это. Он остаётся на месте намеренно: это РЕЗУЛЬТАТ, а не «ничего нет».\n\n" : "") + "Счёт чередует колена от нуля. У нисходящего ноль — ВЕРШИНА HH, поэтому нечётная точка НИЗ, чётная ВЕРШИНА. Потолок пять. Встречная подпись счёт НЕ обрывает — она помечает точку как манипуляционную, и нога к ней рисуется штрих-пунктиром.\n\nПРЕДВАРИТЕЛЬНОГО КОЛЕНА (⋯) здесь не бывает: его брали у соседнего слоя, а у 2/2 соседа снизу нет.\n\nПОСЛЕ (5) РЕШАЕТ ПЕРВАЯ НОВАЯ ВЕРШИНА, и больше ничего: LH — ПРОДОЛЖЕНИЕ, счёт пойдёт с нуля на ней; HH — АРХИВ. Одно колено решает судьбу тренда.\n\nЭто зеркало восходящего, где после (5) решает первый новый НИЗ: HL продолжение, LL архив.")
        table.cell(TBL, 1, 14, livD or sD == ST_ARC ? str.tostring(array.get(tRST, 1)) : "—", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 1, 15, not livD ? "—" : na(lvD) ? "нет" : (array.get(tLHL, 1) ? "LH " : "HH ") + str.tostring(-lvD, format.mintick), text_color = livD and not na(lvD) ? (array.get(tLHL, 1) ? cTrDn : color.new(cTrDn, 45)) : color.gray, text_size = tSz)
        // ── НОВАЯ СТРОКА 16: ЧЕМ РУБИТСЯ СЕЙЧАС. З44, зеркало ──
        string rubD = not livD or na(lvD) ? "—" : zOnD ? "касанием " + str.tostring(-lvD, format.mintick) : "глубиной " + str.tostring(-thrD, format.mintick)
        table.cell(TBL, 1, 16, rubD, text_color = not livD or na(lvD) ? color.gray : zOnD ? color.orange : color.gray, text_size = tSz)
        // З44, зеркало. В перевёрнутом мире минимум свечи это −high,
        // поэтому на строгой ступени считается от МАКСИМУМА настоящей
        // свечи: в живых ценах это «уровень − максимум свечи»
        float zapD = na(lvD) ? na : zOnD ? -high - lvD : math.min(-open, -close) - thrD
        bool  negD = not na(zapD) and zapD < 0
        // З47. Процент от цены, как у восходящего. zapD это РАССТОЯНИЕ:
        // в перевёрнутом мире знак у него тот же, что у восходящего,
        // поэтому делится на НАСТОЯЩУЮ цену close, а не на -close
        string zapTxtD = na(zapD) or not livD ? "—" : str.tostring(zapD, format.mintick) + "  " + str.tostring(100 * zapD / close, "#.##") + "%"
        table.cell(TBL, 1, 17, zapTxtD, text_color = not livD ? color.gray : negD ? cTrDie : color.gray, text_size = tSz)
        string ageD = livD and array.get(tZB, 1) >= 0 ? str.tostring(last_bar_index - array.get(tZB, 1)) + (array.get(tZB0, 1) >= 0 ? "  ·  всего " + str.tostring(last_bar_index - array.get(tZB0, 1)) : "") : "—"
        table.cell(TBL, 1, 18, ageD, text_color = color.gray, text_size = tSz)
        dbD = array.get(tDB, 1)
        table.cell(TBL, 1, 19, dbD < 0 ? "—" : str.tostring(last_bar_index - dbD) + " / " + str.tostring(-array.get(tDP, 1), format.mintick), text_color = dbD < 0 ? color.gray : cTrUp, text_size = tSz)
        [mcN, miN, mnN] = f_matchS(tlF)
        bool rojdN = zlF == "LL"
        int fiN = miN >= 0 ? miN + (rojdN ? 0 : 8) : 0
        int frN = miN >= 0 and npF >= 5 ? array.get(SFR, fiN) : -1
        string nmD2 = mcN > 0 ? mnN : "вне справ."
        bool showsN = livD or sD == ST_ARC
        string cellN = not showsN ? "—" : npF < 5 ? (mcN <= 3 ? nmD2 : str.tostring(mcN) + " вар.") : nmD2
        string tipN = not showsN ? "Тренда нет." : "Слой 2/2, " + (rojdN ? "РОЖДЕНИЕ, ноль HH" : "ПРОДОЛЖЕНИЕ, ноль LH") + "\n\nсейчас на графике:  " + f_swap1(zlF) + (npF > 0 ? "·" + f_swapSeq(tlF) : "") + "\n" + (mcN == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВ нисходящем все восемь требуют LH на местах (2) и (4) — значит вершина оказалась HH, была МАНИПУЛЯЦИЯ. Это тождество, замер Н39." : npF < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mcN) + " из 8 — " + mnN : "это " + mnN + ", за 9 лет часовика встретилась " + str.tostring(frN) + " раз") + "\n\nНумерация ЗЕРКАЛЬНАЯ: С1 это зеркало П1."
        table.cell(TBL, 1, 20, cellN, text_color = showsN ? (mcN == 0 ? color.orange : npF >= 5 ? cTrDn : color.gray) : color.gray, text_size = tSz, tooltip = tipN)
        table.cell(TBL, 0, 12, "состояние", text_color = color.gray, text_size = tSz, tooltip = "Чем кончилось: умер · архив · не было · нет. Плюс два живых: возможен и НИСХ.\n\nЗЕРКАЛО СТРОКИ ВОСХОДЯЩЕГО, и слова те же. Меняются только метки: ноль у нисходящего HH, подтверждает его LH, в архив отправляет HH.\n\nСлова «переход» здесь нет и не будет — решение владельца 07.10.2026.\n\nСлова «не свой» здесь тоже нет: ОТКАЗ случался, когда слою не хватало чужих колен, а у 2/2 чужих колен не бывает.")
        table.cell(TBL, 0, 13, "счёт", text_color = color.gray, text_size = tSz, tooltip = "Счёт чередует колена от нуля. Потолок пять.\n\nУ НИСХОДЯЩЕГО ноль — вершина HH, поэтому нечётная точка НИЗ, чётная ВЕРШИНА, и (5) всегда низ.\n\nВстречная подпись счёт НЕ обрывает — она помечает точку как манипуляционную, и нога к ней рисуется штрих-пунктиром.\n\nСЧЁТ ИДЁТ ПО КОЛЕНАМ, А НЕ ПО БАРАМ: если одна свеча сделала и вершину, и низ, то колен два и номера два. Замечание З41.\n\nЧто означает каждое состояние счёта — наведите на само значение справа." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 14, "полных счётов", text_color = color.gray, text_size = tSz, tooltip = "Сколько раз ЭТОТ тренд дошёл до (5) и продолжился, не умирая.\n\n0 — тренд молодой, ни разу не прошёл весь путь. 3 — трижды отработал и жив до сих пор. Такой тренд не просто жив, он СИЛЁН, а по остальным строкам табло отличить его от молодого нельзя.\n\nПродолжение идёт цепочкой: (5) → LH → новый счёт с нуля на этой LH → (5) → LH → … Это ОДИН тренд, а на графике видно только последний счёт и один бледный перед ним.\n\nОбнуляется вместе с трендом: при смерти, отмене и архиве." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 15, "уровень", text_color = color.gray, text_size = tSz, tooltip = "Последняя появившаяся ВЕРШИНА от нуля — ЛЮБОЙ подписи, не только LH. Замена безусловная, храповика нет.\n\nТРИ ВИДА ЛИНИИ, и по ней видно, чем тренд рубится:\n· ТОЧКИ — уровень на САМОМ НУЛЕ, ни одной вершины ещё не было. Рубится КАСАНИЕМ сверху, без буфера → «тренда не было»;\n· ШТРИХ-ПУНКТИР — уровень съехал на МАНИПУЛЯЦИОННУЮ вершину. Держит: рубится глубиной по телу → «умер»;\n· СПЛОШНАЯ с подписью — уровень на LH, настоящая опора. Тоже глубиной.\n\nВ ячейке стоит подпись того колена, на котором уровень сейчас: LH у настоящей опоры. HH стоит в ДВУХ РАЗНЫХ случаях — когда уровень съехал на манипуляционную вершину (держит) и когда он ещё на самом нуле (не держит). Отличает их ЛИНИЯ: штрих-пунктир против точек." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 16, "рубится", text_color = color.gray, text_size = tSz, tooltip = "ЧЕМ ТРЕНД РУБИТСЯ ПРЯМО СЕЙЧАС, и по какой цене. Строка добавлена 15.10.2026, замечание З44, шаг Т4.\n\n· КАСАНИЕМ — опора стоит на САМОМ НУЛЕ, то есть на вершине HH, ступень СТРОГАЯ. Цена дошла до названной цифры снизу — «тренда не было», разметка стирается без следа. Запаса нет вовсе, и меряется МАКСИМУМОМ свечи: на строгой ступени тень рубит;\n· ГЛУБИНОЙ — опора съехала с нуля, ступень МЯГКАЯ. Рубит ТЕЛО свечи выше названной цифры, то есть уровень плюс " + str.tostring(depthD) + " скользящего колена. Тень тут НЕ убивает — замер Н28.\n\nЦИФРА РЯДОМ — ТА САМАЯ ЦЕНА, на которой это случится. Смерть нисходящего — это ход ВВЕРХ.\n\nНА ГРАФИКЕ ЭТО И РАНЬШЕ БЫЛО ВИДНО — по форме линии уровня: точки рубятся касанием, штрих-пунктир и сплошная глубиной.\n\nОРАНЖЕВЫЙ ЦВЕТ значит строгую ступень: в этот момент тренд самый хрупкий. Этим кончается треть счётов нисходящего — замер Н36." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 17, "запас " + str.tostring(depthD) + " кол.", text_color = color.gray, text_size = tSz, tooltip = (zOnD ? "СЕЙЧАС РАБОТАЕТ СТРОГАЯ СТУПЕНЬ — опора стоит на САМОМ НУЛЕ, то есть на вершине HH, и здесь стоит расстояние ДО КАСАНИЯ:\n   запас = уровень − максимум свечи\n\nМеряется МАКСИМУМОМ, а не телом: на строгой ступени тень рубит. Дошло до нуля — «тренда не было», разметка стирается.\n\nПОДПИСЬ СТРОКИ ПРИ ЭТОМ ПО-ПРЕЖНЕМУ НАЗЫВАЕТ " + str.tostring(depthD) + " КОЛЕНА — это про МЯГКУЮ ступень, она включится, когда опора съедет с нуля. Какая ступень работает сейчас, пишет строка «рубится» выше.\n\n" : "Сколько осталось телу свечи до порога смерти:\n   запас = (уровень + " + str.tostring(depthD) + " × скользящее колено) − max(открытие, закрытие)\n\n") + "ПРОЦЕНТ РЯДОМ — то же расстояние, но от цены: столько цена может пройти, прежде чем тренд умрёт. Та же мерка, что в строках «ближе слом» и «дальний слом», медианы там 0.40% и 0.44%.\n\nМИНУС ЗНАЧИТ РОВНО ОДНО: эта НЕЗАКРЫТАЯ свеча уже за порогом. Закроется так — тренд умрёт.\n\nПоломки здесь нет. Движок проверяет смерть только на ЗАКРЫТЫХ свечах, а табло пересчитывается каждый тик по текущей. Это ЕДИНСТВЕННАЯ клетка табло, которая смотрит ВПЕРЁД — и смотрит честно: говорит не «что будет», а «что уже есть на незакрытой свече».\n\nСмерть нисходящего — это ход ВВЕРХ." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 18, "баров от (0)", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров прошло от нуля ТЕКУЩЕГО счёта.\n\nОБНУЛЯЕТСЯ КАЖДЫМ ПРОДОЛЖЕНИЕМ: дошёл счёт до (5), пришла LH — ноль переезжает на неё, и отсчёт начинается заново. Поэтому тренд, прошедший весь путь трижды, по этой строке выглядит молодым.\n\nСколько раз он прошёл путь — строка «полных счётов» выше. Две строки читаются только вместе.\n\nВТОРОЕ ЧИСЛО, «всего» — ВОЗРАСТ ВСЕГО ТРЕНДА, от нуля ПЕРВОГО счёта. Продолжение его не обнуляет, поэтому разница между двумя числами и есть то, что тренд прожил сверх текущего круга.\n\nУ тренда без продолжений оба числа совпадают." + "\n\nЗЕРКАЛО: движок у двух направлений ОДИН, нисходящий считается тем же кодом на перевёрнутых свечах. Эта строка у обоих блоков говорит об одном и том же, словами своей стороны.")
        table.cell(TBL, 0, 19, "прошлая смерть", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров назад умер прошлый НИСХОДЯЩИЙ тренд и на какой цене.\n\nСмерть нисходящего — это ход ВВЕРХ: тело свечи ушло выше уровня на долю скользящего колена. Зеркало восходящего, где смерть это ход вниз.\n\nЦВЕТ ячейки говорит, КУДА пошла цена: у нисходящего смерть зелёная (ход вверх), у восходящего красная (ход вниз). Зелёный берётся из цвета восходящего тренда, красный — из настройки ⑥ «Смерть тренда».\n\nСлово «слом» здесь не употребляется: оно значит ОДНО — цена взяла непробитый пивот слоя, блок ниже. Смерть тренда это другое событие, и путать их в одном табло нельзя (З35).")
        table.cell(TBL, 0, 20, "посл-ть", text_color = color.gray, text_size = tSz, tooltip = "Номер последовательности из справочника нисходящего, перепись девяти лет часовика, слой 2/2.\n\nНисходящий всегда начинается с HH — это ноль (0). В СПРАВОЧНИКЕ вершины всегда LH, поэтому свободны только низы, и вариантов ровно восемь.\n\nКак и у восходящего: счёт с манипуляционной вершиной HH живёт дальше, но ни одному эталону не соответствует и получает «вне справ.». Это тождество, Н39.")

    // ── СЛОМЫ В ТАБЛО: ЗАГОЛОВОК плюс три строки ──
    //
    // ЗАГОЛОВОК ДОБАВЛЕН 13.10.2026, шаг Т1. Слово владельца: «хочу
    // как-то выделить таблицу, где восходящий, где нисходящий… заметил,
    // что есть отличия между трендами по строкам».
    //
    // Отличий в подписях НЕ БЫЛО: девять строк у каждого тренда, слово в
    // слово, в том же порядке. Разницу создавал ЭТОТ блок — три строки
    // сломов стояли вплотную под нисходящим, без заголовка, и читались
    // как его продолжение. Опись всех строк — indicator/ТАБЛО.md
    //
    // Слом не принадлежит ни одному тренду: это цена взяла ближайший
    // непробитый пивот слоя. Со смертью тренда его путать нельзя — З35
    if slOn and blkSl
        table.cell(TBL, 0, 21, "сломы", text_color = color.gray, text_size = tSz, bgcolor = cBlkS, tooltip = "ТРЕТИЙ БЛОК ТАБЛО, и он не принадлежит ни восходящему, ни нисходящему.\n\nСЛОМ — это когда цена взяла ближайший НЕПРОБИТЫЙ пивот слоя, по касанию. Он считается по самим коленам и живёт независимо от того, есть ли сейчас тренд и какой.\n\nСО СМЕРТЬЮ ТРЕНДА НЕ ПУТАТЬ: смерть это тело свечи за уровнем тренда на долю скользящего колена, и она лежит в строке «прошлая смерть» каждого из двух блоков выше. Два разных события, З35.\n\nБлок выключается галочкой «сломы» в ⑤.")
        table.cell(TBL, 1, 21, "2/2", text_color = color.gray, text_size = tSz, bgcolor = cBlkS)
        table.cell(TBL, 0, 22, "сломов подряд", text_color = color.gray, text_size = tSz, tooltip = "Сколько сломов подряд ушло в одну сторону. Слом — цена взяла ближайший непробитый пивот слоя, по касанию.\n\nПотолка у этого счёта нет: за девять лет серии доходили до 16-24 сломов.\n\nЧЕГО СТОИТ САМА СЕРИЯ. При РАВНЫХ расстояниях до уровней надбавка +7.3 процентного пункта — медиана по клеткам, 9 из 10 положительных, замер Н17 на 2/2.\n\nПрежний замер Н14 давал +7…+20, и он был ЗАВЫШЕН ПРИМЕРНО ВДВОЕ: половина эффекта оказалась географией, а не серией. Это ошибка ассистента, исправлена замером Н17.\n\nСходится ли серия с географией — строка «серия и уровни» ниже.")
        table.cell(TBL, 0, 23, "последний слом", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров назад случился последний слом и на какой цене.")
        table.cell(TBL, 0, 24, "ближе слом", text_color = color.gray, text_size = tSz, tooltip = "СВЕРХУ или СНИЗУ — с какой стороны от цены стоит ближайший непробитый уровень слоя, то есть куда случится следующий слом. Это НЕ тренд: блок сломов не принадлежит ни одному из них.\n\nЗдесь тот из двух уровней, что БЛИЖЕ к цене, и сколько до него в процентах. Второй, встречный, стоит строкой ниже.\n\nЧЕГО ЭТО СТОИТ. Замер Н17, девять лет часовика, 4413 пар «слом → следующий слом» на 2/2: когда верхний уровень намного ближе, слом вверх случается в 72.8% случаев; когда намного ближе нижний — в 31.1%. Размах 41.7 процентного пункта.\n\nЭто САМЫЙ СИЛЬНЫЙ признак, какой в проекте измерен. Серия сломов — второй, независимый, но слабее примерно в шесть раз.\n\nМедианы расстояний за девять лет на 2/2: сверху 0.40%, снизу 0.44%.")
        table.cell(TBL, 0, 25, "дальний слом", text_color = color.gray, text_size = tSz, tooltip = "Тот из двух ближайших непробитых уровней, что ДАЛЬШЕ от цены — встречный к строке выше.\n\nЗАЧЕМ ОН ЗДЕСЬ. «Ближе слом» одна не говорит, ближний он с перевесом в волосок или вдесятеро. 0.28% сверху при 2.80% снизу — цена у одного крючка, второй далеко. 0.20% при 0.80% — цена ЗАЖАТА между двумя. Два числа сравниваются глазами, делить не надо.\n\nПРОЧЕРК значит, что с этой стороны живого непробитого уровня НЕТ вовсе. На растущем рынке так бывает сверху: непробитые вершины исчезают, непробитые низы копятся.\n\nУровень умирает ПО КАСАНИЮ: вершина когда её тронул максимум свечи, низ когда минимум. Значит показанная цена — спусковой крючок, а не «примерно».\n\nСтрока добавлена 15.10.2026, замечание З12. Оно висело с 23.09: «добавить строку с отношением расстояний».")
        table.cell(TBL, 0, 26, "серия и уровни", text_color = color.gray, text_size = tSz, tooltip = "СВЯЗЫВАЕТ БЛОК: смотрят ли серия сломов и география в одну сторону.\n\n· согласны — серия идёт вверх, и ближайший уровень тоже сверху. Или всё наоборот, вниз;\n· спорят — серия идёт вверх, а ближе оказался НИЖНИЙ уровень;\n· прочерк — серии ещё нет, или с одной стороны живого уровня нет.\n\nТО ЖЕ ВИДНО ЦВЕТОМ, и было видно всегда: строки «сломов подряд» и «ближе слом» красятся из одной пары цветов. Один цвет — согласны, разные — спорят. Эта строка называет словами то, что цвет говорил и раньше.\n\nЧЕГО ЭТО СТОИТ. Замер Н17, пункт 4: серия говорит ГРОМЧЕ ВСЕГО, когда спорит с расстоянием. Надбавка +8.9…+11.5 процентного пункта на 3/3 и 2/2, против +7.3 при равных расстояниях. Клетки там тоньше, поэтому вывод осторожный.\n\nОРАНЖЕВЫЙ у «спорят» значит не «плохо», а «самое заметное состояние блока» — тот же смысл, что у оранжевого в «вне справ.» и в «рубится касанием».\n\nСтрока НИЧЕГО НЕ ПРЕДСКАЗЫВАЕТ: она описывает, что есть сейчас. Числа — про «потом», и потому стоят здесь, в подсказке, а не в табло. Решение владельца 06.10.2026: «он предсказывает, а в торговле это плохо».")
        int dr = array.get(sDIR, 0)
        int rn = array.get(sRUN, 0)
        color cS = dr > 0 ? cSlUp : dr < 0 ? cSlDn : color.gray
        table.cell(TBL, 1, 22, dr == 0 ? "—" : (dr > 0 ? "↑" : "↓") + str.tostring(rn), text_color = cS, text_size = tSz)
        int lbS = array.get(sLB, 0)
        table.cell(TBL, 1, 23, lbS < 0 ? "—" : str.tostring(last_bar_index - lbS) + " / " + str.tostring(array.get(sLP, 0), format.mintick), text_color = color.gray, text_size = tSz)
        float du = na(mUp) ? 1.0e18 : mUp - close
        float dd = na(mDn) ? 1.0e18 : close - mDn
        string nearTxt = "—"
        color  nearCol = color.gray
        if du < dd
            nearTxt := "сверху " + str.tostring(mUp, format.mintick) + "  " + str.tostring(100 * du / close, "#.##") + "%"
            nearCol := cSlUp
        else if dd < 1.0e17
            nearTxt := "снизу " + str.tostring(mDn, format.mintick) + "  " + str.tostring(100 * dd / close, "#.##") + "%"
            nearCol := cSlDn
        table.cell(TBL, 1, 24, nearTxt, text_color = nearCol, text_size = tSz)
        // ── ДАЛЬНИЙ СЛОМ, строка 25. Замечание З12, висело с 23.09.2026 ──
        //
        // Строка «ближе слом» одна не говорит, ближний он с перевесом в
        // волосок или вдесятеро. Отношение владелец читать не стал —
        // форма «×10» провалила проверку чтением 15.10. Поэтому не
        // отношение, а ВТОРОЕ ЧИСЛО: сравнивается глазами, делить нечего
        string farTxt = "—"
        color  farCol = color.gray
        bool   bothOk = not na(mUp) and not na(mDn)
        if bothOk
            if du < dd
                farTxt := "снизу " + str.tostring(mDn, format.mintick) + "  " + str.tostring(100 * dd / close, "#.##") + "%"
                farCol := cSlDn
            else
                farTxt := "сверху " + str.tostring(mUp, format.mintick) + "  " + str.tostring(100 * du / close, "#.##") + "%"
                farCol := cSlUp
        table.cell(TBL, 1, 25, farTxt, text_color = farCol, text_size = tSz)
        // ── СЕРИЯ И УРОВНИ, строка 26. Связывает блок ──
        //
        // Слово владельца 15.10.2026: «интуитивно чего-то не хватает
        // какого-то показателя, чтобы этот блок был полноценным... нужно
        // сюда добавить строку сломов подряд, чтобы они были
        // взаимосвязаны». Связь эта УЖЕ БЫЛА НА ЭКРАНЕ цветом — строки
        // «сломов подряд» и «ближе слом» красятся из одной пары цветов,
        // — но её ни разу не назвали словами. Эта строка называет.
        //
        // Замер Н17, пункт 4: серия говорит ГРОМЧЕ ВСЕГО, когда спорит с
        // расстоянием. Числа — в подсказке: в табло только то, что
        // описывает СЕЙЧАС, решение владельца 06.10.2026
        int    geoDir = bothOk ? (du < dd ? 1 : -1) : 0
        string relTxt = "—"
        color  relCol = color.gray
        if dr != 0 and geoDir != 0
            bool agree = (dr > 0) == (geoDir > 0)
            relTxt := agree ? "согласны" : "спорят"
            relCol := agree ? (dr > 0 ? cSlUp : cSlDn) : color.orange
        table.cell(TBL, 1, 26, relTxt, text_color = relCol, text_size = tSz)
