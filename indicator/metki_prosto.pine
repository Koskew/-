//@version=5
// ═══════════════════════════════════════════════════════════════════
// МЕТКИ — только структура. Три слоя на выбор
//
// Метки HH / LH / HL / LL на трёх слоях: 5/5, 3/3, 2/2. Каждый
// включается отдельно, и у КАЖДОГО свои штрих-линии по своей глубине.
// Уровни 4H и 1D — общие, один набор на всех.
//
// Здесь ЕСТЬ, кроме самой разметки: восходящий И нисходящий тренды на
// трёх слоях со счётом (0)-(5), уровнем, смертью и сломами; два
// справочника последовательностей — П для роста, С для спуска; счёт по
// СЛОМАМ с частотами за девять лет; табло на двадцать три строки.
//
// 23.09.2026 добавлен НИСХОДЯЩИЙ тренд. Своего кода у него нет: это тот
// же движок на ПЕРЕВЁРНУТЫХ коленах — минус-цена, сторона наоборот.
// Второго набора правил не существует, зеркало точное по построению.
//
// Здесь НЕТ: боковика, мутного, триггерных свечей, входов и риска.
//
// Строка выше до 23.09.2026 говорила, что здесь нет ни счёта, ни тренда,
// ни таблицы. Это было верно, когда файл начинался, и перестало быть
// верным ещё в сентябре.
//
// ── ДВА ПРАВИЛА, КОТОРЫЕ ЗДЕСЬ ГЛАВНЫЕ ──
//
// 1. МЕТКА не пропадает никогда. Подпись HH/LH/HL/LL остаётся на своём
//    месте, что бы цена дальше ни делала.
//
// 2. ЛИНИЯ от метки живёт, пока цена её не коснулась. Коснулась —
//    линия УДАЛЯЕТСЯ совсем. Механизм взят из Тренажёра v9 один в один:
//    уровень это СЫРОЙ ПИВОТ со своей ценой, лежит в массиве, при
//    касании вычёркивается.
//
//    Раньше я брал уровень из КОЛЕНА. Колено при слиянии переезжает на
//    новый экстремум, и я вместе с ценой сбрасывал флаг перебития —
//    линия оживала. Сырые пивоты не переезжают, поэтому пробитый
//    уровень мёртв навсегда.
//
// ── ДОРИСОВКА ──
// Слой может не увидеть разворот вовсе: между двумя своими коленами он
// идёт прямой, хотя внутри был отскок. Такой участок дорисовывается
// коленами более быстрого слоя, рисуется ШТРИХ-ПУНКТИРОМ, а метка
// ставится сырая, с точкой спереди: ·LH. 5/5 берёт у 3/3, 3/3 у 2/2.
// ═══════════════════════════════════════════════════════════════════
indicator("МЕТКИ", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 3000)

gA = "① Слои"
on5    = input.bool(false, "5/5", inline = "s", group = gA)
on3    = input.bool(true,  "3/3", inline = "s", group = gA)
on2    = input.bool(false, "2/2", inline = "s", group = gA)
labWho = input.string("3/3", "Чьи метки подписывать", options = ["5/5", "3/3", "2/2", "все", "никто"], group = gA, tooltip = "Подписи слоёв накладываются друг на друга, поэтому обычно подписывают один. Остальные видно зиг-загом.")
showZZ = input.bool(true,  "Зиг-заг по коленам", group = gA)
winBars= input.int(400, "Рисовать за последние N баров", minval = 100, maxval = 2000, group = gA, tooltip = "Чем больше окно и чем больше слоёв включено, тем ближе к пределу TradingView в 500 линий. Если разметка обрывается — уменьшите окно или выключите лишний слой.")

gB = "② Штрих-линии слоёв"
lvOn   = input.bool(true, "Показывать линии слоёв", group = gB, tooltip = "У каждого включённого слоя свои линии, по его собственной глубине. Линия живёт, пока цена её не коснулась; коснулась — пропадает совсем. Сама метка при этом остаётся.")
lvLH   = input.bool(true, "Линии для LH и HL тоже", group = gB, tooltip = "HH и LL — пунктир, LH и HL — точки.")
lv_n   = input.int(3, "Ближайших к цене с каждой стороны", minval = 1, maxval = 10, group = gB)
lvTr   = input.int(45, "Прозрачность линий", minval = 0, maxval = 90, group = gB)
absOn  = input.bool(true, "Показывать поглощённые метки", group = gB, tooltip = "Когда два пивота одной стороны идут подряд, они схлопываются в одно колено, и подпись проигравшего прежде исчезала с графика. Теперь она остаётся на своём месте — бледная, мелкая, с короткой точкой на своём уровне. Это самая частая подрисовка: около 21% колен. Линии уровня у неё нет, только метка.")
fillOn = input.bool(true, "Дорисовывать пропущенные колена", group = gB, tooltip = "Слой может не увидеть разворот вовсе. Тогда участок дорисовывается коленами более быстрого слоя, рисуется ШТРИХ-ПУНКТИРОМ, метка ставится сырая с точкой спереди. 5/5 берёт у 3/3, 3/3 у 2/2. У 2/2 более быстрого слоя нет.")
fillLv = input.bool(true, "Линии и у дорисованных меток", group = gB, tooltip = "Сырая метка получает свою линию по тем же правилам: пока цена её не коснулась — тянется вправо, коснулась — пропадает. Живость проверяется по слою, откуда метка одолжена.")

gT = "③ Тренд"
trOn5  = input.bool(true, "Считать восходящий тренд", group = gT, tooltip = "Считается СРАЗУ ПО ТРЁМ слоям, независимо. В табло три колонки. На графике рисуется тот слой, который включён в ①; если включено несколько — самый медленный из них.\n\nПервое из пяти состояний. Ноль счёта ставится на низ перед первой HH; если прошлый тренд был восходящий и дошёл до (3) и дальше, нулём может быть HL — продолжение. Счёт чередует колена от нуля: нечётная точка вершина, чётная низ. Встречная подпись счёт НЕ обрывает, она помечает точку как манипуляционную.")
trDeath = input.string("имп × 0.33", "Чем убивается тренд", options = ["имп × 0.33", "4 закрытия ниже", "оба", "любое"], group = gT, tooltip = "Замер Н7 на 9 годах: правила НЕРАЗЛИЧИМЫ, знак разницы меняется между слоями, полторы сигмы. Выбирать глазами. «оба» — нужны оба сразу, «любое» — кто первый.")
trFib   = input.float(0.33, "Глубина, импульсов", 0.0, 1.0, 0.01, group = gT)
trNbar  = input.int(4, "Свечей подряд ниже уровня", 1, 10, group = gT, tooltip = "Слово владельца: четыре подряд, считая от первой, которая закрылась ниже уровня. Считается по ЗАКРЫТИЮ — прочтение «всё тело ниже» замер отклонил, оно хуже во всём.")
trNum   = input.bool(true, "Номера точек (0)-(5)", group = gT)
trShow5 = input.bool(false, "Показывать 5/5 поверх, как контекст", group = gT, tooltip = "Насильно показывает слой 5/5, даже если он выключен в ①. По умолчанию ВЫКЛЮЧЕНО: раньше этот флаг стоял включённым и накладывал весь слой 5/5 поверх рабочего слоя — от этого метки на графике смазывались. Включать, только если хочется видеть крупную структуру рядом с мелкой.")
trFull  = input.bool(true, "У слоя 5/5 показывать всё остальное", group = gT, tooltip = "Когда 5/5 включён только ради счёта тренда, у него по умолчанию видны лишь зиг-заг и колена счёта. Этот флаг возвращает остальное: штрих-пунктирные линии слоя 5/5, поглощённые метки и одолженные сырые метки ·LH. Если поверх вашего рабочего слоя это мешает — снять флаг, останется только счёт.")
trTbl   = input.bool(true, "Табло состояния", group = gT, tooltip = "Что движки думают прямо сейчас. Три колонки — 5/5, 3/3, 2/2, — считаются независимо друг от друга.\n\nВерхние девять строк про восходящий тренд: состояние, счёт, уровень, запас до смерти, закрытия ниже, возраст счёта, прошлый слом, номер последовательности.\n\nНижние пять — про сломы: серия, последний слом, две цены впереди и частота из замера Н14.")
trBrk   = input.string("HL", "Чем подтверждается зелёный слом", options = ["HL", "имп × 0.33", "4 закрытия выше"], group = gT, tooltip = "Зелёный слом — это слом НИСХОДЯЩЕЙ структуры: цена от LL перебила вершину и сделала HH. Чёрточка появляется СРАЗУ, на цене перебитой вершины. До подтверждения зиг-заг счёта рисуется ТОНКИМ, после — толстым.\n\nЧем подтверждать:\n· HL — пришёл первый HL после HH. Структурно, в том же языке, что и весь слой;\n· имп × 0.33 — цена ушла выше перебитой вершины на треть импульса;\n· 4 закрытия выше — столько же закрытий подряд, сколько стоит в поле «Свечей подряд ниже уровня».\n\nКакое лучше — не проверено. Замер будет, когда линия поживёт на графике.\n\nВАЖНО: нисходящий тренд движком НЕ считается. Зелёная линия отмечает только сам факт «структуру сломали вверх».")
cTrUp   = input.color(#00c853, "Восходящий: метки, счёт, уровень", group = gT)
cTrDie  = input.color(#ff1744, "Слом", group = gT)

gD = "④ Уровни 4H и 1D — общие"
hOn    = input.bool(true, "Показывать", inline = "h", group = gD)
h_tf4  = input.bool(true, "4H",         inline = "h", group = gD)
h_tfd  = input.bool(true, "1D",         inline = "h", group = gD)
hLB    = input.int(3, "Глубина пивота старших ТФ", minval = 1, maxval = 8, group = gD)
cHiH   = input.color(color.green, "верх / низ", inline = "hc", group = gD)
cLoH   = input.color(color.red,   "",           inline = "hc", group = gD)

gC = "⑤ Цвета слоёв"
c5H = input.color(#ff6d00, "5/5  вершина / низ", inline = "c5", group = gC)
c5L = input.color(#ffab40, "",                   inline = "c5", group = gC)
c3H = input.color(#e0342c, "3/3  вершина / низ", inline = "c3", group = gC)
c3L = input.color(#00b050, "",                   inline = "c3", group = gC)
c2H = input.color(#7e57c2, "2/2  вершина / низ", inline = "c2", group = gC)
c2L = input.color(#4fc3f7, "",                   inline = "c2", group = gC)
zzW = input.int(1, "Толщина зиг-зага", minval = 1, maxval = 4, group = gC)

gS = "⑥ Сломы"
slOn   = input.bool(true, "Считать сломы", group = gS, tooltip = "Слом — цена взяла ближайший НЕПРОБИТЫЙ пивот слоя. Это тот самый момент, когда живой уровень из ② перестаёт быть живым: механизм работал с самого начала, его просто не считали и не называли.\n\nКолено становится известно задним числом: на 2/2 через два бара, на 5/5 через пять. Слом известен ЗАРАНЕЕ — цена, которую надо пробить, уже нарисована на графике.\n\nЗамер Н14 на девяти годах часовика: сломы НЕ независимы, они слипаются. После серии в одну сторону следующий идёт туда же чаще собственной базовой доли на 7-20 процентных пунктов. Тридцать клеток, все положительные, знак держится в обеих половинах выборки, перемешанный контроль садится в ноль.\n\nСчитаются все четыре метки — HH, LH, HL, LL. Слом засчитывается по КАСАНИЮ: хватает тени. Замер сделан по тому же правилу, поэтому частоты в табло относятся именно к касанию.")
slLine = input.bool(true, "Линии ближайших сломов", group = gS, tooltip = "Ближайший непробитый уровень сверху и снизу рисуется толще остальных и получает подпись с ценой и расстоянием в процентах. Это две цены, между которыми сейчас находится рынок, и обе видны заранее.\n\nОстальные живые уровни из ② остаются как были.")
slNum  = input.bool(true, "Номера серии на графике", group = gS, tooltip = "На каждом сломе ТЕКУЩЕЙ серии встаёт метка с его номером: ↑1, ↑2, ↑3. Сменилось направление — счёт с единицы, метки прошлой серии стираются.\n\nПрошлые серии не рисуются намеренно: на 2/2 слом случается раз в 5.4 бара, и вся история в окне превратилась бы в кашу.")
slTbl  = input.bool(true, "Блок сломов в табло", group = gS)
slNoCap= input.bool(true, "Счёт без потолка", group = gS, tooltip = "У счёта по коленам потолок пять. У сломов серии доходят до 16-24, и потолок отрезал бы самые длинные десять процентов. Поэтому счёт растёт, сколько идёт.\n\nЧастота в табло для всего, что длиннее пяти, берётся из клетки «5 и больше».")
cSlUp  = input.color(#26a69a, "Слом вверх / вниз", inline = "cs", group = gS)
cSlDn  = input.color(#ef5350, "",                  inline = "cs", group = gS)

gN = "⑦ Нисходящий"
trDn   = input.bool(true, "Считать нисходящий тренд", group = gN, tooltip = "Нисходящий считается ТЕМ ЖЕ движком на ПЕРЕВЁРНУТЫХ свечах. Идея владельца 22.09.2026: не переводить сорок правил руками, а перевернуть цены. Перевёрнутая свеча — знак меняется, максимум и минимум местами. Тогда пивот-вершина на перевёрнутых это пивот-низ на настоящих, HH это LL, HL это LH, а ВОСХОДЯЩИЙ на перевёрнутых это НИСХОДЯЩИЙ на настоящих.\n\nВторого набора правил не существует: зеркало точное по построению, а не потому, что я аккуратно переписал условия.\n\nПроверено на девяти годах часовика: 519 трендов на 5/5, 806 на 3/3, 1131 на 2/2. Падений больше числом и короче по жизни, чем ростов, — ровно та форма, которую обязан дать растущий рынок. Покрытие баров хоть каким-то трендом выросло с 60% до 93%.")
trWho  = input.string("авто", "Какой тренд рисовать", options = ["авто", "только восходящий", "только нисходящий"], group = gN, tooltip = "Колена у обоих трендов ОДНИ И ТЕ ЖЕ — один зиг-заг, те же бары, те же цены. Отличается только прочтение. Поэтому одна нога не может быть двух цветов, а одно колено не может нести два номера.\n\nЗамер на девяти годах: оба движка живы одновременно 19.5% баров на 5/5, 21.9% на 3/3, 21.8% на 2/2. Кусками по 7-14 баров медианно, до ста подряд. Это пятая часть времени, не краевой случай.\n\n«авто» — рисуется тот, кто жив. Живы оба — тот, чей НОЛЬ БЛИЖЕ к сегодняшнему дню: свежая структура это то, что рынок строит сейчас, старая уже контекст и всё равно видна в табло.\n\nОстальные два варианта — чтобы сравнить глазами.")
trCntSw= input.string("весь, набранный в фоне", "Счёт при переключении", options = ["весь, набранный в фоне", "фоновую часть бледнее", "только с момента переключения"], group = gN, tooltip = "Только для режима «авто». Движок НЕ трогается: оба направления считают всегда, как считали. Меняется только то, какие номера счёта видит глаз.\n\nЗачем: когда «авто» переключается на другой тренд, тот появляется уже со счётом, набранным пока был невидим — сразу (2) или (3). Эта настройка позволяет посмотреть глазами, много ли счёта пришло из невидимой части.\n\n· «весь, набранный в фоне» — как было всегда, ничего не меняется;\n· «фоновую часть бледнее» — номера, набранные до переключения, показаны бледными. Видно и их, и границу;\n· «только с момента переключения» — номера до переключения не показываются вовсе, подписи меток остаются. Это ближе всего к тому, как выглядел бы тренд, если бы начинал счёт с нуля в момент переключения.")
swMark = input.bool(true, "Отмечать, где авто передумало", group = gN, tooltip = "Метка ⇄ на баре, где режим «авто» сменил рисуемый тренд. Показываются все переключения основного слоя, попавшие в окно.")
cTrDn  = input.color(#ff1744, "Нисходящий: метки, счёт, уровень", group = gN)

gV = "⑧ Вставки в колена 5/5 и 3/3"
// 30.09.2026, слово владельца: «не отдельным разделом в настройки, а
// обязательным условием для нисходящего и восходящего тренда».
//
// Вставки вошли ВНУТРЬ колен слоёв 5/5 и 3/3. Второго комплекта больше
// нет: галочка «Второй комплект», переключатель «Какой счёт рисовать» и
// четыре строки табло «+» убраны как дубликат — по его же слову
// «убирай второй комплект».
//
// Вставка выглядит как ОБЫЧНОЕ колено: без точки, без штрих-пунктира.
// Тоже его решение, 30.09.2026.
//
// Доза задаётся ручкой ниже. Положение «0» в точности воспроизводит
// прежние колена без вставок — прежнее поведение никуда не делось.
vsCap  = input.string("1", "Вставок в одну ногу", options = ["0", "1", "2", "без ограничения"], group = gV, tooltip = "Сколько сырых вставок пускать в КОЛЕНА слоя внутри одной ноги. По ним потом считается всё: счёт, уровень, смерть, зиг-заг, справочник.\n\n· 0 — вставок нет, колена ровно те же, что были до 30.09.2026. Это способ вернуть прежнее поведение;\n· 1 — берётся только ПЕРВАЯ вставка в ноге. Слой видит разворот, который проспал, но не дробится на мелочь;\n· 2 — чуть подробнее;\n· без ограничения — слой становится почти слоем-донором. Замер Н20: 737 трендов против 736 у чистого 3/3.\n\nЧем больше доза, тем ближе 5/5 к 3/3, а 3/3 к 2/2. Это арифметика, а не настройка вкуса: пивот 5/5 — всегда и пивот 3/3.\n\nЦЕНА, замер Н20: доля счётов, чья форма находится в справочнике П и С, падает на 5.2 и 7.8 процентного пункта на 5/5. На 3/3 почти не меняется.")
vsSrc  = input.string("3/3, а если пусто — 2/2", "Откуда 5/5 берёт вставки", options = ["только 3/3", "3/3, а если пусто — 2/2", "3/3 и 2/2 вместе"], group = gV, tooltip = "Только для слоя 5/5. У 3/3 донор всегда 2/2, выбирать там нечего.\n\nНаблюдение владельца 29.09.2026: «3/3 просто идеально всё нарисовал, а вот 5/5, беря сырые метки только у 3/3, пропускает этот момент, потому что там метки сырые с 2/2. Он выстраивает зиг-заг правильно, только счёт не отображает».\n\nПричина ровно такая: ОТРИСОВКА у 5/5 запасного донора использует, поэтому зиг-заг и метки ·· нарисованы верно, а цепочка для СЧЁТА брала только у 3/3.\n\n· «только 3/3» — как было;\n· «3/3, а если пусто — 2/2» — если 3/3 в этой ноге ещё ничего не дал, берётся 2/2. По умолчанию;\n· «3/3 и 2/2 вместе» — берётся всё подряд, слой станет очень дробным.\n\nЦЕНА, замер Н19: запасных меток на 5/5 БОЛЬШЕ, чем с 3/3, — 1960 против 1790. Это не добавка, а почти удвоение: 5/5 со вставками поедет в сторону 2/2.\n\nОГОВОРКА. Отрисовка решает «в ноге пусто» задним числом, когда нога закрылась. Счёт так не может — он идёт вперёд и назад не переписывается. Поэтому в счёте условие «3/3 в этой ноге ЕЩЁ ничего не дал». Если 3/3 даст метку позже в той же ноге, счёт успеет взять метку с 2/2, а на графике она останется с двумя точками.")

// сколько вставок пускать в одну ногу, числом
vsN = vsCap == "0" ? 0 : vsCap == "1" ? 1 : vsCap == "2" ? 2 : 999
// запасной донор 2/2 для слоя 5/5
vs2ok  = vsSrc != "только 3/3"
vs2all = vsSrc == "3/3 и 2/2 вместе"

MAXK = 100
// «нуля счёта нет». Пайн не принимает na в параметр функции, у которого
// тип выводится из вызова, — ни голый, ни через int-переменную. Поэтому
// сторож обычным числом: бар-индекс никогда не бывает отрицательным.
NOZERO = -1

