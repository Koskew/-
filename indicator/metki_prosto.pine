//@version=5
// ═══════════════════════════════════════════════════════════════════
// МЕТКИ — только структура. Три слоя на выбор
//
// Метки HH / LH / HL / LL на трёх слоях: 5/5, 3/3, 2/2. Каждый
// включается отдельно, и у КАЖДОГО свои штрих-линии по своей глубине.
// Уровни 4H и 1D — общие, один набор на всех.
//
// Здесь НЕТ: счёта (0)-(5), тренда, слома, уровня тренда, запаса,
// таблицы, триггерных свечей, входов и риска.
//
// ── ДВА ПРАВИЛА, КОТОРЫЕ ЗДЕСЬ ГЛАВНЫЕ ──
//
// 1. МЕТКА не пропадает никогда. Подпись HH/LH/HL/LL остаётся на своём
//    месте, что бы цена дальше ни делала.
//
// 2. ЛИНИЯ от метки живёт, пока цена её не коснулась. Коснулась —
//    линия УДАЛЯЕТСЯ совсем. Механизм взят из Тренажёра v9 один в один:
//    уровень это СЫРОЙ ПИВОТ со своей ценой, лежит в массиве, при
//    касании вычёркивается.
//
//    Раньше я брал уровень из КОЛЕНА. Колено при слиянии переезжает на
//    новый экстремум, и я вместе с ценой сбрасывал флаг перебития —
//    линия оживала. Сырые пивоты не переезжают, поэтому пробитый
//    уровень мёртв навсегда.
//
// ── ДОРИСОВКА ──
// Слой может не увидеть разворот вовсе: между двумя своими коленами он
// идёт прямой, хотя внутри был отскок. Такой участок дорисовывается
// коленами более быстрого слоя, рисуется ШТРИХ-ПУНКТИРОМ, а метка
// ставится сырая, с точкой спереди: ·LH. 5/5 берёт у 3/3, 3/3 у 2/2.
// ═══════════════════════════════════════════════════════════════════
indicator("МЕТКИ", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 3000)

gA = "① Слои"
on5    = input.bool(false, "5/5", inline = "s", group = gA)
on3    = input.bool(true,  "3/3", inline = "s", group = gA)
on2    = input.bool(false, "2/2", inline = "s", group = gA)
labWho = input.string("3/3", "Чьи метки подписывать", options = ["5/5", "3/3", "2/2", "все", "никто"], group = gA, tooltip = "Подписи слоёв накладываются друг на друга, поэтому обычно подписывают один. Остальные видно зиг-загом.")
showZZ = input.bool(true,  "Зиг-заг по коленам", group = gA)
winBars= input.int(400, "Рисовать за последние N баров", minval = 100, maxval = 2000, group = gA, tooltip = "Чем больше окно и чем больше слоёв включено, тем ближе к пределу TradingView в 500 линий. Если разметка обрывается — уменьшите окно или выключите лишний слой.")

gB = "② Штрих-линии слоёв"
lvOn   = input.bool(true, "Показывать линии слоёв", group = gB, tooltip = "У каждого включённого слоя свои линии, по его собственной глубине. Линия живёт, пока цена её не коснулась; коснулась — пропадает совсем. Сама метка при этом остаётся.")
lvLH   = input.bool(true, "Линии для LH и HL тоже", group = gB, tooltip = "HH и LL — пунктир, LH и HL — точки.")
lv_n   = input.int(3, "Ближайших к цене с каждой стороны", minval = 1, maxval = 10, group = gB)
lvTr   = input.int(45, "Прозрачность линий", minval = 0, maxval = 90, group = gB)
absOn  = input.bool(true, "Показывать поглощённые метки", group = gB, tooltip = "Когда два пивота одной стороны идут подряд, они схлопываются в одно колено, и подпись проигравшего прежде исчезала с графика. Теперь она остаётся на своём месте — бледная, мелкая, с короткой точкой на своём уровне. Это самая частая подрисовка: около 21% колен. Линии уровня у неё нет, только метка.")
fillOn = input.bool(true, "Дорисовывать пропущенные колена", group = gB, tooltip = "Слой может не увидеть разворот вовсе. Тогда участок дорисовывается коленами более быстрого слоя, рисуется ШТРИХ-ПУНКТИРОМ, метка ставится сырая с точкой спереди. 5/5 берёт у 3/3, 3/3 у 2/2. У 2/2 более быстрого слоя нет.")
fillLv = input.bool(true, "Линии и у дорисованных меток", group = gB, tooltip = "Сырая метка получает свою линию по тем же правилам: пока цена её не коснулась — тянется вправо, коснулась — пропадает. Живость проверяется по слою, откуда метка одолжена.")

gT = "③ Тренд"
trOn5  = input.bool(true, "Считать восходящий тренд", group = gT, tooltip = "Считается СРАЗУ ПО ТРЁМ слоям, независимо. В табло три колонки. На графике рисуется тот слой, который включён в ①; если включено несколько — самый медленный из них.\n\nПервое из пяти состояний. Ноль счёта ставится на низ перед первой HH; если прошлый тренд был восходящий и дошёл до (3) и дальше, нулём может быть HL — продолжение. Счёт чередует колена от нуля: нечётная точка вершина, чётная низ. Встречная подпись счёт НЕ обрывает, она помечает точку как манипуляционную.")
trDeath = input.string("имп × 0.33", "Чем убивается тренд", options = ["имп × 0.33", "4 закрытия ниже", "оба", "любое"], group = gT, tooltip = "Замер Н7 на 9 годах: правила НЕРАЗЛИЧИМЫ, знак разницы меняется между слоями, полторы сигмы. Выбирать глазами. «оба» — нужны оба сразу, «любое» — кто первый.")
trFib   = input.float(0.33, "Глубина, импульсов", 0.0, 1.0, 0.01, group = gT)
trNbar  = input.int(4, "Свечей подряд ниже уровня", 1, 10, group = gT, tooltip = "Слово владельца: четыре подряд, считая от первой, которая закрылась ниже уровня. Считается по ЗАКРЫТИЮ — прочтение «всё тело ниже» замер отклонил, оно хуже во всём.")
trNum   = input.bool(true, "Номера точек (0)-(5)", group = gT)
trCont  = input.string("только LL", "С чего может начаться восходящий", options = ["только LL", "LL, и HL как продолжение"], group = gT, tooltip = "ВОСХОДЯЩИЙ.md §1: продолжение может начаться с HL, но только если ПРЕДЫДУЩИЙ тренд был восходящий и дошёл до (3)+. Если предыдущий был нисходящий и случился слом — только с LL.\n\nДвижка нисходящего у нас пока нет, поэтому «предыдущий был восходящий» проверить нечем: флаг t5pUp помнит последний восходящий, даже если после него успел пройти нисходящий. Именно на этом индикатор ошибся 17.09.2026. Пока стоит безопасное «только LL». Вторая строчка возвращает старое поведение.")
trShow5 = input.bool(false, "Показывать 5/5 поверх, как контекст", group = gT, tooltip = "Насильно показывает слой 5/5, даже если он выключен в ①. По умолчанию ВЫКЛЮЧЕНО: раньше этот флаг стоял включённым и накладывал весь слой 5/5 поверх рабочего слоя — от этого метки на графике смазывались. Включать, только если хочется видеть крупную структуру рядом с мелкой.")
trFull  = input.bool(true, "У слоя 5/5 показывать всё остальное", group = gT, tooltip = "Когда 5/5 включён только ради счёта тренда, у него по умолчанию видны лишь зиг-заг и колена счёта. Этот флаг возвращает остальное: штрих-пунктирные линии слоя 5/5, поглощённые метки и одолженные сырые метки ·LH. Если поверх вашего рабочего слоя это мешает — снять флаг, останется только счёт.")
trTbl   = input.bool(true, "Табло состояния", group = gT, tooltip = "Что движок думает про восходящий тренд прямо сейчас. Первый кирпич той таблицы, про которую договаривались: пока одна колонка 5/5, дальше встанут 3/3 и 2/2.")
trBrk   = input.string("HL", "Чем подтверждается зелёный слом", options = ["HL", "имп × 0.33", "4 закрытия выше"], group = gT, tooltip = "Зелёный слом — это слом НИСХОДЯЩЕЙ структуры: цена от LL перебила вершину и сделала HH. Чёрточка появляется СРАЗУ, на цене перебитой вершины. До подтверждения зиг-заг счёта рисуется ТОНКИМ, после — толстым.\n\nЧем подтверждать:\n· HL — пришёл первый HL после HH. Структурно, в том же языке, что и весь слой;\n· имп × 0.33 — цена ушла выше перебитой вершины на треть импульса;\n· 4 закрытия выше — столько же закрытий подряд, сколько стоит в поле «Свечей подряд ниже уровня».\n\nКакое лучше — не проверено. Замер будет, когда линия поживёт на графике.\n\nВАЖНО: нисходящий тренд движком НЕ считается. Зелёная линия отмечает только сам факт «структуру сломали вверх».")
cTrUp   = input.color(#00c853, "Восходящий: метки, счёт, уровень", group = gT)
cTrDie  = input.color(#ff1744, "Слом", group = gT)

gD = "④ Уровни 4H и 1D — общие"
hOn    = input.bool(true, "Показывать", inline = "h", group = gD)
h_tf4  = input.bool(true, "4H",         inline = "h", group = gD)
h_tfd  = input.bool(true, "1D",         inline = "h", group = gD)
hLB    = input.int(3, "Глубина пивота старших ТФ", minval = 1, maxval = 8, group = gD)
cHiH   = input.color(color.green, "верх / низ", inline = "hc", group = gD)
cLoH   = input.color(color.red,   "",           inline = "hc", group = gD)

gC = "⑤ Цвета слоёв"
c5H = input.color(#ff6d00, "5/5  вершина / низ", inline = "c5", group = gC)
c5L = input.color(#ffab40, "",                   inline = "c5", group = gC)
c3H = input.color(#e0342c, "3/3  вершина / низ", inline = "c3", group = gC)
c3L = input.color(#00b050, "",                   inline = "c3", group = gC)
c2H = input.color(#7e57c2, "2/2  вершина / низ", inline = "c2", group = gC)
c2L = input.color(#4fc3f7, "",                   inline = "c2", group = gC)
zzW = input.int(1, "Толщина зиг-зага", minval = 1, maxval = 4, group = gC)

MAXK = 100
// «нуля счёта нет». Пайн не принимает na в параметр функции, у которого
// тип выводится из вызова, — ни голый, ни через int-переменную. Поэтому
// сторож обычным числом: бар-индекс никогда не бывает отрицательным.
NOZERO = -1

// ══════════════ КОЛЕНА (для зиг-зага и подписей) ══════════════
// Колено — пивот; подряд идущие одной стороны схлопываются в экстремум.
var float[]  P5 = array.new_float()
var int[]    B5 = array.new_int()
var bool[]   H5 = array.new_bool()
var string[] L5 = array.new_string()
var int[]    M5 = array.new_int()
var float[]  G5 = array.new_float()
var int[]    Y5 = array.new_int()
var bool[]   Z5 = array.new_bool()
var string[] W5 = array.new_string()

var float[]  P3 = array.new_float()
var int[]    B3 = array.new_int()
var bool[]   H3 = array.new_bool()
var string[] L3 = array.new_string()
var int[]    M3 = array.new_int()
var float[]  G3 = array.new_float()
var int[]    Y3 = array.new_int()
var bool[]   Z3 = array.new_bool()
var string[] W3 = array.new_string()

var float[]  P2 = array.new_float()
var int[]    B2 = array.new_int()
var bool[]   H2 = array.new_bool()
var string[] L2 = array.new_string()
var int[]    M2 = array.new_int()
var float[]  G2 = array.new_float()
var int[]    Y2 = array.new_int()
var bool[]   Z2 = array.new_bool()
var string[] W2 = array.new_string()

f_relabel(_P, _H, _L) =>
    array.clear(_L)
    n = array.size(_P)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(_H, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(_H, j) == hi
                    prev := array.get(_P, j)
                    break
                j -= 1
            cur = array.get(_P, i)
            array.push(_L, na(prev) ? "?" : hi ? (cur > prev ? "HH" : "LH") : (cur > prev ? "HL" : "LL"))
    n

// Метка, которая проявилась, не должна пропадать. При слиянии двух
// пивотов одной стороны проигравший уходит в список поглощённых и
// остаётся видимым на своём месте. Подпись считается от ПРЕДЫДУЩЕГО
// колена той же стороны, а не от того, в которое метка влилась.
f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi) =>
    n = array.size(_P)
    float prev = na
    j = n - 2
    while j >= 0
        if array.get(_H, j) == _hi
            prev := array.get(_P, j)
            break
        j -= 1
    array.push(_G, _price)
    array.push(_Y, _bar)
    array.push(_Z, _hi)
    array.push(_W, na(prev) ? "?" : _hi ? (_price > prev ? "HH" : "LH") : (_price > prev ? "HL" : "LL"))
    if array.size(_G) > MAXK
        array.shift(_G)
        array.shift(_Y)
        array.shift(_Z)
        array.shift(_W)
    0

f_push(_P, _B, _H, _L, _M, _G, _Y, _Z, _W, _price, _bar, _hi) =>
    n = array.size(_P)
    bool same = false
    if n > 0
        same := array.get(_H, n - 1) == _hi
    if same
        old = array.get(_P, n - 1)
        oldB = array.get(_B, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(_M, n - 1, array.get(_M, n - 1) + 1)
        if better
            a1 = f_absorb(_G, _Y, _Z, _W, _P, _H, old, oldB, _hi)
            array.set(_P, n - 1, _price)
            array.set(_B, n - 1, _bar)
        else
            a2 = f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi)
    else
        array.push(_P, _price)
        array.push(_B, _bar)
        array.push(_H, _hi)
        array.push(_M, 1)
        if array.size(_P) > MAXK
            array.shift(_P)
            array.shift(_B)
            array.shift(_H)
            array.shift(_M)
    d = f_relabel(_P, _H, _L)
    not same

// ══════════════ ВОСХОДЯЩИЙ ТРЕНД, СЛОЙ 5/5 ══════════════
// Правила владельца, indicator/ВОСХОДЯЩИЙ.md:
//
//   рождение — ноль на низ перед первой HH. Этот низ должен быть LL;
//     HL допускается только как ПРОДОЛЖЕНИЕ, если прошлый тренд был
//     восходящий и его счёт дошёл до (3) или дальше;
//   счёт — чередование колен от нуля, нечётная точка вершина, чётная
//     низ. Встречная подпись счёт НЕ обрывает: (2) в идеале HL, но может
//     быть LL — это манипуляция, а не конец счёта;
//   уровень — ПОСЛЕДНИЙ появившийся HL. Заменяет предыдущий безусловно,
//     выше тот оказался или ниже. Храповика здесь нет намеренно;
//   смерть — тело за уровень на имп x 0.33, либо N закрытий подряд ниже
//     уровня. Замер Н7 их не различил, поэтому переключатель.
// Состояние держится ПО СЛОЯМ: индекс 0 = 5/5, 1 = 3/3, 2 = 2/2.
// Движков теперь три, по одному на слой, и считают они независимо друг
// от друга. В табло стоят три колонки, а на графике рисуется тот слой,
// который выбран в ① — если включено несколько, самый медленный.
// Бары держим числом, -1 значит «нет»: пайн капризен с na в массивах.
var int[]    tTR  = array.new_int(3, 0)        // 0 нет тренда, 1 восходящий
var int[]    tZB  = array.new_int(3, -1)       // бар колена-нуля
var float[]  tZP  = array.new_float(3, na)     // его цена
var string[] tZL  = array.new_string(3, "")    // его подпись
var float[]  tLVL = array.new_float(3, na)     // уровень — последний HL
var int[]    tLVB = array.new_int(3, -1)
var bool[]   tLHL = array.new_bool(3, false)   // уровень на настоящем HL
var int[]    tCNT = array.new_int(3, -1)       // номер последней точки
var int[]    tMAX = array.new_int(3, -1)       // докуда счёт дошёл
var float[]  tIMP = array.new_float(3, 0.0)    // импульсное колено
var int[]    tBEL = array.new_int(3, 0)        // закрытий подряд ниже
var bool[]   tPUP = array.new_bool(3, false)   // прошлый был восходящий
var int[]    tPMX = array.new_int(3, -1)
var float[]  tDP  = array.new_float(3, na)     // цена слома
var int[]    tDB  = array.new_int(3, -1)       // бар слома
var int[]    tBB  = array.new_int(3, -1)       // бар рождения
var int[]    tPZB = array.new_int(3, -1)       // ноль ПРОШЛОГО счёта
// ЗЕЛЁНЫЙ СЛОМ — слом нисходящей структуры. Цена от LL перебила вершину
// и сделала HH. Чёрточка встаёт на цене перебитой вершины сразу, а до
// подтверждения ноги счёта рисуются тонкими
var float[]  tBP  = array.new_float(3, na)     // цена перебитой вершины
var int[]    tBB2 = array.new_int(3, -1)       // бар зелёного слома
var bool[]   tBOK = array.new_bool(3, false)   // подтверждён ли
var int[]    tBAB = array.new_int(3, 0)        // закрытий подряд выше

var table TBL = table.new(position.top_right, 4, 8, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 80))

// Один шаг движка для слоя _i. Вся логика та же, что была у 5/5, просто
// состояние читается и пишется по индексу слоя.
f_trend(_i, _P, _B, _H, _L, _nw, _fr) =>
    n = array.size(_P)
    // 1. смерть проверяется КАЖДЫЙ бар, а не только на колене
    if array.get(tTR, _i) == 1 and not na(array.get(tLVL, _i))
        lv = array.get(tLVL, _i)
        im = array.get(tIMP, _i)
        bLo = math.min(open, close)
        bool okA = bLo < lv - im * trFib
        array.set(tBEL, _i, close < lv ? array.get(tBEL, _i) + 1 : 0)
        bool okB = array.get(tBEL, _i) >= trNbar
        bool died = trDeath == "имп × 0.33" ? okA : trDeath == "4 закрытия ниже" ? okB : trDeath == "оба" ? (okA and okB) : (okA or okB)
        if died
            array.set(tPUP, _i, true)
            array.set(tPMX, _i, array.get(tMAX, _i))
            array.set(tDP,  _i, lv)
            array.set(tDB,  _i, bar_index)
            array.set(tTR,  _i, 0)
            array.set(tCNT, _i, -1)
            array.set(tZB,  _i, -1)
            array.set(tPZB, _i, -1)
            array.set(tLVL, _i, na)
            array.set(tBEL, _i, 0)
            array.set(tBP,  _i, na)
            array.set(tBB2, _i, -1)
            array.set(tBOK, _i, false)
            array.set(tBAB, _i, 0)
    // 1b. подтверждение ЗЕЛЁНОГО слома — тоже каждый бар
    if not na(array.get(tBP, _i)) and not array.get(tBOK, _i)
        bp = array.get(tBP, _i)
        array.set(tBAB, _i, close > bp ? array.get(tBAB, _i) + 1 : 0)
        bool bA = math.max(open, close) > bp + array.get(tIMP, _i) * trFib
        bool bB = array.get(tBAB, _i) >= trNbar
        if trBrk == "имп × 0.33" and bA
            array.set(tBOK, _i, true)
        if trBrk == "4 закрытия выше" and bB
            array.set(tBOK, _i, true)
    // 2. новое колено: счёт, уровень, рождение
    if _fr and n >= 2
        lb  = array.get(_L, n - 1)
        hiK = array.get(_H, n - 1)
        prK = array.get(_P, n - 1)
        bbK = array.get(_B, n - 1)
        ppK = array.get(_P, n - 2)
        if prK > ppK
            array.set(tIMP, _i, prK - ppK)
        if array.get(tTR, _i) == 1
            // §5: первый HL после (5) начинает НОВЫЙ счёт и сам стаёт нулём
            bool restart = _nw and array.get(tCNT, _i) >= 5 and not hiK and lb == "HL"
            if restart
                array.set(tPZB, _i, array.get(tZB, _i))
                array.set(tZB,  _i, bbK)
                array.set(tZP,  _i, prK)
                array.set(tZL,  _i, lb)
                array.set(tCNT, _i, 0)
                array.set(tMAX, _i, 0)
                array.set(tLVL, _i, prK)
                array.set(tLVB, _i, bbK)
                array.set(tLHL, _i, true)
                array.set(tBEL, _i, 0)
            else
                if _nw and array.get(tCNT, _i) < 5
                    array.set(tCNT, _i, array.get(tCNT, _i) + 1)
                    array.set(tMAX, _i, math.max(array.get(tMAX, _i), array.get(tCNT, _i)))
                // уровень — последний HL, безусловно
                if not hiK and lb == "HL"
                    array.set(tLVL, _i, prK)
                    array.set(tLVB, _i, bbK)
                    array.set(tLHL, _i, true)
                    array.set(tBEL, _i, 0)
                    // первый HL после HH подтверждает зелёный слом
                    if trBrk == "HL"
                        array.set(tBOK, _i, true)
        else
            // рождение: пришла HH, ноль — низ перед ней
            if hiK and lb == "HH"
                int j = n - 2
                while j >= 0
                    if not array.get(_H, j)
                        break
                    j -= 1
                if j >= 0
                    zl = array.get(_L, j)
                    bool ok = zl == "LL" or (trCont != "только LL" and zl == "HL" and array.get(tPUP, _i) and array.get(tPMX, _i) >= 3)
                    if ok
                        array.set(tTR,  _i, 1)
                        array.set(tBB,  _i, bar_index)
                        array.set(tZB,  _i, array.get(_B, j))
                        array.set(tZP,  _i, array.get(_P, j))
                        array.set(tZL,  _i, zl)
                        array.set(tCNT, _i, 1)
                        array.set(tMAX, _i, 1)
                        // ноль всегда становится уровнем. HL — настоящий,
                        // сплошной; LL — временный, штрих-пунктир без подписи
                        array.set(tLVL, _i, array.get(_P, j))
                        array.set(tLVB, _i, array.get(_B, j))
                        array.set(tLHL, _i, zl == "HL")
                        array.set(tBEL, _i, 0)
                        // ЗЕЛЁНЫЙ СЛОМ: вершина, которую цена перебила по
                        // дороге от нуля к этой HH. Это колено-вершина
                        // перед нулём — то самое «LH или HH потом LL»
                        int v = j - 1
                        while v >= 0
                            if array.get(_H, v)
                                break
                            v -= 1
                        if v >= 0
                            array.set(tBP,  _i, array.get(_P, v))
                            array.set(tBB2, _i, bar_index)
                            array.set(tBOK, _i, zl == "HL" and trBrk == "HL")
                            array.set(tBAB, _i, 0)
                        else
                            array.set(tBP,  _i, na)
                            array.set(tBB2, _i, -1)
                            array.set(tBOK, _i, false)
    0

ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow (low,  5, 5)
ph3 = ta.pivothigh(high, 3, 3)
pl3 = ta.pivotlow (low,  3, 3)
ph2 = ta.pivothigh(high, 2, 2)
pl2 = ta.pivotlow (low,  2, 2)

if barstate.isconfirmed
    // nwN — родилось ли на слое НОВОЕ колено. Счёт двигается по коленам,
    // а не по сырым пивотам: слияние пивота в уже стоящее колено счёт не двигает
    bool nw5 = false
    bool nw3 = false
    bool nw2 = false
    if not na(ph5)
        q1 = f_push(P5, B5, H5, L5, M5, G5, Y5, Z5, W5, high[5], bar_index - 5, true)
        nw5 := nw5 or q1
    if not na(pl5)
        q2 = f_push(P5, B5, H5, L5, M5, G5, Y5, Z5, W5, low[5],  bar_index - 5, false)
        nw5 := nw5 or q2
    if not na(ph3)
        q3 = f_push(P3, B3, H3, L3, M3, G3, Y3, Z3, W3, high[3], bar_index - 3, true)
        nw3 := nw3 or q3
    if not na(pl3)
        q4 = f_push(P3, B3, H3, L3, M3, G3, Y3, Z3, W3, low[3],  bar_index - 3, false)
        nw3 := nw3 or q4
    if not na(ph2)
        q5 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, high[2], bar_index - 2, true)
        nw2 := nw2 or q5
    if not na(pl2)
        q6 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, low[2],  bar_index - 2, false)
        nw2 := nw2 or q6

    // ── шаг восходящего тренда: три слоя, независимо ──
    if trOn5
        bool fr5 = not na(ph5) or not na(pl5)
        bool fr3 = not na(ph3) or not na(pl3)
        bool fr2 = not na(ph2) or not na(pl2)
        e5 = f_trend(0, P5, B5, H5, L5, nw5, fr5)
        e3 = f_trend(1, P3, B3, H3, L3, nw3, fr3)
        e2 = f_trend(2, P2, B2, H2, L2, nw2, fr2)

// ══════════════ ЖИВЫЕ УРОВНИ СЛОЯ ══════════════
// Механизм Тренажёра v9: уровень — СЫРОЙ пивот, лежит в списке, при
// касании ценой ВЫЧЁРКИВАЕТСЯ из списка. Пивоты не переезжают, поэтому
// пробитый уровень мёртв навсегда.
var float[]  V5P = array.new_float()
var int[]    V5B = array.new_int()
var bool[]   V5H = array.new_bool()
var string[] V5L = array.new_string()

var float[]  V3P = array.new_float()
var int[]    V3B = array.new_int()
var bool[]   V3H = array.new_bool()
var string[] V3L = array.new_string()

var float[]  V2P = array.new_float()
var int[]    V2B = array.new_int()
var bool[]   V2H = array.new_bool()
var string[] V2L = array.new_string()

f_lvPush(_p, _b, _h, _l, _v, _off, _isHi, _lab) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - _off)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

// уровень существует, пока не пробит. Коснулась цена — удаляем совсем
f_purgeL(_p, _b, _h, _l) =>
    i = 0
    while i < array.size(_p)
        pr = array.get(_p, i)
        bool dead = array.get(_h, i) ? high >= pr : low <= pr
        if dead
            array.remove(_p, i)
            array.remove(_b, i)
            array.remove(_h, i)
            array.remove(_l, i)
        else
            i += 1
    0

// жив ли уровень с такой ценой — для линий у сырых меток
f_alive(_p, _v) =>
    bool r = false
    n = array.size(_p)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(_p, i) - _v) <= syminfo.mintick
                r := true
                break
    r

// подпись сырого пивота: сравнение с предыдущим пивотом той же стороны
a51 = ta.valuewhen(not na(ph5), high[5], 1)
a52 = ta.valuewhen(not na(ph5), high[5], 0)
hh5 = na(ph5) ? na : a51 < a52 ? ph5 : na
lh5 = na(ph5) ? na : a51 > a52 ? ph5 : na
a53 = ta.valuewhen(not na(pl5), low[5], 1)
a54 = ta.valuewhen(not na(pl5), low[5], 0)
ll5 = na(pl5) ? na : a53 > a54 ? pl5 : na
hl5 = na(pl5) ? na : a53 < a54 ? pl5 : na

a31 = ta.valuewhen(not na(ph3), high[3], 1)
a32 = ta.valuewhen(not na(ph3), high[3], 0)
hh3 = na(ph3) ? na : a31 < a32 ? ph3 : na
lh3 = na(ph3) ? na : a31 > a32 ? ph3 : na
a33 = ta.valuewhen(not na(pl3), low[3], 1)
a34 = ta.valuewhen(not na(pl3), low[3], 0)
ll3 = na(pl3) ? na : a33 > a34 ? pl3 : na
hl3 = na(pl3) ? na : a33 < a34 ? pl3 : na

a21 = ta.valuewhen(not na(ph2), high[2], 1)
a22 = ta.valuewhen(not na(ph2), high[2], 0)
hh2 = na(ph2) ? na : a21 < a22 ? ph2 : na
lh2 = na(ph2) ? na : a21 > a22 ? ph2 : na
a23 = ta.valuewhen(not na(pl2), low[2], 1)
a24 = ta.valuewhen(not na(pl2), low[2], 0)
ll2 = na(pl2) ? na : a23 > a24 ? pl2 : na
hl2 = na(pl2) ? na : a23 < a24 ? pl2 : na

u01 = f_lvPush(V5P, V5B, V5H, V5L, hh5, 5, true,  "HH")
u02 = f_lvPush(V5P, V5B, V5H, V5L, lh5, 5, true,  "LH")
u03 = f_lvPush(V5P, V5B, V5H, V5L, hl5, 5, false, "HL")
u04 = f_lvPush(V5P, V5B, V5H, V5L, ll5, 5, false, "LL")
u05 = f_lvPush(V3P, V3B, V3H, V3L, hh3, 3, true,  "HH")
u06 = f_lvPush(V3P, V3B, V3H, V3L, lh3, 3, true,  "LH")
u07 = f_lvPush(V3P, V3B, V3H, V3L, hl3, 3, false, "HL")
u08 = f_lvPush(V3P, V3B, V3H, V3L, ll3, 3, false, "LL")
u09 = f_lvPush(V2P, V2B, V2H, V2L, hh2, 2, true,  "HH")
u10 = f_lvPush(V2P, V2B, V2H, V2L, lh2, 2, true,  "LH")
u11 = f_lvPush(V2P, V2B, V2H, V2L, hl2, 2, false, "HL")
u12 = f_lvPush(V2P, V2B, V2H, V2L, ll2, 2, false, "LL")

v01 = f_purgeL(V5P, V5B, V5H, V5L)
v02 = f_purgeL(V3P, V3B, V3H, V3L)
v03 = f_purgeL(V2P, V2B, V2H, V2L)

// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()

f_lvlLayer(_p, _b, _h, _l, _cHi, _cLo) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? _cHi : _cLo, lvTr), width = 1, style = st, extend = extend.right))
    n

// Поглощённые метки: бледная подпись на своём месте плюс короткая точка
// на своём уровне. Линии уровня у них нет — только метка.
f_drawAbs(_G, _Y, _Z, _W, _cHi, _cLo, _tag) =>
    n = array.size(_G)
    if n > 0
        for i = 0 to n - 1
            yb = array.get(_Y, i)
            if last_bar_index - yb <= winBars
                pr = array.get(_G, i)
                hi = array.get(_Z, i)
                lb = array.get(_W, i)
                array.push(LNS, line.new(yb, pr, yb + 3, pr, color = color.new(hi ? _cHi : _cLo, 50), width = 1, style = line.style_dotted))
                array.push(LBS, label.new(yb, pr, lb, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(hi ? _cHi : _cLo, 50), size = size.tiny, tooltip = "ПОГЛОЩЁННАЯ метка слоя " + _tag + "\n" + lb + "  " + str.tostring(pr, format.mintick) + "\nэта метка проявилась, потом цена ушла дальше и колено переехало на новый экстремум. Сама метка никуда не делась."))
    n

// Подпуть более быстрого слоя внутри одной ноги.
// Берём только то, что реально ЧЕРЕДУЕТСЯ: цепочка начинается со
// стороны, противоположной началу ноги, и не кончается стороной её
// конца — иначе слой подставит тот же экстремум второй раз.
f_sub(_sB, _sH, _x1, _x2, _s1, _s2) =>
    int[] keep = array.new_int()
    n = array.size(_sB)
    if n > 0
        bool want = not _s1
        for k = 0 to n - 1
            b = array.get(_sB, k)
            if b > _x1 and b < _x2
                if array.get(_sH, k) == want
                    array.push(keep, k)
                    want := not want
    while array.size(keep) > 0
        last = array.get(keep, array.size(keep) - 1)
        if array.get(_sH, last) == _s2
            dummy = array.pop(keep)
        else
            break
    keep

// ХВОСТ: колена быстрого слоя ПОСЛЕ последнего колена нашего слоя.
// Здесь конца ноги ещё нет — слой не подтвердил разворот, а быстрый уже
// подтвердил: 3/3 знает через 3 бара, 5/5 только через 5. Это живой
// край, и метки здесь нужны не меньше, чем в истории.
f_subTail(_sB, _sH, _x1, _s1) =>
    int[] keep = array.new_int()
    n = array.size(_sB)
    if n > 0
        bool want = not _s1
        for k = 0 to n - 1
            if array.get(_sB, k) > _x1
                if array.get(_sH, k) == want
                    array.push(keep, k)
                    want := not want
    keep

f_draw(_P, _B, _H, _L, _M, _fP, _fB, _fH, _fL, _fV, _gP, _gB, _gH, _gL, _gV, _hasF, _cHi, _cLo, _tag, _lab, _labK, _tzB, _tpzB, _ttr, _bok) =>
    n = array.size(_P)
    // колено-ноль действующего счёта: первое, чей бар не раньше нуля
    int zi = -1
    if _ttr == 1 and _tzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tzB
                zi := i
                break
    // ноль ПРОШЛОГО счёта: его номера и ноги остаются, но бледными
    int pzi = -1
    if _ttr == 1 and _tpzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tpzB
                pzi := i
                break
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(_B, i - 1)
            x2 = array.get(_B, i)
            p1 = array.get(_P, i - 1)
            p2 = array.get(_P, i)
            if last_bar_index - x1 <= winBars
                s1 = array.get(_H, i - 1)
                s2 = array.get(_H, i)
                int[] keep = array.new_int()
                bool useG = false
                if fillOn and _hasF
                    keep := f_sub(_fB, _fH, x1, x2, s1, s2)
                    if array.size(keep) == 0
                        keep := f_sub(_gB, _gH, x1, x2, s1, s2)
                        if array.size(keep) > 0
                            useG := true
                nk = array.size(keep)
                bool filled = nk > 0
                // нога ДЕЙСТВУЮЩЕГО счёта. ВОСХОДЯЩИЙ.md §6: цвет по НОГЕ,
                // чередованием (0)-(1) зелёная, (1)-(2) красная и дальше.
                // Колена чередуются вершина/низ, поэтому направление ноги и
                // чётность её номера — одно и то же.
                bool inCnt = zi >= 0 and i > zi and i - zi <= 5
                bool inPrv = not inCnt and pzi >= 0 and i > pzi and i - pzi <= 5
                col0 = inCnt ? (p2 > p1 ? cTrUp : cTrDie) : inPrv ? color.new(p2 > p1 ? cTrUp : cTrDie, 55) : (p2 > p1 ? _cHi : _cLo)
                // §5: точка (5) может быть LH вместо HH. Счёт от этого не
                // ломается, но нога (4)-(5) с такой вершиной рисуется
                // ШТРИХ-ПУНКТИРОМ — зелёным, цвет не меняется
                bool weak5 = (inCnt and i - zi == 5 or inPrv and i - pzi == 5) and array.get(_L, i) == "LH"
                // пока зелёный слом не подтверждён, нога счёта ТОНКАЯ.
                // Штрих-пунктир для этого не берём: он занят дорисовкой
                int wCnt = inCnt ? (_bok ? zzW + 1 : zzW) : zzW
                if showZZ
                    if filled
                        // участок с дорисовкой остаётся ШТРИХ-ПУНКТИРОМ — это
                        // признак «колено одолжено», — но внутри счёта цвет
                        // берётся от ноги, а не от слоя. Все куски подпути
                        // красятся одинаково: нога одна, ныряния внутри неё
                        // своего цвета не имеют
                        int px = x1
                        float pp = p1
                        for q = 0 to nk - 1
                            k = array.get(keep, q)
                            fx = useG ? array.get(_gB, k) : array.get(_fB, k)
                            fp = useG ? array.get(_gP, k) : array.get(_fP, k)
                            cseg = inCnt or inPrv ? col0 : (fp > pp ? _cHi : _cLo)
                            array.push(LNS, line.new(px, pp, fx, fp, color = color.new(cseg, inCnt ? 0 : 15), width = wCnt, style = line.style_dashed))
                            px := fx
                            pp := fp
                        cend = inCnt or inPrv ? col0 : (p2 > pp ? _cHi : _cLo)
                        array.push(LNS, line.new(px, pp, x2, p2, color = color.new(cend, inCnt ? 0 : 15), width = wCnt, style = line.style_dashed))
                    else
                        array.push(LNS, line.new(x1, p1, x2, p2, color = color.new(col0, inCnt ? 0 : 55), width = wCnt, style = weak5 ? line.style_dashed : line.style_solid))
                if _lab
                    if filled and not _labK
                        for q = 0 to nk - 1
                            k = array.get(keep, q)
                            flb = useG ? array.get(_gL, k) : array.get(_fL, k)
                            fpr = useG ? array.get(_gP, k) : array.get(_fP, k)
                            fhi = useG ? array.get(_gH, k) : array.get(_fH, k)
                            fbx = useG ? array.get(_gB, k) : array.get(_fB, k)
                            array.push(LBS, label.new(fbx, fpr, "·" + flb, style = fhi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = fhi ? _cHi : _cLo, size = size.small, tooltip = "СЫРАЯ метка — у слоя " + _tag + " колена здесь нет, взято с более быстрого слоя\n" + flb + "  " + str.tostring(fpr, format.mintick) + "\nучасток нарисован штрих-пунктиром"))
                            // линия сырой метки: только пока она ЖИВА в
                            // списке уровней того слоя, откуда одолжена
                            if fillLv and lvOn
                                if f_alive(useG ? _gV : _fV, fpr)
                                    fst = flb == "HH" or flb == "LL" ? line.style_dashed : line.style_dotted
                                    fxl = math.max(fbx, bar_index - 2900)
                                    array.push(LNS, line.new(fxl, fpr, bar_index, fpr, color = color.new(fhi ? _cHi : _cLo, lvTr), width = 1, style = fst, extend = extend.right))
                    lb = array.get(_L, i)
                    hi = array.get(_H, i)
                    mc = array.get(_M, i)
                    // колено действующего счёта: номер спереди, зелёным
                    int k = -1
                    if zi >= 0 and i >= zi
                        kk = i - zi
                        if kk <= 5
                            k := kk
                    // номер ПРОШЛОГО счёта — остаётся, но бледным
                    int pk = -1
                    if k < 0 and pzi >= 0 and i >= pzi
                        kk2 = i - pzi
                        if kk2 <= 5
                            pk := kk2
                    kk3 = k >= 0 ? k : pk
                    bool ideal = kk3 < 0 ? false : hi ? lb == "HH" : (kk3 == 0 ? lb == "LL" or lb == "HL" : lb == "HL")
                    txt = kk3 >= 0 and trNum ? "(" + str.tostring(kk3) + ") " + lb : lb
                    col1 = k >= 0 ? cTrUp : pk >= 0 ? color.new(cTrUp, 55) : (hi ? _cHi : _cLo)
                    tipK = kk3 < 0 ? "" : "\nточка (" + str.tostring(kk3) + ") из 5 · " + (ideal ? "подпись идеальная" : "подпись встречная — МАНИПУЛЯЦИЯ, счёт продолжается") + (pk >= 0 ? "\nПРОШЛЫЙ счёт. Он дошёл до (5), после чего пришёл HL и начался новый счёт с нуля на нём." : "") + (k == 0 and _tpzB >= 0 ? "\nНОВЫЙ счёт: это первый HL после (5) прошлого счёта. Тренд не умирал, он продолжается." : "")
                    if not _labK or kk3 >= 0
                        array.push(LBS, label.new(x2, p2, txt, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = col1, size = size.small, tooltip = "слой " + _tag + "   " + lb + "  " + str.tostring(p2, format.mintick) + "\n" + (hi ? "вершина" : "низ") + tipK + (mc >= 2 ? "\nслилось сырых меток: " + str.tostring(mc) : "")))

    // ── ХВОСТ ──
    if n >= 1 and fillOn and _hasF
        xt = array.get(_B, n - 1)
        pt = array.get(_P, n - 1)
        st = array.get(_H, n - 1)
        if last_bar_index - xt <= winBars
            int[] kt = f_subTail(_fB, _fH, xt, st)
            bool useG2 = false
            if array.size(kt) == 0
                kt := f_subTail(_gB, _gH, xt, st)
                if array.size(kt) > 0
                    useG2 := true
            nt = array.size(kt)
            if nt > 0
                if showZZ
                    int px2 = xt
                    float pp2 = pt
                    for q = 0 to nt - 1
                        k = array.get(kt, q)
                        fx = useG2 ? array.get(_gB, k) : array.get(_fB, k)
                        fp = useG2 ? array.get(_gP, k) : array.get(_fP, k)
                        array.push(LNS, line.new(px2, pp2, fx, fp, color = color.new(fp > pp2 ? _cHi : _cLo, 15), width = zzW, style = line.style_dashed))
                        px2 := fx
                        pp2 := fp
                if _lab and not _labK
                    for q = 0 to nt - 1
                        k = array.get(kt, q)
                        flb = useG2 ? array.get(_gL, k) : array.get(_fL, k)
                        fpr = useG2 ? array.get(_gP, k) : array.get(_fP, k)
                        fhi = useG2 ? array.get(_gH, k) : array.get(_fH, k)
                        fbx = useG2 ? array.get(_gB, k) : array.get(_fB, k)
                        array.push(LBS, label.new(fbx, fpr, "·" + flb, style = fhi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = fhi ? _cHi : _cLo, size = size.small, tooltip = "СЫРАЯ метка в ХВОСТЕ — слой " + _tag + " этот разворот ещё не подтвердил, взято с более быстрого слоя\n" + flb + "  " + str.tostring(fpr, format.mintick) + "\nучасток нарисован штрих-пунктиром"))
                        if fillLv and lvOn
                            if f_alive(useG2 ? _gV : _fV, fpr)
                                fst = flb == "HH" or flb == "LL" ? line.style_dashed : line.style_dotted
                                fxl = math.max(fbx, bar_index - 2900)
                                array.push(LNS, line.new(fxl, fpr, bar_index, fpr, color = color.new(fhi ? _cHi : _cLo, lvTr), width = 1, style = fst, extend = extend.right))
    n

// ══════════════ УРОВНИ 4H и 1D — ОБЩИЕ ══════════════
ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[hLB], lookahead = barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[hLB],  lookahead = barmerge.lookahead_off)
b41 = ta.valuewhen(not na(ph4), ph4v, 1)
b42 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b41 < b42 ? ph4 : na
lh4 = na(ph4) ? na : b41 > b42 ? ph4 : na
b43 = ta.valuewhen(not na(pl4), pl4v, 1)
b44 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b43 > b44 ? pl4 : na
hl4 = na(pl4) ? na : b43 < b44 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[hLB], lookahead = barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[hLB],  lookahead = barmerge.lookahead_off)
bd1 = ta.valuewhen(not na(phd), phdv, 1)
bd2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : bd1 < bd2 ? phd : na
lhd = na(phd) ? na : bd1 > bd2 ? phd : na
bd3 = ta.valuewhen(not na(pld), pldv, 1)
bd4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : bd3 > bd4 ? pld : na
hld = na(pld) ? na : bd3 < bd4 ? pld : na

var float[]  V4P = array.new_float()
var int[]    V4B = array.new_int()
var bool[]   V4H = array.new_bool()
var string[] V4L = array.new_string()
var float[]  VDP = array.new_float()
var int[]    VDB = array.new_int()
var bool[]   VDH = array.new_bool()
var string[] VDL = array.new_string()

f_lvPushHTF(_p, _b, _h, _l, _v, _prev, _isHi, _lab) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

w01 = f_lvPushHTF(V4P, V4B, V4H, V4L, hh4, nz(hh4[1]), true,  "HH")
w02 = f_lvPushHTF(V4P, V4B, V4H, V4L, lh4, nz(lh4[1]), true,  "LH")
w03 = f_lvPushHTF(V4P, V4B, V4H, V4L, hl4, nz(hl4[1]), false, "HL")
w04 = f_lvPushHTF(V4P, V4B, V4H, V4L, ll4, nz(ll4[1]), false, "LL")
w05 = f_lvPushHTF(VDP, VDB, VDH, VDL, hhd, nz(hhd[1]), true,  "HH")
w06 = f_lvPushHTF(VDP, VDB, VDH, VDL, lhd, nz(lhd[1]), true,  "LH")
w07 = f_lvPushHTF(VDP, VDB, VDH, VDL, hld, nz(hld[1]), false, "HL")
w08 = f_lvPushHTF(VDP, VDB, VDH, VDL, lld, nz(lld[1]), false, "LL")

w09 = f_purgeL(V4P, V4B, V4H, V4L)
w10 = f_purgeL(VDP, VDB, VDH, VDL)

f_lvlHTF(_p, _b, _h, _l, _w) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? cHiH : cLoH, lvTr), width = _w, style = st, extend = extend.right))
    n

// ══════════════ РИСУЕМ ══════════════
if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))

    if hOn and h_tf4
        e1 = f_lvlHTF(V4P, V4B, V4H, V4L, 2)
    if hOn and h_tfd
        e2 = f_lvlHTF(VDP, VDB, VDH, VDL, 3)

    // 5/5 дорисовывается по 3/3, запасной 2/2; 3/3 по 2/2
    // Слой 5/5 может быть показан по двум причинам: включён вручную (on5)
    // или включён ради счёта тренда (trShow). Во втором случае линии слоя
    // и поглощённые метки не рисуем, а подписываем только колена счёта
    bool lab5 = labWho == "5/5" or labWho == "все"
    bool trShow = trOn5 and trShow5
    // ГЛАВНЫЙ слой: тот, что включён в ①. Включено несколько — берём самый
    // медленный. Слово владельца: «если выбираю два, основной тот, который
    // больше». Тренд на графике рисуется только по нему
    int mainL = on5 ? 0 : on3 ? 1 : on2 ? 2 : -1
    if on5 or trShow
        if lvOn and (on5 or trFull)
            r5 = f_lvlLayer(V5P, V5B, V5H, V5L, c5H, c5L)
        if absOn and (lab5 or trFull)
            g5 = f_drawAbs(G5, Y5, Z5, W5, c5H, c5L, "5/5")
        d5 = f_draw(P5, B5, H5, L5, M5, P3, B3, H3, L3, V3P, P2, B2, H2, L2, V2P, true,  c5H, c5L, "5/5", lab5 or trShow, not lab5 and not trFull, mainL == 0 ? array.get(tZB, 0) : NOZERO, mainL == 0 ? array.get(tPZB, 0) : NOZERO, mainL == 0 and trOn5 ? array.get(tTR, 0) : 0, array.get(tBOK, 0))
    if on2
        if lvOn
            r2 = f_lvlLayer(V2P, V2B, V2H, V2L, c2H, c2L)
        if absOn and (labWho == "2/2" or labWho == "все")
            g2 = f_drawAbs(G2, Y2, Z2, W2, c2H, c2L, "2/2")
        d2 = f_draw(P2, B2, H2, L2, M2, P2, B2, H2, L2, V2P, P2, B2, H2, L2, V2P, false, c2H, c2L, "2/2", labWho == "2/2" or labWho == "все", false, mainL == 2 ? array.get(tZB, 2) : NOZERO, mainL == 2 ? array.get(tPZB, 2) : NOZERO, mainL == 2 and trOn5 ? array.get(tTR, 2) : 0, array.get(tBOK, 2))
    // ── тренд: зелёный уровень и красный слом рисуются по ГЛАВНОМУ слою ──
    if trOn5 and mainL >= 0
        mLvl = array.get(tLVL, mainL)
        mHL  = array.get(tLHL, mainL)
        if array.get(tTR, mainL) == 1 and not na(mLvl)
            x0 = array.get(tLVB, mainL) < 0 ? bar_index - 30 : array.get(tLVB, mainL)
            array.push(LNS, line.new(x0, mLvl, bar_index, mLvl, color = cTrUp, width = mHL ? 2 : 1, style = mHL ? line.style_solid : line.style_dashed, extend = extend.right))
            if mHL
                array.push(LBS, label.new(bar_index, mLvl, "держит HL " + str.tostring(mLvl, format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cTrUp, size = size.small, tooltip = "Уровень восходящего — последний появившийся HL. Новый HL заменяет его безусловно, выше тот или ниже.\nСлой: " + (mainL == 0 ? "5/5" : mainL == 1 ? "3/3" : "2/2")))
        // ЗЕЛЁНЫЙ СЛОМ — на цене перебитой вершины, короткой чёрточкой
        mBB = array.get(tBB2, mainL)
        if mBB >= 0 and last_bar_index - mBB <= winBars
            mBP = array.get(tBP, mainL)
            bok = array.get(tBOK, mainL)
            array.push(LNS, line.new(mBB - 12, mBP, mBB + 12, mBP, color = cTrUp, width = bok ? 2 : 1))
            array.push(LBS, label.new(mBB, mBP, bok ? "слом ↑" : "слом ↑ ?", style = label.style_label_up, color = color.new(color.black, 100), textcolor = cTrUp, size = size.tiny, tooltip = "ЗЕЛЁНЫЙ СЛОМ — слом нисходящей структуры на " + str.tostring(mBP, format.mintick) + ".\nЦена от нуля перебила эту вершину и сделала HH.\n" + (bok ? "ПОДТВЕРЖДЁН правилом «" + trBrk + "», зиг-заг счёта толстый." : "НЕ подтверждён правилом «" + trBrk + "», зиг-заг счёта тонкий.") + "\nСлой: " + (mainL == 0 ? "5/5" : mainL == 1 ? "3/3" : "2/2") + "\n\nНисходящий тренд движком НЕ считается — это отметка факта, а не состояние.")
        mDB = array.get(tDB, mainL)
        if mDB >= 0 and last_bar_index - mDB <= winBars
            mDP = array.get(tDP, mainL)
            array.push(LNS, line.new(mDB - 12, mDP, mDB + 12, mDP, color = cTrDie, width = 2))
            array.push(LBS, label.new(mDB, mDP, "слом", style = label.style_label_down, color = color.new(color.black, 100), textcolor = cTrDie, size = size.tiny, tooltip = "Слом восходящего на уровне " + str.tostring(mDP, format.mintick) + "\nСлой: " + (mainL == 0 ? "5/5" : mainL == 1 ? "3/3" : "2/2")))

    // ── ТАБЛО: три колонки, по одной на слой ──
    if trOn5 and trTbl
        table.cell(TBL, 0, 0, "восходящий", text_color = color.gray, text_size = size.tiny)
        for c = 0 to 2
            nm = c == 0 ? "5/5" : c == 1 ? "3/3" : "2/2"
            bool isMain = c == mainL
            table.cell(TBL, c + 1, 0, isMain ? nm + " ◂" : nm, text_color = isMain ? cTrUp : color.gray, text_size = size.tiny)
            bool up = array.get(tTR, c) == 1
            lv = array.get(tLVL, c)
            im = array.get(tIMP, c)
            float thrA = na(lv) ? na : lv - im * trFib
            cG = up ? cTrUp : color.gray
            table.cell(TBL, c + 1, 1, up ? "ВОСХ" : "нет", text_color = cG, text_size = size.tiny)
            table.cell(TBL, c + 1, 2, up ? "(" + str.tostring(array.get(tCNT, c)) + ")/5" : "—", text_color = cG, text_size = size.tiny)
            table.cell(TBL, c + 1, 3, not up ? "—" : na(lv) ? "нет" : (array.get(tLHL, c) ? "HL " : "LL ") + str.tostring(lv, format.mintick), text_color = up and not na(lv) ? cTrUp : color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 4, na(thrA) or not up ? "—" : str.tostring(close - thrA, format.mintick), text_color = color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 5, up ? str.tostring(array.get(tBEL, c)) + "/" + str.tostring(trNbar) : "—", text_color = color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 6, up and array.get(tZB, c) >= 0 ? str.tostring(last_bar_index - array.get(tZB, c)) : "—", text_color = color.gray, text_size = size.tiny)
            db = array.get(tDB, c)
            table.cell(TBL, c + 1, 7, db < 0 ? "—" : str.tostring(last_bar_index - db) + " / " + str.tostring(array.get(tDP, c), format.mintick), text_color = db < 0 ? color.gray : cTrDie, text_size = size.tiny)
        table.cell(TBL, 0, 1, "состояние", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 2, "счёт", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 3, "уровень", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 4, "запас имп×" + str.tostring(trFib), text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 5, "закр. ниже", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 6, "баров от (0)", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 7, "прошлый слом", text_color = color.gray, text_size = size.tiny)

    if on3
        if lvOn
            r3 = f_lvlLayer(V3P, V3B, V3H, V3L, c3H, c3L)
        if absOn and (labWho == "3/3" or labWho == "все")
            g3 = f_drawAbs(G3, Y3, Z3, W3, c3H, c3L, "3/3")
        d3 = f_draw(P3, B3, H3, L3, M3, P2, B2, H2, L2, V2P, P2, B2, H2, L2, V2P, true,  c3H, c3L, "3/3", labWho == "3/3" or labWho == "все", false, mainL == 1 ? array.get(tZB, 1) : NOZERO, mainL == 1 ? array.get(tPZB, 1) : NOZERO, mainL == 1 and trOn5 ? array.get(tTR, 1) : 0, array.get(tBOK, 1))
