//@version=5
// ═══════════════════════════════════════════════════════════════════
// МЕТКИ — только структура, два слоя
//
// Ничего, кроме меток и уровней: структурные метки HH / LH / HL / LL
// на ДВУХ слоях с независимой глубиной пивота, и неперебитые уровни
// этих же меток с текущего ТФ, 4H и 1D.
//
// Здесь НЕТ: счёта (0)-(5), тренда, слома, уровня тренда, запаса,
// таблицы, триггерных свечей, входов и риска. Всё это живёт в
// metki_33.pine и gde_my_v6.pine и сюда намеренно не перенесено.
//
// Колено — это пивот. Если подряд идут два пивота одной стороны, они
// сливаются в один: остаётся экстремальный. Метка ставится сравнением
// колена с предыдущим коленом ТОЙ ЖЕ стороны:
//   вершина выше прошлой вершины — HH, ниже — LH
//   низ выше прошлого низа      — HL, ниже — LL
// ═══════════════════════════════════════════════════════════════════
indicator("МЕТКИ", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 3000)

gA = "① Слои"
drawA  = input.bool(true,  "Рисовать слой A", inline = "a", group = gA)
lbA    = input.int(3, "глубина", minval = 1, maxval = 10, inline = "a", group = gA, tooltip = "Слой A. 3 = метки 3/3. Метка появляется через столько же баров после факта — раньше её знать нельзя.")
drawB  = input.bool(false, "Рисовать слой B", inline = "b", group = gA)
lbB    = input.int(2, "глубина", minval = 1, maxval = 10, inline = "b", group = gA, tooltip = "Слой B. Второй слой поверх первого: быстрая глубина показывает то, что медленная не видит. Выключен по умолчанию.")
labWho = input.string("A", "Чьи метки подписывать", options = ["A", "B", "оба", "ничьи"], group = gA, tooltip = "Подписи двух слоёв накладываются друг на друга, поэтому обычно подписывают один. Второй виден зиг-загом.")

gB = "② Что рисовать"
showZZ  = input.bool(true,  "Зиг-заг по коленам", group = gB)
showRaw = input.bool(false, "Сырые пивоты слоя A", group = gB, tooltip = "Маленькие треугольники на самих пивотах. Если рядом два одной стороны — они слились в одно колено.")
winBars = input.int(700,  "Рисовать за последние N баров", minval = 100, group = gB)

gC = "③ Цвета"
cHiA = input.color(#e0342c, "A: вершина / низ", inline = "ca", group = gC)
cLoA = input.color(#00b050, "",                 inline = "ca", group = gC)
cHiB = input.color(color.new(#e0342c, 45), "B: вершина / низ", inline = "cb", group = gC)
cLoB = input.color(color.new(#00b050, 45), "",                 inline = "cb", group = gC)
cZZA = input.color(color.new(color.gray, 35), "Зиг-заг A / B", inline = "cz", group = gC)
cZZB = input.color(color.new(color.gray, 70), "",              inline = "cz", group = gC)
zzWA = input.int(1, "Толщина зиг-зага A / B", minval = 1, maxval = 4, inline = "zw", group = gC)
zzWB = input.int(1, "", minval = 1, maxval = 4, inline = "zw", group = gC)

MAXK = 200

// ══════════════ КОЛЕНА ══════════════
// Массивы передаются в функции по ссылке, поэтому один и тот же код
// обслуживает оба слоя — копий логики нет.
var float[]  AP = array.new_float()
var int[]    AB = array.new_int()
var bool[]   AH = array.new_bool()
var string[] AL = array.new_string()
var int[]    AM = array.new_int()

var float[]  BP = array.new_float()
var int[]    BB = array.new_int()
var bool[]   BH = array.new_bool()
var string[] BL = array.new_string()
var int[]    BM = array.new_int()

// метка колена: сравнение с предыдущим коленом той же стороны
f_relabel(_P, _H, _L) =>
    array.clear(_L)
    n = array.size(_P)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(_H, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(_H, j) == hi
                    prev := array.get(_P, j)
                    break
                j -= 1
            cur = array.get(_P, i)
            array.push(_L, na(prev) ? "?" : hi ? (cur > prev ? "HH" : "LH") : (cur > prev ? "HL" : "LL"))
    n

// серия пивотов одной стороны схлопывается в свой экстремум
f_push(_P, _B, _H, _L, _M, _price, _bar, _hi) =>
    n = array.size(_P)
    bool same = false
    if n > 0
        same := array.get(_H, n - 1) == _hi
    if same
        old = array.get(_P, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(_M, n - 1, array.get(_M, n - 1) + 1)
        if better
            array.set(_P, n - 1, _price)
            array.set(_B, n - 1, _bar)
    else
        array.push(_P, _price)
        array.push(_B, _bar)
        array.push(_H, _hi)
        array.push(_M, 1)
        if array.size(_P) > MAXK
            array.shift(_P)
            array.shift(_B)
            array.shift(_H)
            array.shift(_M)
    d = f_relabel(_P, _H, _L)
    0

pvHA = ta.pivothigh(high, lbA, lbA)
pvLA = ta.pivotlow (low,  lbA, lbA)
pvHB = ta.pivothigh(high, lbB, lbB)
pvLB = ta.pivotlow (low,  lbB, lbB)

if barstate.isconfirmed
    if not na(pvHA)
        q1 = f_push(AP, AB, AH, AL, AM, high[lbA], bar_index - lbA, true)
    if not na(pvLA)
        q2 = f_push(AP, AB, AH, AL, AM, low[lbA],  bar_index - lbA, false)
    if not na(pvHB)
        q3 = f_push(BP, BB, BH, BL, BM, high[lbB], bar_index - lbB, true)
    if not na(pvLB)
        q4 = f_push(BP, BB, BH, BL, BM, low[lbB],  bar_index - lbB, false)

plotshape(showRaw and not na(pvHA) ? pvHA : na, title = "сырая вершина A", style = shape.triangledown, location = location.absolute, color = color.new(cHiA, 35), size = size.tiny, offset = -lbA)
plotshape(showRaw and not na(pvLA) ? pvLA : na, title = "сырой низ A",     style = shape.triangleup,   location = location.absolute, color = color.new(cLoA, 35), size = size.tiny, offset = -lbA)

// ══════════════ ОТРИСОВКА МЕТОК ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()

f_draw(_P, _B, _H, _L, _M, _cHi, _cLo, _cZZ, _w, _tag, _lab) =>
    n = array.size(_P)
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(_B, i - 1)
            x2 = array.get(_B, i)
            if last_bar_index - x1 <= winBars
                if showZZ
                    array.push(LNS, line.new(x1, array.get(_P, i - 1), x2, array.get(_P, i), color = _cZZ, width = _w))
                if _lab
                    lb = array.get(_L, i)
                    pr = array.get(_P, i)
                    hi = array.get(_H, i)
                    mc = array.get(_M, i)
                    array.push(LBS, label.new(x2, pr, lb, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = hi ? _cHi : _cLo, size = size.small, tooltip = "слой " + _tag + "   " + lb + "  " + str.tostring(pr, format.mintick) + "\n" + (hi ? "вершина" : "низ") + (mc >= 2 ? "\nслилось сырых меток: " + str.tostring(mc) : "")))
    n

if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))
    if drawB
        d2 = f_draw(BP, BB, BH, BL, BM, cHiB, cLoB, cZZB, zzWB, str.tostring(lbB) + "/" + str.tostring(lbB), labWho == "B" or labWho == "оба")
    if drawA
        d1 = f_draw(AP, AB, AH, AL, AM, cHiA, cLoA, cZZA, zzWA, str.tostring(lbA) + "/" + str.tostring(lbA), labWho == "A" or labWho == "оба")

// ══════════════ УРОВНИ HH/LL/LH/HL — текущий ТФ, 4H, 1D ══════════════
// Уровень существует, пока не пробит: как только цена его прошла — он
// умирает и не рисуется. Живых уровней бывает около сотни, поэтому
// рисуются только N ближайших к цене с каждой стороны на каждом ТФ.
// HH и LL — пунктир, LH и HL — точки. Толщина растёт с таймфреймом.
gL = "④ Уровни HH/LL/LH/HL"
lvOn    = input.bool(true, "Показывать уровни", group = gL)
lv_tf1  = input.bool(true, "текущий ТФ", inline = "lv", group = gL)
lv_tf4  = input.bool(true, "4H",         inline = "lv", group = gL)
lv_tfd  = input.bool(true, "1D",         inline = "lv", group = gL)
lvLH    = input.bool(true, "Штрихи для LH и HL", group = gL, tooltip = "Неперебитые LH сверху и HL снизу. HH и LL — пунктир, LH и HL — точки.")
lvLB    = input.int(3, "Глубина пивота уровней", minval = 1, maxval = 8, group = gL, tooltip = "3 — как слой A по умолчанию. Поставьте 2, чтобы вернуть глубину Тренажёра.")
lv_n    = input.int(3, "Ближайших к цене с каждой стороны", minval = 1, maxval = 10, group = gL)
lvTransp= input.int(40, "Прозрачность", minval = 0, maxval = 90, group = gL)
cLvH    = input.color(color.green, "верх / низ", inline = "lc", group = gL)
cLvL    = input.color(color.red,   "",           inline = "lc", group = gL)

lph = ta.pivothigh(high, lvLB, lvLB)
lpl = ta.pivotlow (low,  lvLB, lvLB)
lphv = high[lvLB]
lplv = low[lvLB]
a1 = ta.valuewhen(not na(lph), lphv, 1)
a2 = ta.valuewhen(not na(lph), lphv, 0)
hh1 = na(lph) ? na : a1 < a2 ? lph : na
lh1 = na(lph) ? na : a1 > a2 ? lph : na
a3 = ta.valuewhen(not na(lpl), lplv, 1)
a4 = ta.valuewhen(not na(lpl), lplv, 0)
ll1 = na(lpl) ? na : a3 > a4 ? lpl : na
hl1 = na(lpl) ? na : a3 < a4 ? lpl : na

ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, lvLB, lvLB), lookahead = barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  lvLB, lvLB), lookahead = barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[lvLB], lookahead = barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[lvLB],  lookahead = barmerge.lookahead_off)
b1 = ta.valuewhen(not na(ph4), ph4v, 1)
b2 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b1 < b2 ? ph4 : na
lh4 = na(ph4) ? na : b1 > b2 ? ph4 : na
b3 = ta.valuewhen(not na(pl4), pl4v, 1)
b4 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b3 > b4 ? pl4 : na
hl4 = na(pl4) ? na : b3 < b4 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, lvLB, lvLB), lookahead = barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  lvLB, lvLB), lookahead = barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[lvLB], lookahead = barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[lvLB],  lookahead = barmerge.lookahead_off)
c1 = ta.valuewhen(not na(phd), phdv, 1)
c2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : c1 < c2 ? phd : na
lhd = na(phd) ? na : c1 > c2 ? phd : na
c3 = ta.valuewhen(not na(pld), pldv, 1)
c4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : c3 > c4 ? pld : na
hld = na(pld) ? na : c3 < c4 ? pld : na

var float[] HH1P = array.new_float()
var int[]   HH1B = array.new_int()
var float[] LL1P = array.new_float()
var int[]   LL1B = array.new_int()
var float[] LH1P = array.new_float()
var int[]   LH1B = array.new_int()
var float[] HL1P = array.new_float()
var int[]   HL1B = array.new_int()
var float[] HH4P = array.new_float()
var int[]   HH4B = array.new_int()
var float[] LL4P = array.new_float()
var int[]   LL4B = array.new_int()
var float[] LH4P = array.new_float()
var int[]   LH4B = array.new_int()
var float[] HL4P = array.new_float()
var int[]   HL4B = array.new_int()
var float[] HHDP = array.new_float()
var int[]   HHDB = array.new_int()
var float[] LLDP = array.new_float()
var int[]   LLDB = array.new_int()
var float[] LHDP = array.new_float()
var int[]   LHDB = array.new_int()
var float[] HLDP = array.new_float()
var int[]   HLDB = array.new_int()

f_addNow(_p, _b, _v) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - lvLB)
    0
f_addHTF(_p, _b, _v, _prev) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
    0

x1_ = f_addNow(HH1P, HH1B, hh1)
x2_ = f_addNow(LL1P, LL1B, ll1)
x3_ = f_addNow(LH1P, LH1B, lh1)
x4_ = f_addNow(HL1P, HL1B, hl1)
x5_ = f_addHTF(HH4P, HH4B, hh4, nz(hh4[1]))
x6_ = f_addHTF(LL4P, LL4B, ll4, nz(ll4[1]))
x7_ = f_addHTF(LH4P, LH4B, lh4, nz(lh4[1]))
x8_ = f_addHTF(HL4P, HL4B, hl4, nz(hl4[1]))
x9_ = f_addHTF(HHDP, HHDB, hhd, nz(hhd[1]))
xa_ = f_addHTF(LLDP, LLDB, lld, nz(lld[1]))
xb_ = f_addHTF(LHDP, LHDB, lhd, nz(lhd[1]))
xc_ = f_addHTF(HLDP, HLDB, hld, nz(hld[1]))

// уровень существует, пока не пробит
f_purge(_p, _b, _isHi) =>
    i = 0
    while i < array.size(_p)
        if (_isHi and high >= array.get(_p, i)) or (not _isHi and low <= array.get(_p, i))
            array.remove(_p, i)
            array.remove(_b, i)
        else
            i += 1
    0

y1_ = f_purge(HH1P, HH1B, true)
y2_ = f_purge(LL1P, LL1B, false)
y3_ = f_purge(LH1P, LH1B, true)
y4_ = f_purge(HL1P, HL1B, false)
y5_ = f_purge(HH4P, HH4B, true)
y6_ = f_purge(LL4P, LL4B, false)
y7_ = f_purge(LH4P, LH4B, true)
y8_ = f_purge(HL4P, HL4B, false)
y9_ = f_purge(HHDP, HHDB, true)
ya_ = f_purge(LLDP, LLDB, false)
yb_ = f_purge(LHDP, LHDB, true)
yc_ = f_purge(HLDP, HLDB, false)

var line[] LVL = array.new<line>()

f_nearest(_p, _b, _col, _w, _st) =>
    if array.size(_p) > 0
        bool[] used = array.new_bool(array.size(_p), false)
        for k = 1 to lv_n
            best = -1
            float bestd = 1.0e18
            for i = 0 to array.size(_p) - 1
                if not array.get(used, i)
                    d = math.abs(array.get(_p, i) - close)
                    if d < bestd
                        bestd := d
                        best := i
            if best >= 0
                array.set(used, best, true)
                // левый край не дальше буфера истории, иначе в симуляторе
                // линия просит бар за пределами доступного
                xl = math.max(array.get(_b, best), bar_index - 2900)
                array.push(LVL, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(_col, lvTransp), width = _w, style = _st, extend = extend.right))
    0

if barstate.islast
    while array.size(LVL) > 0
        line.delete(array.pop(LVL))
    if lvOn and lv_tf1
        z1 = f_nearest(HH1P, HH1B, cLvH, 1, line.style_dashed)
        z2 = f_nearest(LL1P, LL1B, cLvL, 1, line.style_dashed)
        if lvLH
            z3 = f_nearest(LH1P, LH1B, cLvH, 1, line.style_dotted)
            z4 = f_nearest(HL1P, HL1B, cLvL, 1, line.style_dotted)
    if lvOn and lv_tf4
        z5 = f_nearest(HH4P, HH4B, cLvH, 2, line.style_dashed)
        z6 = f_nearest(LL4P, LL4B, cLvL, 2, line.style_dashed)
        if lvLH
            z7 = f_nearest(LH4P, LH4B, cLvH, 2, line.style_dotted)
            z8 = f_nearest(HL4P, HL4B, cLvL, 2, line.style_dotted)
    if lvOn and lv_tfd
        z9 = f_nearest(HHDP, HHDB, cLvH, 3, line.style_dashed)
        za = f_nearest(LLDP, LLDB, cLvL, 3, line.style_dashed)
        if lvLH
            zb = f_nearest(LHDP, LHDB, cLvH, 3, line.style_dotted)
            zc = f_nearest(HLDP, HLDB, cLvL, 3, line.style_dotted)
