var float[]  PV3n = array.new_float()
var int[]    BV3n = array.new_int()
var bool[]   HV3n = array.new_bool()
var string[] LV3n = array.new_string()
var int[]    MV3n = array.new_int()
var float[]  GV3n = array.new_float()
var int[]    YV3n = array.new_int()
var bool[]   ZV3n = array.new_bool()
var string[] WV3n = array.new_string()

// сколько вставок уже взято в ТЕКУЩЕЙ ноге каждого из четырёх комплектов
var int[] VCN = array.new_int(4, 0)
// дал ли уже 3/3 метку в текущей ноге слоя 5/5. Нужен для запасного
// донора: он подключается, только когда первый донор молчит
var bool[] VF3 = array.new_bool(2, false)
// сколько вставок реально СТАЛО коленом. 0 — 5/5 настоящий мир,
// 1 — 3/3 настоящий, 2 — 5/5 перевёрнутый, 3 — 3/3 перевёрнутый
var int[] VINS = array.new_int(4, 0)

// З22, 29.09.2026. Вставка, совпадающая по стороне с последним коленом
// цепочки, в счёт идти НЕ должна. f_push такую не добавляет, а ПОГЛОЩАЕТ:
// колено не появляется, счёт не шагает, а цена колена самого слоя может
// ещё и сдвинуться на вставку. Замер на девяти годах: 1316 поглощений и
// 268 сдвигов цены колена слоя при потолке 2.
//
// Отрисовка так никогда не делала: внутри ноги она берёт строго
// ЧЕРЕДУЮЩУЮСЯ цепочку. Отсюда и слова владельца «зиг-заг видит
// правильно, счёт пропускает». Теперь счёт чередуется так же.
//
// ОШИБКА 29.09.2026, RE10045 на баре 0. Сначала было написано
// `n == 0 or array.get(_H, n - 1) != _hi`. Пайн НЕ обрывает `or`: он
// считает обе половины, и при пустом массиве array.get(_H, -1) падает.
// Это ровно то, в чём я не был уверен 22.09 и о чём оставил в файле
// оговорку «проверить нечем». Теперь проверено рынком: обрыва нет.
f_altOk(_H, _hi) =>
    n = array.size(_H)
    bool r = true
    if n > 0
        r := array.get(_H, n - 1) != _hi
    r

f_relabel(_P, _H, _L) =>
    array.clear(_L)
    n = array.size(_P)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(_H, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(_H, j) == hi
                    prev := array.get(_P, j)
                    break
                j -= 1
            cur = array.get(_P, i)
            array.push(_L, na(prev) ? "?" : hi ? (cur > prev ? "HH" : "LH") : (cur > prev ? "HL" : "LL"))
    n

// Метка, которая проявилась, не должна пропадать. При слиянии двух
// пивотов одной стороны проигравший уходит в список поглощённых и
// остаётся видимым на своём месте. Подпись считается от ПРЕДЫДУЩЕГО
// колена той же стороны, а не от того, в которое метка влилась.
f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi) =>
    n = array.size(_P)
    float prev = na
    j = n - 2
    while j >= 0
        if array.get(_H, j) == _hi
            prev := array.get(_P, j)
            break
        j -= 1
    array.push(_G, _price)
    array.push(_Y, _bar)
    array.push(_Z, _hi)
    array.push(_W, na(prev) ? "?" : _hi ? (_price > prev ? "HH" : "LH") : (_price > prev ? "HL" : "LL"))
    if array.size(_G) > MAXK
        array.shift(_G)
        array.shift(_Y)
        array.shift(_Z)
        array.shift(_W)
    0

f_push(_P, _B, _H, _L, _M, _G, _Y, _Z, _W, _price, _bar, _hi) =>
    n = array.size(_P)
    bool same = false
    if n > 0
        same := array.get(_H, n - 1) == _hi
    if same
        old = array.get(_P, n - 1)
        oldB = array.get(_B, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(_M, n - 1, array.get(_M, n - 1) + 1)
        if better
            a1 = f_absorb(_G, _Y, _Z, _W, _P, _H, old, oldB, _hi)
            array.set(_P, n - 1, _price)
            array.set(_B, n - 1, _bar)
        else
            a2 = f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi)
    else
        array.push(_P, _price)
        array.push(_B, _bar)
        array.push(_H, _hi)
        array.push(_M, 1)
        if array.size(_P) > MAXK
            array.shift(_P)
            array.shift(_B)
            array.shift(_H)
            array.shift(_M)
    d = f_relabel(_P, _H, _L)
    not same

// ══════════════ ВОСХОДЯЩИЙ ТРЕНД, ТРИ СЛОЯ ══════════════
// Правила владельца, indicator/ВОСХОДЯЩИЙ.md:
//
//   рождение — ноль на низ перед первой HH. Этот низ должен быть LL;
//     HL допускается только как ПРОДОЛЖЕНИЕ, если прошлый тренд был
//     восходящий и его счёт дошёл до (3) или дальше;
//   счёт — чередование колен от нуля, нечётная точка вершина, чётная
//     низ. Встречная подпись счёт НЕ обрывает: (2) в идеале HL, но может
//     быть LL — это манипуляция, а не конец счёта;
//   уровень — ПОСЛЕДНИЙ появившийся HL. Заменяет предыдущий безусловно,
//     выше тот оказался или ниже. Храповика здесь нет намеренно;
//   смерть — тело за уровень на имп x 0.33, либо N закрытий подряд ниже
//     уровня. Замер Н7 их не различил, поэтому переключатель.
// Состояние держится ПО СЛОЯМ: индекс 0 = 5/5, 1 = 3/3, 2 = 2/2.
// Движков теперь три, по одному на слой, и считают они независимо друг
// от друга. В табло стоят три колонки, а на графике рисуется тот слой,
// который выбран в ① — если включено несколько, самый медленный.
// Бары держим числом, -1 значит «нет»: пайн капризен с na в массивах.
//
// 23.09.2026 ячеек стало ШЕСТЬ. Индексы 0-2 — восходящий на слоях
// 5/5, 3/3, 2/2. Индексы 3-5 — НИСХОДЯЩИЙ на тех же слоях, посчитанный
// тем же движком на ПЕРЕВЁРНУТЫХ коленах. Сама f_trend об этом не
// знает и не должна: она работает по индексу, ей всё равно, какой мир
// ей подали.
//
// ВНИМАНИЕ: цены в ячейках 3-5 ОТРИЦАТЕЛЬНЫЕ — это перевёрнутый мир.
// Всё, что идёт на экран и в табло, переворачивается обратно. В историю
// сломов цена кладётся уже настоящей, знаком внутри f_trend.
var int[]    tTR  = array.new_int(10, 0)        // 0 нет тренда, 1 восходящий
var int[]    tZB  = array.new_int(10, -1)       // бар колена-нуля
var float[]  tZP  = array.new_float(10, na)     // его цена
var string[] tZL  = array.new_string(10, "")    // его подпись
var float[]  tLVL = array.new_float(10, na)     // уровень — последний HL
var int[]    tLVB = array.new_int(10, -1)
var bool[]   tLHL = array.new_bool(10, false)   // уровень на настоящем HL
var int[]    tCNT = array.new_int(10, -1)       // номер последней точки
var int[]    tMAX = array.new_int(10, -1)       // докуда счёт дошёл
var float[]  tIMP = array.new_float(10, 0.0)    // импульсное колено
var int[]    tBEL = array.new_int(10, 0)        // закрытий подряд ниже
var bool[]   tPUP = array.new_bool(10, false)   // прошлый был восходящий
var int[]    tPMX = array.new_int(10, -1)
var float[]  tDP  = array.new_float(10, na)     // цена слома
var int[]    tDB  = array.new_int(10, -1)       // бар слома
var int[]    tBB  = array.new_int(10, -1)       // бар рождения
var int[]    tPZB = array.new_int(10, -1)       // ноль ПРОШЛОГО счёта
// ЗЕЛЁНЫЙ СЛОМ — слом нисходящей структуры. Цена от LL перебила вершину
// и сделала HH. Чёрточка встаёт на цене перебитой вершины сразу, а до
// подтверждения ноги счёта рисуются тонкими
// ИСТОРИЯ СЛОМОВ, плоскими списками: бар, цена, слой. Рисуем все, что
// попали в окно, а не только последний. Слой 5/5 показывается всегда,
// как контекст; 3/3 и 2/2 — только когда выбраны основным
var int[]   RDB = array.new_int()      // красный слом: бар
var float[] RDP = array.new_float()    //               цена
var int[]   RDL = array.new_int()      //               слой
var int[]   GDB = array.new_int()      // зелёный слом: бар
var float[] GDP = array.new_float()    //               цена
var int[]   GDL = array.new_int()      //               слой
var bool[]  GOK = array.new_bool()     //               подтверждён
MAXSL = 600      // движков стало два, сломов вдвое больше

// ── ПЕРЕКЛЮЧЕНИЯ «АВТО» ──
// 28.09.2026, вопрос владельца: что именно переключает «авто» — только
// картинку или ещё и счёт. Счёт сейчас идёт у обоих направлений всегда
// (им управляют trOn5 и trDn), а trWho выбирает только, кого нарисовать.
// Поэтому тренд, на который «авто» переключилось, появляется уже со
// счётом, набранным пока он был невидим.
//
// Здесь запоминается, на каком баре «авто» в последний раз сменило
// направление по каждому слою. Движок этим не пользуется — только
// отрисовка, и только если владелец переключит trCntSw.
var int[]  swB = array.new_int(3, -1)        // бар последней смены
var bool[] swD = array.new_bool(3, false)    // что рисуем: true нисходящий
var bool[] swI = array.new_bool(3, false)    // решение уже принималось
// РЕЖИМ, а не флаг: 0 веду восходящий, 1 веду нисходящий, -1 никого.
// -2 значит «ещё не считали ни разу»
var int[]  SWM = array.new_int(3, -2)
// история переключений для меток на графике
var int[]  AWB = array.new_int()             // бар
var int[]  AWL = array.new_int()             // слой
var bool[] AWD = array.new_bool()            // на что переключились
var float[] AWP = array.new_float()          // цена закрытия на этом баре

var float[]  tBP  = array.new_float(10, na)     // цена перебитой вершины
var int[]    tBB2 = array.new_int(10, -1)       // бар зелёного слома
var bool[]   tBOK = array.new_bool(10, false)   // подтверждён ли
var int[]    tBAB = array.new_int(10, 0)        // закрытий подряд выше

// ══════════════ СПРАВОЧНИК ПОСЛЕДОВАТЕЛЬНОСТЕЙ ══════════════
// Перепись 9 лет часовика, research/spravochnik_niz.py. Низы в
// восходящем всегда HL — иначе это не восходящий, — поэтому свободны
// только вершины и вариантов ровно восемь. Ноль пишется первым: LL у
// рождения, HL у продолжения. Индикатор НЕ предсказывает: он узнаёт
// форму и называет её номером, как шаблон триггерной свечи.
//
// МЕТОД, 22.09.2026 (Н15). Обе половины считаются ОДНИМ способом —
// переписью: от каждого колена-низа берутся следующие пять колен и
// записываются подписи. Никаких правил тренда, это перепись, а не
// движок.
//
// До 22.09 половины считались по-разному: рождения переписью, а
// продолжения цепочками из spisok.py, где блок засчитывался только
// внутри цепочки, у которой КАЖДЫЙ блок дошёл до (5) с низами HL.
// Числа расходились в шесть раз и больше — 9 против 51, 16 против 137, —
// а в подсказке стояли рядом и читались как одно и то же.
// Решение владельца: считать обе половины переписью.
var string[] PAT = array.from("LH·HL·HH·HL·HH","LH·HL·HH·HL·LH","HH·HL·HH·HL·HH","HH·HL·HH·HL·LH","HH·HL·LH·HL·HH","LH·HL·LH·HL·HH","HH·HL·LH·HL·LH","LH·HL·LH·HL·LH")
var string[] PNM = array.from("П1","П5","П6","П12","П16","П20","П25","П29")
// сколько раз встретилось за 9 лет: [рождения 5/5, 3/3, 2/2, продолжения 5/5, 3/3, 2/2]
var int[] PFR = array.from(100,73,59,44,30,29,12,2, 133,95,96,67,71,38,31,13, 187,116,129,104,96,64,39,26, 51,29,137,92,65,3,15,1, 64,39,157,118,87,7,24,9, 113,60,208,166,135,17,34,3)

// ── СПРАВОЧНИК НИСХОДЯЩЕГО ──
// В перевёрнутом мире нисходящий — это буквально восходящий, поэтому
// строки PAT подходят как есть, а f_seqNow и f_match работают без
// единой правки. Переводится обратно только то, что идёт на экран.
//
// Нумерация ЗЕРКАЛЬНАЯ: С1 это зеркало П1, С5 зеркало П5 и так далее.
// Буква С от «спуск»; Н занята наблюдениями. Так две таблицы кладутся
// рядом и сравниваются напрямую.
//
// Перепись девяти лет, research/spravochnik_niz.py. Обе половины одним
// методом, как и у восходящего после Н15.
var string[] SNM = array.from("С1","С5","С6","С12","С16","С20","С25","С29")
// [рождения 5/5, 3/3, 2/2, продолжения 5/5, 3/3, 2/2], порядок форм как в PAT
var int[] SFR = array.from(82,62,44,60,42,23,15,4, 97,90,75,76,69,40,28,14, 152,107,109,107,98,59,45,11, 30,28,72,78,48,3,16,0, 50,51,88,100,64,20,23,4, 76,56,123,156,95,18,46,10)

// подпись из перевёрнутого мира в настоящий: HH<->LL, HL<->LH
f_swap1(_x) =>
    _x == "HH" ? "LL" : _x == "LL" ? "HH" : _x == "HL" ? "LH" : _x == "LH" ? "HL" : _x

// то же для целой цепочки через точку
f_swapSeq(_s) =>
    string r = ""
    arr = str.split(_s, "·")
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            r := r + (i == 0 ? "" : "·") + f_swap1(array.get(arr, i))
    r

var table TBL = table.new(position.top_right, 4, 24, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 80))

// последний зелёный слом слоя _i в истории, -1 если нет
f_lastG(_i) =>
    int r = -1
    n = array.size(GDL)
    if n > 0
        for k = n - 1 to 0
            if array.get(GDL, k) == _i
                r := k
                break
    r

// Текущая последовательность слоя _i: подпись нуля и хвост от (1).
// Возвращает [подпись нуля, хвост, сколько точек в хвосте]
f_seqNow(_P, _B, _H, _L, _i) =>
    string zlab = ""
    string tail = ""
    int np = 0
    if array.get(tTR, _i) == 1 and array.get(tZB, _i) >= 0
        n = array.size(_P)
        int zi = -1
        if n > 0
            for k = 0 to n - 1
                // ноль ищется не только по бару, но и ПО СТОРОНЕ. Он всегда
                // НИЗ: LL при рождении, HL при продолжении. Большая свеча
                // умеет сделать и вершину, и низ сразу — тогда два колена
                // сидят на одном баре, и поиск «по бару» хватал вершину
                if array.get(_B, k) >= array.get(tZB, _i) and not array.get(_H, k)
                    zi := k
                    break
        if zi >= 0
            zlab := array.get(_L, zi)
            int last = math.min(zi + 5, n - 1)
            if last >= zi + 1
                for k = zi + 1 to last
                    tail := tail + (np == 0 ? "" : "·") + array.get(_L, k)
                    np += 1
    [zlab, tail, np]

// Сколько эталонов ещё подходят под этот хвост и как они называются
f_match(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(PNM, p)
    [cnt, idx, nms]

// То же, что f_match, но имена берутся из справочника НИСХОДЯЩЕГО.
// Строки PAT одни и те же: в перевёрнутом мире нисходящий — это
// буквально восходящий, меняются только номера.
f_matchS(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(SNM, p)
    [cnt, idx, nms]

// Один шаг движка для слоя _i. Вся логика та же, что была у 5/5, просто
// состояние читается и пишется по индексу слоя.
// _o и _c — открытие и закрытие. Раньше функция читала свечу напрямую;
// 23.09.2026 они стали параметрами, иначе нисходящий на ПЕРЕВЁРНУТЫХ
// коленах брал бы настоящую свечу и сравнивал с перевёрнутым уровнем.
// Восходящий зовёт её с open, close — для него не меняется ничего.
f_trend(_i, _P, _B, _H, _L, _nw, _fr, _o, _c) =>
    n = array.size(_P)
    // в ИСТОРИЮ сломов цена кладётся настоящей: ячейки 3-5 живут в
    // перевёрнутом мире, и без этого чёрточки уехали бы под график
    // перевёрнутый мир: ячейки 3-5 (нисходящий по чистым коленам) и
    // 8-9 (нисходящий по объединённым). 6-7 — восходящий объединённый,
    // мир настоящий
    float sg = (_i >= 3 and _i <= 5) or _i >= 8 ? -1.0 : 1.0
    // 1. смерть проверяется КАЖДЫЙ бар, а не только на колене
    if array.get(tTR, _i) == 1 and not na(array.get(tLVL, _i))
        lv = array.get(tLVL, _i)
        im = array.get(tIMP, _i)
        bLo = math.min(_o, _c)
        bool okA = bLo < lv - im * trFib
        array.set(tBEL, _i, _c < lv ? array.get(tBEL, _i) + 1 : 0)
        bool okB = array.get(tBEL, _i) >= trNbar
        bool died = trDeath == "имп × 0.33" ? okA : trDeath == "4 закрытия ниже" ? okB : trDeath == "оба" ? (okA and okB) : (okA or okB)
        if died
            array.set(tPUP, _i, true)
            array.set(tPMX, _i, array.get(tMAX, _i))
            array.set(tDP,  _i, lv)
            array.set(tDB,  _i, bar_index)
            array.set(tTR,  _i, 0)
            array.set(tCNT, _i, -1)
            array.set(tZB,  _i, -1)
            array.set(tPZB, _i, -1)
            array.set(tLVL, _i, na)
            array.set(tBEL, _i, 0)
            array.set(tBAB, _i, 0)
            // красный слом уходит в историю. Зелёную метку НЕ гасим:
            // она отмечает событие, которое было, а событие не отменяется
            // тем, что тренд потом умер
            array.push(RDB, bar_index)
            array.push(RDP, lv * sg)
            array.push(RDL, _i)
            if array.size(RDB) > MAXSL
                array.shift(RDB)
                array.shift(RDP)
                array.shift(RDL)
    // 1b. подтверждение ЗЕЛЁНОГО слома — тоже каждый бар
    if array.get(tTR, _i) == 1 and not na(array.get(tBP, _i)) and not array.get(tBOK, _i)
        bp = array.get(tBP, _i)
        array.set(tBAB, _i, _c > bp ? array.get(tBAB, _i) + 1 : 0)
        bool bA = math.max(_o, _c) > bp + array.get(tIMP, _i) * trFib
        bool bB = array.get(tBAB, _i) >= trNbar
        if (trBrk == "имп × 0.33" and bA) or (trBrk == "4 закрытия выше" and bB)
            array.set(tBOK, _i, true)
            gi = f_lastG(_i)
            if gi >= 0
                array.set(GOK, gi, true)
    // 2. новое колено: счёт, уровень, рождение
    if _fr and n >= 2
        lb  = array.get(_L, n - 1)
        hiK = array.get(_H, n - 1)
        prK = array.get(_P, n - 1)
        bbK = array.get(_B, n - 1)
        ppK = array.get(_P, n - 2)
        if prK > ppK
            array.set(tIMP, _i, prK - ppK)
        if array.get(tTR, _i) == 1
            // §5: первый HL после (5) начинает НОВЫЙ счёт и сам стаёт нулём
            bool restart = _nw and array.get(tCNT, _i) >= 5 and not hiK and lb == "HL"
            if restart
                array.set(tPZB, _i, array.get(tZB, _i))
                array.set(tZB,  _i, bbK)
                array.set(tZP,  _i, prK)
                array.set(tZL,  _i, lb)
                array.set(tCNT, _i, 0)
                array.set(tMAX, _i, 0)
                array.set(tLVL, _i, prK)
                array.set(tLVB, _i, bbK)
                array.set(tLHL, _i, true)
                array.set(tBEL, _i, 0)
            else
                if _nw and array.get(tCNT, _i) < 5
                    array.set(tCNT, _i, array.get(tCNT, _i) + 1)
                    array.set(tMAX, _i, math.max(array.get(tMAX, _i), array.get(tCNT, _i)))
                // уровень — последний HL, безусловно
                if not hiK and lb == "HL"
                    array.set(tLVL, _i, prK)
                    array.set(tLVB, _i, bbK)
                    array.set(tLHL, _i, true)
                    array.set(tBEL, _i, 0)
                    // первый HL после HH подтверждает зелёный слом
                    if trBrk == "HL"
                        array.set(tBOK, _i, true)
                        gj = f_lastG(_i)
                        if gj >= 0
                            array.set(GOK, gj, true)
        else
            // РОЖДЕНИЕ: пришла HH, ноль — ближайший назад LL.
            //
            // Ноль ищется НЕ вплотную перед HH, а до пяти колен назад,
            // перешагивая HL. Иначе движок запирается: стоит после LL
            // прийти вершине LH, как все следующие низы становятся HL, и
            // условие «низ прямо перед HH должен быть LL» не выполнится
            // уже никогда. 21.09.2026 так пропали 180 пунктов роста на
            // всех трёх слоях сразу: отказов 7 на 2/2, 5 на 3/3, 2 на 5/5.
            //
            // Перепись девяти лет говорит то же: 58% рождений на 5/5
            // начинаются с LH, и старое правило не видело их в принципе.
            if hiK and lb == "HH"
                int j = -1
                int step = 0
                // 02.10.2026, слово владельца «1в удаляй». Вариант «только
                // вплотную перед HH» убран вместе с настройкой: он ЗАПИРАЛ
                // движок — стоит после LL прийти вершине LH, как все
                // следующие низы становятся HL, и условие не выполнится уже
                // никогда. 21.09 так пропали 180 пунктов роста на всех трёх
                // слоях сразу. Перепись девяти лет: 58% рождений на 5/5
                // начинаются с LH, старое правило не видело их в принципе.
                // Выбора не осталось, поэтому и ручки больше нет.
                int back = 3
                int q = n - 2
                while q >= 0 and step < back
                    if not array.get(_H, q)
                        step += 1
                        if array.get(_L, q) == "LL"
                            j := q
                            break
                    q -= 1
                if j >= 0
                    zl = array.get(_L, j)
                    // расстояние от нуля до этой HH и есть её номер в счёте
                    int kFrom = n - 1 - j
                    bool ok = kFrom <= 5
                    if ok
                        array.set(tTR,  _i, 1)
                        array.set(tBB,  _i, bar_index)
                        array.set(tZB,  _i, array.get(_B, j))
                        array.set(tZP,  _i, array.get(_P, j))
                        array.set(tZL,  _i, zl)
                        array.set(tCNT, _i, kFrom)
                        array.set(tMAX, _i, kFrom)
                        // ноль всегда становится уровнем. HL — настоящий,
                        // сплошной; LL — временный, штрих-пунктир без подписи
                        array.set(tLVL, _i, array.get(_P, j))
                        array.set(tLVB, _i, array.get(_B, j))
                        array.set(tLHL, _i, zl == "HL")
                        array.set(tBEL, _i, 0)
                        // ЗЕЛЁНЫЙ СЛОМ: вершина, которую цена перебила по
                        // дороге от нуля к этой HH. Это колено-вершина
                        // перед нулём — то самое «LH или HH потом LL»
                        int v = j - 1
                        while v >= 0
                            if array.get(_H, v)
                                break
                            v -= 1
                        if v >= 0
                            array.set(tBP,  _i, array.get(_P, v))
                            array.set(tBB2, _i, bar_index)
                            array.set(tBOK, _i, zl == "HL" and trBrk == "HL")
                            array.set(tBAB, _i, 0)
                            array.push(GDB, bar_index)
                            array.push(GDP, array.get(_P, v) * sg)
                            array.push(GDL, _i)
                            array.push(GOK, zl == "HL" and trBrk == "HL")
                            if array.size(GDB) > MAXSL
                                array.shift(GDB)
                                array.shift(GDP)
                                array.shift(GDL)
                                array.shift(GOK)
                        else
                            array.set(tBP,  _i, na)
                            array.set(tBB2, _i, -1)
                            array.set(tBOK, _i, false)
    0

ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow (low,  5, 5)
ph3 = ta.pivothigh(high, 3, 3)
pl3 = ta.pivotlow (low,  3, 3)
ph2 = ta.pivothigh(high, 2, 2)
pl2 = ta.pivotlow (low,  2, 2)

if barstate.isconfirmed
    // nwN — родилось ли на слое НОВОЕ колено. Счёт двигается по коленам,
    // а не по сырым пивотам: слияние пивота в уже стоящее колено счёт не двигает
    bool nw5 = false
    bool nw3 = false
    bool nw2 = false
    if not na(ph5)
        q1 = f_push(P5, B5, H5, L5, M5, G5, Y5, Z5, W5, high[5], bar_index - 5, true)
        nw5 := nw5 or q1
    if not na(pl5)
        q2 = f_push(P5, B5, H5, L5, M5, G5, Y5, Z5, W5, low[5],  bar_index - 5, false)
        nw5 := nw5 or q2
    if not na(ph3)
        q3 = f_push(P3, B3, H3, L3, M3, G3, Y3, Z3, W3, high[3], bar_index - 3, true)
        nw3 := nw3 or q3
    if not na(pl3)
        q4 = f_push(P3, B3, H3, L3, M3, G3, Y3, Z3, W3, low[3],  bar_index - 3, false)
        nw3 := nw3 or q4
    if not na(ph2)
        q5 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, high[2], bar_index - 2, true)
        nw2 := nw2 or q5
    if not na(pl2)
        q6 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, low[2],  bar_index - 2, false)
        nw2 := nw2 or q6

    // ── ПЕРЕВЁРНУТЫЕ КОЛЕНА: та же f_push, минус-цена, сторона наоборот ──
    bool mw5 = false
    bool mw3 = false
    bool mw2 = false
    if not na(ph5)
        r1 = f_push(P5n, B5n, H5n, L5n, M5n, G5n, Y5n, Z5n, W5n, -high[5], bar_index - 5, false)
        mw5 := mw5 or r1
    if not na(pl5)
        r2 = f_push(P5n, B5n, H5n, L5n, M5n, G5n, Y5n, Z5n, W5n, -low[5],  bar_index - 5, true)
        mw5 := mw5 or r2
    if not na(ph3)
        r3 = f_push(P3n, B3n, H3n, L3n, M3n, G3n, Y3n, Z3n, W3n, -high[3], bar_index - 3, false)
        mw3 := mw3 or r3
    if not na(pl3)
        r4 = f_push(P3n, B3n, H3n, L3n, M3n, G3n, Y3n, Z3n, W3n, -low[3],  bar_index - 3, true)
        mw3 := mw3 or r4
    if not na(ph2)
        r5 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -high[2], bar_index - 2, false)
        mw2 := mw2 or r5
    if not na(pl2)
        r6 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -low[2],  bar_index - 2, true)
        mw2 := mw2 or r6

    // ── КОЛЕНА СЛОЁВ 5/5 и 3/3: свои пивоты ПЛЮС вставки донора ──
    // 30.09.2026, слово владельца: «не отдельным разделом в настройки, а
    // обязательным условием для нисходящего и восходящего тренда». Вставки
    // больше не второй комплект рядом — они внутри самих колен слоя, и по
    // ним считается всё: счёт, уровень, смерть, зиг-заг, справочник.
    // Ручка «Вставок в одну ногу» в положении 0 даёт ровно прежние колена.
    //
    // Вставка кладётся с ТЕМ ЖЕ лагом, что колено слоя: у 5/5 это пять
    // баров, поэтому колено 3/3 берётся как ph3[2] — оно с того же бара,
    // что и ph5. Так зиг-заг остаётся зиг-загом.
    bool vw5 = false
    bool vw3 = false
    bool vm5 = false
    bool vm3 = false
    // ─ 5/5 + вставки с 3/3, мир настоящий ─
    if not na(ph5)
        va1 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, high[5], bar_index - 5, true)
        if va1
            array.set(VCN, 0, 0)
            array.set(VF3, 0, false)
        vw5 := vw5 or va1
    else if not na(ph3[2]) and array.get(VCN, 0) < vsN and f_altOk(HV5, true)
        va2 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, high[5], bar_index - 5, true)
        if va2
            array.set(VCN, 0, array.get(VCN, 0) + 1)
            array.set(VINS, 0, array.get(VINS, 0) + 1)
            array.set(VF3, 0, true)
        vw5 := vw5 or va2
    else if vs2ok and not na(ph2[3]) and array.get(VCN, 0) < vsN and f_altOk(HV5, true) and (vs2all or not array.get(VF3, 0))
        va2b = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, high[5], bar_index - 5, true)
        if va2b
            array.set(VCN, 0, array.get(VCN, 0) + 1)
            array.set(VINS, 0, array.get(VINS, 0) + 1)
        vw5 := vw5 or va2b
    if not na(pl5)
        va3 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, low[5], bar_index - 5, false)
        if va3
            array.set(VCN, 0, 0)
            array.set(VF3, 0, false)
        vw5 := vw5 or va3
    else if not na(pl3[2]) and array.get(VCN, 0) < vsN and f_altOk(HV5, false)
        va4 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, low[5], bar_index - 5, false)
        if va4
            array.set(VCN, 0, array.get(VCN, 0) + 1)
            array.set(VINS, 0, array.get(VINS, 0) + 1)
            array.set(VF3, 0, true)
        vw5 := vw5 or va4
    else if vs2ok and not na(pl2[3]) and array.get(VCN, 0) < vsN and f_altOk(HV5, false) and (vs2all or not array.get(VF3, 0))
        va4b = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, low[5], bar_index - 5, false)
        if va4b
            array.set(VCN, 0, array.get(VCN, 0) + 1)
            array.set(VINS, 0, array.get(VINS, 0) + 1)
        vw5 := vw5 or va4b
    // ─ 3/3 + вставки с 2/2, мир настоящий ─
    if not na(ph3)
        vb1 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, high[3], bar_index - 3, true)
        if vb1
            array.set(VCN, 1, 0)
        vw3 := vw3 or vb1
    else if not na(ph2[1]) and array.get(VCN, 1) < vsN and f_altOk(HV3, true)
        vb2 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, high[3], bar_index - 3, true)
        if vb2
            array.set(VCN, 1, array.get(VCN, 1) + 1)
            array.set(VINS, 1, array.get(VINS, 1) + 1)
        vw3 := vw3 or vb2
    if not na(pl3)
        vb3 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, low[3], bar_index - 3, false)
        if vb3
            array.set(VCN, 1, 0)
        vw3 := vw3 or vb3
    else if not na(pl2[1]) and array.get(VCN, 1) < vsN and f_altOk(HV3, false)
        vb4 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, low[3], bar_index - 3, false)
        if vb4
            array.set(VCN, 1, array.get(VCN, 1) + 1)
            array.set(VINS, 1, array.get(VINS, 1) + 1)
        vw3 := vw3 or vb4
    // ─ то же ЗЕРКАЛЬНО: минус-цена, сторона наоборот ─
    if not na(ph5)
        vc1 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -high[5], bar_index - 5, false)
        if vc1
            array.set(VCN, 2, 0)
            array.set(VF3, 1, false)
        vm5 := vm5 or vc1
    else if not na(ph3[2]) and array.get(VCN, 2) < vsN and f_altOk(HV5n, false)
        vc2 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -high[5], bar_index - 5, false)
        if vc2
            array.set(VCN, 2, array.get(VCN, 2) + 1)
            array.set(VINS, 2, array.get(VINS, 2) + 1)
            array.set(VF3, 1, true)
        vm5 := vm5 or vc2
    else if vs2ok and not na(ph2[3]) and array.get(VCN, 2) < vsN and f_altOk(HV5n, false) and (vs2all or not array.get(VF3, 1))
        vc2b = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -high[5], bar_index - 5, false)
        if vc2b
            array.set(VCN, 2, array.get(VCN, 2) + 1)
            array.set(VINS, 2, array.get(VINS, 2) + 1)
        vm5 := vm5 or vc2b
    if not na(pl5)
        vc3 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -low[5], bar_index - 5, true)
        if vc3
            array.set(VCN, 2, 0)
            array.set(VF3, 1, false)
        vm5 := vm5 or vc3
    else if not na(pl3[2]) and array.get(VCN, 2) < vsN and f_altOk(HV5n, true)
        vc4 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -low[5], bar_index - 5, true)
        if vc4
            array.set(VCN, 2, array.get(VCN, 2) + 1)
            array.set(VINS, 2, array.get(VINS, 2) + 1)
            array.set(VF3, 1, true)
        vm5 := vm5 or vc4
    else if vs2ok and not na(pl2[3]) and array.get(VCN, 2) < vsN and f_altOk(HV5n, true) and (vs2all or not array.get(VF3, 1))
        vc4b = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -low[5], bar_index - 5, true)
        if vc4b
            array.set(VCN, 2, array.get(VCN, 2) + 1)
            array.set(VINS, 2, array.get(VINS, 2) + 1)
        vm5 := vm5 or vc4b
    if not na(ph3)
        vd1 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -high[3], bar_index - 3, false)
        if vd1
            array.set(VCN, 3, 0)
        vm3 := vm3 or vd1
    else if not na(ph2[1]) and array.get(VCN, 3) < vsN and f_altOk(HV3n, false)
        vd2 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -high[3], bar_index - 3, false)
        if vd2
            array.set(VCN, 3, array.get(VCN, 3) + 1)
            array.set(VINS, 3, array.get(VINS, 3) + 1)
        vm3 := vm3 or vd2
    if not na(pl3)
        vd3 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -low[3], bar_index - 3, true)
        if vd3
            array.set(VCN, 3, 0)
        vm3 := vm3 or vd3
    else if not na(pl2[1]) and array.get(VCN, 3) < vsN and f_altOk(HV3n, true)
        vd4 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -low[3], bar_index - 3, true)
        if vd4
            array.set(VCN, 3, array.get(VCN, 3) + 1)
            array.set(VINS, 3, array.get(VINS, 3) + 1)
        vm3 := vm3 or vd4
    bool fv5 = not na(ph5) or not na(pl5) or not na(ph3[2]) or not na(pl3[2]) or (vs2ok and (not na(ph2[3]) or not na(pl2[3])))
    bool fv3 = not na(ph3) or not na(pl3) or not na(ph2[1]) or not na(pl2[1])

    // ── шаг тренда: три слоя, два направления, шесть независимых движков ──
    // У 5/5 и 3/3 колена ОБЪЕДИНЁННЫЕ — со вставками, решение владельца
    // 30.09.2026. У 2/2 донора нет, он считает по своим
    bool fr5 = not na(ph5) or not na(pl5)
    bool fr3 = not na(ph3) or not na(pl3)
    bool fr2 = not na(ph2) or not na(pl2)
    if trOn5
        e5 = f_trend(0, PV5, BV5, HV5, LV5, vw5, fv5, open, close)
        e3 = f_trend(1, PV3, BV3, HV3, LV3, vw3, fv3, open, close)
        e2 = f_trend(2, P2, B2, H2, L2, nw2, fr2, open, close)
    // тот же движок, перевёрнутый мир. Второго набора правил нет
    if trDn
        n5 = f_trend(3, PV5n, BV5n, HV5n, LV5n, vm5, fv5, -open, -close)
        n3 = f_trend(4, PV3n, BV3n, HV3n, LV3n, vm3, fv3, -open, -close)
        n2 = f_trend(5, P2n, B2n, H2n, L2n, mw2, fr2, -open, -close)



    // ── кого «авто» рисует ПРЯМО СЕЙЧАС, по каждому слою ──
    // Правило то же самое, что в блоке отрисовки ниже, слово в слово.
    // Здесь оно считается каждый бар только ради одного: запомнить бар,
    // на котором решение поменялось. На сам выбор это не влияет.
    for c = 0 to 2
        // З20: тот же набор ячеек, что и в отрисовке, иначе метки ⇄
        // отмечали бы переключения, которых на графике не было
        int uI = c
        int dI = c + 3
        bool uA = trOn5 and array.get(tTR, uI) == 1
        bool dA = trDn and array.get(tTR, dI) == 1
        // тот же трёхзначный режим, что и в отрисовке
        int mD = -1
        if trWho == "только восходящий"
            mD := uA ? 0 : -1
        else if trWho == "только нисходящий"
            mD := dA ? 1 : -1
        else
            if uA and dA
                mD := array.get(tZB, dI) > array.get(tZB, uI) ? 1 : 0
            else if uA
                mD := 0
            else if dA
                mD := 1
        bool dD = mD == 1
        if not array.get(swI, c) or mD != array.get(SWM, c)
            array.set(swB, c, bar_index)
            array.set(SWM, c, mD)
            array.set(swD, c, dD)
            // метка ⇄ ставится, только когда переключились НА тренд.
            // Уход в «никого» метки не получает: там и рисовать нечего
            if array.get(swI, c) and mD >= 0
                array.push(AWB, bar_index)
                array.push(AWL, c)
                array.push(AWD, dD)
                array.push(AWP, close)
                if array.size(AWB) > MAXSL
                    array.shift(AWB)
                    array.shift(AWL)
                    array.shift(AWD)
                    array.shift(AWP)
            array.set(swI, c, true)

// ══════════════ ЖИВЫЕ УРОВНИ СЛОЯ ══════════════
// Механизм Тренажёра v9: уровень — СЫРОЙ пивот, лежит в списке, при
// касании ценой ВЫЧЁРКИВАЕТСЯ из списка. Пивоты не переезжают, поэтому
// пробитый уровень мёртв навсегда.
var float[]  V5P = array.new_float()
var int[]    V5B = array.new_int()
var bool[]   V5H = array.new_bool()
var string[] V5L = array.new_string()

var float[]  V3P = array.new_float()
var int[]    V3B = array.new_int()
var bool[]   V3H = array.new_bool()
var string[] V3L = array.new_string()

var float[]  V2P = array.new_float()
var int[]    V2B = array.new_int()
var bool[]   V2H = array.new_bool()
var string[] V2L = array.new_string()

f_lvPush(_p, _b, _h, _l, _v, _off, _isHi, _lab) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - _off)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

// уровень существует, пока не пробит. Коснулась цена — удаляем совсем
f_purgeL(_p, _b, _h, _l) =>
    i = 0
    while i < array.size(_p)
        pr = array.get(_p, i)
        bool dead = array.get(_h, i) ? high >= pr : low <= pr
        if dead
            array.remove(_p, i)
            array.remove(_b, i)
            array.remove(_h, i)
            array.remove(_l, i)
        else
            i += 1
    0

// жив ли уровень с такой ценой — для линий у сырых меток
f_alive(_p, _v) =>
    bool r = false
    n = array.size(_p)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(_p, i) - _v) <= syminfo.mintick
                r := true
                break
    r

// ══════════════ СЧЁТ ПО СЛОМАМ ══════════════
// Идея владельца 22.09.2026: «что если счёт вести не по коленам, а по
// сломам, чтобы понять как сейчас и как будет».
//
// Слом = цена взяла ближайший НЕПРОБИТЫЙ пивот слоя. Своего механизма
// это не требует: живые уровни выше уже так и устроены — пивот лежит в
// списке, цена коснулась, уровень вычёркивается навсегда. Момент
// вычёркивания и есть слом.
//
// Почему это сильнее колена: колено известно ЗАДНИМ ЧИСЛОМ, на 2/2
// через два бара, на 5/5 через пять. Слом известен ЗАРАНЕЕ — цена, до
// которой надо дойти, уже стоит на графике.
//
// Замер Н14, девять лет часовика, 52 518 баров. Из трёх значений слова
// «слом» в основу счёта годится только это: у слома по уровню тренда и
// по структуре серия почти всегда равна единице, они чередуются по
// построению. У слома по экстремуму серия: медиана 2, девять десятых
// до 5-6, максимум 16-24.
//
// И главное: сломы НЕ независимы, они слипаются.
var int[]   sDIR = array.new_int(3, 0)        // сторона серии: +1 вверх, -1 вниз, 0 нет
var int[]   sRUN = array.new_int(3, 0)        // сколько сломов подряд
var int[]   sLB  = array.new_int(3, -1)       // бар последнего слома
var float[] sLP  = array.new_float(3, na)     // его цена
// метки ТЕКУЩЕЙ серии, плоскими списками: бар, цена, слой, номер
var int[]   SB = array.new_int()
var float[] SP = array.new_float()
var int[]   SL = array.new_int()
var int[]   SN = array.new_int()

// Н14: доля случаев, когда следующий слом пошёл в ТУ ЖЕ сторону.
// Порядок: слой 5/5, 3/3, 2/2 × сторона вверх, вниз × длина серии 1..5,
// где пятая клетка значит «пять и больше». Девять лет часовика.
var float[] SFQ = array.from(62.6, 65.5, 71.0, 66.1, 66.4,   57.8, 67.9, 63.6, 63.8, 60.0, 62.6, 59.4, 63.8, 67.7, 68.4,   56.2, 61.8, 64.8, 65.4, 60.6, 61.4, 62.3, 59.1, 64.4, 65.5,   56.8, 59.2, 63.1, 61.6, 62.1)
// размеры выборок к тем же клеткам
var int[]   SFN = array.from(842, 527, 345, 245, 479,   841, 486, 330, 210, 335, 1360, 852, 505, 322, 690,   1359, 764, 472, 306, 507, 1893, 1163, 724, 427, 798,   1892, 1074, 636, 401, 651)
// базовая доля сломов вверх по слоям — против неё и считается надбавка
var float[] SFB = array.from(52.6, 52.3, 51.8)

// один слом слоя _i: двигает серию, кладёт метку
f_slomOne(_i, _dir, _price) =>
    if array.get(sDIR, _i) != _dir
        // сменилось направление: метки прошлой серии стираем
        int k = 0
        while k < array.size(SL)
            if array.get(SL, k) == _i
                array.remove(SB, k)
                array.remove(SP, k)
                array.remove(SL, k)
                array.remove(SN, k)
            else
                k += 1
        array.set(sDIR, _i, _dir)
        array.set(sRUN, _i, 1)
    else
        // потолка у счёта по сломам нет по умолчанию: за девять лет серии
        // доходили до 16-24, и потолок на пяти отрезал бы самые длинные
        // десять процентов. Снять галочку — счёт встанет на пяти, как у колен
        if slNoCap or array.get(sRUN, _i) < 5
            array.set(sRUN, _i, array.get(sRUN, _i) + 1)
    array.set(sLB, _i, bar_index)
    array.set(sLP, _i, _price)
    array.push(SB, bar_index)
    array.push(SP, _price)
    array.push(SL, _i)
    array.push(SN, array.get(sRUN, _i))
    if array.size(SB) > MAXSL
        array.shift(SB)
        array.shift(SP)
        array.shift(SL)
        array.shift(SN)
    0

// Ищет сломы этого бара по живым уровням слоя. Берётся БЛИЖАЙШИЙ
// пробитый с каждой стороны. Вызывается ДО того, как в список попадут
// уровни текущего бара, — ровно так считалось в замере Н14.
f_slom(_i, _p, _h) =>
    if slOn
        n = array.size(_p)
        float bu = na
        float bd = na
        if n > 0
            for k = 0 to n - 1
                pr = array.get(_p, k)
                if array.get(_h, k)
                    if high >= pr
                        bu := na(bu) ? pr : math.min(bu, pr)
                else
                    if low <= pr
                        bd := na(bd) ? pr : math.max(bd, pr)
        if not na(bu)
            z1 = f_slomOne(_i, 1, bu)
        if not na(bd)
            z2 = f_slomOne(_i, -1, bd)
    0

// ближайший НЕПРОБИТЫЙ уровень слоя сверху и снизу от цены — это и есть
// две цены, на которых случится следующий слом
f_nearest(_p, _h) =>
    float up = na
    float dn = na
    n = array.size(_p)
    if n > 0
        for k = 0 to n - 1
            pr = array.get(_p, k)
            if array.get(_h, k)
                if pr > close
                    up := na(up) ? pr : math.min(up, pr)
            else
                if pr < close
                    dn := na(dn) ? pr : math.max(dn, pr)
    [up, dn]

// подпись сырого пивота: сравнение с предыдущим пивотом той же стороны
a51 = ta.valuewhen(not na(ph5), high[5], 1)
a52 = ta.valuewhen(not na(ph5), high[5], 0)
hh5 = na(ph5) ? na : a51 < a52 ? ph5 : na
lh5 = na(ph5) ? na : a51 > a52 ? ph5 : na
a53 = ta.valuewhen(not na(pl5), low[5], 1)
a54 = ta.valuewhen(not na(pl5), low[5], 0)
ll5 = na(pl5) ? na : a53 > a54 ? pl5 : na
hl5 = na(pl5) ? na : a53 < a54 ? pl5 : na

a31 = ta.valuewhen(not na(ph3), high[3], 1)
a32 = ta.valuewhen(not na(ph3), high[3], 0)
hh3 = na(ph3) ? na : a31 < a32 ? ph3 : na
lh3 = na(ph3) ? na : a31 > a32 ? ph3 : na
a33 = ta.valuewhen(not na(pl3), low[3], 1)
a34 = ta.valuewhen(not na(pl3), low[3], 0)
ll3 = na(pl3) ? na : a33 > a34 ? pl3 : na
hl3 = na(pl3) ? na : a33 < a34 ? pl3 : na

a21 = ta.valuewhen(not na(ph2), high[2], 1)
a22 = ta.valuewhen(not na(ph2), high[2], 0)
hh2 = na(ph2) ? na : a21 < a22 ? ph2 : na
lh2 = na(ph2) ? na : a21 > a22 ? ph2 : na
a23 = ta.valuewhen(not na(pl2), low[2], 1)
a24 = ta.valuewhen(not na(pl2), low[2], 0)
ll2 = na(pl2) ? na : a23 > a24 ? pl2 : na
hl2 = na(pl2) ? na : a23 < a24 ? pl2 : na

// сломы ищутся ПО ПРОШЛЫМ уровням, до того как добавятся сегодняшние
s01 = f_slom(0, V5P, V5H)
s02 = f_slom(1, V3P, V3H)
s03 = f_slom(2, V2P, V2H)

u01 = f_lvPush(V5P, V5B, V5H, V5L, hh5, 5, true,  "HH")
u02 = f_lvPush(V5P, V5B, V5H, V5L, lh5, 5, true,  "LH")
u03 = f_lvPush(V5P, V5B, V5H, V5L, hl5, 5, false, "HL")
u04 = f_lvPush(V5P, V5B, V5H, V5L, ll5, 5, false, "LL")
u05 = f_lvPush(V3P, V3B, V3H, V3L, hh3, 3, true,  "HH")
u06 = f_lvPush(V3P, V3B, V3H, V3L, lh3, 3, true,  "LH")
u07 = f_lvPush(V3P, V3B, V3H, V3L, hl3, 3, false, "HL")
u08 = f_lvPush(V3P, V3B, V3H, V3L, ll3, 3, false, "LL")
u09 = f_lvPush(V2P, V2B, V2H, V2L, hh2, 2, true,  "HH")
u10 = f_lvPush(V2P, V2B, V2H, V2L, lh2, 2, true,  "LH")
u11 = f_lvPush(V2P, V2B, V2H, V2L, hl2, 2, false, "HL")
u12 = f_lvPush(V2P, V2B, V2H, V2L, ll2, 2, false, "LL")

v01 = f_purgeL(V5P, V5B, V5H, V5L)
v02 = f_purgeL(V3P, V3B, V3H, V3L)
v03 = f_purgeL(V2P, V2B, V2H, V2L)

// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()

f_lvlLayer(_p, _b, _h, _l, _cHi, _cLo) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? _cHi : _cLo, lvTr), width = 1, style = st, extend = extend.right))
    n

// Поглощённые метки: бледная подпись на своём месте плюс короткая точка
// на своём уровне. Линии уровня у них нет — только метка.
f_drawAbs(_G, _Y, _Z, _W, _cHi, _cLo, _tag) =>
    n = array.size(_G)
    if n > 0
        for i = 0 to n - 1
            yb = array.get(_Y, i)
            if last_bar_index - yb <= winBars
                pr = array.get(_G, i)
                hi = array.get(_Z, i)
                lb = array.get(_W, i)
                array.push(LNS, line.new(yb, pr, yb + 3, pr, color = color.new(hi ? _cHi : _cLo, 50), width = 1, style = line.style_dotted))
                array.push(LBS, label.new(yb, pr, lb, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(hi ? _cHi : _cLo, 50), size = size.tiny, tooltip = "ПОГЛОЩЁННАЯ метка слоя " + _tag + "\n" + lb + "  " + str.tostring(pr, format.mintick) + "\nэта метка проявилась, потом цена ушла дальше и колено переехало на новый экстремум. Сама метка никуда не делась."))
    n

// Подпуть более быстрого слоя внутри одной ноги.
// Берём только то, что реально ЧЕРЕДУЕТСЯ: цепочка начинается со
// стороны, противоположной началу ноги, и не кончается стороной её
// конца — иначе слой подставит тот же экстремум второй раз.
f_sub(_sB, _sH, _x1, _x2, _s1, _s2) =>
    int[] keep = array.new_int()
    n = array.size(_sB)
    if n > 0
        bool want = not _s1
        for k = 0 to n - 1
            b = array.get(_sB, k)
            if b > _x1 and b < _x2
                if array.get(_sH, k) == want
                    array.push(keep, k)
                    want := not want
    while array.size(keep) > 0
        last = array.get(keep, array.size(keep) - 1)
        if array.get(_sH, last) == _s2
            dummy = array.pop(keep)
        else
            break
    keep

// ХВОСТ: колена быстрого слоя ПОСЛЕ последнего колена нашего слоя.
// Здесь конца ноги ещё нет — слой не подтвердил разворот, а быстрый уже
// подтвердил: 3/3 знает через 3 бара, 5/5 только через 5. Это живой
// край, и метки здесь нужны не меньше, чем в истории.
f_subTail(_sB, _sH, _x1, _s1) =>
    int[] keep = array.new_int()
    n = array.size(_sB)
    if n > 0
        bool want = not _s1
        for k = 0 to n - 1
            if array.get(_sB, k) > _x1
                if array.get(_sH, k) == want
                    array.push(keep, k)
                    want := not want
    keep

// _dn — какой счёт рисуем: false восходящий, true нисходящий.
//
// Колена у обоих ОДНИ И ТЕ ЖЕ: один зиг-заг, те же бары, те же цены.
// Отличается только прочтение, поэтому никаких перевёрнутых цен здесь
// нет — разворачиваются ЧЕТЫРЕ ветки. При _dn = false каждая обязана
// дать ровно то, что давала до 23.09.2026.
f_draw(_P, _B, _H, _L, _M, _fP, _fB, _fH, _fL, _fV, _gP, _gB, _gH, _gL, _gV, _hasF, _cHi, _cLo, _tag, _lab, _labK, _tzB, _tpzB, _ttr, _bok, _dn, _swB) =>
    // _swB — бар, с которого этот тренд стал РИСОВАТЬСЯ. Нужен только
    // настройке «Счёт при переключении». При значении по умолчанию
    // ничего не меняет: swFull гасит всю ветку
    bool swFull = trCntSw == "весь, набранный в фоне"
    bool swPale = trCntSw == "фоновую часть бледнее"
    n = array.size(_P)
    // колено-ноль действующего счёта: первый НИЗ, чей бар не раньше нуля.
    //
    // Сторона здесь обязательна. Ноль всегда низ — LL при рождении, HL при
    // продолжении, — а большая свеча умеет сделать и вершину, и низ сразу:
    // 6 янв 2026, 07:00 на 2/2 колена 4474.265 и 4449.510 сели на один бар.
    // Поиск «по бару» хватал вершину, и весь счёт на экране съезжал на
    // единицу: на графике (5), в таблице (4). За два года часовика такая
    // свеча-накрышка встречается 49 раз на 2565 колен 2/2 (1.9%), 21 на
    // 1827 у 3/3, 5 на 1221 у 5/5
    int zi = -1
    if _ttr == 1 and _tzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tzB and array.get(_H, i) == _dn
                zi := i
                break
    // ноль ПРОШЛОГО счёта: его номера и ноги остаются, но бледными. Он
    // тоже всегда низ, поэтому ищется так же
    int pzi = -1
    if _ttr == 1 and _tpzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tpzB and array.get(_H, i) == _dn
                pzi := i
                break
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(_B, i - 1)
            x2 = array.get(_B, i)
            p1 = array.get(_P, i - 1)
            p2 = array.get(_P, i)
            if last_bar_index - x1 <= winBars
                s1 = array.get(_H, i - 1)
                s2 = array.get(_H, i)
                int[] keep = array.new_int()
                bool useG = false
                if fillOn and _hasF
                    keep := f_sub(_fB, _fH, x1, x2, s1, s2)
                    if array.size(keep) == 0
                        keep := f_sub(_gB, _gH, x1, x2, s1, s2)
                        if array.size(keep) > 0
                            useG := true
                nk = array.size(keep)
                bool filled = nk > 0
                // нога ДЕЙСТВУЮЩЕГО счёта. ВОСХОДЯЩИЙ.md §6: цвет по НОГЕ,
                // чередованием (0)-(1) зелёная, (1)-(2) красная и дальше.
                // Колена чередуются вершина/низ, поэтому направление ноги и
                // чётность её номера — одно и то же.
                bool inCnt = zi >= 0 and i > zi and i - zi <= 5
                bool inPrv = not inCnt and pzi >= 0 and i > pzi and i - pzi <= 5
                cOwn = _dn ? cTrDn : cTrDie
                col0 = inCnt ? (p2 > p1 ? cTrUp : cOwn) : inPrv ? color.new(p2 > p1 ? cTrUp : cOwn, 55) : (p2 > p1 ? _cHi : _cLo)
                // §5: точка (5) может быть LH вместо HH. Счёт от этого не
                // ломается, но нога (4)-(5) с такой вершиной рисуется
                // ШТРИХ-ПУНКТИРОМ — зелёным, цвет не меняется
                bool weak5 = (inCnt and i - zi == 5 or inPrv and i - pzi == 5) and array.get(_L, i) == (_dn ? "HL" : "LH")
                // 22.09.2026, слово владельца: то же правило на ЛЮБУЮ
                // встречную подпись в счёте, «чтобы глаз видел — восходящий,
                // но через манипуляцию». Идеал: вершина HH, низ HL. Ноль не
                // проверяется, у него законны и LL, и HL. Счёт не ломается,
                // цвет остаётся зелёным, меняется только стиль ноги.
                //
                // Штрих-пунктир занят дорисовкой, и теперь им рисуются две
                // разные вещи. Отличать на глаз: у дорисовки на пунктире
                // стоят метки с точкой спереди (·LH, ·HL), у манипуляции их нет
                int kLeg = inCnt ? i - zi : inPrv ? i - pzi : -1
                bool manip = kLeg >= 1 and (array.get(_H, i) ? array.get(_L, i) != (_dn ? "LH" : "HH") : array.get(_L, i) != (_dn ? "LL" : "HL"))
                // Пока тренд не подтверждён первым HL, нога счёта ТОНКАЯ.
                //
                // З29, 02.10.2026. Было «плюс один пиксель»: при толщине
                // зиг-зага 1 это 1 против 2, и владелец за всё время ни разу
                // не сказал, что видит момент подтверждения, — его просто не
                // было видно. Стало ПЛЮС ДВА: 1 против 3, разница втрое.
                //
                // Владелец просил штрих-пунктир против сплошной. ЭТОГО СДЕЛАТЬ
                // НЕЛЬЗЯ: у ноги счёта штрих-пунктир уже занят и означает
                // МАНИПУЛЯЦИЮ — строка ниже, `weak5 or manip`. Решение 22.09:
                // «чтобы глаз видел — восходящий, но через манипуляцию».
                // Совпали бы ровно там, где это больнее всего: нога (0)-(1)
                // и не подтверждена, и может нести слабую вершину LH.
                int wCnt = inCnt ? (_bok ? zzW + 2 : zzW) : zzW
                if showZZ
                    if filled
                        // участок с дорисовкой остаётся ШТРИХ-ПУНКТИРОМ — это
                        // признак «колено одолжено», — но внутри счёта цвет
                        // берётся от ноги, а не от слоя. Все куски подпути
                        // красятся одинаково: нога одна, ныряния внутри неё
                        // своего цвета не имеют
                        int px = x1
                        float pp = p1
                        for q = 0 to nk - 1
                            k = array.get(keep, q)
                            fx = useG ? array.get(_gB, k) : array.get(_fB, k)
                            fp = useG ? array.get(_gP, k) : array.get(_fP, k)
                            cseg = inCnt or inPrv ? col0 : (fp > pp ? _cHi : _cLo)
                            array.push(LNS, line.new(px, pp, fx, fp, color = color.new(cseg, inCnt ? 0 : 15), width = wCnt, style = line.style_dashed))
                            px := fx
                            pp := fp
                        cend = inCnt or inPrv ? col0 : (p2 > pp ? _cHi : _cLo)
                        array.push(LNS, line.new(px, pp, x2, p2, color = color.new(cend, inCnt ? 0 : 15), width = wCnt, style = line.style_dashed))
                    else
                        array.push(LNS, line.new(x1, p1, x2, p2, color = color.new(col0, inCnt ? 0 : 55), width = wCnt, style = weak5 or manip ? line.style_dashed : line.style_solid))
                if _lab
                    if filled and not _labK
                        for q = 0 to nk - 1
                            k = array.get(keep, q)
                            flb = useG ? array.get(_gL, k) : array.get(_fL, k)
                            fpr = useG ? array.get(_gP, k) : array.get(_fP, k)
                            fhi = useG ? array.get(_gH, k) : array.get(_fH, k)
                            fbx = useG ? array.get(_gB, k) : array.get(_fB, k)
                            array.push(LBS, label.new(fbx, fpr, (useG ? "··" : "·") + flb, style = fhi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = fhi ? _cHi : _cLo, size = size.small, tooltip = (useG ? "СЫРАЯ метка с ЗАПАСНОГО донора — две точки спереди. У слоя " + _tag + " колена здесь нет, и у первого донора тоже. Взято через один слой вниз.\nВ счёт со вставками такие метки НЕ идут: слово владельца 29.09.2026 — 5/5 берёт у 3/3, 3/3 берёт у 2/2.\nЗамер Н19: таких меток на 5/5 больше, чем с 3/3, — 1960 против 1790.\n" : "СЫРАЯ метка — одна точка спереди. У слоя " + _tag + " колена здесь нет, взято с более быстрого слоя.\n") + flb + "  " + str.tostring(fpr, format.mintick) + "\nучасток нарисован штрих-пунктиром"))
                            // линия сырой метки: только пока она ЖИВА в
                            // списке уровней того слоя, откуда одолжена
                            if fillLv and lvOn
                                if f_alive(useG ? _gV : _fV, fpr)
                                    fst = flb == "HH" or flb == "LL" ? line.style_dashed : line.style_dotted
                                    fxl = math.max(fbx, bar_index - 2900)
                                    array.push(LNS, line.new(fxl, fpr, bar_index, fpr, color = color.new(fhi ? _cHi : _cLo, lvTr), width = 1, style = fst, extend = extend.right))
                    lb = array.get(_L, i)
                    hi = array.get(_H, i)
                    mc = array.get(_M, i)
                    // колено действующего счёта: номер спереди, зелёным
                    int k = -1
                    if zi >= 0 and i >= zi
                        kk = i - zi
                        if kk <= 5
                            k := kk
                    // номер ПРОШЛОГО счёта — остаётся, но бледным
                    int pk = -1
                    if k < 0 and pzi >= 0 and i >= pzi
                        kk2 = i - pzi
                        if kk2 <= 5
                            pk := kk2
                    kk3 = k >= 0 ? k : pk
                    bool ideal = kk3 < 0 ? false : hi ? lb == (_dn ? "LH" : "HH") : (kk3 == 0 ? (_dn ? lb == "HH" or lb == "LH" : lb == "LL" or lb == "HL") : lb == (_dn ? "LL" : "HL"))
                    // колено, чей номер набран ДО переключения «авто».
                    // При настройке по умолчанию swOld всегда false
                    bool swOld  = not swFull and _swB >= 0 and array.get(_B, i) < _swB and kk3 >= 0
                    bool swHide = swOld and not swPale
                    txt = kk3 >= 0 and trNum and not swHide ? "(" + str.tostring(kk3) + ") " + lb : lb
                    cCnt = _dn ? cTrDn : cTrUp
                    col1 = swHide ? (hi ? _cHi : _cLo) : k >= 0 ? (swOld ? color.new(cCnt, 70) : cCnt) : pk >= 0 ? color.new(cCnt, 55) : (hi ? _cHi : _cLo)
                    tipK = kk3 < 0 ? "" : "\nточка (" + str.tostring(kk3) + ") из 5 · " + (ideal ? "подпись идеальная" : "подпись встречная — МАНИПУЛЯЦИЯ, счёт продолжается, нога к ней нарисована штрих-пунктиром") + (pk >= 0 ? "\nПРОШЛЫЙ счёт. Он дошёл до (5), после чего пришёл " + (_dn ? "LH" : "HL") + " и начался новый счёт с нуля на нём." : "") + (k == 0 and _tpzB >= 0 ? "\nНОВЫЙ счёт: это первый " + (_dn ? "LH" : "HL") + " после (5) прошлого счёта. Тренд не умирал, он продолжается." : "")
                    if not _labK or kk3 >= 0
                        array.push(LBS, label.new(x2, p2, txt, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = col1, size = size.small, tooltip = "слой " + _tag + ", счёт " + (_dn ? "НИСХОДЯЩЕГО" : "ВОСХОДЯЩЕГО") + "   " + lb + "  " + str.tostring(p2, format.mintick) + "\n" + (hi ? "вершина" : "низ") + tipK + (mc >= 2 ? "\nслилось сырых меток: " + str.tostring(mc) : "") + (swOld ? "\n\nЭтот номер набран, пока тренд НЕ рисовался: «авто» переключилось на него позже, на баре " + str.tostring(_swB) + "." : "")))

    // ── ХВОСТ ──
    if n >= 1 and fillOn and _hasF
        xt = array.get(_B, n - 1)
        pt = array.get(_P, n - 1)
        st = array.get(_H, n - 1)
        if last_bar_index - xt <= winBars
            int[] kt = f_subTail(_fB, _fH, xt, st)
            bool useG2 = false
            if array.size(kt) == 0
                kt := f_subTail(_gB, _gH, xt, st)
                if array.size(kt) > 0
                    useG2 := true
            nt = array.size(kt)
            if nt > 0
                if showZZ
                    int px2 = xt
                    float pp2 = pt
                    for q = 0 to nt - 1
                        k = array.get(kt, q)
                        fx = useG2 ? array.get(_gB, k) : array.get(_fB, k)
                        fp = useG2 ? array.get(_gP, k) : array.get(_fP, k)
                        array.push(LNS, line.new(px2, pp2, fx, fp, color = color.new(fp > pp2 ? _cHi : _cLo, 15), width = zzW, style = line.style_dashed))
                        px2 := fx
                        pp2 := fp
                if _lab and not _labK
                    for q = 0 to nt - 1
                        k = array.get(kt, q)
                        flb = useG2 ? array.get(_gL, k) : array.get(_fL, k)
                        fpr = useG2 ? array.get(_gP, k) : array.get(_fP, k)
                        fhi = useG2 ? array.get(_gH, k) : array.get(_fH, k)
                        fbx = useG2 ? array.get(_gB, k) : array.get(_fB, k)
                        array.push(LBS, label.new(fbx, fpr, (useG2 ? "··" : "·") + flb, style = fhi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = fhi ? _cHi : _cLo, size = size.small, tooltip = (useG2 ? "СЫРАЯ метка в ХВОСТЕ с ЗАПАСНОГО донора — две точки. В счёт со вставками не идёт.\n" : "СЫРАЯ метка в ХВОСТЕ — слой " + _tag + " этот разворот ещё не подтвердил, взято с более быстрого слоя.\n") + flb + "  " + str.tostring(fpr, format.mintick) + "\nучасток нарисован штрих-пунктиром"))
                        if fillLv and lvOn
                            if f_alive(useG2 ? _gV : _fV, fpr)
                                fst = flb == "HH" or flb == "LL" ? line.style_dashed : line.style_dotted
                                fxl = math.max(fbx, bar_index - 2900)
                                array.push(LNS, line.new(fxl, fpr, bar_index, fpr, color = color.new(fhi ? _cHi : _cLo, lvTr), width = 1, style = fst, extend = extend.right))
    n

// ══════════════ УРОВНИ 4H и 1D — ОБЩИЕ ══════════════
ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[hLB], lookahead = barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[hLB],  lookahead = barmerge.lookahead_off)
b41 = ta.valuewhen(not na(ph4), ph4v, 1)
b42 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b41 < b42 ? ph4 : na
lh4 = na(ph4) ? na : b41 > b42 ? ph4 : na
b43 = ta.valuewhen(not na(pl4), pl4v, 1)
b44 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b43 > b44 ? pl4 : na
hl4 = na(pl4) ? na : b43 < b44 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[hLB], lookahead = barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[hLB],  lookahead = barmerge.lookahead_off)
bd1 = ta.valuewhen(not na(phd), phdv, 1)
bd2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : bd1 < bd2 ? phd : na
lhd = na(phd) ? na : bd1 > bd2 ? phd : na
bd3 = ta.valuewhen(not na(pld), pldv, 1)
bd4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : bd3 > bd4 ? pld : na
hld = na(pld) ? na : bd3 < bd4 ? pld : na

var float[]  V4P = array.new_float()
var int[]    V4B = array.new_int()
var bool[]   V4H = array.new_bool()
var string[] V4L = array.new_string()
var float[]  VDP = array.new_float()
var int[]    VDB = array.new_int()
var bool[]   VDH = array.new_bool()
var string[] VDL = array.new_string()

f_lvPushHTF(_p, _b, _h, _l, _v, _prev, _isHi, _lab) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

w01 = f_lvPushHTF(V4P, V4B, V4H, V4L, hh4, nz(hh4[1]), true,  "HH")
w02 = f_lvPushHTF(V4P, V4B, V4H, V4L, lh4, nz(lh4[1]), true,  "LH")
w03 = f_lvPushHTF(V4P, V4B, V4H, V4L, hl4, nz(hl4[1]), false, "HL")
w04 = f_lvPushHTF(V4P, V4B, V4H, V4L, ll4, nz(ll4[1]), false, "LL")
w05 = f_lvPushHTF(VDP, VDB, VDH, VDL, hhd, nz(hhd[1]), true,  "HH")
w06 = f_lvPushHTF(VDP, VDB, VDH, VDL, lhd, nz(lhd[1]), true,  "LH")
w07 = f_lvPushHTF(VDP, VDB, VDH, VDL, hld, nz(hld[1]), false, "HL")
w08 = f_lvPushHTF(VDP, VDB, VDH, VDL, lld, nz(lld[1]), false, "LL")

w09 = f_purgeL(V4P, V4B, V4H, V4L)
w10 = f_purgeL(VDP, VDB, VDH, VDL)

f_lvlHTF(_p, _b, _h, _l, _w) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? cHiH : cLoH, lvTr), width = _w, style = st, extend = extend.right))
    n

// ══════════════ РИСУЕМ ══════════════
if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))

    if hOn and h_tf4
        e1 = f_lvlHTF(V4P, V4B, V4H, V4L, 2)
    if hOn and h_tfd
        e2 = f_lvlHTF(VDP, VDB, VDH, VDL, 3)

    // 5/5 дорисовывается по 3/3, запасной 2/2; 3/3 по 2/2
    // Слой 5/5 может быть показан по двум причинам: включён вручную (on5)
    // или включён ради счёта тренда (trShow). Во втором случае линии слоя
    // и поглощённые метки не рисуем, а подписываем только колена счёта
    bool lab5 = labWho == "5/5" or labWho == "все"
    bool trShow = trOn5 and trShow5
    // ГЛАВНЫЙ слой: тот, что включён в ①. Включено несколько — берём самый
    // медленный. Слово владельца: «если выбираю два, основной тот, который
    // больше». Тренд на графике рисуется только по нему
    int mainL = on5 ? 0 : on3 ? 1 : on2 ? 2 : -1
    // ── КАКОЙ ИЗ ДВУХ ТРЕНДОВ РИСУЕМ ──
    // Колена у обоих ОДНИ И ТЕ ЖЕ, поэтому счёт на графике может быть
    // только один: одна нога не бывает двух цветов, одно колено не несёт
    // двух номеров. Замер на девяти годах: оба живы 19.5% баров на 5/5,
    // 21.9% на 3/3, 21.8% на 2/2 — пятая часть времени.
    //
    // «авто»: жив один — рисуем его. Живы оба — тот, чей НОЛЬ СВЕЖЕЕ:
    // это структура, которую рынок строит сейчас, а старая к этому
    // моменту уже контекст и всё равно видна в табло.
    //
    // Когда слой не выбран, mainL равен -1, и array.get(-1) уронил бы
    // индикатор. Поэтому индекс всегда валидный (safeL), а пускает или
    // нет — решает условие рядом.
    //
    // 29.09.2026 это перестало быть предосторожностью и стало фактом:
    // f_altOk с `n == 0 or array.get(_H, n - 1)` уронила индикатор с
    // RE10045 на баре 0. Пайн обе половины `or` считает всегда.
    int safeL = mainL < 0 ? 0 : mainL
    // З20, 29.09.2026: «авто» обязано РЕШАТЬ по тому же набору движков,
    // который оно РИСУЕТ. До починки оно смотрело в ячейки 0 и 3 (чистые
    // движки), а при включённом втором комплекте рисовало ячейки 6-9 (со
    // вставками). Последствий было два, оба видны на таблице владельца:
    // нисходящий со вставками мог быть жив, а чистый мёртв — и «авто» на
    // него не переключалось никогда; а в обратном случае «авто» выбирало
    // тренд, у которого счёта нет, и на графике не рисовалось ничего.
    // Вставки теперь внутри колен 5/5 и 3/3, отдельных ячеек под них нет.
    // Поэтому индексы снова простые: 0-2 восходящий, 3-5 нисходящий
    int upIdx = safeL
    int dnIdx = safeL + 3
    bool upAlive = mainL >= 0 and trOn5 and array.get(tTR, upIdx) == 1
    bool dnAlive = mainL >= 0 and trDn and array.get(tTR, dnIdx) == 1
    // ── РЕЖИМЫ РАЗДЕЛЕНЫ, 30.09.2026 ──
    // Раньше здесь стоял один флаг dnDraw на два значения, и ЛОЖЬ в нём
    // означала «рисуем восходящий». Сказать «не рисую никого» он не умел.
    // Отсюда З23: «только нисходящий» при смерти нисходящего молча
    // показывал восходящий, хотя владелец такого не просил.
    //
    // Теперь ответ ТРЁХЗНАЧНЫЙ:
    //     0  веду восходящий
    //     1  веду нисходящий
    //    -1  не веду никого, счёта на графике нет
    //
    // Это и есть разделение режимов, которое владелец назвал 30.09.2026:
    // «я поэтому и хотел разделить режимы авто, восходящий, нисходящий,
    // будет ещё боковик — так как у каждого будут свои функции, критерии
    // и задачи. И самый основной будет авто, который должен понимать,
    // что делать».
    //
    // «Авто» пока решает по старому правилу — чей ноль свежее. Его
    // переделка идёт отдельно, по перечням из indicator/АВТО-РЕЖИМ.md.
    // Здесь сделана только РАЗВЯЗКА: теперь есть куда встраивать.
    int drawMode = -1
    if trWho == "только восходящий"
        drawMode := upAlive ? 0 : -1
    else if trWho == "только нисходящий"
        drawMode := dnAlive ? 1 : -1
    else
        if upAlive and dnAlive
            drawMode := array.get(tZB, dnIdx) > array.get(tZB, upIdx) ? 1 : 0
        else if upAlive
            drawMode := 0
        else if dnAlive
            drawMode := 1
    bool dnDraw = drawMode == 1
    // drawIdx оставлен КАК БЫЛ, по слою и направлению. Через него
    // рисуются чёрточки «слом» и «умер», а событие не отменяется тем,
    // что сейчас мы никого не ведём: оно было. Если завести сюда -1,
    // чёрточки молча исчезнут в состоянии «никого» — сверка такого не
    // ловит, у неё условие показа на вид то же самое
    int drawIdx = mainL < 0 ? -1 : (dnDraw ? mainL + 3 : mainL)
    int bokIdx  = drawIdx < 0 ? 0 : drawIdx
    // а вот СЧЁТ и УРОВЕНЬ — только когда кого-то ведём. drawTr = 0
    // гасит номера, линию уровня и подпись «держит», оставляя зиг-заг в
    // цветах слоя. Это и есть состояние «не веду никого»
    int drawTr  = drawMode < 0 or drawIdx < 0 ? 0 : (dnDraw ? (trDn ? array.get(tTR, bokIdx) : 0) : (trOn5 ? array.get(tTR, bokIdx) : 0))
    if on5 or trShow
        if lvOn and (on5 or trFull)
            r5 = f_lvlLayer(V5P, V5B, V5H, V5L, c5H, c5L)
        if absOn and (lab5 or trFull)
            g5 = f_drawAbs(GV5, YV5, ZV5, WV5, c5H, c5L, "5/5")
        d5 = f_draw(PV5, BV5, HV5, LV5, MV5, PV3, BV3, HV3, LV3, V3P, P2, B2, H2, L2, V2P, true,  c5H, c5L, "5/5", lab5 or trShow, not lab5 and not trFull, mainL == 0 ? array.get(tZB, bokIdx) : NOZERO, mainL == 0 ? array.get(tPZB, bokIdx) : NOZERO, mainL == 0 ? drawTr : 0, array.get(tBOK, bokIdx), dnDraw, mainL == 0 ? array.get(swB, 0) : NOZERO)
    if on2
        if lvOn
            r2 = f_lvlLayer(V2P, V2B, V2H, V2L, c2H, c2L)
        if absOn and (labWho == "2/2" or labWho == "все")
            g2 = f_drawAbs(G2, Y2, Z2, W2, c2H, c2L, "2/2")
        d2 = f_draw(P2, B2, H2, L2, M2, P2, B2, H2, L2, V2P, P2, B2, H2, L2, V2P, false, c2H, c2L, "2/2", labWho == "2/2" or labWho == "все", false, mainL == 2 ? array.get(tZB, bokIdx) : NOZERO, mainL == 2 ? array.get(tPZB, bokIdx) : NOZERO, mainL == 2 ? drawTr : 0, array.get(tBOK, bokIdx), dnDraw, mainL == 2 ? array.get(swB, 2) : NOZERO)
    // ── тренд: зелёный уровень и красный слом рисуются по ГЛАВНОМУ слою ──
    if (trOn5 or trDn) and drawIdx >= 0
        // цены ячеек 3-5 живут в перевёрнутом мире — знак назад
        float mSg  = dnDraw ? -1.0 : 1.0
        float mLvl = array.get(tLVL, drawIdx) * mSg
        mHL  = array.get(tLHL, drawIdx)
        color cDir = dnDraw ? cTrDn : cTrUp
        if drawTr == 1 and not na(mLvl)
            x0 = array.get(tLVB, drawIdx) < 0 ? bar_index - 30 : array.get(tLVB, drawIdx)
            array.push(LNS, line.new(x0, mLvl, bar_index, mLvl, color = cDir, width = mHL ? 2 : 1, style = mHL ? line.style_solid : line.style_dashed, extend = extend.right))
            if mHL
                array.push(LBS, label.new(bar_index, mLvl, "держит " + (dnDraw ? "LH " : "HL ") + str.tostring(mLvl, format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cDir, size = size.small, tooltip = "Уровень " + (dnDraw ? "нисходящего — последняя появившаяся LH. Новая LH" : "восходящего — последний появившийся HL. Новый HL") + " заменяет его безусловно, ниже тот или выше.\nСлой: " + (mainL == 0 ? "5/5" : mainL == 1 ? "3/3" : "2/2")))
        // ── СЛОМЫ: все, что попали в окно ──
        // Слой 5/5 рисуется ВСЕГДА, как контекст. 3/3 и 2/2 — только когда
        // выбраны основным. Сломы основного слоя идут в полный цвет и с
        // подписью, контекстные 5/5 — бледные и без подписи, чтобы глаз
        // сразу отделял рабочее от фона
        nR = array.size(RDB)
        if nR > 0
            for k = 0 to nR - 1
                lr = array.get(RDL, k)
                // показываем сломы РИСУЕМОГО слоя плюс 5/5 того же
                // направления как бледный контекст
                bool okShow = lr == drawIdx or lr == (dnDraw ? 3 : 0)
                if okShow and last_bar_index - array.get(RDB, k) <= winBars
                    bool isMain = lr == drawIdx
                    rb = array.get(RDB, k)
                    rp = array.get(RDP, k)
                    bool rDn = lr >= 3
                    color cR = rDn ? cTrUp : cTrDie
                    array.push(LNS, line.new(rb - 12, rp, rb + 12, rp, color = color.new(cR, isMain ? 0 : 65), width = isMain ? 2 : 1))
                    if isMain
                        array.push(LBS, label.new(rb, rp, rDn ? "умер ↓" : "умер ↑", style = rDn ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = cR, size = size.tiny, tooltip = (rDn ? "НИСХОДЯЩИЙ умер" : "ВОСХОДЯЩИЙ умер") + " на уровне " + str.tostring(rp, format.mintick) + "\nТело свечи ушло за уровень на имп × " + str.tostring(trFib) + " либо набралось " + str.tostring(trNbar) + " закрытий подряд.\nСлой: " + (lr >= 6 ? (lr % 2 == 0 ? "5/5+" : "3/3+") : lr % 3 == 0 ? "5/5" : lr % 3 == 1 ? "3/3" : "2/2")))
        nG = array.size(GDB)
        if nG > 0
            for k = 0 to nG - 1
                lg = array.get(GDL, k)
                bool okShowG = lg == drawIdx or lg == (dnDraw ? 3 : 0)
                if okShowG and last_bar_index - array.get(GDB, k) <= winBars
                    bool isMainG = lg == drawIdx
                    gb = array.get(GDB, k)
                    gp = array.get(GDP, k)
                    bool gok = array.get(GOK, k)
                    bool gDn = lg >= 3
                    color cGc = gDn ? cTrDn : cTrUp
                    array.push(LNS, line.new(gb - 12, gp, gb + 12, gp, color = color.new(cGc, isMainG ? 0 : 65), width = isMainG and gok ? 2 : 1))
                    if isMainG
                        array.push(LBS, label.new(gb, gp, (gDn ? "слом ↓" : "слом ↑") + (gok ? "" : " ?"), style = gDn ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cGc, size = size.tiny, tooltip = (gDn ? "СЛОМ ВНИЗ — сломали ВОСХОДЯЩУЮ структуру на " : "СЛОМ ВВЕРХ — сломали НИСХОДЯЩУЮ структуру на ") + str.tostring(gp, format.mintick) + ".\nЦена от нуля перебила " + (gDn ? "этот низ и сделала LL." : "эту вершину и сделала HH.") + "\n" + (gok ? "ПОДТВЕРЖДЁН правилом «" + trBrk + "»." : "НЕ подтверждён правилом «" + trBrk + "».") + "\nСлой: " + (lg >= 6 ? (lg % 2 == 0 ? "5/5+" : "3/3+") : lg % 3 == 0 ? "5/5" : lg % 3 == 1 ? "3/3" : "2/2") + "\n\nЭто рождение тренда: отметка события, а не состояние."))

    // ── СЛОМЫ: две цены впереди и номера текущей серии ──
    // Линии рисуются только по ОСНОВНОМУ слою — тому, что выбран в ①.
    // Считаются сломы по всем трём, их видно в табло
    // ближайшие непробитые уровни считаем ОДИН раз на все три слоя:
    // пайн не умеет ни тернарник по массивам, ни разбор кортежа в цикле
    [u5n, d5n] = f_nearest(V5P, V5H)
    [u3n, d3n] = f_nearest(V3P, V3H)
    [u2n, d2n] = f_nearest(V2P, V2H)
    if slOn and mainL >= 0
        float mUp = mainL == 0 ? u5n : mainL == 1 ? u3n : u2n
        float mDn = mainL == 0 ? d5n : mainL == 1 ? d3n : d2n
        string mNm = mainL == 0 ? "5/5" : mainL == 1 ? "3/3" : "2/2"
        if slLine
            if not na(mUp)
                array.push(LNS, line.new(bar_index - 60, mUp, bar_index, mUp, color = cSlUp, width = 2, extend = extend.right))
                array.push(LBS, label.new(bar_index, mUp, "слом ↑ " + str.tostring(mUp, format.mintick) + "   " + str.tostring(100 * (mUp - close) / close, "#.##") + "%", style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlUp, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя " + mNm + " сверху.\nДойдёт сюда цена — будет слом вверх.\n\nЭта цена известна ЗАРАНЕЕ, в отличие от колена: колено становится видно только через " + (mainL == 0 ? "пять" : mainL == 1 ? "три" : "два") + " бара после того, как оно случилось.\n\nСлом засчитывается по КАСАНИЮ — хватает тени."))
            if not na(mDn)
                array.push(LNS, line.new(bar_index - 60, mDn, bar_index, mDn, color = cSlDn, width = 2, extend = extend.right))
                array.push(LBS, label.new(bar_index, mDn, "слом ↓ " + str.tostring(mDn, format.mintick) + "   " + str.tostring(100 * (close - mDn) / close, "#.##") + "%", style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlDn, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя " + mNm + " снизу.\nДойдёт сюда цена — будет слом вниз.\n\nЭта цена известна ЗАРАНЕЕ, в отличие от колена.\n\nСлом засчитывается по КАСАНИЮ — хватает тени."))
        if slNum
            int dirM = array.get(sDIR, mainL)
            nS = array.size(SB)
            if nS > 0
                for k = 0 to nS - 1
                    if array.get(SL, k) == mainL
                        sb = array.get(SB, k)
                        if last_bar_index - sb <= winBars
                            sp = array.get(SP, k)
                            sn = array.get(SN, k)
                            array.push(LBS, label.new(sb, sp, (dirM > 0 ? "↑" : "↓") + str.tostring(sn), style = dirM > 0 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = dirM > 0 ? cSlUp : cSlDn, size = size.tiny, tooltip = "Слом " + (dirM > 0 ? "ВВЕРХ" : "ВНИЗ") + " номер " + str.tostring(sn) + " в текущей серии.\nЦена взяла непробитый уровень " + str.tostring(sp, format.mintick) + " слоя " + mNm + ".\n\nПоказывается только ТЕКУЩАЯ серия. Сменится направление — эти метки уйдут и счёт начнётся с единицы."))

    // ── ГДЕ «АВТО» ПЕРЕДУМАЛО ──
    // 28.09.2026. Метка на баре, где сменился рисуемый тренд. Показываются
    // переключения ОСНОВНОГО слоя, попавшие в окно. Ничего не считает —
    // только показывает то, что уже посчитано выше
    if swMark and mainL >= 0 and trWho == "авто"
        nA = array.size(AWB)
        if nA > 0
            for k = 0 to nA - 1
                if array.get(AWL, k) == mainL
                    ab = array.get(AWB, k)
                    if last_bar_index - ab <= winBars
                        bool aDn = array.get(AWD, k)
                        ap = array.get(AWP, k)
                        color cA = aDn ? cTrDn : cTrUp
                        array.push(LBS, label.new(ab, ap, aDn ? "⇄ НИСХ" : "⇄ ВОСХ", style = label.style_label_center, color = color.new(color.black, 100), textcolor = cA, size = size.tiny, tooltip = "Здесь режим «авто» сменил рисуемый тренд на " + (aDn ? "НИСХОДЯЩИЙ" : "ВОСХОДЯЩИЙ") + ".\nСлой " + (mainL == 0 ? "5/5" : mainL == 1 ? "3/3" : "2/2") + ", бар " + str.tostring(ab) + ".\n\nСчёт обоих направлений идёт ВСЕГДА, независимо от того, кто нарисован. Поэтому тренд появляется здесь уже с тем счётом, который набрал, пока был невидим.\n\nНастройка «Счёт при переключении» в группе ⑦ показывает, много ли счёта пришло из невидимой части."))

    // ── ТАБЛО: три колонки, по одной на слой ──
    if trOn5 and trTbl
        // строки последовательностей считаем ДО цикла: пайн не умеет
        // тернарник, возвращающий кортеж
        [zlA, tlA, npA] = f_seqNow(PV5, BV5, HV5, LV5, 0)
        [zlB, tlB, npB] = f_seqNow(PV3, BV3, HV3, LV3, 1)
        [zlC, tlC, npC] = f_seqNow(P2, B2, H2, L2, 2)
        table.cell(TBL, 0, 0, "восходящий", text_color = color.gray, text_size = size.tiny)
        for c = 0 to 2
            nm = c == 0 ? "5/5" : c == 1 ? "3/3" : "2/2"
            bool isMain = c == mainL
            table.cell(TBL, c + 1, 0, isMain ? nm + " ◂" : nm, text_color = isMain ? cTrUp : color.gray, text_size = size.tiny)
            bool up = array.get(tTR, c) == 1
            lv = array.get(tLVL, c)
            im = array.get(tIMP, c)
            float thrA = na(lv) ? na : lv - im * trFib
            cG = up ? cTrUp : color.gray
            table.cell(TBL, c + 1, 1, up ? "ВОСХ" : "нет", text_color = cG, text_size = size.tiny)
            table.cell(TBL, c + 1, 2, up ? "(" + str.tostring(array.get(tCNT, c)) + ")/5" : "—", text_color = cG, text_size = size.tiny)
            table.cell(TBL, c + 1, 3, not up ? "—" : na(lv) ? "нет" : (array.get(tLHL, c) ? "HL " : "LL ") + str.tostring(lv, format.mintick), text_color = up and not na(lv) ? cTrUp : color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 4, na(thrA) or not up ? "—" : str.tostring(close - thrA, format.mintick), text_color = color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 5, up ? str.tostring(array.get(tBEL, c)) + "/" + str.tostring(trNbar) : "—", text_color = color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 6, up and array.get(tZB, c) >= 0 ? str.tostring(last_bar_index - array.get(tZB, c)) : "—", text_color = color.gray, text_size = size.tiny)
            db = array.get(tDB, c)
            table.cell(TBL, c + 1, 7, db < 0 ? "—" : str.tostring(last_bar_index - db) + " / " + str.tostring(array.get(tDP, c), format.mintick), text_color = db < 0 ? color.gray : cTrDie, text_size = size.tiny)
            // ── последовательность: узнаём форму и называем номером ──
            zl = c == 0 ? zlA : c == 1 ? zlB : zlC
            tl = c == 0 ? tlA : c == 1 ? tlB : tlC
            np = c == 0 ? npA : c == 1 ? npB : npC
            [mc, mi, mn] = f_match(tl)
            bool rojd = zl == "LL"
            // индекс считается отдельно и никогда не уходит в минус:
            // при mi = -1 голое выражение дало бы -1 и обращение за
            // границу массива. Та же предосторожность, что и с safeL
            int fiU = mi >= 0 ? mi + 8 * c + (rojd ? 0 : 24) : 0
            int fr = mi >= 0 and np >= 5 ? array.get(PFR, fiU) : -1
            // З28, 02.10.2026. Не подошёл НИ ОДИН эталон — f_match
            // возвращает пустое имя, и в ячейку клалась ПУСТОТА. Самый
            // сильный признак индикатора показывался пустым местом:
            // замер Н21 — счёт вне справочника доходит до (5) в 37%
            // против 90%. Теперь это слово, а не отсутствие слова.
            string nmU = mc > 0 ? mn : "вне справ."
            string cell = not up ? "—" : np < 5 ? (mc <= 3 ? nmU : str.tostring(mc) + " вар.") : nmU
            string tip = not up ? "Тренда нет." : "Слой " + nm + ", " + (rojd ? "РОЖДЕНИЕ, ноль LL" : "ПРОДОЛЖЕНИЕ, ноль HL") + "\n\nсейчас на графике:  " + zl + (np > 0 ? "·" + tl : "") + "\n" + (mc == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВсе восемь требуют HL на местах (2) и (4) — значит низ оказался LL, была манипуляция.\n\nЗамер Н21 на двух годах часовика: такие счёты доходят до (5) примерно в 37% случаев против 90% у формы из справочника." : np < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mc) + " из 8 — " + mn : "это " + mn + ", за 9 лет часовика встретилась " + str.tostring(fr) + " раз") + "\n\nИндикатор ничего не предсказывает. Он узнаёт форму и называет её номером, как шаблон триггерной свечи."
            table.cell(TBL, c + 1, 8, cell, text_color = up ? (mc == 0 ? color.orange : np >= 5 ? cTrUp : color.gray) : color.gray, text_size = size.tiny, tooltip = tip)
        table.cell(TBL, 0, 1, "состояние", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 2, "счёт", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 3, "уровень", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 4, "запас имп×" + str.tostring(trFib), text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 5, "закр. ниже", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 6, "баров от (0)", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 7, "прошлый слом", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 8, "посл-ть", text_color = color.gray, text_size = size.tiny, tooltip = "Номер последовательности из справочника на девяти годах часовика.\n\nВосходящий всегда начинается с LL — это ноль (0). Низы в нём всегда HL, иначе это не восходящий. Поэтому свободны только вершины, и вариантов ровно восемь.\n\nПока счёт не дошёл до (5), показано, сколько эталонов ещё подходят. Дошёл — показан номер, в подсказке колонки написано, сколько раз он встречался.\n\nПродолжение отличается нулём: у него он HL, а не LL, и свои частоты.")

    // ── НИСХОДЯЩИЙ: те же девять строк, ячейки 3-5 ──
    // Цены в этих ячейках отрицательные — перевёрнутый мир. Всё, что
    // идёт в табло, переворачивается обратно знаком.
    if trDn and trTbl
        [zlD, tlD, npD] = f_seqNow(PV5n, BV5n, HV5n, LV5n, 3)
        [zlE, tlE, npE] = f_seqNow(PV3n, BV3n, HV3n, LV3n, 4)
        [zlF, tlF, npF] = f_seqNow(P2n, B2n, H2n, L2n, 5)
        table.cell(TBL, 0, 9, "нисходящий", text_color = color.gray, text_size = size.tiny, tooltip = "Нисходящий считается ТЕМ ЖЕ движком на перевёрнутых свечах. Второго набора правил не существует — зеркало точное по построению.")
        for c = 0 to 2
            nmD = c == 0 ? "5/5" : c == 1 ? "3/3" : "2/2"
            bool isMainD = c == mainL
            table.cell(TBL, c + 1, 9, isMainD ? nmD + " ◂" : nmD, text_color = isMainD ? cTrDn : color.gray, text_size = size.tiny)
            bool dn = array.get(tTR, c + 3) == 1
            lvD = array.get(tLVL, c + 3)
            imD = array.get(tIMP, c + 3)
            float thrD = na(lvD) ? na : lvD - imD * trFib
            cD = dn ? cTrDn : color.gray
            table.cell(TBL, c + 1, 10, dn ? "НИСХ" : "нет", text_color = cD, text_size = size.tiny)
            table.cell(TBL, c + 1, 11, dn ? "(" + str.tostring(array.get(tCNT, c + 3)) + ")/5" : "—", text_color = cD, text_size = size.tiny)
            table.cell(TBL, c + 1, 12, not dn ? "—" : na(lvD) ? "нет" : (array.get(tLHL, c + 3) ? "LH " : "HH ") + str.tostring(-lvD, format.mintick), text_color = dn and not na(lvD) ? cTrDn : color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 13, na(thrD) or not dn ? "—" : str.tostring(-close - thrD, format.mintick), text_color = color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 14, dn ? str.tostring(array.get(tBEL, c + 3)) + "/" + str.tostring(trNbar) : "—", text_color = color.gray, text_size = size.tiny)
            table.cell(TBL, c + 1, 15, dn and array.get(tZB, c + 3) >= 0 ? str.tostring(last_bar_index - array.get(tZB, c + 3)) : "—", text_color = color.gray, text_size = size.tiny)
            dbD = array.get(tDB, c + 3)
            table.cell(TBL, c + 1, 16, dbD < 0 ? "—" : str.tostring(last_bar_index - dbD) + " / " + str.tostring(-array.get(tDP, c + 3), format.mintick), text_color = dbD < 0 ? color.gray : cTrUp, text_size = size.tiny)
            zlN = c == 0 ? zlD : c == 1 ? zlE : zlF
            tlN = c == 0 ? tlD : c == 1 ? tlE : tlF
            npN = c == 0 ? npD : c == 1 ? npE : npF
            [mcN, miN, mnN] = f_matchS(tlN)
            // подписи приходят из перевёрнутого мира — переводим обратно
            bool rojdN = zlN == "LL"
            int fiN = miN >= 0 ? miN + 8 * c + (rojdN ? 0 : 24) : 0
            int frN = miN >= 0 and npN >= 5 ? array.get(SFR, fiN) : -1
            // З28, то же самое в зеркальном блоке
            string nmD2 = mcN > 0 ? mnN : "вне справ."
            string cellN = not dn ? "—" : npN < 5 ? (mcN <= 3 ? nmD2 : str.tostring(mcN) + " вар.") : nmD2
            string tipN = not dn ? "Тренда нет." : "Слой " + nmD + ", " + (rojdN ? "РОЖДЕНИЕ, ноль HH" : "ПРОДОЛЖЕНИЕ, ноль LH") + "\n\nсейчас на графике:  " + f_swap1(zlN) + (npN > 0 ? "·" + f_swapSeq(tlN) : "") + "\n" + (mcN == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВ нисходящем все восемь требуют LH на местах (2) и (4) — значит вершина оказалась HH, была манипуляция.\n\nЗамер Н21 на двух годах часовика: такие счёты доходят до (5) примерно в 37% случаев против 90% у формы из справочника." : npN < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mcN) + " из 8 — " + mnN : "это " + mnN + ", за 9 лет часовика встретилась " + str.tostring(frN) + " раз") + "\n\nВершины в нисходящем всегда LH — иначе это не нисходящий. Свободны только низы, и вариантов ровно восемь.\n\nНумерация зеркальная: С1 это зеркало П1."
            table.cell(TBL, c + 1, 17, cellN, text_color = dn ? (mcN == 0 ? color.orange : npN >= 5 ? cTrDn : color.gray) : color.gray, text_size = size.tiny, tooltip = tipN)
        table.cell(TBL, 0, 10, "состояние", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 11, "счёт", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 12, "уровень", text_color = color.gray, text_size = size.tiny, tooltip = "Уровень нисходящего — последняя появившаяся LH. Новая LH заменяет предыдущую безусловно, ниже она или выше.")
        table.cell(TBL, 0, 13, "запас имп×" + str.tostring(trFib), text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 14, "закр. выше", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 15, "баров от (0)", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 16, "прошлый слом", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 17, "посл-ть", text_color = color.gray, text_size = size.tiny, tooltip = "Номер последовательности из справочника нисходящего, перепись девяти лет часовика.\n\nНисходящий всегда начинается с HH — это ноль (0). Вершины в нём всегда LH, иначе это не нисходящий. Поэтому свободны только низы, и вариантов ровно восемь.\n\nНумерация ЗЕРКАЛЬНАЯ: С1 это зеркало П1, С5 зеркало П5 и так далее. Так две таблицы кладутся рядом и сравниваются напрямую.\n\nПродолжение отличается нулём: у него он LH, а не HH, и свои частоты.")

    // ── СЛОМЫ В ТАБЛО: пять строк, теперь 18-22 ──
    // 23.09.2026 блок переехал с 9-13 вниз, чтобы нисходящий встал сразу
    // под восходящим. Ничего не пропало, поменялись только номера строк
    if slOn and slTbl
        table.cell(TBL, 0, 18,  "сломов подряд", text_color = color.gray, text_size = size.tiny, tooltip = "Сколько сломов подряд ушло в одну сторону. Слом — цена взяла ближайший непробитый пивот слоя, по касанию.\n\nПотолка у этого счёта нет: за девять лет серии доходили до 16-24 сломов, и потолок на пяти отрезал бы самые длинные десять процентов.")
        table.cell(TBL, 0, 19, "последний слом", text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 0, 20, "до слома ↑", text_color = color.gray, text_size = size.tiny, tooltip = "Ближайший непробитый уровень сверху и расстояние до него в процентах от цены. За девять лет медиана этого расстояния: 0.61% на 5/5, 0.48% на 3/3, 0.40% на 2/2.")
        table.cell(TBL, 0, 21, "до слома ↓", text_color = color.gray, text_size = size.tiny, tooltip = "Ближайший непробитый уровень снизу. Медиана за девять лет: 0.67% на 5/5, 0.53% на 3/3, 0.44% на 2/2.")
        table.cell(TBL, 0, 22, "раньше шло туда же", text_color = color.gray, text_size = size.tiny, tooltip = "Замер Н14, девять лет часовика. Доля случаев, когда после такой же серии следующий слом уходил В ТУ ЖЕ сторону.\n\nВ скобках — размер выборки и надбавка к собственной базовой доле сломов вверх по этому слою. Надбавка считается не от 50%: на растущем золоте без этой поправки цифра говорила бы про рост, а не про сломы.\n\nТридцать клеток замера, все положительные, знак держится в обеих половинах выборки, перемешанный контроль садится в ноль.\n\nЭто НЕ предсказание. Это частота, снятая с истории, — как шаблон триггерной свечи.")
        for c = 0 to 2
            int dr = array.get(sDIR, c)
            int rn = array.get(sRUN, c)
            color cS = dr > 0 ? cSlUp : dr < 0 ? cSlDn : color.gray
            table.cell(TBL, c + 1, 18, dr == 0 ? "—" : (dr > 0 ? "↑" : "↓") + str.tostring(rn), text_color = cS, text_size = size.tiny)
            int lb2 = array.get(sLB, c)
            table.cell(TBL, c + 1, 19, lb2 < 0 ? "—" : str.tostring(last_bar_index - lb2) + " / " + str.tostring(array.get(sLP, c), format.mintick), text_color = color.gray, text_size = size.tiny)
            float uN = c == 0 ? u5n : c == 1 ? u3n : u2n
            float dN = c == 0 ? d5n : c == 1 ? d3n : d2n
            table.cell(TBL, c + 1, 20, na(uN) ? "—" : str.tostring(uN, format.mintick) + "  " + str.tostring(100 * (uN - close) / close, "#.##") + "%", text_color = cSlUp, text_size = size.tiny)
            table.cell(TBL, c + 1, 21, na(dN) ? "—" : str.tostring(dN, format.mintick) + "  " + str.tostring(100 * (close - dN) / close, "#.##") + "%", text_color = cSlDn, text_size = size.tiny)
            // частота из замера: клетка «5 и больше» для всего, что длиннее пяти
            string fcell = "—"
            string ftip  = "Серии ещё нет."
            if dr != 0 and rn > 0
                int rk = rn > 5 ? 5 : rn
                int fi = c * 10 + (dr > 0 ? 0 : 5) + rk - 1
                float fq = array.get(SFQ, fi)
                int fn = array.get(SFN, fi)
                float bs = dr > 0 ? array.get(SFB, c) : 100 - array.get(SFB, c)
                fcell := str.tostring(fq, "#.#") + "%"
                ftip  := "После " + str.tostring(rk) + (rn > 5 ? " и более" : "") + " сломов подряд " + (dr > 0 ? "вверх" : "вниз") + " следующий уходил туда же в " + str.tostring(fq, "#.#") + "% случаев.\nВыборка: " + str.tostring(fn) + " случаев.\nБазовая доля по слою: " + str.tostring(bs, "#.#") + "%.\nНадбавка: " + (fq - bs >= 0 ? "+" : "") + str.tostring(fq - bs, "#.#") + " процентных пункта."
            table.cell(TBL, c + 1, 22, fcell, text_color = cS, text_size = size.tiny, tooltip = ftip)
    // ── ВСТАВКИ В ТАБЛО: одна строка-прибор ──
    // Второй комплект убран решением владельца 30.09.2026: вставки вошли
    // в сами колена 5/5 и 3/3, и строки «восх + вставки», «счёт +»,
    // «уровень + восх», «уровень + нисх» стали дубликатом строк выше.
    // Осталась одна — сколько вставок реально вошло в колена
    if trTbl
        table.cell(TBL, 0, 23, "вставок в коленах", text_color = color.gray, text_size = size.tiny, tooltip = "Сколько сырых вставок РЕАЛЬНО стало коленом слоя за всю историю графика. ↑ считает прямая цепочка, ↓ перевёрнутая.\n\nЧисла ↑ и ↓ обязаны совпадать: перевёрнутый мир берёт ровно те же пивоты. Разошлись — сломано зеркало.\n\nЕсли число не растёт при смене «Откуда 5/5 берёт вставки» — вставки не доходят до колен, и дело в коде.\n\nСчитаются только те, что СТАЛИ коленом. Вставка, совпавшая по стороне с предыдущим коленом, пропускается и сюда не идёт — З22.\n\nУ слоя 2/2 донора нет, там прочерк.")
        for c2 = 0 to 1
            table.cell(TBL, c2 + 1, 23, "↑" + str.tostring(array.get(VINS, c2)) + "  ↓" + str.tostring(array.get(VINS, c2 + 2)), text_color = color.gray, text_size = size.tiny)
        table.cell(TBL, 3, 23, "—", text_color = color.gray, text_size = size.tiny)

    if on3
        if lvOn
            r3 = f_lvlLayer(V3P, V3B, V3H, V3L, c3H, c3L)
        if absOn and (labWho == "3/3" or labWho == "все")
            g3 = f_drawAbs(GV3, YV3, ZV3, WV3, c3H, c3L, "3/3")
        d3 = f_draw(PV3, BV3, HV3, LV3, MV3, P2, B2, H2, L2, V2P, P2, B2, H2, L2, V2P, true,  c3H, c3L, "3/3", labWho == "3/3" or labWho == "все", false, mainL == 1 ? array.get(tZB, bokIdx) : NOZERO, mainL == 1 ? array.get(tPZB, bokIdx) : NOZERO, mainL == 1 ? drawTr : 0, array.get(tBOK, bokIdx), dnDraw, mainL == 1 ? array.get(swB, 1) : NOZERO)
