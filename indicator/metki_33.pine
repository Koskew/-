//@version=5
// ═══════════════════════════════════════════════════════════════════
// МЕТКИ 3/3 · ТРЕНД = СЧЁТ
//
// Движок переписан. Прежде тренд и счёт были двумя независимыми
// механизмами и считали от разных мест: в таблице стояло «нисходящий
// 236 баров» при нуле счёта двадцатибарной давности.
//
// Теперь одно целое:
//
//   ПОКА СЧЁТ ИДЁТ
//       колена нумеруются подряд от нуля: 0 1 2 3 4 5
//       подписи ничего не рвут, они только описывают
//       тренд = направление счёта, возраст = баров ОТ НУЛЯ
//
//   СЧЁТ КОНЧАЕТСЯ, что раньше
//       СЛОМ  тело закрытой свечи прошло уровень на fib импульса
//             уровень = последний HL (восх) или LH (нисх) от нуля
//       или   дошли до точки (5) и появилось седьмое колено
//
//   НОВЫЙ НОЛЬ — идём назад по коленам от места окончания,
//   берём ПЕРВОЕ встреченное колено с подписью
//       HH  ->  счёт вниз
//       LL  ->  счёт вверх
//   исключение на продолжение: если прошлый счёт был того же
//   направления и дошёл минимум до (3), годится и LH (для вниз)
//   или HL (для вверх), если встретилось раньше
//
// Что проверено и чего от индикатора НЕ ждать: слом ничего не
// предсказывает. После касания уровня цена идёт дальше ровно в
// половине случаев — проверено на 9 годах, трёх слоях, в обеих
// половинах истории. Слом это РАЗМЕТКА, а не сигнал.
// ═══════════════════════════════════════════════════════════════════
indicator("Метки 3/3", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=3000)

gA = "① Слой"
LB     = input.int(3,     "Глубина пивота (3 = метки 3/3)", minval=2, maxval=8, group=gA, tooltip="Сколько баров слева и справа должно быть ниже вершины. Метка видна через столько же баров после факта.")
fibD   = input.float(0.33,"Глубина слома, импульсов", 0.0, 1.0, 0.01, group=gA, tooltip="Насколько тело закрытой свечи должно уйти за уровень, чтобы счёт оборвался.")
maxPt  = input.int(5,     "Точек в счёте", minval=3, maxval=9, group=gA, tooltip="Счёт идёт от (0) до этой точки. Дальше — конец счёта и поиск нового нуля.")
contPt = input.int(3,     "Продолжение разрешено с точки", minval=1, maxval=5, group=gA, tooltip="Если прошлый счёт был того же направления и дошёл минимум до этой точки, новый ноль может встать на LH (для счёта вниз) или HL (для счёта вверх), а не только на HH и LL.")

gB = "② Что рисовать"
showRaw = input.bool(false, "Сырые пивоты", group=gB, tooltip="Треугольники на самих пивотах. Если рядом два одной стороны — они слились в одно колено.")
showZZ  = input.bool(true,  "Зиг-заг по коленам", group=gB)
labMode = input.string("номер и метка", "Подпись у колена", options=["номер и метка","номер + мутность","метка","ничего"], group=gB)
markZero= input.bool(true,  "Выделять ноль счёта", group=gB, tooltip="Ноль подписывается отдельно и крупнее: от него считается тренд.")
drawMud = input.bool(true,  "Помечать мутные колена", group=gB, tooltip="Колено, собранное из двух и более меток. Около 21% на часовике. Проверено: ничего не предсказывает, строка описательная.")
drawLvl = input.bool(true,  "Уровень счёта", group=gB)
drawEnd = input.bool(true,  "Отметки конца счёта", group=gB)
winBars = input.int(700,    "Рисовать за последние N баров", minval=100, group=gB)

gC = "③ Цвета"
cUp    = input.color(#00b050, "Счёт вверх", group=gC)
cDn    = input.color(#e0342c, "Счёт вниз", group=gC)
cMud   = input.color(#ff9800, "Пометка мутного", group=gC)
cZero  = input.color(#ffd54f, "Ноль счёта", group=gC)
zzW    = input.int(2, "Толщина зиг-зага", minval=1, maxval=4, group=gC)

gT = "④ Триггерная свеча"
trOn  = input.bool(true,  "Отмечать триггерные свечи", group=gT)
trTol = input.float(4.0,  "Допуск формы ±%", 1.0, 15.0, group=gT)
cTrig = input.color(#ffd54f, "Цвет отметки", group=gT)

gL = "⑤ Уровни HH/LL"
lvOn    = input.bool(true, "Показывать уровни", group=gL)
lv_tf1  = input.bool(true, "текущий ТФ", inline="lv", group=gL)
lv_tf4  = input.bool(true, "4H",         inline="lv", group=gL)
lv_tfd  = input.bool(true, "1D",         inline="lv", group=gL)
lvLH    = input.bool(true, "Штрихи для LH и HL", group=gL)
lvLB    = input.int(2, "Глубина пивота уровней", minval=1, maxval=8, group=gL)
lv_n    = input.int(3, "Ближайших к цене с каждой стороны", minval=1, maxval=10, group=gL)
lvTransp= input.int(40, "Прозрачность", minval=0, maxval=90, group=gL)
cLvH    = input.color(color.green, "верх / низ", inline="lc", group=gL)
cLvL    = input.color(color.red,   "",           inline="lc", group=gL)

gD = "⑥ Таблица"
showT = input.bool(true, "Таблица", group=gD)
posT  = input.string("верх-право", "Позиция", options=["верх-право","верх-лево","низ-право","низ-лево"], group=gD)
sizeT = input.string("small", "Размер", options=["tiny","small","normal"], group=gD)

MAXK = 80

// ══════════════ КОЛЕНА ══════════════
var float[]  KP = array.new_float()    // цена колена
var int[]    KB = array.new_int()      // бар экстремума
var bool[]   KH = array.new_bool()     // вершина или низ
var string[] KL = array.new_string()   // подпись HH / LH / HL / LL
var int[]    KM = array.new_int()      // сколько сырых меток слилось
var float[]  KA = array.new_float()    // цена поглощённой метки
var int[]    KN = array.new_int()      // номер точки в счёте, -1 вне счёта

// ══════════════ СОСТОЯНИЕ СЧЁТА ══════════════
var int   cz    = -1        // индекс колена-нуля, -1 = счёта нет
var int   czPrev= -1        // индекс нуля предыдущего счёта
var int   cdir  = 0         // +1 вверх, -1 вниз
var float lvl   = na        // уровень счёта
var float imp   = 0.0       // импульсная нога
var bool  lvlBroken = false // уровень уже проколот телом, но слома ещё нет

// прошлый счёт
var int   pDir  = 0
var int   pMax  = 0
var float pZeroP= na
var int   pZeroB= na
var string pZeroL = ""
var float pEndP = na
var int   pEndB = na
var string pWhy = ""
var int   pBars = 0

// отметки конца счёта для графика
var float[] EP = array.new_float()
var int[]   EB = array.new_int()
var int[]   ED = array.new_int()

f_isUp(_l) => _l == "HH" or _l == "HL"

// подпись: сравнение с предыдущим коленом ТОЙ ЖЕ стороны
f_relabel() =>
    array.clear(KL)
    n = array.size(KP)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(KH, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(KH, j) == hi
                    prev := array.get(KP, j)
                    break
                j -= 1
            cur = array.get(KP, i)
            array.push(KL, na(prev) ? "?" : hi ? (cur > prev ? "HH" : "LH") : (cur > prev ? "HL" : "LL"))
    n

// номера точек: подряд от нуля, ничем не прерываются
f_renumber() =>
    n = array.size(KP)
    array.clear(KN)
    if n > 0
        for i = 0 to n - 1
            array.push(KN, -1)
    if cz >= 0 and cz < n
        for i = cz to math.min(n - 1, cz + maxPt)
            array.set(KN, i, i - cz)
    n

// уровень и импульс текущего счёта. Глобальные переменные из функции
// менять нельзя, поэтому возвращаем пару и присваиваем на месте вызова.
f_state() =>
    n = array.size(KP)
    float L = na
    float I = 0.0
    if cz >= 0 and cz < n and cdir != 0
        want = cdir == 1 ? "HL" : "LH"
        j = math.min(n - 1, cz + maxPt)
        while j > cz
            if array.get(KL, j) == want
                L := array.get(KP, j)
                break
            j -= 1
        if na(L)
            L := array.get(KP, cz)
        k = math.min(n - 1, cz + maxPt)
        while k > cz
            p1 = array.get(KP, k)
            p0 = array.get(KP, k - 1)
            if (cdir == 1 and p1 > p0) or (cdir == -1 and p1 < p0)
                I := math.abs(p1 - p0)
                break
            k -= 1
        if I <= 0 and n > cz + 1
            I := math.abs(array.get(KP, cz + 1) - array.get(KP, cz))
    [L, I]

// поиск нового нуля: назад от конца, первое подходящее колено
f_findZero() =>
    n = array.size(KL)
    int z = -1
    int d = 0
    i = n - 1
    while i > czPrev and i >= 0
        lb = array.get(KL, i)
        int dd = 0
        if lb == "HH"
            dd := -1
        else if lb == "LL"
            dd := 1
        else if pMax >= contPt and pDir == -1 and lb == "LH"
            dd := -1
        else if pMax >= contPt and pDir == 1 and lb == "HL"
            dd := 1
        if dd != 0
            z := i
            d := dd
            break
        i -= 1
    [z, d]

// серия меток одной стороны схлопывается в свой экстремум.
// Возвращает пару: появилось ли новое колено и обрезался ли массив
// сверху — индексы cz и czPrev двигает уже вызывающий код.
f_push(_price, _bar, _hi) =>
    n = array.size(KP)
    bool same = n > 0 and array.get(KH, n - 1) == _hi
    bool fresh = false
    bool trimmed = false
    if same
        old = array.get(KP, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(KM, n - 1, array.get(KM, n - 1) + 1)
        if na(array.get(KA, n - 1))
            array.set(KA, n - 1, old)
        if better
            array.set(KP, n - 1, _price)
            array.set(KB, n - 1, _bar)
    else
        array.push(KP, _price)
        array.push(KB, _bar)
        array.push(KH, _hi)
        array.push(KM, 1)
        array.push(KA, na)
        fresh := true
        if array.size(KP) > MAXK
            array.shift(KP)
            array.shift(KB)
            array.shift(KH)
            array.shift(KM)
            array.shift(KA)
            trimmed := true
    d1 = f_relabel()
    [fresh, trimmed]

// ══════════════ ШАГ БАРА ══════════════
pvH = ta.pivothigh(high, LB, LB)
pvL = ta.pivotlow (low,  LB, LB)

var int[] KD = array.new_int()      // направление счёта, которому принадлежало колено

if barstate.isconfirmed
    bool  endNow = false
    string why   = ""
    int    endMax = 0

    // 1. слом: тело закрытой свечи прошло уровень на fib импульса
    if cz >= 0 and cdir != 0 and not na(lvl) and imp > 0
        bLo = math.min(open, close)
        bHi = math.max(open, close)
        need = imp * fibD
        bool died = (cdir == 1 and bLo < lvl - need) or (cdir == -1 and bHi > lvl + need)
        if died
            endNow := true
            why := "слом"
            endMax := math.min(array.size(KP) - 1 - cz, maxPt)

    // 2. новые колена. KD держим той же длины, что и KP: при новом
    // колене дописываем в конец, при обрезке снимаем с начала и
    // сдвигаем индексы нулей на один влево.
    if not na(pvH)
        [f1, t1] = f_push(high[LB], bar_index - LB, true)
        if f1
            array.push(KD, 0)
        if t1
            array.shift(KD)
            cz := cz > 0 ? cz - 1 : (cz == 0 ? -1 : cz)
            czPrev := czPrev > 0 ? czPrev - 1 : (czPrev == 0 ? -1 : czPrev)
    if not na(pvL)
        [f2, t2] = f_push(low[LB], bar_index - LB, false)
        if f2
            array.push(KD, 0)
        if t2
            array.shift(KD)
            cz := cz > 0 ? cz - 1 : (cz == 0 ? -1 : cz)
            czPrev := czPrev > 0 ? czPrev - 1 : (czPrev == 0 ? -1 : czPrev)

    // 3. счёт упёрся в последнюю точку и появилось лишнее колено
    if cz >= 0 and not endNow and array.size(KP) - 1 > cz + maxPt
        endNow := true
        why := "дошёл до (" + str.tostring(maxPt) + ")"
        endMax := maxPt

    // 4. закрываем счёт и запоминаем его
    if endNow and cz >= 0 and cz < array.size(KP)
        pDir   := cdir
        pMax   := endMax
        pZeroP := array.get(KP, cz)
        pZeroB := array.get(KB, cz)
        pZeroL := array.get(KL, cz)
        pEndP  := why == "слом" ? lvl : close
        pEndB  := bar_index
        pBars  := bar_index - pZeroB
        pWhy   := why
        array.push(EP, pEndP)
        array.push(EB, bar_index)
        array.push(ED, cdir)
        czPrev := cz
        cz := -1
        cdir := 0
        lvl := na
        imp := 0.0

    // 5. счёта нет — ищем законный ноль
    if cz < 0
        [z, d] = f_findZero()
        if z >= 0
            cz := z
            cdir := d

    // 6. номера точек, уровень, импульс
    r1 = f_renumber()
    [Lx, Ix] = f_state()
    lvl := Lx
    imp := Ix

    // 7. помечаем колена текущего счёта его направлением
    if cz >= 0
        for i = cz to math.min(array.size(KD) - 1, cz + maxPt)
            array.set(KD, i, cdir)

// ══════════════ ПРОИЗВОДНЫЕ ══════════════
f_curPt() =>
    n = array.size(KN)
    n > 0 ? array.get(KN, n - 1) : -1

// оставшийся ход до порога слома, в импульсах
f_room() =>
    float r = na
    if cz >= 0 and cdir != 0 and not na(lvl) and imp > 0
        thr = cdir == 1 ? lvl - imp * fibD : lvl + imp * fibD
        r := math.max(0.0, cdir == 1 ? close - thr : thr - close) / imp
    r

f_chain() =>
    n = array.size(KL)
    s = ""
    if cz >= 0 and n > 0
        for j = cz to math.min(n - 1, cz + maxPt)
            s := s + (j > cz ? ">" : "") + array.get(KL, j)
    s

f_mud() =>
    n = array.size(KM)
    mc = 0
    cnt = 0
    if cz >= 0
        for q = cz to math.min(n - 1, cz + maxPt)
            cnt += 1
            if array.get(KM, q) >= 2
                mc += 1
    last = n > 0 ? array.get(KM, n - 1) : 1
    (last >= 2 ? "МУТНОЕ x" + str.tostring(last) + " · " : "чистое · ") + str.tostring(mc) + " из " + str.tostring(cnt)

// ══════════════ ТРИГГЕРНАЯ СВЕЧА ══════════════
// Форма в долях диапазона совпала с одним из 40 шаблонов. Сама по себе
// свеча монетка: на 2199 срабатываниях вход по закрытию даёт от -0.23R
// до +0.05R. Это «здесь можно смотреть», а не вход.
tb_ = array.from(12.6,14.7,17.0,32.0,20.2,4.1,23.0,27.9,30.7,35.2,24.5,41.9,26.0,25.9,11.6,23.3,49.3,14.0,18.3,25.4,27.9,45.7,29.2,40.6,41.9,10.4,41.5,23.6,32.2,18.8,35.5,32.2,54.2,10.8,47.3,16.0,21.6,19.8,9.9,27.5)
tu_ = array.from(33.7,37.3,37.7,27.8,29.4,40.4,35.7,35.3,41.0,35.7,28.4,22.0,39.6,37.4,46.0,31.5,21.5,27.5,47.3,35.6,26.2,24.8,36.3,36.7,26.8,35.6,20.7,34.5,36.4,46.2,38.6,33.6,21.6,44.1,22.9,45.2,42.8,45.2,41.5,30.7)
tl_ = array.from(53.7,48.0,45.3,40.2,50.4,55.5,41.3,36.8,28.3,29.1,47.1,36.0,34.5,36.7,42.5,45.2,29.2,58.5,34.4,39.0,46.0,29.5,34.5,22.6,31.3,54.0,37.9,41.9,31.4,34.9,25.8,34.2,24.2,45.1,29.8,38.8,35.5,35.0,48.6,41.8)

rng_ = high - low
bp_  = rng_ > 0 ? math.abs(close - open) / rng_ * 100 : 0.0
upp_ = rng_ > 0 ? (open > close ? high - open : high - close) / rng_ * 100 : 0.0
lop_ = rng_ > 0 ? (open > close ? close - low : open - low) / rng_ * 100 : 0.0
int trIdx = -1
if trOn and rng_ > 0
    for ti = 0 to 39
        if math.abs(bp_ - array.get(tb_, ti)) <= trTol and math.abs(upp_ - array.get(tu_, ti)) <= trTol and math.abs(lop_ - array.get(tl_, ti)) <= trTol
            trIdx := ti
            break
trig_ok = trIdx >= 0
plotshape(trig_ok, title="Триггерная свеча", style=shape.circle, location=location.belowbar, color=cTrig, size=size.tiny)
plotshape(showRaw and not na(pvH) ? pvH : na, title="сырой верх", style=shape.triangledown, location=location.absolute, color=color.new(cDn, 35), size=size.tiny, offset=-LB)
plotshape(showRaw and not na(pvL) ? pvL : na, title="сырой низ",  style=shape.triangleup,   location=location.absolute, color=color.new(cUp, 35), size=size.tiny, offset=-LB)

// ══════════════ УРОВНИ HH/LL/LH/HL — 1H, 4H, 1D ══════════════
// Перенесено из Тренажёра без изменений логики. Уровень существует,
// пока не пробит: как только цена его прошла — он умирает и не рисуется.
// Рисуются только N ближайших к цене с каждой стороны на каждом ТФ:
// живых уровней бывает около 130 одновременно, большинство далёкие.
// HH и LL — пунктир, LH и HL — точки. Толщина растёт с таймфреймом.

lph = ta.pivothigh(high, lvLB, lvLB)
lpl = ta.pivotlow (low,  lvLB, lvLB)
lphv = high[lvLB]
lplv = low[lvLB]
a1 = ta.valuewhen(not na(lph), lphv, 1)
a2 = ta.valuewhen(not na(lph), lphv, 0)
hh1 = na(lph) ? na : a1 < a2 ? lph : na
lh1 = na(lph) ? na : a1 > a2 ? lph : na
a3 = ta.valuewhen(not na(lpl), lplv, 1)
a4 = ta.valuewhen(not na(lpl), lplv, 0)
ll1 = na(lpl) ? na : a3 > a4 ? lpl : na
hl1 = na(lpl) ? na : a3 < a4 ? lpl : na

ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, lvLB, lvLB), lookahead=barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  lvLB, lvLB), lookahead=barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[lvLB], lookahead=barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[lvLB],  lookahead=barmerge.lookahead_off)
b1 = ta.valuewhen(not na(ph4), ph4v, 1)
b2 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b1 < b2 ? ph4 : na
lh4 = na(ph4) ? na : b1 > b2 ? ph4 : na
b3 = ta.valuewhen(not na(pl4), pl4v, 1)
b4 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b3 > b4 ? pl4 : na
hl4 = na(pl4) ? na : b3 < b4 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, lvLB, lvLB), lookahead=barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  lvLB, lvLB), lookahead=barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[lvLB], lookahead=barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[lvLB],  lookahead=barmerge.lookahead_off)
c1 = ta.valuewhen(not na(phd), phdv, 1)
c2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : c1 < c2 ? phd : na
lhd = na(phd) ? na : c1 > c2 ? phd : na
c3 = ta.valuewhen(not na(pld), pldv, 1)
c4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : c3 > c4 ? pld : na
hld = na(pld) ? na : c3 < c4 ? pld : na

var float[] HH1P = array.new_float()
var int[] HH1B = array.new_int()
var float[] LL1P = array.new_float()
var int[] LL1B = array.new_int()
var float[] LH1P = array.new_float()
var int[] LH1B = array.new_int()
var float[] HL1P = array.new_float()
var int[] HL1B = array.new_int()
var float[] HH4P = array.new_float()
var int[] HH4B = array.new_int()
var float[] LL4P = array.new_float()
var int[] LL4B = array.new_int()
var float[] LH4P = array.new_float()
var int[] LH4B = array.new_int()
var float[] HL4P = array.new_float()
var int[] HL4B = array.new_int()
var float[] HHDP = array.new_float()
var int[] HHDB = array.new_int()
var float[] LLDP = array.new_float()
var int[] LLDB = array.new_int()
var float[] LHDP = array.new_float()
var int[] LHDB = array.new_int()
var float[] HLDP = array.new_float()
var int[] HLDB = array.new_int()

f_addNow(_p, _b, _v) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - lvLB)
    0
f_addHTF(_p, _b, _v, _prev) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
    0

x1_ = f_addNow(HH1P, HH1B, hh1)
x2_ = f_addNow(LL1P, LL1B, ll1)
x3_ = f_addNow(LH1P, LH1B, lh1)
x4_ = f_addNow(HL1P, HL1B, hl1)
x5_ = f_addHTF(HH4P, HH4B, hh4, nz(hh4[1]))
x6_ = f_addHTF(LL4P, LL4B, ll4, nz(ll4[1]))
x7_ = f_addHTF(LH4P, LH4B, lh4, nz(lh4[1]))
x8_ = f_addHTF(HL4P, HL4B, hl4, nz(hl4[1]))
x9_ = f_addHTF(HHDP, HHDB, hhd, nz(hhd[1]))
xa_ = f_addHTF(LLDP, LLDB, lld, nz(lld[1]))
xb_ = f_addHTF(LHDP, LHDB, lhd, nz(lhd[1]))
xc_ = f_addHTF(HLDP, HLDB, hld, nz(hld[1]))

// уровень существует, пока не пробит
f_purge(_p, _b, _isHi) =>
    i = 0
    while i < array.size(_p)
        if (_isHi and high >= array.get(_p, i)) or (not _isHi and low <= array.get(_p, i))
            array.remove(_p, i)
            array.remove(_b, i)
        else
            i += 1
    0

y1_ = f_purge(HH1P, HH1B, true)
y2_ = f_purge(LL1P, LL1B, false)
y3_ = f_purge(LH1P, LH1B, true)
y4_ = f_purge(HL1P, HL1B, false)
y5_ = f_purge(HH4P, HH4B, true)
y6_ = f_purge(LL4P, LL4B, false)
y7_ = f_purge(LH4P, LH4B, true)
y8_ = f_purge(HL4P, HL4B, false)
y9_ = f_purge(HHDP, HHDB, true)
ya_ = f_purge(LLDP, LLDB, false)
yb_ = f_purge(LHDP, LHDB, true)
yc_ = f_purge(HLDP, HLDB, false)

var line[] LVL = array.new<line>()

f_nearest(_p, _b, _col, _w, _st) =>
    if array.size(_p) > 0
        bool[] used = array.new_bool(array.size(_p), false)
        for k = 1 to lv_n
            best = -1
            float bestd = 1.0e18
            for i = 0 to array.size(_p) - 1
                if not array.get(used, i)
                    d = math.abs(array.get(_p, i) - close)
                    if d < bestd
                        bestd := d
                        best := i
            if best >= 0
                array.set(used, best, true)
                // левый край не дальше буфера истории, иначе в симуляторе
                // линия просит бар за пределами доступного
                xl = math.max(array.get(_b, best), bar_index - 2900)
                array.push(LVL, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color=color.new(_col, lvTransp), width=_w, style=_st, extend=extend.right))
    0

if barstate.islast
    while array.size(LVL) > 0
        line.delete(array.pop(LVL))
    if lvOn and lv_tf1
        z1 = f_nearest(HH1P, HH1B, cLvH, 1, line.style_dashed)
        z2 = f_nearest(LL1P, LL1B, cLvL, 1, line.style_dashed)
        if lvLH
            z3 = f_nearest(LH1P, LH1B, cLvH, 1, line.style_dotted)
            z4 = f_nearest(HL1P, HL1B, cLvL, 1, line.style_dotted)
    if lvOn and lv_tf4
        z5 = f_nearest(HH4P, HH4B, cLvH, 2, line.style_dashed)
        z6 = f_nearest(LL4P, LL4B, cLvL, 2, line.style_dashed)
        if lvLH
            z7 = f_nearest(LH4P, LH4B, cLvH, 2, line.style_dotted)
            z8 = f_nearest(HL4P, HL4B, cLvL, 2, line.style_dotted)
    if lvOn and lv_tfd
        z9 = f_nearest(HHDP, HHDB, cLvH, 3, line.style_dashed)
        za = f_nearest(LLDP, LLDB, cLvL, 3, line.style_dashed)
        if lvLH
            zb = f_nearest(LHDP, LHDB, cLvH, 3, line.style_dotted)
            zc = f_nearest(HLDP, HLDB, cLvL, 3, line.style_dotted)


// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()
f_col(_d) => _d == 1 ? cUp : cDn

f_drawZZ() =>
    n = array.size(KP)
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(KB, i - 1)
            x2 = array.get(KB, i)
            if last_bar_index - x1 <= winBars
                num  = array.get(KN, i)
                d    = i < array.size(KD) ? array.get(KD, i) : 0
                // нога В НОЛЬ принадлежит прошлому счёту, а не новому
                dL   = (num == 0 and i > 0 and i - 1 < array.size(KD)) ? array.get(KD, i - 1) : d
                bool inCur = cz >= 0 and i > cz and i <= cz + maxPt
                bool corr  = num > 0 and num % 2 == 0
                cc0 = dL == 0 ? color.gray : f_col(dL)
                tp  = (corr ? 40 : 0) + (inCur ? 0 : 55)
                cc  = color.new(cc0, math.min(85, tp))
                if showZZ
                    array.push(LNS, line.new(x1, array.get(KP, i - 1), x2, array.get(KP, i), color=cc, width=corr ? zzW : zzW + 1))
                mc  = array.get(KM, i)
                ap  = array.get(KA, i)
                lbb = array.get(KL, i)
                pr  = array.get(KP, i)
                hh  = array.get(KH, i)
                mud = mc >= 2
                if drawMud and mud and not na(ap)
                    array.push(LNS, line.new(x1, ap, x2, ap, color=color.new(cMud, 20), width=1, style=line.style_dotted))
                bool isZero = i == cz
                string txt = na
                if labMode == "номер и метка"
                    txt := (num >= 0 ? "(" + str.tostring(num) + ") " : "") + lbb + (mud ? " м" : "")
                else if labMode == "номер + мутность"
                    txt := (num >= 0 ? "(" + str.tostring(num) + ")" : "·") + (mud ? "м" : "")
                else if labMode == "метка"
                    txt := lbb + (mud ? " м" : "")
                if isZero and markZero
                    txt := "◆ (0) " + lbb
                if not na(txt)
                    lc0 = isZero and markZero ? cZero : (dL == 0 ? color.gray : f_col(dL))
                    lc  = inCur or isZero ? lc0 : color.new(lc0, 62)
                    dd  = i < array.size(KD) ? array.get(KD, i) : 0
                    tip = "колено " + lbb + "  " + str.tostring(pr, format.mintick) + "\n" + (num >= 0 ? (num == 0 ? "НОЛЬ СЧЁТА — отсюда считается тренд" : "точка (" + str.tostring(num) + ") из " + str.tostring(maxPt) + " · " + (num % 2 == 1 ? "импульсная" : "корректирующая")) : "вне счёта") + "\n" + (dd == 1 ? "счёт вверх" : dd == -1 ? "счёт вниз" : "счёт не определён") + "\n" + (mud ? "МУТНОЕ: слилось " + str.tostring(mc) + " меток, поглощена " + str.tostring(ap, format.mintick) : "чистое колено")
                    array.push(LBS, label.new(x2, pr, txt, style=hh ? label.style_label_down : label.style_label_up, color=color.new(color.black, 100), textcolor=mud and not isZero ? cMud : lc, size=isZero and markZero ? size.normal : size.small, tooltip=tip))
    n

f_drawLvl() =>
    if drawLvl and cz >= 0 and not na(lvl) and cdir != 0
        x0 = cz < array.size(KB) ? array.get(KB, cz) : bar_index - 50
        thr = cdir == 1 ? lvl - imp * fibD : lvl + imp * fibD
        array.push(LNS, line.new(x0, lvl, bar_index + 8, lvl, color=color.new(f_col(cdir), 25), width=2, style=line.style_dashed))
        array.push(LBS, label.new(bar_index + 8, lvl, (cdir == 1 ? "HL " : "LH ") + str.tostring(lvl, format.mintick), style=label.style_label_left, color=color.new(f_col(cdir), 85), textcolor=f_col(cdir), size=size.small))
        if imp > 0
            array.push(LNS, line.new(x0, thr, bar_index + 8, thr, color=color.new(f_col(cdir), 60), width=1, style=line.style_dotted))
            array.push(LBS, label.new(bar_index + 8, thr, "слом " + str.tostring(thr, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(f_col(cdir), 35), size=size.tiny))
    0

if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))
    d1 = f_drawZZ()
    d2 = f_drawLvl()
    if drawEnd and array.size(EB) > 0
        i0 = math.max(0, array.size(EB) - 12)
        for i = i0 to array.size(EB) - 1
            eb = array.get(EB, i)
            if last_bar_index - eb <= winBars
                ep = array.get(EP, i)
                ed = array.get(ED, i)
                array.push(LBS, label.new(eb, ep, "конец", style=ed == 1 ? label.style_label_up : label.style_label_down, color=color.new(f_col(ed == 1 ? -1 : 1), 30), textcolor=color.white, size=size.tiny))

// ══════════════ ТАБЛИЦА ══════════════
tss  = sizeT == "tiny" ? size.tiny : sizeT == "normal" ? size.normal : size.small
tpos = posT == "верх-лево" ? position.top_left : posT == "низ-право" ? position.bottom_right : posT == "низ-лево" ? position.bottom_left : position.top_right
var table T = table.new(tpos, 2, 11, bgcolor=color.new(#12121c, 8), border_color=color.new(color.gray, 70), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

f_row(_r, _k, _v, _c, _tip) =>
    table.cell(T, 0, _r, _k, text_color=color.new(color.silver, 25), text_halign=text.align_left, text_size=tss, tooltip=_tip)
    table.cell(T, 1, _r, _v, text_color=_c, text_halign=text.align_left, text_size=tss)
    _r

if showT and barstate.islast
    cp = f_curPt()
    rm = f_room()
    table.cell(T, 0, 0, "━━  МЕТКИ  ━━", text_color=color.new(color.silver, 5), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.tiny)
    table.cell(T, 1, 0, str.tostring(LB) + "/" + str.tostring(LB), text_color=color.new(color.aqua, 0), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.tiny)

    string trTxt = "ПЕРЕХОД — нет законного нуля"
    color  trCol = color.new(color.orange, 0)
    if cz >= 0 and cdir != 0 and cz < array.size(KB)
        trTxt := (cdir == 1 ? "ВОСХОДЯЩИЙ" : "НИСХОДЯЩИЙ") + ", " + str.tostring(bar_index - array.get(KB, cz)) + "б от нуля"
        trCol := f_col(cdir)
    r1 = f_row(1, "тренд", trTxt, trCol, "Тренд и счёт — одно и то же. Тренд начинается на точке (0) своего счёта, идёт в его направлении и живёт, пока счёт идёт. Возраст считается ОТ НУЛЯ, а не от отдельной точки рождения.")

    r2 = f_row(2, "счёт", cz < 0 ? "—" : "(" + str.tostring(cp) + ") из " + str.tostring(maxPt) + " " + (cdir == 1 ? "↑" : "↓") + (cp <= 0 ? "" : cp % 2 == 1 ? " импульс" : " коррекция"), cz < 0 ? color.gray : f_col(cdir), "Колена нумеруются подряд от нуля. Подписи счёт не рвут — они только описывают, что получилось.")

    string z0 = "—"
    if cz >= 0 and cz < array.size(KP)
        z0 := array.get(KL, cz) + " " + str.tostring(array.get(KP, cz), format.mintick) + " · " + str.tostring(bar_index - array.get(KB, cz)) + "б назад"
    r3 = f_row(3, "ноль счёта", z0, cz < 0 ? color.gray : cZero, "Ноль ищется назад по коленам: первое встреченное HH даёт счёт вниз, первое LL — счёт вверх. LH и HL годятся только в продолжении, когда прошлый счёт был того же направления и дошёл минимум до точки " + str.tostring(contPt) + ".")

    r4 = f_row(4, "уровень", cz < 0 or na(lvl) ? "—" : (cdir == 1 ? "HL " : "LH ") + str.tostring(lvl, format.mintick) + (imp > 0 ? "  слом за " + str.tostring(cdir == 1 ? lvl - imp * fibD : lvl + imp * fibD, format.mintick) : ""), cz < 0 or na(lvl) ? color.gray : color.white, "Последний HL для восходящего счёта, последний LH для нисходящего. Счёт обрывается, когда тело закрытой свечи прошло уровень на " + str.tostring(fibD) + " импульса.")

    r5 = f_row(5, "запас", na(rm) ? "—" : str.tostring(rm, "#.##") + " имп", na(rm) ? color.gray : rm < 0.25 ? cDn : rm < 0.5 ? color.new(color.orange, 0) : rm < 1.0 ? color.new(color.silver, 20) : cUp, "Сколько импульсов осталось до порога слома. ВАЖНО: это не прогноз. Проверено на 9 годах — после касания уровня цена идёт дальше ровно в половине случаев.")

    r6 = f_row(6, "цепочка", cz < 0 ? "—" : f_chain(), cz < 0 ? color.gray : f_col(cdir), "Подписи колен от нуля. Эталон вверх: LL>LH>HL>HH>HL>HH. Проверено: эталонная последовательность встречается вдвое чаще случайного, но поведение цены после неё ничем не отличается.")

    r7 = f_row(7, "чистота", cz < 0 ? "—" : f_mud(), color.new(color.silver, 30), "Мутное колено собралось из двух и более меток. Около 21% на часовике. Проверено: ничего не предсказывает, строка описательная.")

    string p1 = "—"
    string p2 = "—"
    if pDir != 0
        p1 := (pDir == 1 ? "восх" : "нисх") + " · ноль " + pZeroL + " " + str.tostring(pZeroP, format.mintick) + " · дошёл до (" + str.tostring(pMax) + ")"
        p2 := pWhy + " на " + str.tostring(pEndP, format.mintick) + " · прожил " + str.tostring(pBars) + "б · " + str.tostring(bar_index - pEndB) + "б назад"
    r8 = f_row(8, "прошлый счёт", p1, pDir == 0 ? color.gray : color.new(f_col(pDir), 35), "Где стоял его ноль, в какую сторону шёл и до какой точки дошёл. Номер точки важен: продолжение разрешено только если прошлый дошёл минимум до (" + str.tostring(contPt) + ").")
    r9 = f_row(9, "чем кончился", p2, pDir == 0 ? color.gray : color.new(color.silver, 25), "Слом по уровню или дошёл до последней точки. Прожил — баров ОТ СВОЕГО НУЛЯ.")

    r10 = f_row(10, "свеча", trig_ok ? "ТРИГГЕРНАЯ · шаблон " + str.tostring(trIdx + 1) : "обычная", trig_ok ? cTrig : color.gray, "Форма свечи совпала с одним из 40 шаблонов. Сама по себе монетка: на 2199 срабатываниях вход по закрытию даёт от -0.23R до +0.05R. Это «здесь можно смотреть», а не вход.")
