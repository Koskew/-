//@version=5
// ═══════════════════════════════════════════════════════════════════
// МЕТКИ 3/3 — один слой, только структура
//
// Движок скопирован из ГДЕ МЫ v5 без единого изменения: тип Layer,
// f_relabel, f_recount, f_push, f_step. Отличие одно — слой один, и
// его глубина пивота вынесена в настройку.
//
// Что показывает:
//   сырые пивоты      — маленькие треугольники, видно слияние в колена
//   зиг-заг по коленам — цвет говорит про счёт, толщина про импульс
//   подписи у колен    — номер точки, стрелка счёта, мутность
//   пунктир            — уровень, на котором держится тренд
//   таблица            — где мы сейчас
//
// Замер на 1H золота, два года: при глубине пивота 3 колено появляется
// раз в 6.7 бара против 4.8 у 2/2 и 10.0 у 5/5, счёт идёт 28 баров
// против 19 и 41. Мутность, медиана глубины счёта и доля счётов,
// дошедших до (5), у всех слоёв ОДИНАКОВЫ — настройка пивота меняет
// скорость, а не форму структуры.
// ═══════════════════════════════════════════════════════════════════
indicator("Метки 3/3", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=3000)

gA = "① Слой"
LB      = input.int(3,    "Глубина пивота (3 = метки 3/3)", minval=2, maxval=8, group=gA, tooltip="Сколько баров слева и справа должно быть ниже вершины. Меняйте, чтобы сравнить 2/2, 3/3, 4/4, 5/5 на одном графике. Метка видна через столько же баров после факта.")
fibD    = input.float(0.33,"Глубина слома, импульсов", 0.0, 1.0, 0.01, group=gA, tooltip="Насколько тело закрытой свечи должно уйти за уровень, чтобы тренд считался мёртвым. 0.33 при глубине пивота 3 даёт медиану жизни тренда 32 бара на 1H и 30 на 5m, время в ПЕРЕХОДЕ 18-21%.")
jumpC   = input.float(0.5, "Досрочное подтверждение, импульсов", 0.0, 3.0, 0.25, group=gA, tooltip="Пауза «жду 2 колена» в одностороннем ходе не двигается: новый экстремум сливается в то же колено. Рывок подтверждает тренд сразу, если цена ушла от уровня смерти дальше этой доли импульса И две последние метки согласны. 0 выключает.")
provOn  = input.bool(true, "После рывка держать на уровне смерти", group=gA)
zSeek   = input.int(6,     "Глубина поиска нуля, колен", minval=2, maxval=40, group=gA, tooltip="Ноль счёта ищется НАЗАД до колена нужной подписи: HH/LL на развороте, LH/HL на продолжении. Это окно поиска. Без границы в затяжном ходе поиск уходил на десятки колен назад, якорь вставал так далеко, что новые колена сразу были за точкой (5) и счёт пропадал. 6 — длина одного полного счёта. Если нужной подписи в окне нет, ноль встаёт на ближайшее колено нужной СТОРОНЫ: счёт вверх стартует с низа, вниз с вершины.")
ratchet = input.bool(true, "Храповик опоры", group=gA, tooltip="Опора восходящего тренда может только подниматься, нисходящего — только опускаться. Взято у супертренда. Без храповика нырок под опору, не дотянувший до порога смерти, рождает LL, следующий HL встаёт НИЖЕ прежней опоры — и запас после провала становится больше, чем был до него. Выключите, чтобы сравнить со старым поведением.")

gB = "② Что рисовать"
showRaw = input.bool(true,  "Сырые пивоты", group=gB, tooltip="Маленькие треугольники на самих пивотах. Если рядом два одной стороны — они слились в одно колено, это и есть мутность.")
showZZ  = input.bool(true,  "Зиг-заг по коленам", group=gB)
labMode = input.string("номер и метка", "Подпись у колена", options=["номер и метка","номер + мутность","метка","ничего"], group=gB, tooltip="«номер и метка» — (2) HL↑: номер точки счёта, буква структуры, стрелка направления счёта. Остальное в тултипе при наведении на подпись.")
drawMud = input.bool(true,  "Помечать мутные колена", group=gB, tooltip="Колено, собранное из двух и более меток: первая появилась, была перебита, цена сделала второй экстремум. Около 21% на 1H и 18% на 5m — и это не зависит от глубины пивота.")
drawLvl = input.bool(true,  "Уровень, который держит тренд", group=gB)
drawMSB = input.bool(true,  "Отметка слома", group=gB)
stOn   = input.bool(true, "Опора и порог линией", group=gB, tooltip="Сплошная — опора (колено). Пунктир — порог смерти, опора ∓ имп × глубина слома. Разрыв обеих = ПЕРЕХОД.")
stFill = input.bool(true, "Заливать запас", group=gB, tooltip="Между серединой тела и порогом. Чем тоньше полоса, тем меньше осталось до смерти тренда.")
winBars = input.int(700,   "Рисовать за последние N баров", minval=100, group=gB)

gC = "③ Цвета"
cUp    = input.color(#00b050, "Восходящий", group=gC)
cDn    = input.color(#e0342c, "Нисходящий", group=gC)
cMud   = input.color(#ff9800, "Пометка мутного", group=gC)
cZero  = input.color(#ffd54f, "Ноль действующего счёта", group=gC, tooltip="Действующий счёт рисуется ПОВЕРХ старой разметки, на бар правее: ромб с нулём и номера до пяти. Прежние подписи при этом остаются на месте.")
zzW    = input.int(2, "Толщина зиг-зага", minval=1, maxval=4, group=gC)
zzMode = input.string("по счёту", "Чем красить зиг-заг", options=["по счёту","по ходу ноги","по тренду"], group=gC, tooltip="«по счёту» — цвет говорит, куда считает структура, толщина отделяет импульс от коррекции. «по ходу ноги» — вниз красная, вверх зелёная. «по тренду» — цвет действующего тренда.")

gD = "④ Таблица"
showT = input.bool(true, "Таблица", group=gD)
posT  = input.string("верх-право", "Позиция", options=["верх-право","верх-лево","низ-право","низ-лево"], group=gD)
sizeT = input.string("small", "Размер", options=["tiny","small","normal"], group=gD)

MAXK = 80

// ══════════════ СЛОЙ ══════════════
type Layer
    array<float>  KP        // цена колена
    array<int>    KB        // бар колена
    array<bool>   KH        // вершина или низ
    array<string> KL        // метка HH / LH / HL / LL
    array<int>    KN        // номер точки в счёте, -1 вне счёта
    array<int>    KM        // сколько сырых меток слилось
    array<float>  KA        // цена первой, поглощённой метки
    array<int>    KT        // тренд на момент появления колена
    array<bool>   KX        // колено появилось в ПЕРЕХОДЕ
    int      lb
    float    fib
    float    jump
    int      tr
    float    lvl
    float    imp
    int      trFrom
    bool     inTrans
    int      marks
    float    lastD
    bool     lvlProv
    int      pTr
    float    pD
    int      pDb
    int      czIdx     // колено-ноль в массиве; -1 если уехало за обрезку
    int      czBar     // бар нуля — живёт, даже когда колено обрезано
    float    czPrice   // цена нуля
    string   czLab     // подпись нуля
    int      lastTr    // тренд на прошлом баре — чтобы поймать смену
    bool     lastTrans  // был ли ПЕРЕХОД на прошлом баре
    int      pCdir     // направление прошлого счёта
    int      pCmax     // до какой точки прошлый счёт дошёл
    int      pZb       // бар нуля прошлого тренда
    float    pZp       // цена нуля прошлого тренда
    string   pZl       // подпись нуля прошлого тренда

f_new(_lb, _fib, _jump) =>
    Layer.new(KP = array.new_float(), KB = array.new_int(), KH = array.new_bool(),
              KL = array.new_string(), KN = array.new_int(), KM = array.new_int(),
              KA = array.new_float(), KT = array.new_int(), KX = array.new_bool(),
              lb = _lb, fib = _fib, jump = _jump,
              tr = 0, lvl = na, imp = 0.0, trFrom = na, inTrans = false, marks = 0,
              lastD = na, lvlProv = false, pTr = 0, pD = na, pDb = na,
              czIdx = -1, czBar = na, czPrice = na, czLab = "",
              lastTr = 0, lastTrans = false, pCdir = 0, pCmax = 0,
              pZb = na, pZp = na, pZl = "")

f_isUp(_l) => _l == "HH" or _l == "HL"

f_relabel(L) =>
    array.clear(L.KL)
    n = array.size(L.KP)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(L.KH, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(L.KH, j) == hi
                    prev := array.get(L.KP, j)
                    break
                j -= 1
            cur = array.get(L.KP, i)
            array.push(L.KL, na(prev) ? "?" : hi ? (cur > prev ? "HH" : "LH") : (cur > prev ? "HL" : "LL"))
    n

// Счёт идёт по коленам подряд: 0 1 2 3 4 5, потом снова 0.
// После слома отсчёт начинается заново — первое появившееся колено
// становится точкой (0). Номер живёт вместе с коленом и задним числом
// не переписывается, поэтому вся история остаётся пронумерованной.
//
// Подписи HH/LH/HL/LL счёт не рвут: они описывают, что получилось,
// а не задают, где считать. Проверено на 9 годах — эталонная
// последовательность подписей ничего не предсказывает.

f_push(L, _price, _bar, _hi) =>
    n = array.size(L.KP)
    bool same = false
    if n > 0
        same := array.get(L.KH, n - 1) == _hi
    bool fresh = false
    if same
        old = array.get(L.KP, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(L.KM, n - 1, array.get(L.KM, n - 1) + 1)
        if na(array.get(L.KA, n - 1))
            array.set(L.KA, n - 1, old)
        if better
            array.set(L.KP, n - 1, _price)
            array.set(L.KB, n - 1, _bar)
    else
        array.push(L.KP, _price)
        array.push(L.KB, _bar)
        array.push(L.KH, _hi)
        array.push(L.KM, 1)
        array.push(L.KA, na)
        array.push(L.KT, L.tr)
        array.push(L.KX, L.inTrans)
        fresh := true
        // Номер точки присваивается один раз, при рождении колена, и
        // больше не пересчитывается — поэтому история их не теряет.
        //
        // Счёт ОБРЫВАЕТСЯ сломом. Колено, родившееся в ПЕРЕХОДЕ, номера
        // не получает вовсе: счёта в этот момент нет. Как только тренд
        // подтверждён, первое же новое колено начинает счёт с нуля.
        // Прежде счётчик крутился 0-1-2-3-4-5-0 по кругу и слом не
        // замечал — на графике ПЕРЕХОД был не виден.
        // Номер кладём заглушкой. Настоящий проставляется в КОНЦЕ шага
        // бара, после постановки якоря: на баре подтверждения тренда
        // якорь ещё не стоит, и номер, посчитанный здесь, был бы взят от
        // прошлого счёта.
        array.push(L.KN, -1)
        if array.size(L.KP) > MAXK
            array.shift(L.KP)
            array.shift(L.KB)
            array.shift(L.KH)
            array.shift(L.KM)
            array.shift(L.KA)
            array.shift(L.KT)
            array.shift(L.KX)
            array.shift(L.KN)
            L.czIdx := L.czIdx > 0 ? L.czIdx - 1 : (L.czIdx == 0 ? -1 : L.czIdx)
    d1 = f_relabel(L)
    fresh

// Ноль счёта ставится по подписи, а не по порядку появления.
// Восходящий тренд считается от LL, нисходящий от HH — идём НАЗАД по
// коленам до первого подходящего. Исключение на продолжение: если
// прошлый счёт был того же направления и дошёл минимум до третьей
// точки, годится и HL (для восходящего) или LH (для нисходящего),
// если встретилось раньше.
//
// Колена от нуля перенумеровываются: 0 1 2 3 4 5, потом снова 0.
// Это переписывает несколько последних номеров — иначе ноль нельзя
// поставить назад, а он должен стоять именно там.
f_setZero(L, _dir) =>
    n = array.size(L.KL)
    // СНАЧАЛА закрываем прошлый счёт: его направление и то, до какой
    // точки он дошёл. Если читать это после — условие на продолжение
    // проверяется против позапрошлого счёта, а не прошлого.
    if L.czIdx >= 0 and L.czIdx < n
        L.pCmax := array.get(L.KN, n - 1)
        L.pCdir := L.lastTr
    int z = -1
    if n > 0
        want  = _dir == 1 ? "LL" : "HH"
        want2 = _dir == 1 ? "HL" : "LH"
        // продолжение: прошлый счёт шёл в ту же сторону и дошёл до (3)
        bool cont = L.pCdir == _dir and L.pCmax >= 3
        // ГРАНИЦА ПОИСКА. Без неё в затяжном падении свежих HH нет, и
        // поиск уходил на десятки колен назад: якорь вставал так далеко,
        // что новые колена сразу оказывались за точкой (5) и счёт на
        // графике пропадал совсем. Ищем в окне длиной в один счёт.
        int lo = math.max(0, n - zSeek)
        // запасной ноль — ближайшее колено НУЖНОЙ СТОРОНЫ в том же окне:
        // счёт вверх стартует с низа, вниз с вершины. Сторона важнее
        // подписи, иначе счёта не будет вовсе.
        int alt = -1
        bool needHi = _dir == -1
        i = n - 1
        while i >= lo
            lb = array.get(L.KL, i)
            if alt < 0 and array.get(L.KH, i) == needHi
                alt := i
            if lb == want
                z := i
                break
            if cont and lb == want2
                z := i
                break
            i -= 1
        if z < 0
            z := alt
    // Номера прошлого счёта НЕ переписываем: кусок старого тренда должен
    // остаться таким, каким был. Новый счёт рисуется поверх — его номера
    // считаются от якоря на лету, см. f_curN.
    if z >= 0
        L.czIdx := z
        L.czBar := array.get(L.KB, z)
        L.czPrice := array.get(L.KP, z)
        L.czLab := array.get(L.KL, z)
    z

// ══════════════ ШАГ БАРА ══════════════
// Порядок ровно как в v5, он сверен репликой строка в строку.
f_step(L, _pvH, _pvL, _hiPx, _loPx) =>
    bLo = math.min(open, close)
    bHi = math.max(open, close)

    // 1. смерть тренда с фильтром глубины
    need = L.imp * L.fib
    bool died = false
    if L.tr == 1
        if not na(L.lvl)
            if bLo < L.lvl - need
                died := true
    if L.tr == -1
        if not na(L.lvl)
            if bHi > L.lvl + need
                died := true
    if died
        if not na(L.lastD)
            if math.abs(L.lvl - L.lastD) < syminfo.mintick
                died := false
    if died
        // ноль умершего тренда — берём прямо якорь, а не поиск KN==0:
        // после перенумеровки нули повторяются каждые шесть колен
        if L.czIdx >= 0 and L.czIdx < array.size(L.KP)
            L.pZb := array.get(L.KB, L.czIdx)
            L.pZp := array.get(L.KP, L.czIdx)
            L.pZl := array.get(L.KL, L.czIdx)
        L.pTr := L.tr
        L.pD := L.lvl
        L.pDb := bar_index
        L.lastD := L.lvl
        L.inTrans := true
        L.marks := 0
        L.lvl := na
        L.lvlProv := false

    // 1б. досрочное подтверждение по рывку
    if L.jump > 0 and L.inTrans and L.imp > 0 and not na(L.lastD)
        nj = array.size(L.KL)
        if nj >= 2
            j1 = array.get(L.KL, nj - 1)
            j2 = array.get(L.KL, nj - 2)
            bool ju = f_isUp(j1) and f_isUp(j2)
            bool jd = (not f_isUp(j1)) and (not f_isUp(j2))
            bool far = false
            if jd
                far := close < L.lastD - L.imp * L.jump
            if ju
                far := close > L.lastD + L.imp * L.jump
            if far
                dl = L.lastD
                L.tr := ju ? 1 : -1
                L.trFrom := bar_index
                L.inTrans := false
                L.lastD := na
                L.lvl := na
                if provOn
                    L.lvl := dl
                    L.lvlProv := true

    // 2. новые колена
    bool fresh = false
    if not na(_pvH)
        if f_push(L, _hiPx, bar_index - L.lb, true)
            fresh := true
    if not na(_pvL)
        if f_push(L, _loPx, bar_index - L.lb, false)
            fresh := true
    if fresh
        L.marks := L.marks + 1

    n = array.size(L.KL)
    if n >= 2
        l1 = array.get(L.KL, n - 1)
        l2 = array.get(L.KL, n - 2)
        p1 = array.get(L.KP, n - 1)
        p2 = array.get(L.KP, n - 2)

        if fresh
            // 3. импульсное колено — ход по направлению тренда
            if L.tr != 0
                movedUp = p1 > p2
                if (L.tr == 1 and movedUp) or (L.tr == -1 and not movedUp)
                    L.imp := math.abs(p1 - p2)
            // 4. рождение или подтверждение
            bool up2 = f_isUp(l1) and f_isUp(l2)
            bool dn2 = (not f_isUp(l1)) and (not f_isUp(l2))
            if L.tr == 0
                if up2
                    L.tr := 1
                    L.trFrom := bar_index
                    L.imp := math.abs(p1 - p2)
                if dn2
                    L.tr := -1
                    L.trFrom := bar_index
                    L.imp := math.abs(p1 - p2)
            else if L.inTrans
                if L.marks >= 2
                    if up2 or dn2
                        L.tr := up2 ? 1 : -1
                        L.trFrom := bar_index
                        L.inTrans := false
                        L.lastD := na
                        L.lvlProv := false
                        L.imp := math.abs(p1 - p2)

        // 5. уровень тренда. В ПЕРЕХОДЕ не восстанавливается: иначе
        // поиск назад воскрешает старый HL, цена пробивает и его, и
        // пишется вторая смерть уже мёртвого тренда.
        if not L.inTrans and L.tr == 1
            if l1 == "HL"
                // храповик: опора восходящего тренда только поднимается.
                // Провизорный уровень после рывка — не опора, его первое
                // же настоящее колено вытесняет без условия.
                if not ratchet or na(L.lvl) or L.lvlProv
                    L.lvl := p1
                else if p1 > L.lvl
                    L.lvl := p1
                L.lvlProv := false
            if na(L.lvl)
                j = n - 1
                while j >= 0
                    if array.get(L.KL, j) == "HL"
                        L.lvl := array.get(L.KP, j)
                        break
                    j -= 1
        if not L.inTrans and L.tr == -1
            if l1 == "LH"
                // зеркально: опора нисходящего только опускается
                if not ratchet or na(L.lvl) or L.lvlProv
                    L.lvl := p1
                else if p1 < L.lvl
                    L.lvl := p1
                L.lvlProv := false
            if na(L.lvl)
                j = n - 1
                while j >= 0
                    if array.get(L.KL, j) == "LH"
                        L.lvl := array.get(L.KP, j)
                        break
                    j -= 1

        // 6. тренд и флаг ПЕРЕХОДА пишутся один раз, на баре появления
        if fresh and array.size(L.KT) > 0
            array.set(L.KT, array.size(L.KT) - 1, L.tr)
            array.set(L.KX, array.size(L.KX) - 1, L.inTrans)
    // 7. тренд родился или сменился — ставим ноль по подписи, назад по
    // коленам. Ловим и возрождение в ТУ ЖЕ сторону после ПЕРЕХОДА:
    // движок не обнуляет tr на смерти, поэтому по одному лишь сравнению
    // направлений такой случай был бы пропущен.
    if L.tr != 0 and not L.inTrans and (L.tr != L.lastTr or L.lastTrans)
        zz = f_setZero(L, L.tr)
    L.lastTr := L.tr
    L.lastTrans := L.inTrans

    // 8. номер точки родившемуся колену — ТЕПЕРЬ, когда якорь на месте.
    // Номер = расстояние до якоря, то есть до нуля действующего счёта.
    // Якорь ищется назад до колена нужной подписи (HH/LL на развороте,
    // LH/HL на продолжении), поэтому ноль всегда на правильной стороне.
    // В ПЕРЕХОДЕ счёта нет: колено остаётся с -1 и рисуется крестиком.
    // После точки (5) счёт закончен — дальше тоже -1.
    // Присвоение однократное: старые подписи не переписываются никогда.
    if fresh and array.size(L.KN) > 0
        int iN = array.size(L.KN) - 1
        if not L.inTrans and L.czIdx >= 0
            // Счёт кончился на (5), а тренд жив — начинаем следующий, не
            // дожидаясь слома. Так было в v5 и v6; при переносе счёта на
            // якорь это потерялось, и после пятёрки колена уходили «вне
            // счёта» до самой смены тренда.
            if iN - L.czIdx > 5
                int nz = -1
                bool needHi = L.tr == -1
                int lo2 = math.max(0, iN - zSeek)
                j2 = iN
                while j2 >= lo2
                    if array.get(L.KH, j2) == needHi
                        nz := j2
                        break
                    j2 -= 1
                if nz >= 0
                    L.czIdx := nz
                    L.czBar := array.get(L.KB, nz)
                    L.czPrice := array.get(L.KP, nz)
                    L.czLab := array.get(L.KL, nz)
        int vN = -1
        if not L.inTrans and L.czIdx >= 0
            k = iN - L.czIdx
            if k >= 0 and k <= 5
                vN := k
        array.set(L.KN, iN, vN)
    fresh

// ══════════════ ПРОИЗВОДНЫЕ ══════════════
// Ноль действующего счёта — это якорь, поставленный при смене тренда.
// Искать последний KN==0 нельзя: после перенумеровки нули повторяются
// каждые шесть колен, и поиск находил бы не тот.
// Ноль действующего счёта — только якорь. Прежде, когда колено-ноль
// уезжало за обрезку массива, функция искала последний KN==0 и находила
// не ноль счёта, а очередной ноль цикла нумерации: в таблице появлялся
// чужой уровень и завышенный возраст тренда. Теперь в таком случае
// честно возвращается -1, а подпись и цена нуля берутся из памяти.
f_cstart(L) =>
    int o = -1
    if L.czIdx >= 0 and L.czIdx < array.size(L.KN)
        o := L.czIdx
    o

// Номер колена в действующем счёте: от якоря, 0..5. Историю не трогает.
// -1 значит «колено вне действующего счёта».
f_curN(L, _i) =>
    int v = -1
    if L.czIdx >= 0 and _i >= L.czIdx
        k = _i - L.czIdx
        if k <= 5
            v := k
    v

// Направление счёта берётся ПО СТОРОНЕ НУЛЯ и только по ней.
// Ноль на вершине (HH или LH) — счёт вниз, ноль на низу (LL или HL) —
// счёт вверх. Прежде направление брали по подписи СЛЕДУЮЩЕГО колена;
// с новой постановкой нуля это расходилось со стороной на 40% баров,
// и в таблице выходило «НИСХОДЯЩИЙ» со стрелкой вверх.
f_cdir(L, _o) =>
    int d = 0
    if _o >= 0 and _o < array.size(L.KH)
        d := array.get(L.KH, _o) ? -1 : 1
    else if L.czLab == "HH" or L.czLab == "LH"
        d := -1
    else if L.czLab == "LL" or L.czLab == "HL"
        d := 1
    d

// Направление счёта, которому принадлежит колено: сторона ближайшего
// нуля назад. Колено с номером -1 родилось в ПЕРЕХОДЕ и не принадлежит
// никакому счёту — оно рисуется серым, а не цветом умершего тренда.
f_kdir(L, _i) =>
    int d = 0
    if _i >= 0 and _i < array.size(L.KN)
        nn = array.get(L.KN, _i)
        if nn >= 0
            // номер — это расстояние до якоря, значит якорь считается
            // обратно, без поиска: искать ближайший KN==0 назад нельзя,
            // колено-якорь могло уехать за обрезку массива
            z = _i - nn
            if z >= 0 and z < array.size(L.KH)
                d := array.get(L.KH, z) ? -1 : 1
    d

f_room(L) =>
    float r = na
    if not L.inTrans and not na(L.lvl) and L.tr != 0 and L.imp > 0
        thr = L.tr == 1 ? L.lvl - L.imp * L.fib : L.lvl + L.imp * L.fib
        r := math.max(0.0, L.tr == 1 ? close - thr : thr - close) / L.imp
    r

f_chainCur(L, _o, _min) =>
    n = array.size(L.KL)
    s = ""
    if _o >= 0 and n > 0
        from = math.max(0, math.min(_o, n - _min))
        for j = from to n - 1
            s := s + (j == _o and j > from ? " | " : j > from ? ">" : "") + array.get(L.KL, j)
    s

// ══════════════ ПРОГОН ══════════════
var Layer L = f_new(LB, fibD, jumpC)
L.fib  := fibD
L.jump := jumpC

pvH = ta.pivothigh(high, LB, LB)
pvL = ta.pivotlow (low,  LB, LB)

var float[] DXP = array.new_float()
var int[]   DXB = array.new_int()
var int[]   DXT = array.new_int()

if barstate.isconfirmed
    fr = f_step(L, pvH, pvL, high[LB], low[LB])
    // смерть могла быть перекрыта рывком в том же баре, поэтому
    // отмечаем по бару смерти, а не по состоянию ПЕРЕХОДА
    if L.pDb == bar_index
        array.push(DXP, L.pD)
        array.push(DXB, L.pDb)
        array.push(DXT, L.pTr)

// сырые пивоты — видно, где две метки слились в одно колено
plotshape(showRaw and not na(pvH) ? pvH : na, title="сырой верх", style=shape.triangledown, location=location.absolute, color=color.new(cDn, 35), size=size.tiny, offset=-LB)
plotshape(showRaw and not na(pvL) ? pvL : na, title="сырой низ",  style=shape.triangleup,   location=location.absolute, color=color.new(cUp, 35), size=size.tiny, offset=-LB)

// ══════════════ ОПОРА И ПОРОГ ЛИНИЕЙ ══════════════
// Взято у супертренда: там линия, за которую держится тренд, идёт через
// всю историю и меняет цвет на сломе. У нас таких линий ДВЕ, и это не
// одно и то же:
//   ОПОРА  — колено HL (вверх) или LH (вниз). Структурная точка.
//   ПОРОГ  — опора ∓ имп × глубина слома. Вот ЭТО прямой аналог
//            супертрендовой линии: тренд умирает, когда тело закрылось
//            за порогом, а не за опорой.
// Разрыв в линиях — это ПЕРЕХОД. У супертренда разрывов нет, он всегда
// в тренде; у нас пауза между трендами существует и должна быть видна.

stAlive = stOn and not na(L.lvl) and L.tr != 0 and not L.inTrans
stSup   = stAlive ? L.lvl : na
stThr   = stAlive and L.imp > 0 ? (L.tr == 1 ? L.lvl - L.imp * fibD : L.lvl + L.imp * fibD) : na

supUp = plot(L.tr ==  1 ? stSup : na, "Опора восходящего",  color=color.new(cUp, 10), style=plot.style_linebr, linewidth=2)
supDn = plot(L.tr == -1 ? stSup : na, "Опора нисходящего",  color=color.new(cDn, 10), style=plot.style_linebr, linewidth=2)
thrUp = plot(L.tr ==  1 ? stThr : na, "Порог восходящего",  color=color.new(cUp, 40), style=plot.style_circles, linewidth=1)
thrDn = plot(L.tr == -1 ? stThr : na, "Порог нисходящего",  color=color.new(cDn, 40), style=plot.style_circles, linewidth=1)
midBd = plot(stFill and stAlive ? (open + close) / 2 : na, "Середина тела", display=display.none)

fill(midBd, thrUp, title="Запас восходящего", color=color.new(cUp, 88), fillgaps=false)
fill(midBd, thrDn, title="Запас нисходящего", color=color.new(cDn, 88), fillgaps=false)


// ══════════════ ТРИГГЕРНАЯ СВЕЧА ══════════════
// Форма свечи в долях диапазона: тело, верхняя тень, нижняя тень.
// Совпала с одним из 40 шаблонов при допуске — свеча триггерная.
//
// Сама по себе свеча — монетка: на 2199 срабатываниях за два года вход
// по закрытию со стопом за экстремумом даёт от -0.23R до +0.05R. Это
// сигнал «здесь можно смотреть», а не вход. Встречается на 18% баров
// на 1H и на 16% на 5m.
gT = "⑤ Триггерная свеча"
trOn  = input.bool(true, "Отмечать триггерные свечи", group=gT)
trTol = input.float(4.0, "Допуск формы ±%", 1.0, 15.0, group=gT)
cTrig = input.color(#ffd54f, "Цвет отметки", group=gT)

// ── БЛОК ШАБЛОНОВ: заменяемый ─────────────────────────────────────
// Текущий набор из 40 форм, перенесённый из Тренажёра. Когда пропишем
// новые формы, меняется только эта тройка массивов.
tb_ = array.from(12.6,14.7,17.0,32.0,20.2,4.1,23.0,27.9,30.7,35.2,24.5,41.9,26.0,25.9,11.6,23.3,49.3,14.0,18.3,25.4,27.9,45.7,29.2,40.6,41.9,10.4,41.5,23.6,32.2,18.8,35.5,32.2,54.2,10.8,47.3,16.0,21.6,19.8,9.9,27.5)
tu_ = array.from(33.7,37.3,37.7,27.8,29.4,40.4,35.7,35.3,41.0,35.7,28.4,22.0,39.6,37.4,46.0,31.5,21.5,27.5,47.3,35.6,26.2,24.8,36.3,36.7,26.8,35.6,20.7,34.5,36.4,46.2,38.6,33.6,21.6,44.1,22.9,45.2,42.8,45.2,41.5,30.7)
tl_ = array.from(53.7,48.0,45.3,40.2,50.4,55.5,41.3,36.8,28.3,29.1,47.1,36.0,34.5,36.7,42.5,45.2,29.2,58.5,34.4,39.0,46.0,29.5,34.5,22.6,31.3,54.0,37.9,41.9,31.4,34.9,25.8,34.2,24.2,45.1,29.8,38.8,35.5,35.0,48.6,41.8)

rng_ = high - low
bod_ = math.abs(close - open)
up_  = open > close ? high - open : high - close
low_ = open > close ? close - low : open - low
bp_  = rng_ > 0 ? bod_ / rng_ * 100 : 0.0
upp_ = rng_ > 0 ? up_  / rng_ * 100 : 0.0
lop_ = rng_ > 0 ? low_ / rng_ * 100 : 0.0

int trIdx = -1
if trOn and rng_ > 0
    for ti = 0 to 39
        if math.abs(bp_ - array.get(tb_, ti)) <= trTol and math.abs(upp_ - array.get(tu_, ti)) <= trTol and math.abs(lop_ - array.get(tl_, ti)) <= trTol
            trIdx := ti
            break
trig_ok = trIdx >= 0
plotshape(trig_ok, title="Триггерная свеча", style=shape.circle, location=location.belowbar, color=cTrig, size=size.tiny)

// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()
f_col(_t) => _t == 1 ? cUp : cDn

f_drawZZ(L2, _w) =>
    n = array.size(L2.KP)
    cs = f_cstart(L2)
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(L2.KB, i - 1)
            x2 = array.get(L2.KB, i)
            if last_bar_index - x1 <= winBars
                t2   = array.get(L2.KT, i)
                trs  = array.get(L2.KX, i)
                kd   = f_kdir(L2, i)
                num0 = array.get(L2.KN, i)
                // нога В НОЛЬ счёта принадлежит ПРЕДЫДУЩЕМУ счёту
                kdL  = (num0 == 0 and i > 0) ? f_kdir(L2, i - 1) : kd
                bool corr  = num0 > 0 and num0 % 2 == 0
                bool legUp = array.get(L2.KP, i) > array.get(L2.KP, i - 1)
                cc0 = zzMode == "по ходу ноги" ? (legUp ? cUp : cDn) : zzMode == "по счёту" ? (kdL == 0 ? color.gray : f_col(kdL)) : trs ? (legUp ? cUp : cDn) : t2 == 0 ? color.gray : f_col(t2)
                bool act = false
                if cs >= 0
                    act := i > cs
                bool thin = corr and zzMode == "по счёту"
                tp = (thin ? 45 : 0) + (act ? 0 : 55)
                cc = color.new(cc0, math.min(85, tp))
                if showZZ and array.get(L2.KT, i - 1) == t2
                    array.push(LNS, line.new(x1, array.get(L2.KP, i - 1), x2, array.get(L2.KP, i), color=cc, width=thin ? _w : _w + 1, style=trs ? line.style_dashed : line.style_solid))
                mc  = array.get(L2.KM, i)
                ap  = array.get(L2.KA, i)
                lbb = array.get(L2.KL, i)
                pr  = array.get(L2.KP, i)
                hh  = array.get(L2.KH, i)
                mud = mc >= 2
                if drawMud and mud and not na(ap)
                    array.push(LNS, line.new(x1, ap, x2, ap, color=color.new(cMud, 20), width=1, style=line.style_dotted))
                arr = kd == 1 ? "↑" : kd == -1 ? "↓" : ""
                string txt = na
                // «×» вместо номера — колено родилось в ПЕРЕХОДЕ, счёта
                // в этот момент не было. Метка HH/LH/HL/LL стоит всегда.
                pfx = num0 >= 0 ? "(" + str.tostring(num0) + ") " : "× "
                if labMode == "номер + мутность"
                    txt := (num0 >= 0 ? "(" + str.tostring(num0) + ")" : "×") + arr + (mud ? "м" : "")
                else if labMode == "метка"
                    txt := lbb + arr + (mud ? " м" : "")
                else if labMode == "номер и метка"
                    txt := pfx + lbb + arr + (mud ? " м" : "")
                // новый счёт рисуется ПОВЕРХ старого, на бар правее,
                // чтобы не затирать прежнюю подпись
                // Слой-поверх рисуется ТОЛЬКО там, где действующий счёт
                // расходится с номером, записанным при рождении колена.
                // Это и есть «новый счёт поверх старого»: прежние подписи
                // остаются на месте, а поверх видно, как их читает
                // сегодняшний якорь. Где расхождения нет — не дублируем.
                cn2 = f_curN(L2, i)
                if cn2 >= 0 and cn2 != num0
                    string ov = (cn2 == 0 ? "◆ 0" : str.tostring(cn2))
                    array.push(LBS, label.new(x2 + 1, pr, ov, style=hh ? label.style_label_down : label.style_label_up, color=color.new(color.black, 100), textcolor=cZero, size=cn2 == 0 ? size.normal : size.small, tooltip="действующий счёт · точка (" + str.tostring(cn2) + ") из 5 · ноль на " + (L2.czIdx >= 0 and L2.czIdx < array.size(L2.KL) ? array.get(L2.KL, L2.czIdx) : "?")))
                if not na(txt)
                    lc0 = kd == 0 ? color.gray : f_col(kd)
                    lc  = act ? lc0 : color.new(lc0, 62)
                    kdn = kd == 1 ? "ВОСХОДЯЩИЙ счёт" : kd == -1 ? "НИСХОДЯЩИЙ счёт" : "счёт не определён"
                    trn = trs ? "на этом колене был ПЕРЕХОД от " + (t2 == 1 ? "восходящего" : "нисходящего") : t2 == 1 ? "на этом колене тренд был восходящий" : t2 == -1 ? "на этом колене тренд был нисходящий" : "на этом колене тренда не было"
                    now = L2.inTrans ? -2 : L2.tr
                    was = trs ? -2 : t2
                    nw  = now == was ? "" : "\nсейчас " + (L2.inTrans ? "ПЕРЕХОД" : L2.tr == 1 ? "восходящий" : L2.tr == -1 ? "нисходящий" : "не определён")
                    tip = str.tostring(L2.lb) + "/" + str.tostring(L2.lb) + "   " + lbb + "  " + str.tostring(pr, format.mintick) + "\n" + (num0 >= 0 ? "точка (" + str.tostring(num0) + ") из 5 · " + (num0 % 2 == 1 ? "импульсное" : num0 == 0 ? "начало счёта" : "корректирующее") : "ВНЕ СЧЁТА — колено родилось в ПЕРЕХОДЕ") + "\n" + kdn + "\n" + trn + (kd != 0 and t2 != 0 and kd != t2 and not trs ? "   ← счёт шёл против тренда" : "") + nw + "\n" + (mud ? "МУТНОЕ: слилось " + str.tostring(mc) + " меток, поглощена " + str.tostring(ap, format.mintick) : "чистое колено")
                    array.push(LBS, label.new(x2, pr, txt, style=hh ? label.style_label_down : label.style_label_up, color=color.new(color.black, 100), textcolor=mud ? (act ? cMud : color.new(cMud, 62)) : lc, size=size.small, tooltip=tip))
    n

f_drawLvl(L2) =>
    if drawLvl and not na(L2.lvl) and L2.tr != 0 and not L2.inTrans
        array.push(LBS, label.new(bar_index + 8, L2.lvl, (L2.lvlProv ? "провиз " : L2.tr == 1 ? "HL " : "LH ") + str.tostring(L2.lvl, format.mintick), style=label.style_label_left, color=color.new(f_col(L2.tr), 85), textcolor=f_col(L2.tr), size=size.small))
    0

if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))
    d1 = f_drawZZ(L, zzW)
    d2 = f_drawLvl(L)
    if drawMSB and array.size(DXB) > 0
        i0 = math.max(0, array.size(DXB) - 10)
        for i = i0 to array.size(DXB) - 1
            db = array.get(DXB, i)
            if last_bar_index - db <= winBars
                dp = array.get(DXP, i)
                dt = array.get(DXT, i)
                array.push(LBS, label.new(db, dp, "слом", style=dt == 1 ? label.style_label_up : label.style_label_down, color=color.new(f_col(dt == 1 ? -1 : 1), 30), textcolor=color.white, size=size.tiny))

// ══════════════ УРОВНИ HH/LL/LH/HL — 1H, 4H, 1D ══════════════
// Перенесено из Тренажёра без изменений логики. Уровень существует,
// пока не пробит: как только цена его прошла — он умирает и не рисуется.
// Рисуются только N ближайших к цене с каждой стороны на каждом ТФ:
// живых уровней бывает около 130 одновременно, большинство далёкие.
// HH и LL — пунктир, LH и HL — точки. Толщина растёт с таймфреймом.
gL = "⑥ Уровни HH/LL"
lvOn    = input.bool(true, "Показывать уровни", group=gL)
lv_tf1  = input.bool(true, "текущий ТФ", inline="lv", group=gL)
lv_tf4  = input.bool(true, "4H",         inline="lv", group=gL)
lv_tfd  = input.bool(true, "1D",         inline="lv", group=gL)
lvLH    = input.bool(true, "Штрихи для LH и HL", group=gL, tooltip="Неперебитые LH сверху и HL снизу. HH и LL — пунктир, LH и HL — точки.")
lvLB    = input.int(2, "Глубина пивота уровней", minval=1, maxval=8, group=gL, tooltip="Отдельно от глубины слоя. 2 — как в Тренажёре.")
lv_n    = input.int(3, "Ближайших к цене с каждой стороны", minval=1, maxval=10, group=gL)
lvTransp= input.int(40, "Прозрачность", minval=0, maxval=90, group=gL)
cLvH    = input.color(color.green, "верх / низ", inline="lc", group=gL)
cLvL    = input.color(color.red,   "",           inline="lc", group=gL)

lph = ta.pivothigh(high, lvLB, lvLB)
lpl = ta.pivotlow (low,  lvLB, lvLB)
lphv = high[lvLB]
lplv = low[lvLB]
a1 = ta.valuewhen(not na(lph), lphv, 1)
a2 = ta.valuewhen(not na(lph), lphv, 0)
hh1 = na(lph) ? na : a1 < a2 ? lph : na
lh1 = na(lph) ? na : a1 > a2 ? lph : na
a3 = ta.valuewhen(not na(lpl), lplv, 1)
a4 = ta.valuewhen(not na(lpl), lplv, 0)
ll1 = na(lpl) ? na : a3 > a4 ? lpl : na
hl1 = na(lpl) ? na : a3 < a4 ? lpl : na

ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, lvLB, lvLB), lookahead=barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  lvLB, lvLB), lookahead=barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[lvLB], lookahead=barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[lvLB],  lookahead=barmerge.lookahead_off)
b1 = ta.valuewhen(not na(ph4), ph4v, 1)
b2 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b1 < b2 ? ph4 : na
lh4 = na(ph4) ? na : b1 > b2 ? ph4 : na
b3 = ta.valuewhen(not na(pl4), pl4v, 1)
b4 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b3 > b4 ? pl4 : na
hl4 = na(pl4) ? na : b3 < b4 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, lvLB, lvLB), lookahead=barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  lvLB, lvLB), lookahead=barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[lvLB], lookahead=barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[lvLB],  lookahead=barmerge.lookahead_off)
c1 = ta.valuewhen(not na(phd), phdv, 1)
c2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : c1 < c2 ? phd : na
lhd = na(phd) ? na : c1 > c2 ? phd : na
c3 = ta.valuewhen(not na(pld), pldv, 1)
c4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : c3 > c4 ? pld : na
hld = na(pld) ? na : c3 < c4 ? pld : na

var float[] HH1P = array.new_float()
var int[] HH1B = array.new_int()
var float[] LL1P = array.new_float()
var int[] LL1B = array.new_int()
var float[] LH1P = array.new_float()
var int[] LH1B = array.new_int()
var float[] HL1P = array.new_float()
var int[] HL1B = array.new_int()
var float[] HH4P = array.new_float()
var int[] HH4B = array.new_int()
var float[] LL4P = array.new_float()
var int[] LL4B = array.new_int()
var float[] LH4P = array.new_float()
var int[] LH4B = array.new_int()
var float[] HL4P = array.new_float()
var int[] HL4B = array.new_int()
var float[] HHDP = array.new_float()
var int[] HHDB = array.new_int()
var float[] LLDP = array.new_float()
var int[] LLDB = array.new_int()
var float[] LHDP = array.new_float()
var int[] LHDB = array.new_int()
var float[] HLDP = array.new_float()
var int[] HLDB = array.new_int()

f_addNow(_p, _b, _v) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - lvLB)
    0
f_addHTF(_p, _b, _v, _prev) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
    0

x1_ = f_addNow(HH1P, HH1B, hh1)
x2_ = f_addNow(LL1P, LL1B, ll1)
x3_ = f_addNow(LH1P, LH1B, lh1)
x4_ = f_addNow(HL1P, HL1B, hl1)
x5_ = f_addHTF(HH4P, HH4B, hh4, nz(hh4[1]))
x6_ = f_addHTF(LL4P, LL4B, ll4, nz(ll4[1]))
x7_ = f_addHTF(LH4P, LH4B, lh4, nz(lh4[1]))
x8_ = f_addHTF(HL4P, HL4B, hl4, nz(hl4[1]))
x9_ = f_addHTF(HHDP, HHDB, hhd, nz(hhd[1]))
xa_ = f_addHTF(LLDP, LLDB, lld, nz(lld[1]))
xb_ = f_addHTF(LHDP, LHDB, lhd, nz(lhd[1]))
xc_ = f_addHTF(HLDP, HLDB, hld, nz(hld[1]))

// уровень существует, пока не пробит
f_purge(_p, _b, _isHi) =>
    i = 0
    while i < array.size(_p)
        if (_isHi and high >= array.get(_p, i)) or (not _isHi and low <= array.get(_p, i))
            array.remove(_p, i)
            array.remove(_b, i)
        else
            i += 1
    0

y1_ = f_purge(HH1P, HH1B, true)
y2_ = f_purge(LL1P, LL1B, false)
y3_ = f_purge(LH1P, LH1B, true)
y4_ = f_purge(HL1P, HL1B, false)
y5_ = f_purge(HH4P, HH4B, true)
y6_ = f_purge(LL4P, LL4B, false)
y7_ = f_purge(LH4P, LH4B, true)
y8_ = f_purge(HL4P, HL4B, false)
y9_ = f_purge(HHDP, HHDB, true)
ya_ = f_purge(LLDP, LLDB, false)
yb_ = f_purge(LHDP, LHDB, true)
yc_ = f_purge(HLDP, HLDB, false)

var line[] LVL = array.new<line>()

f_nearest(_p, _b, _col, _w, _st) =>
    if array.size(_p) > 0
        bool[] used = array.new_bool(array.size(_p), false)
        for k = 1 to lv_n
            best = -1
            float bestd = 1.0e18
            for i = 0 to array.size(_p) - 1
                if not array.get(used, i)
                    d = math.abs(array.get(_p, i) - close)
                    if d < bestd
                        bestd := d
                        best := i
            if best >= 0
                array.set(used, best, true)
                // левый край не дальше буфера истории, иначе в симуляторе
                // линия просит бар за пределами доступного
                xl = math.max(array.get(_b, best), bar_index - 2900)
                array.push(LVL, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color=color.new(_col, lvTransp), width=_w, style=_st, extend=extend.right))
    0

if barstate.islast
    while array.size(LVL) > 0
        line.delete(array.pop(LVL))
    if lvOn and lv_tf1
        z1 = f_nearest(HH1P, HH1B, cLvH, 1, line.style_dashed)
        z2 = f_nearest(LL1P, LL1B, cLvL, 1, line.style_dashed)
        if lvLH
            z3 = f_nearest(LH1P, LH1B, cLvH, 1, line.style_dotted)
            z4 = f_nearest(HL1P, HL1B, cLvL, 1, line.style_dotted)
    if lvOn and lv_tf4
        z5 = f_nearest(HH4P, HH4B, cLvH, 2, line.style_dashed)
        z6 = f_nearest(LL4P, LL4B, cLvL, 2, line.style_dashed)
        if lvLH
            z7 = f_nearest(LH4P, LH4B, cLvH, 2, line.style_dotted)
            z8 = f_nearest(HL4P, HL4B, cLvL, 2, line.style_dotted)
    if lvOn and lv_tfd
        z9 = f_nearest(HHDP, HHDB, cLvH, 3, line.style_dashed)
        za = f_nearest(LLDP, LLDB, cLvL, 3, line.style_dashed)
        if lvLH
            zb = f_nearest(LHDP, LHDB, cLvH, 3, line.style_dotted)
            zc = f_nearest(HLDP, HLDB, cLvL, 3, line.style_dotted)

// ══════════════ ТАБЛИЦА ══════════════
tss = sizeT == "tiny" ? size.tiny : sizeT == "normal" ? size.normal : size.small
tpos = posT == "верх-лево" ? position.top_left : posT == "низ-право" ? position.bottom_right : posT == "низ-лево" ? position.bottom_left : position.top_right
var table T = table.new(tpos, 2, 12, bgcolor=color.new(#12121c, 8), border_color=color.new(color.gray, 70), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

f_row(_r, _k, _v, _c, _tip) =>
    table.cell(T, 0, _r, _k, text_color=color.new(color.silver, 25), text_halign=text.align_left, text_size=tss, tooltip=_tip)
    table.cell(T, 1, _r, _v, text_color=_c, text_halign=text.align_left, text_size=tss)
    _r

// Тренд показывается вместе с точкой, ОТ КОТОРОЙ он считается: подпись,
// цена и бар нуля его счёта. После слома ноль встаёт заново, поэтому
// возраст тренда и возраст счёта — одно и то же число.
f_trend(L2) =>
    string s0 = "не определён"
    // подпись, цена и бар нуля берутся из памяти слоя, а не из массива:
    // колено-ноль может уехать за обрезку, а тренд от него всё ещё идёт
    string anc = ""
    int ab = na
    if not na(L2.czPrice)
        anc := " · от " + L2.czLab + " " + str.tostring(L2.czPrice, format.mintick)
        ab := L2.czBar
    age = na(ab) ? (na(L2.trFrom) ? 0 : bar_index - L2.trFrom) : bar_index - ab
    if L2.inTrans
        s0 := "ПЕРЕХОД, был " + (L2.pTr == 1 ? "восх" : "нисх")
    else if L2.tr == 1
        s0 := "ВОСХОДЯЩИЙ" + anc + " · " + str.tostring(age) + "б"
    else if L2.tr == -1
        s0 := "НИСХОДЯЩИЙ" + anc + " · " + str.tostring(age) + "б"
    s0

f_lvlTxt(L2) =>
    L2.inTrans ? "— пробит" : na(L2.lvl) ? "—" : (L2.lvlProv ? "смерть " : L2.tr == 1 ? "HL " : "LH ") + str.tostring(L2.lvl, format.mintick) + (L2.lvlProv ? " провиз" : "")

f_roomTxt(L2) =>
    r = f_room(L2)
    na(r) ? "—" : str.tostring(r, "#.##") + " имп · " + (r < 0.25 ? "73%" : r < 0.5 ? "42%" : r < 1.0 ? "17%" : r < 2.0 ? "6%" : "1%")

f_mud(L2, _cs) =>
    nk = array.size(L2.KM)
    mudC = 0
    cnt = 0
    if _cs >= 0 and _cs <= nk - 1
        for q = _cs to nk - 1
            cnt += 1
            if array.get(L2.KM, q) >= 2
                mudC += 1
    int last = 1
    if nk > 0
        last := array.get(L2.KM, nk - 1)
    (last >= 2 ? "МУТНОЕ x" + str.tostring(last) + " · " : "чистое · ") + str.tostring(mudC) + " из " + str.tostring(cnt)

if showT and barstate.islast
    table.cell(T, 0, 0, "━━  МЕТКИ  ━━", text_color=color.new(color.silver, 5), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.tiny)
    table.cell(T, 1, 0, str.tostring(LB) + "/" + str.tostring(LB), text_color=color.new(color.aqua, 0), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.tiny)

    cs = f_cstart(L)
    cd = f_cdir(L, cs)
    // номер берём у действующего счёта, от якоря, а не из истории
    int cn = -1
    if array.size(L.KP) > 0
        cn := f_curN(L, array.size(L.KP) - 1)
    int lm = 1
    if array.size(L.KM) > 0
        lm := array.get(L.KM, array.size(L.KM) - 1)
    r  = f_room(L)

    r1 = f_row(1, "тренд", f_trend(L), L.inTrans ? color.new(color.orange, 0) : L.tr == 0 ? color.gray : f_col(L.tr), "Считается от нуля своего счёта — подпись и цена нуля показаны здесь же. После слома ноль всегда встаёт заново: первое появившееся колено становится точкой (0).")
    r2 = f_row(2, "держится на", f_lvlTxt(L), L.inTrans or L.lvlProv ? color.new(color.orange, 0) : color.white, "Последнее колено-опора со стороны тренда. В ПЕРЕХОДЕ строка гасится: движок не воскрешает старый уровень.")
    r3 = f_row(3, "запас", f_roomTxt(L), na(r) ? color.gray : r < 0.25 ? cDn : r < 0.5 ? color.new(color.orange, 0) : r < 1.0 ? color.new(color.silver, 20) : cUp, "Оставшийся ход до порога смерти, в импульсных коленах. Проценты — вероятность смерти тренда за 10 баров по замеру на 9675 барах: меньше 0.25 импульса — 73%, 0.25-0.50 — 42%, 0.50-1.00 — 17%, 1.00-2.00 — 6%, дальше — 1%. В среднем по рынку 16%.")
    r4 = f_row(4, "счёт", cn < 0 ? "счёт кончился" : "(" + str.tostring(cn) + ") из 5 " + (cd == 1 ? "↑" : cd == -1 ? "↓" : "") + (cn <= 0 ? "" : cn % 2 == 1 ? " импульс" : " коррекция"), cd == 0 ? color.gray : f_col(cd), "Нечётная точка — импульс, чётная — коррекция. До точки (5) доходит примерно каждый пятый счёт, и это не зависит от глубины пивота.")

    string z = "—"
    if not na(L.czPrice)
        zl = L.czLab
        z := zl + " " + str.tostring(L.czPrice, format.mintick) + " · " + ((cd == 1 ? zl == "LL" : cd == -1 ? zl == "HH" : false) ? "разворот" : "продолж")
        if cs < 0
            z := z + " · колено ушло за окно"
    r5 = f_row(5, "счёт от", z, cd == 0 ? color.gray : f_col(cd), "Метка нуля счёта. Направление берётся ПО СТОРОНЕ НУЛЯ: вершина — счёт вниз, низ — счёт вверх. Ноль LL при счёте вверх или HH при счёте вниз — движение разворотное, LH и HL — продолжение. Подпись и цена нуля хранятся отдельно, поэтому видны и когда колено ушло за окно в 80 колен.")
    r6 = f_row(6, "цепочка", f_chainCur(L, cs, 4), cd == 0 ? color.gray : f_col(cd), "Фактическая последовательность подписей колен. Черта отделяет ноль счёта от остального.")
    // Подписи от нуля против направления тренда. Движок считает тренд по
    // своему правилу (два однонаправленных колена, смерть по уровню), а
    // подписи могут идти против — тогда в таблице «ВОСХОДЯЩИЙ», а метки
    // структуры шортовые. Эта строка показывает расхождение, а не решает
    // за вас: проверено, что последовательность подписей ничего не
    // предсказывает.
    int sAgr = 0
    int sTot = 0
    nkl = array.size(L.KL)
    if cs >= 0 and cs + 1 <= nkl - 1
        for q = cs + 1 to math.min(nkl - 1, cs + 5)
            lq = array.get(L.KL, q)
            bool up = lq == "HH" or lq == "HL"
            sTot += 1
            if (up and L.tr == 1) or (not up and L.tr == -1)
                sAgr += 1
    string sTxt = "—"
    color  sCol = color.gray
    if sTot > 0
        sTxt := str.tostring(sAgr) + " из " + str.tostring(sTot) + " по тренду"
        if sAgr * 2 < sTot
            sTxt := sTxt + "  ← метки против"
            sCol := color.new(color.orange, 0)
        else
            sCol := color.new(color.silver, 25)
    r7 = f_row(7, "структура", sTxt, sCol, "Сколько подписей от нуля совпадает с направлением тренда. Тренд считается по своему правилу — два подряд однонаправленных колена и смерть по уровню — а подписи могут идти против. Если их меньше половины, тренд держится не на структуре.")
    r8 = f_row(8, "чистота", f_mud(L, cs), lm >= 2 ? cMud : color.new(color.silver, 30), "Первая часть — про последнее колено, вторая — сколько мутных внутри текущего счёта. Мутность около 21% на 1H и 18% на 5m и от глубины пивота не зависит. Ничего не предсказывает: связь оказалась тавтологией и исчезла при нормировке. Строка описательная.")
    string p8 = "—"
    if L.pTr != 0
        string pa = na(L.pZp) ? "" : " · от " + L.pZl + " " + str.tostring(L.pZp, format.mintick)
        string pl = na(L.pZb) ? "" : " · прожил " + str.tostring(L.pDb - L.pZb) + "б"
        p8 := (L.pTr == 1 ? "восх" : "нисх") + pa + " · слом " + str.tostring(L.pD, format.mintick) + pl + " · " + str.tostring(bar_index - L.pDb) + "б назад"
    r9 = f_row(9, "прошлый тренд", p8, L.pTr == 0 ? color.gray : color.new(f_col(L.pTr), 35), "Откуда он считался — подпись и цена его нуля; где сломался; сколько прожил ОТ СВОЕГО НУЛЯ; сколько баров прошло с тех пор.")
    r10 = f_row(10, "пауза", L.inTrans ? str.tostring(math.min(L.marks, 2)) + " из 2 колен" : "—", L.inTrans ? color.new(color.orange, 0) : color.gray, "После смерти тренда нужны два колена, чтобы родился новый. Рывок подтверждает досрочно.")
    r11 = f_row(11, "свеча", trig_ok ? "ТРИГГЕРНАЯ · шаблон " + str.tostring(trIdx + 1) : "обычная", trig_ok ? cTrig : color.gray, "Форма свечи совпала с одним из 40 шаблонов при допуске. Сама по себе свеча — монетка: на 2199 срабатываниях за два года вход по закрытию со стопом за экстремумом даёт от -0.23R до +0.05R. Это сигнал «здесь можно смотреть», а не вход.")
