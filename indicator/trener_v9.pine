//@version=5
// ═══════════════════════════════════════════════════════════════════
// ТРЕНАЖЁР v9. База — v8, чей каскад сверен с engine_v5.py повердиктно
// 9416/9416 и по сделкам 939/939. Логика каскада не тронута, добавлена
// одна ступень и переделано отображение.
//
// Что изменилось против v8:
//   1. Раздел ГДЕ МЫ заменён на два слоя из gde_my_v5: 5/5 и 2/2 считаются
//      параллельно, у каждого свои колена, счёт, тренд, уровень и запас.
//      Внизу строка СВЯЗЬ — разворот 2/2 против 5/5 разделяется запасом
//      старшего: меньше 0.5 импульса старший ломается в 54% за 10 баров,
//      больше 1.0 — ни разу за два года.
//   2. Новая ступень каскада «колена»: балл от 0 до 3 по трём условиям —
//      слои согласны, вход на коррекционной точке счёта, у старшего есть
//      запас. По умолчанию режим «мягко»: балл считается и красит точку,
//      но вход не блокирует.
//   3. Точки красятся по КАЧЕСТВУ входа, а не по причине отказа. Причина
//      осталась в тултипе. Старая раскладка доступна переключателем.
//   4. Блок РИСК переписан: день, неделя, месяц, всего с просадкой, серия.
//      Периоды считаются по времени ВХОДА сделки, а не закрытия.
//   5. Алерт на вход шлёт живой текст: цена, стоп, цель, RR, балл, оба слоя.
//
// Ориентиры за два года на часовом золоте (research/risk_check.py):
//   261 сделка, +29.3R, доля TP 20%, медианный RR у выигрышей 4.05.
//   День: медиана -1.0R, в плюсе 27%.  Неделя: -1.0R, в плюсе 44%.
//   Месяц: +1.2R, в плюсе 58%.  Просадка максимальная 21.1R.
//   Серии стопов: медиана 4, девяностый перцентиль 13, максимум 19.
//
// ЧЕСТНО ПРО БАЛЛ: упорядоченность есть — 0 даёт -0.13R на сделку, 1 даёт
// -0.01R, 2 даёт +0.35R, 3 даёт +0.73R. Но разница между «балл >= 2» и
// «балл <= 1» составляет +0.49R при стандартной ошибке 0.31R, это всего
// 1.6 сигмы, и признаки подобраны на этих же двух годах. Величина НЕ
// доказана. Поэтому режим по умолчанию мягкий.
// ═══════════════════════════════════════════════════════════════════
indicator("Тренажёр v9 — ГДЕ МЫ v5", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=3000)

// ══════════════ НАСТРОЙКИ ══════════════
g1 = "🕯 Триггерные свечи"
tol = input.float(4.0, "Допуск формы ±%", minval=1.0, maxval=15.0, group=g1)

g2 = "🤖 Движок v5"
v5_thr_mode = input.string("фикс (эталон движка)", "Порог размера свечи", options=["фикс (эталон движка)","авто (растущее окно)"], group=g2, tooltip="Движок: P80 по всей истории = 0.317% на золоте 1H. «авто» — честно в реальном времени, но история отличается от эталона.")
v5_thr_fix  = input.float(0.317, "Фикс. порог, % (золото 1H: 0.317)", minval=0.01, step=0.001, group=g2)
v5_pctl     = input.float(80, "Перцентиль для «авто»", minval=50, maxval=99, group=g2)
v5_min_smpl = input.int(20, "Мин. триггеров для «авто»", minval=1, group=g2)
v5_rr_min   = input.float(3.0, "Мин. RR магнита (движок: 3.0)", minval=0.5, step=0.5, group=g2)
v5_buf_pct  = input.float(0.1, "Буфер стопа, % (движок: 0.1)", minval=0.0, step=0.05, group=g2)
use_ws      = input.bool(true, "Недельный предохранитель", group=g2, tooltip="Неделя достигла -X R → новые входы стоят до понедельника. Проверено на v5: +53.2R → +80.1R, худшая неделя -9 → -3R, обе половины истории лучше, 8/10 лет не хуже, эффект размазан по 36 месяцам. ВЫКЛ = эталонные 939 сделок движка.")
ws_r        = input.float(3.0, "Предохранитель, -R (проверено: 3)", minval=1.0, step=0.5, group=g2)
use_regfilt = input.bool(false, "Фильтр режима: не входить БОК+LONG", group=g2, tooltip="Пропускать ЛОНГИ, когда тренд D3 = БОКОВИК. На золоте лонги в боковике дали -33R (шорты +15R — асимметрия). С фильтром: +53.2R → +86.2R (train +37/test +49). Прошёл walk-forward (+26R OOS, единственный выживший из кандидатов). Оговорка: не бесплатен — в 2021 бакет дал +7R, минусовым был 6/8 лет. ВЫКЛ = эталонные 939 сделок движка.")

g3 = "🎨 Точки"
show_entry = input.bool(true,  "Входы (жёлтые)", group=g3)
show_skip  = input.bool(true,  "Пропуски (цвет = причина)", group=g3)

g6 = "🏷 Структура"
show_fast  = input.bool(true, "Быстрые метки 2/2 (решающие)", group=g6, tooltip="~31/нед. По ним работает движок. Подтверждение через 2 бара.")
show_slow  = input.bool(true, "Медленные метки 5/5 (глобальная структура)", group=g6, tooltip="~14/нед. Контекст, в решениях движка НЕ участвует. Подтверждение через 5 баров. Каждый медленный пивот — одновременно быстрый, но название метки может отличаться: сравнение идёт с предыдущим медленным.")
col_fastH  = input.color(color.new(color.green, 30), "быстрые верх/низ", inline="cf", group=g6)
col_fastL  = input.color(color.new(color.red, 30),   "", inline="cf", group=g6)
col_slowH  = input.color(color.new(#00c853, 0), "медленные верх/низ", inline="cs", group=g6)
col_slowL  = input.color(color.new(#ff1744, 0), "", inline="cs", group=g6)

g4 = "📐 Линии сделок"
show_lines   = input.bool(true, "Линии вход/стоп/тейк", group=g4)
v5_line_bars = input.int(4000, "Линии за последние N баров", minval=100, group=g4, tooltip="Лимит TradingView 500 линий = ~160 сделок × 3 линии. Медиана сделки 4 бара.")

g7 = "📏 Уровни HH/LL (живые, N ближайших)"
show_lv1h = input.bool(true, "1H", inline="lv", group=g7)
show_lv4h = input.bool(true, "4H", inline="lv", group=g7)
show_lv1d = input.bool(true, "1D", inline="lv", group=g7)
show_lvlh = input.bool(true, "LH/HL уровни (точечный стиль)", group=g7, tooltip="Неперебитые LH (сверху) и HL (снизу) — кандидаты в магниты движка. HH/LL — пунктир, LH/HL — точки.")
lv_n      = input.int(3, "Ближайших к цене с каждой стороны", minval=1, maxval=10, group=g7, tooltip="Живых уровней бывает ~130 одновременно (медиана по 9 годам золота), большинство — древние и далёкие. Рисуются только N ближайших сверху (HH) и снизу (LL) на каждый ТФ. Уровни видны на правом крае и на курсоре bar replay.")
lv_transp = input.int(40, "Прозрачность", minval=0, maxval=90, group=g7)
col_lvH   = input.color(color.new(color.green, 0), "верх/низ", inline="lc", group=g7)
col_lvL   = input.color(color.new(color.red, 0),   "", inline="lc", group=g7)

g8 = "〰 Зиг-заг"
show_zz  = input.bool(true, "Показывать зиг-заг", group=g8)
zz_len   = input.int(3, "Длина", minval=1, maxval=20, group=g8)
zz_width = input.int(2, "Толщина", minval=1, maxval=4, group=g8)
zz_bars  = input.int(3000, "Зиг-заг за последние N баров", minval=100, group=g8, tooltip="Зиг-заг делит лимит 500 линий с линиями сделок и уровнями.")

g5 = "💬 Чек-листы и таблица"
show_tips   = input.bool(true, "Tooltip-точки (наведи мышь — чек-лист)", group=g5)
v5_tip_bars = input.int(1500, "Tooltip за последние N баров", minval=100, group=g5, tooltip="Лимит 500 меток; ~18% баров — триггеры.")
show_tbl    = input.bool(true, "Таблица-чеклист", group=g5)
tbl_pos     = input.string("верх-право", "Позиция таблицы", options=["верх-право","верх-лево","низ-право","низ-лево"], group=g5)
tbl_tz      = input.string("Europe/Kyiv", "Часовой пояс времени в таблице", group=g5)

// ══════════════ ТРИГГЕРНЫЕ СВЕЧИ (40 шаблонов) ══════════════
range_    = high - low
body_     = math.abs(close - open)
upper_    = open > close ? high - open  : high - close
lower_    = open > close ? close - low  : open  - low
body_pct  = range_ > 0 ? body_  / range_ * 100 : 0.0
upper_pct = range_ > 0 ? upper_ / range_ * 100 : 0.0
lower_pct = range_ > 0 ? lower_ / range_ * 100 : 0.0

tb = array.from(12.6,14.7,17.0,32.0,20.2,4.1,23.0,27.9,30.7,35.2,24.5,41.9,26.0,25.9,11.6,23.3,49.3,14.0,18.3,25.4,27.9,45.7,29.2,40.6,41.9,10.4,41.5,23.6,32.2,18.8,35.5,32.2,54.2,10.8,47.3,16.0,21.6,19.8,9.9,27.5)
tu = array.from(33.7,37.3,37.7,27.8,29.4,40.4,35.7,35.3,41.0,35.7,28.4,22.0,39.6,37.4,46.0,31.5,21.5,27.5,47.3,35.6,26.2,24.8,36.3,36.7,26.8,35.6,20.7,34.5,36.4,46.2,38.6,33.6,21.6,44.1,22.9,45.2,42.8,45.2,41.5,30.7)
tl = array.from(53.7,48.0,45.3,40.2,50.4,55.5,41.3,36.8,28.3,29.1,47.1,36.0,34.5,36.7,42.5,45.2,29.2,58.5,34.4,39.0,46.0,29.5,34.5,22.6,31.3,54.0,37.9,41.9,31.4,34.9,25.8,34.2,24.2,45.1,29.8,38.8,35.5,35.0,48.6,41.8)

shape_ok = false
for i = 0 to 39
    if math.abs(body_pct  - array.get(tb, i)) <= tol and
       math.abs(upper_pct - array.get(tu, i)) <= tol and
       math.abs(lower_pct - array.get(tl, i)) <= tol
        shape_ok := true
        break

// ══════════════ ПИВОТЫ 2/2 И МЕТКИ (сверено с mk() движка) ══════════════
ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow (low,  2, 2)
ph_value = high[2]
pl_value = low[2]

vw1 = ta.valuewhen(not na(ph), ph_value, 1)
vw2 = ta.valuewhen(not na(ph), ph_value, 0)
higherhigh = na(ph) ? na : vw1 < vw2 ? ph : na
lowerhigh  = na(ph) ? na : vw1 > vw2 ? ph : na
vw3 = ta.valuewhen(not na(pl), pl_value, 1)
vw4 = ta.valuewhen(not na(pl), pl_value, 0)
higherlow = na(pl) ? na : vw3 < vw4 ? pl : na
lowerlow  = na(pl) ? na : vw3 > vw4 ? pl : na

var string[] q_lab  = array.new_string()
var float[]  q_prc  = array.new_float()
var string[] q_side = array.new_string()
var int[]    q_conf = array.new_int()

f_push(_lab, _prc, _side) =>
    array.push(q_lab,  _lab)
    array.push(q_prc,  _prc)
    array.push(q_side, _side)
    array.push(q_conf, bar_index)
    if array.size(q_lab) > 5
        array.shift(q_lab)
        array.shift(q_prc)
        array.shift(q_side)
        array.shift(q_conf)

newH = not na(higherhigh) or not na(lowerhigh)
newL = not na(higherlow)  or not na(lowerlow)
if newH and newL
    f_push(not na(higherhigh) ? "HH" : "LH", ph_value, "high")
    f_push(not na(higherlow)  ? "HL" : "LL", pl_value, "low")
else if newH
    f_push(not na(higherhigh) ? "HH" : "LH", ph_value, "high")
else if newL
    f_push(not na(higherlow)  ? "HL" : "LL", pl_value, "low")


// ══════════════ МЕТКИ СТРУКТУРЫ НА ГРАФИКЕ ══════════════
// быстрые 2/2 — решающие (по ним движок); мелкие, приглушённые
plotshape(show_fast and not na(higherhigh) ? higherhigh : na, title="HH 2/2", style=shape.triangledown, location=location.abovebar, color=col_fastH, text="HH", textcolor=col_fastH, size=size.tiny, offset=-2)
plotshape(show_fast and not na(lowerhigh)  ? lowerhigh  : na, title="LH 2/2", style=shape.triangledown, location=location.abovebar, color=col_fastH, text="LH", textcolor=col_fastH, size=size.tiny, offset=-2)
plotshape(show_fast and not na(higherlow)  ? higherlow  : na, title="HL 2/2", style=shape.triangleup,   location=location.belowbar, color=col_fastL, text="HL", textcolor=col_fastL, size=size.tiny, offset=-2)
plotshape(show_fast and not na(lowerlow)   ? lowerlow   : na, title="LL 2/2", style=shape.triangleup,   location=location.belowbar, color=col_fastL, text="LL", textcolor=col_fastL, size=size.tiny, offset=-2)

// медленные 5/5 — глобальная структура (контекст); крупнее и ярче, лаг 5 баров
ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow (low,  5, 5)
ph5_value = high[5]
pl5_value = low[5]
vw1s = ta.valuewhen(not na(ph5), ph5_value, 1)
vw2s = ta.valuewhen(not na(ph5), ph5_value, 0)
hh5 = na(ph5) ? na : vw1s < vw2s ? ph5 : na
lh5 = na(ph5) ? na : vw1s > vw2s ? ph5 : na
vw3s = ta.valuewhen(not na(pl5), pl5_value, 1)
vw4s = ta.valuewhen(not na(pl5), pl5_value, 0)
hl5 = na(pl5) ? na : vw3s < vw4s ? pl5 : na
ll5 = na(pl5) ? na : vw3s > vw4s ? pl5 : na

plotshape(show_slow and not na(hh5) ? hh5 : na, title="HH 5/5", style=shape.labeldown, location=location.abovebar, color=color.new(color.black, 100), text="HH", textcolor=col_slowH, size=size.small, offset=-5)
plotshape(show_slow and not na(lh5) ? lh5 : na, title="LH 5/5", style=shape.labeldown, location=location.abovebar, color=color.new(color.black, 100), text="LH", textcolor=col_slowH, size=size.small, offset=-5)
plotshape(show_slow and not na(hl5) ? hl5 : na, title="HL 5/5", style=shape.labelup,   location=location.belowbar, color=color.new(color.black, 100), text="HL", textcolor=col_slowL, size=size.small, offset=-5)
plotshape(show_slow and not na(ll5) ? ll5 : na, title="LL 5/5", style=shape.labelup,   location=location.belowbar, color=color.new(color.black, 100), text="LL", textcolor=col_slowL, size=size.small, offset=-5)


// ══════════════ ГДЕ МЫ v5: ДВА СЛОЯ ══════════════
// Движок слоёв перенесён из gde_my_v5.pine без изменений логики.
// 5/5 и 2/2 считаются параллельно, каждый со своими коленами, метками,
// счётом, трендом и уровнем. Всё проверено репликой research/core.py,
// которая воспроизводит таблицу строка в строку.
gW = "ГДЕ МЫ v5"
w_fib5 = input.float(0.33, "5/5 · глубина слома, импульсов", 0.0, 1.0, 0.01, group=gW, tooltip="0.33 отсеивает 36% сломов и поднимает медиану жизни тренда с 24 до 45 баров.")
w_fib2 = input.float(0.15, "2/2 · глубина слома, импульсов", 0.0, 1.0, 0.01, group=gW, tooltip="На 2/2 смерть по касанию даёт жизнь тренда 7 баров и слом каждые 20 баров — это шум. 0.15 даёт 17 баров при вдвое более быстрой реакции, чем 0.33 на 5/5.")
w_jmp5 = input.float(0.5, "5/5 · досрочное подтверждение, импульсов", 0.0, 3.0, 0.25, group=gW, tooltip="Пауза «жду 2 метки» считает КОЛЕНА. В одностороннем ходе новый экстремум сливается в то же колено, счётчик стоит, и тренд не подтверждается сколько бы цена ни прошла. 0 выключает.")
w_jmp2 = input.float(0.5, "2/2 · досрочное подтверждение, импульсов", 0.0, 3.0, 0.25, group=gW)
w_prov = input.bool(true, "После рывка держать на уровне смерти", group=gW, tooltip="Без этого уровень берётся с вершины прошлого движения: после рывка он дальше 1.5 импульса в 78% случаев, и строка запаса успокаивает ложно.")
W_MAXK = 80

// ══════════════ СЛОЙ ══════════════
type Layer
    array<float>  KP        // цена колена
    array<int>    KB        // бар колена
    array<bool>   KH        // вершина или низ
    array<string> KL        // метка HH / LH / HL / LL
    array<int>    KN        // номер точки в счёте, -1 вне счёта
    array<int>    KM        // сколько сырых меток слилось
    array<float>  KA        // цена первой, поглощённой метки
    array<int>    KT        // тренд на момент появления колена
    array<bool>   KX        // колено появилось в ПЕРЕХОДЕ
    array<float>  LEGS      // амплитуды ног, для медианы
    int      lb        // 5 или 2
    float    fib       // глубина слома
    float    jump      // досрочное подтверждение
    int      tr        // +1 / -1, ноль до первого тренда
    float    lvl
    float    imp       // последнее импульсное колено
    int      trFrom
    bool     inTrans
    int      marks
    float    lastD     // уровень, пробой которого убил прошлый тренд
    bool     lvlProv   // уровень провизорный, настоящей метки ещё нет
    int      pTr
    float    pD
    int      pDb

w_new(_lb, _fib, _jump) =>
    Layer.new(KP = array.new_float(), KB = array.new_int(), KH = array.new_bool(),
              KL = array.new_string(), KN = array.new_int(), KM = array.new_int(),
              KA = array.new_float(), KT = array.new_int(), KX = array.new_bool(),
              LEGS = array.new_float(), lb = _lb, fib = _fib, jump = _jump,
              tr = 0, lvl = na, imp = 0.0, trFrom = na, inTrans = false, marks = 0,
              lastD = na, lvlProv = false, pTr = 0, pD = na, pDb = na)

w_isUp(_l) => _l == "HH" or _l == "HL"

// метка колена: сравнение с предыдущим коленом ТОЙ ЖЕ стороны
w_relabel(L) =>
    array.clear(L.KL)
    n = array.size(L.KP)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(L.KH, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(L.KH, j) == hi
                    prev := array.get(L.KP, j)
                    break
                j -= 1
            cur = array.get(L.KP, i)
            array.push(L.KL, na(prev) ? "?" : hi ? (cur > prev ? "HH" : "LH") : (cur > prev ? "HL" : "LL"))
    n

// счёт (0)-(5) со сбросом. Новый ноль — колено нужной стороны:
// вниз считаем от вершины, вверх от низа.
w_recount(L) =>
    n = array.size(L.KL)
    array.clear(L.KN)
    if n > 0
        for i = 0 to n - 1
            array.push(L.KN, -1)
    if n >= 2
        int o = 0
        int d = w_isUp(array.get(L.KL, 1)) ? 1 : -1
        int guard = 0
        bool go = true
        while go and guard < 500
            guard += 1
            int pts = 0
            i = o + 1
            while i < n and pts < 5
                lbl = array.get(L.KL, i)
                ok = d > 0 ? w_isUp(lbl) : not w_isUp(lbl)
                if not ok
                    break
                pts += 1
                i += 1
            for k = 0 to pts
                if o + k < n
                    array.set(L.KN, o + k, k)
            e = o + pts
            x = e + 1
            if x >= n
                go := false
            else
                nd = pts == 5 ? d : (w_isUp(array.get(L.KL, x)) ? 1 : -1)
                needHi = nd < 0
                j = x
                while j >= 0
                    if array.get(L.KH, j) == needHi
                        break
                    j -= 1
                if j <= o
                    j := x
                o := j
                d := nd
    n

// серия меток одной стороны схлопывается в свой экстремум
w_push(L, _price, _bar, _hi) =>
    n = array.size(L.KP)
    bool same = false
    if n > 0
        same := array.get(L.KH, n - 1) == _hi
    bool fresh = false
    if same
        old = array.get(L.KP, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(L.KM, n - 1, array.get(L.KM, n - 1) + 1)
        if na(array.get(L.KA, n - 1))
            array.set(L.KA, n - 1, old)
        if better
            array.set(L.KP, n - 1, _price)
            array.set(L.KB, n - 1, _bar)
    else
        array.push(L.KP, _price)
        array.push(L.KB, _bar)
        array.push(L.KH, _hi)
        array.push(L.KM, 1)
        array.push(L.KA, na)
        array.push(L.KT, L.tr)
        array.push(L.KX, L.inTrans)
        fresh := true
        if array.size(L.KP) > W_MAXK
            array.shift(L.KP)
            array.shift(L.KB)
            array.shift(L.KH)
            array.shift(L.KM)
            array.shift(L.KA)
            array.shift(L.KT)
            array.shift(L.KX)
    d1 = w_relabel(L)
    d2 = w_recount(L)
    fresh

// ══════════════ ШАГ БАРА ══════════════
// Порядок ровно как в v4, он проверен репликой строка в строку.
w_step(L, _pvH, _pvL, _hiPx, _loPx) =>
    bLo = math.min(open, close)
    bHi = math.max(open, close)

    // 1. смерть тренда с фильтром глубины
    need = L.imp * L.fib
    bool died = false
    if L.tr == 1
        if not na(L.lvl)
            if bLo < L.lvl - need
                died := true
    if L.tr == -1
        if not na(L.lvl)
            if bHi > L.lvl + need
                died := true
    if died
        if not na(L.lastD)
            if math.abs(L.lvl - L.lastD) < syminfo.mintick
                died := false
    if died
        L.pTr := L.tr
        L.pD := L.lvl
        L.pDb := bar_index
        L.lastD := L.lvl
        L.inTrans := true
        L.marks := 0
        L.lvl := na
        L.lvlProv := false

    // 1б. досрочное подтверждение по рывку
    if L.jump > 0 and L.inTrans and L.imp > 0 and not na(L.lastD)
        nj = array.size(L.KL)
        if nj >= 2
            j1 = array.get(L.KL, nj - 1)
            j2 = array.get(L.KL, nj - 2)
            bool ju = w_isUp(j1) and w_isUp(j2)
            bool jd = (not w_isUp(j1)) and (not w_isUp(j2))
            bool far = false
            if jd
                far := close < L.lastD - L.imp * L.jump
            if ju
                far := close > L.lastD + L.imp * L.jump
            if far
                dl = L.lastD
                L.tr := ju ? 1 : -1
                L.trFrom := bar_index
                L.inTrans := false
                L.lastD := na
                L.lvl := na
                if w_prov
                    L.lvl := dl
                    L.lvlProv := true

    // 2. новые колена
    bool fresh = false
    if not na(_pvH)
        if w_push(L, _hiPx, bar_index - L.lb, true)
            fresh := true
    if not na(_pvL)
        if w_push(L, _loPx, bar_index - L.lb, false)
            fresh := true
    if fresh
        L.marks := L.marks + 1

    n = array.size(L.KL)
    if n >= 2
        l1 = array.get(L.KL, n - 1)
        l2 = array.get(L.KL, n - 2)
        p1 = array.get(L.KP, n - 1)
        p2 = array.get(L.KP, n - 2)

        if fresh
            array.push(L.LEGS, math.abs(p1 - p2))
            if array.size(L.LEGS) > 20
                array.shift(L.LEGS)
            // 3. импульсное колено — ход по направлению тренда
            if L.tr != 0
                movedUp = p1 > p2
                if (L.tr == 1 and movedUp) or (L.tr == -1 and not movedUp)
                    L.imp := math.abs(p1 - p2)
            // 4. рождение или подтверждение
            bool up2 = w_isUp(l1) and w_isUp(l2)
            bool dn2 = (not w_isUp(l1)) and (not w_isUp(l2))
            if L.tr == 0
                if up2
                    L.tr := 1
                    L.trFrom := bar_index
                    L.imp := math.abs(p1 - p2)
                if dn2
                    L.tr := -1
                    L.trFrom := bar_index
                    L.imp := math.abs(p1 - p2)
            else if L.inTrans
                if L.marks >= 2
                    if up2 or dn2
                        L.tr := up2 ? 1 : -1
                        L.trFrom := bar_index
                        L.inTrans := false
                        L.lastD := na
                        L.lvlProv := false
                        L.imp := math.abs(p1 - p2)

        // 5. уровень тренда. В ПЕРЕХОДЕ не восстанавливается: иначе
        // поиск назад воскрешал старый HL, цена пробивала и его, и
        // писалась вторая смерть уже мёртвого тренда.
        if not L.inTrans and L.tr == 1
            if l1 == "HL"
                L.lvl := p1
                L.lvlProv := false
            if na(L.lvl)
                j = n - 1
                while j >= 0
                    if array.get(L.KL, j) == "HL"
                        L.lvl := array.get(L.KP, j)
                        break
                    j -= 1
        if not L.inTrans and L.tr == -1
            if l1 == "LH"
                L.lvl := p1
                L.lvlProv := false
            if na(L.lvl)
                j = n - 1
                while j >= 0
                    if array.get(L.KL, j) == "LH"
                        L.lvl := array.get(L.KP, j)
                        break
                    j -= 1

        // 6. тренд и флаг ПЕРЕХОДА пишутся один раз, на баре появления
        if fresh and array.size(L.KT) > 0
            array.set(L.KT, array.size(L.KT) - 1, L.tr)
            array.set(L.KX, array.size(L.KX) - 1, L.inTrans)
    fresh

// ══════════════ ПРОИЗВОДНЫЕ ══════════════
w_cstart(L) =>
    n = array.size(L.KN)
    int o = -1
    if n > 0
        i = n - 1
        while i >= 0
            if array.get(L.KN, i) == 0
                o := i
                break
            i -= 1
    o

// направление счёта. На точке (0) следующего колена ещё нет — берём
// сторону нуля: счёт стартует с вершины вниз и с низа вверх. Проверено
// на 464 счётах, совпадает во всех 464.
w_cdir(L, _o) =>
    n = array.size(L.KL)
    int d = 0
    if _o >= 0
        if _o + 1 < n
            d := w_isUp(array.get(L.KL, _o + 1)) ? 1 : -1
        else if _o < array.size(L.KH)
            d := array.get(L.KH, _o) ? -1 : 1
    d

// к какому счёту принадлежит колено
w_kdir(L, _i) =>
    int z = -1
    j = _i
    while j >= 0
        if array.get(L.KN, j) == 0
            z := j
            break
        j -= 1
    int d = 0
    if z >= 0
        if z < array.size(L.KH)
            d := array.get(L.KH, z) ? -1 : 1
    d

// оставшийся ход до порога смерти, в импульсных коленах
w_room(L) =>
    float r = na
    if not L.inTrans and not na(L.lvl) and L.tr != 0 and L.imp > 0
        thr = L.tr == 1 ? L.lvl - L.imp * L.fib : L.lvl + L.imp * L.fib
        r := math.max(0.0, L.tr == 1 ? close - thr : thr - close) / L.imp
    r

w_chainCur(L, _o, _min) =>
    n = array.size(L.KL)
    s = ""
    if _o >= 0 and n > 0
        from = math.max(0, math.min(_o, n - _min))
        for j = from to n - 1
            s := s + (j == _o and j > from ? " | " : j > from ? ">" : "") + array.get(L.KL, j)
    s


// ── прогон обоих слоёв ──
var Layer L5 = w_new(5, w_fib5, w_jmp5)
var Layer L2 = w_new(2, w_fib2, w_jmp2)
L5.fib := w_fib5
L5.jump := w_jmp5
L2.fib := w_fib2
L2.jump := w_jmp2
if barstate.isconfirmed
    wf5 = w_step(L5, ph5, pl5, high[5], low[5])
    wf2 = w_step(L2, ph,  pl,  high[2], low[2])

// очередь медленных меток (5 последних) — для таблицы
var string[] q5_lab = array.new_string()
f_push5(_lab) =>
    array.push(q5_lab, _lab)
    if array.size(q5_lab) > 5
        array.shift(q5_lab)
new5H = not na(hh5) or not na(lh5)
new5L = not na(hl5) or not na(ll5)
if new5H and new5L
    f_push5(not na(hh5) ? "HH" : "LH")
    f_push5(not na(hl5) ? "HL" : "LL")
else if new5H
    f_push5(not na(hh5) ? "HH" : "LH")
else if new5L
    f_push5(not na(hl5) ? "HL" : "LL")

// ══════════════ ТРЕНД D3: ЛИПКОЕ 5/5, СМЕРТЬ ТЕЛОМ ══════════════
// Проверено на 9 годах золота: медиана тренда 26 баров против 6 у 2/2.
// Старт по паре медленных меток (HH+HL / LH+LL); уровень = последний
// HL(восх) или LH(нисх), обновляется новыми метками той же стороны.
// Смерть ТОЛЬКО когда тело свечи (min/max open,close) закрылось за уровнем.
// Контр-метки тренд НЕ убивают — только пробой уровня телом. Буфер НЕ
// добавлен намеренно: подгонка под фид одного брокера (см. research_log).
var int   d3_state = 0        // +1 восх, -1 нисх, 0 боковик
var float d3_lvl   = na       // живой уровень тренда
var float d3_lvl_prev = na    // уровень, который убил прошлый тренд (для подсказки)
var int   d3_since = na       // бар старта текущего сегмента
var string d3_lastH = ""
var string d3_lastL = ""
var float  d3_lastHp = na
var float  d3_lastLp = na
if barstate.isconfirmed
    if new5H
        d3_lastH := not na(hh5) ? "HH" : "LH"
        d3_lastHp := not na(hh5) ? hh5 : lh5
        if d3_state == -1 and d3_lastH == "LH"
            d3_lvl := d3_lastHp        // уровень нисх-тренда = последний LH
    if new5L
        d3_lastL := not na(hl5) ? "HL" : "LL"
        d3_lastLp := not na(hl5) ? hl5 : ll5
        if d3_state == 1 and d3_lastL == "HL"
            d3_lvl := d3_lastLp        // уровень восх-тренда = последний HL
    if d3_state == 0
        if d3_lastH == "HH" and d3_lastL == "HL"
            d3_state := 1
            d3_lvl := d3_lastLp
            d3_since := bar_index
        else if d3_lastH == "LH" and d3_lastL == "LL"
            d3_state := -1
            d3_lvl := d3_lastHp
            d3_since := bar_index
    // смерть телом
    body_lo = math.min(open, close)
    body_hi = math.max(open, close)
    if d3_state == 1 and not na(d3_lvl) and body_lo < d3_lvl
        d3_lvl_prev := d3_lvl
        d3_state := 0
        d3_lvl := na
        d3_since := bar_index
    else if d3_state == -1 and not na(d3_lvl) and body_hi > d3_lvl
        d3_lvl_prev := d3_lvl
        d3_state := 0
        d3_lvl := na
        d3_since := bar_index

// ── помощники блока ГДЕ МЫ ──
w_col(_t) => _t == 1 ? color.lime : color.new(color.red, 0)

w_trend(L) =>
    L.inTrans ? "ПЕРЕХОД, был " + (L.pTr == 1 ? "восх" : "нисх") : L.tr == 1 ? "ВОСХОДЯЩИЙ, " + str.tostring(bar_index - L.trFrom) + "б" : L.tr == -1 ? "НИСХОДЯЩИЙ, " + str.tostring(bar_index - L.trFrom) + "б" : "не определён"

w_trendC(L) => L.inTrans ? color.new(color.orange, 0) : L.tr == 0 ? color.gray : w_col(L.tr)

w_lvlTxt(L) =>
    L.inTrans ? "— пробит" : na(L.lvl) ? "—" : (L.lvlProv ? "смерть " : L.tr == 1 ? "HL " : "LH ") + str.tostring(L.lvl, format.mintick) + (L.lvlProv ? " провиз" : "")

// вероятность смерти тренда за 10 баров по замеру на 9675 барах живого
// тренда: запас меньше 0.25 импульса — 73%, 0.25-0.50 — 42%, 0.50-1.00 —
// 17%, 1.00-2.00 — 6%, дальше 1%. В среднем по рынку 16%.
w_roomTxt(L) =>
    r = w_room(L)
    na(r) ? "—" : str.tostring(r, "#.##") + " имп · " + (r < 0.25 ? "73%" : r < 0.5 ? "42%" : r < 1.0 ? "17%" : r < 2.0 ? "6%" : "1%")

w_roomC(L) =>
    r = w_room(L)
    na(r) ? color.gray : r < 0.25 ? color.new(color.red, 0) : r < 0.5 ? color.new(color.orange, 0) : r < 1.0 ? color.new(color.silver, 20) : color.lime

w_mudTxt(L, _cs) =>
    nk = array.size(L.KM)
    mudC = 0
    cnt = 0
    if _cs >= 0
        for q = _cs to nk - 1
            cnt += 1
            if array.get(L.KM, q) >= 2
                mudC += 1
    last = nk > 0 ? array.get(L.KM, nk - 1) : 1
    (last >= 2 ? "МУТНОЕ x" + str.tostring(last) + " · " : "чистое · ") + str.tostring(mudC) + " из " + str.tostring(cnt)

w_pauseTxt(L) =>
    s = "—"
    if L.inTrans
        s := str.tostring(math.min(L.marks, 2)) + " из 2 колен"
        nz2 = array.size(L.KL)
        if L.jump > 0 and L.imp > 0 and not na(L.lastD) and nz2 >= 2
            z1 = array.get(L.KL, nz2 - 1)
            z2b = array.get(L.KL, nz2 - 2)
            bool zu = w_isUp(z1) and w_isUp(z2b)
            bool zd = (not w_isUp(z1)) and (not w_isUp(z2b))
            if zu or zd
                s := s + " · рывок " + (zu ? "выше " : "ниже ") + str.tostring(zu ? L.lastD + L.imp * L.jump : L.lastD - L.imp * L.jump, format.mintick)
    s

w_zeroTxt(L, _cs, _cd) =>
    s = "—"
    if _cs >= 0
        zl = array.get(L.KL, _cs)
        s := zl + " " + str.tostring(array.get(L.KP, _cs), format.mintick) + " · " + ((_cd == 1 ? zl == "LL" : _cd == -1 ? zl == "HH" : false) ? "разворот" : "продолж")
    s

w_cntTxt(L, _cn, _cd) =>
    _cn < 0 ? "вне счёта" : "(" + str.tostring(_cn) + ") из 5 " + (_cd == 1 ? "↑" : _cd == -1 ? "↓" : "") + (_cn <= 0 ? "" : _cn % 2 == 1 ? " импульс" : " коррекция")

// ══════════════ БАЛЛ КАЧЕСТВА ВХОДА ══════════════
// Три условия, каждое мерилось отдельно на 261 сделке движка за 2 года:
//   слои согласны              +0.22R против +0.00R
//   коррекционная точка счёта  +0.32R против -0.06R
//   запас старшего > импульса  +0.39R против +0.03R
// Балл в сумме упорядочен: 0 -> -0.13R, 1 -> -0.01R, 2 -> +0.35R, 3 -> +0.73R.
// ВАЖНО: разница между «балл >= 2» и «балл <= 1» составляет +0.49R при
// стандартной ошибке 0.31R — это 1.6 сигмы. Упорядоченность видна, но
// величина НЕ доказана, и признаки подобраны на этих же двух годах.
gQ = "Качество входа"
q_mode = input.string("мягко", "Фильтр по баллу", options=["выкл","мягко","жёстко"], group=gQ, tooltip="«мягко» — балл считается и красит точку, но вход не блокирует. «жёстко» — вход с баллом ниже порога отсекается: на истории это 35% сделок вместо 100% и +39.0R вместо +29.3R, но доказательство слабое (1.6 сигмы). «выкл» — как в v8.")
q_min  = input.int(2, "Минимальный балл для входа", 1, 3, group=gQ)

// балл для конкретного направления сделки
w_score(_isLong) =>
    sd = _isLong ? 1 : -1
    t5 = L5.inTrans ? 0 : L5.tr
    t2 = L2.inTrans ? 0 : L2.tr
    cs2 = w_cstart(L2)
    cd2 = w_cdir(L2, cs2)
    cn2 = array.size(L2.KN) > 0 ? array.get(L2.KN, array.size(L2.KN) - 1) : -1
    r5 = w_room(L5)
    int a = t5 != 0 and t5 == t2 ? 1 : 0
    int b = (cn2 == 2 or cn2 == 4) and cd2 == sd ? 1 : 0
    int c = not na(r5) and r5 > 1.0 ? 1 : 0
    [a + b + c, a, b, c]

// ══════════════ ПОРОГ РАЗМЕРА ══════════════
var float[] trig_sz = array.new_float()
sz_pct = close > 0 ? (high - low) / close * 100 : 0.0
if shape_ok and barstate.isconfirmed
    array.push(trig_sz, sz_pct)
thr = v5_thr_mode == "фикс (эталон движка)" ? v5_thr_fix : array.size(trig_sz) >= v5_min_smpl ? array.percentile_linear_interpolation(trig_sz, v5_pctl) : na

// ══════════════ РЕШЕНИЕ ДВИЖКА + ЧЕК-ЛИСТ (каскад decide_v4 + запреты v5) ══════════════
f_tail(_n) =>
    n = array.size(q_lab)
    m = math.min(_n, n)
    s = ""
    if m > 0
        for j = n - m to n - 1
            s := s + (j > n - m ? ">" : "") + array.get(q_lab, j)
    s

f_decide(_thr) =>
    string vd = ""
    string dd = ""
    float  en = na
    float  sl = na
    float  tp = na
    float  rr = na
    string chk = ""
    n = array.size(q_lab)
    if n == 0
        vd := "нет меток"
        chk := "нет меток — ПРОПУСК"
    else
        lastL   = array.get(q_lab, n - 1)
        is_long = lastL == "HL" or lastL == "LL"
        dd := is_long ? "LONG" : "SHORT"
        lag = bar_index - array.get(q_conf, n - 1)
        up = 0
        dn = 0
        for j = 0 to n - 1
            lb = array.get(q_lab, j)
            up += lb == "HH" or lb == "HL" ? 1 : 0
            dn += lb == "LH" or lb == "LL" ? 1 : 0
        had_slom = false
        if n >= 2
            for j = 1 to n - 1
                a = array.get(q_lab, j - 1)
                b = array.get(q_lab, j)
                if (a == "HH" and b == "LL") or (a == "LL" and b == "HL")
                    had_slom := true
        prevL = n >= 2 ? array.get(q_lab, n - 2) : ""
        fresh_slom = (prevL == "HH" and lastL == "LL") or (prevL == "LL" and lastL == "HL")
        chk := f_tail(5) + "\n" + lastL + " → " + dd
        if (lastL == "LL" or lastL == "HH") and lag <= 1
            vd := "заморозка"
            chk += "\nзаморозка: свежий " + lastL + ", лаг " + str.tostring(lag) + " — ПРОПУСК"
        else
            chk += "\nзаморозка: ок (лаг " + str.tostring(lag) + ")"
            if na(_thr)
                vd := "мало триггеров"
                chk += "\nразмер: мало данных для порога — ПРОПУСК"
            else if sz_pct > _thr
                vd := "бол.свеча"
                chk += "\nразмер: " + str.tostring(sz_pct, "#.###") + "% > " + str.tostring(_thr, "#.###") + "% — ПРОПУСК"
            else
                chk += "\nразмер: ок " + str.tostring(sz_pct, "#.###") + "% ≤ " + str.tostring(_thr, "#.###") + "%"
                // ── ступень: колена обоих слоёв ──
                [qs, qa, qb, qc] = w_score(is_long)
                chk += "\nколена: балл " + str.tostring(qs) + "/3 · " + (qa == 1 ? "слои согласны" : "слои спорят") + " · " + (qb == 1 ? "точка счёта по входу" : "точка счёта не та") + " · " + (qc == 1 ? "запас старшего есть" : "запаса у старшего нет")
                bool knee_block = q_mode == "жёстко" and qs < q_min
                if knee_block
                    chk += "\nколена: балл ниже " + str.tostring(q_min) + " — ПРОПУСК"
                trend_block = false
                if not had_slom and not is_long and up >= (lastL == "HH" ? 3 : 4)
                    trend_block := true
                    chk += "\nтренд: вверх " + str.tostring(up) + "/5 против шорта — ПРОПУСК"
                if not had_slom and is_long and dn >= 4
                    trend_block := true
                    chk += "\nтренд: вниз " + str.tostring(dn) + "/5 против лонга — ПРОПУСК"
                if knee_block
                    vd := "колена"
                else if trend_block
                    vd := "против тренда"
                else
                    chk += "\nтренд: ок (вверх " + str.tostring(up) + " / вниз " + str.tostring(dn) + (had_slom ? ", есть слом в пятёрке" : "") + ")"
                    if fresh_slom
                        vd := "слом"
                        chk += "\nслом: " + prevL + "→" + lastL + " свежий — ПРОПУСК (жду подтверждения)"
                    else
                        chk += "\nслом: ок"
                        en := close
                        sl := is_long ? low * (1 - v5_buf_pct / 100) : high * (1 + v5_buf_pct / 100)
                        if (is_long and sl >= en) or (not is_long and sl <= en)
                            vd := "стоп?"
                            chk += "\nстоп не по ту сторону — ПРОПУСК"
                        else
                            chk += "\nстоп: " + str.tostring(sl, format.mintick)
                            risk = math.abs(en - sl)
                            float[] cprc = array.new_float()
                            for j = 0 to n - 1
                                if array.get(q_side, j) == (is_long ? "high" : "low")
                                    p = array.get(q_prc, j)
                                    if (is_long and p > en) or (not is_long and p < en)
                                        array.push(cprc, p)
                            if array.size(cprc) > 0
                                array.sort(cprc, is_long ? order.ascending : order.descending)
                                for j = 0 to array.size(cprc) - 1
                                    p = array.get(cprc, j)
                                    if math.abs(p - en) / risk >= v5_rr_min
                                        tp := p
                                        break
                            if na(tp)
                                vd := "нет RR"
                                chk += "\nмагнит: нет метки с RR ≥ " + str.tostring(v5_rr_min, "#.#") + " — ПРОПУСК"
                            else
                                rr := math.abs(tp - en) / risk
                                chk += "\nмагнит: RR " + str.tostring(rr, "#.##") + " → " + str.tostring(tp, format.mintick)
                                s5 = f_tail(5)
                                vd := str.endswith(s5, "LL>HH") ? "запрет LL>HH" : str.endswith(s5, "HH>LH") ? "запрет HH>LH" : str.endswith(s5, "LL>LH>HL") ? "запрет LL>LH>HL" : str.endswith(s5, "HH>LL>LL") ? "запрет HH>LL>LL" : "ВХОД"
                                if vd == "ВХОД"
                                    chk += "\nхвост: чист"
                                else
                                    chk += "\nхвост: " + str.replace_all(vd, "запрет ", "") + " — ЗАПРЕТ"
        chk += "\nИТОГ: " + vd
    [vd, dd, en, sl, tp, rr, chk]

// ══════════════ ВИРТУАЛЬНЫЕ ПОЗИЦИИ (до 5 одновременно, как в движке) ══════════════
var array<bool>  P_long = array.new<bool>()
var array<float> P_en   = array.new<float>()
var array<float> P_sl   = array.new<float>()
var array<float> P_tp   = array.new<float>()
var array<int>   P_bar  = array.new<int>()
var array<int>   P_tim  = array.new<int>()   // время входа: период сделки считается по нему
var array<line>  P_lnen = array.new<line>()
var array<line>  P_lnsl = array.new<line>()
var array<line>  P_lntp = array.new<line>()

// закрытые сделки движка — для счётчика R (R = RR при TP, -1 при SL, как эталон)
var float[] R_val = array.new_float()
var int[]   R_tim = array.new_int()          // время закрытия
var int[]   R_ent = array.new_int()          // время ВХОДА — по нему группируем по периодам

// неделя и предохранитель (weekofyear может расходиться с ISO на стыке годов)
// Периоды считаются по времени ВХОДА сделки, а не закрытия. Раньше сделка,
// открытая в пятницу и закрытая в понедельник, падала в следующую неделю.
w_period(_t, _kind) =>
    _kind == "D" ? year(_t, "Etc/UTC") * 10000 + month(_t, "Etc/UTC") * 100 + dayofmonth(_t, "Etc/UTC") : _kind == "W" ? year(_t, "Etc/UTC") * 100 + weekofyear(_t, "Etc/UTC") : year(_t, "Etc/UTC") * 100 + month(_t, "Etc/UTC")

w_sumR(_kind) =>
    float sm = 0.0
    int   cn = 0
    n = array.size(R_val)
    if n > 0
        cur = w_period(time, _kind)
        for i = 0 to n - 1
            if w_period(array.get(R_ent, i), _kind) == cur
                sm += array.get(R_val, i)
                cn += 1
    [sm, cn]

var float wk_r = 0.0

in_line = last_bar_index - bar_index <= v5_line_bars
in_tip  = last_bar_index - bar_index <= v5_tip_bars

if array.size(P_en) > 0
    k = 0
    while k < array.size(P_en)
        lnen = array.get(P_lnen, k)
        if not na(lnen)
            line.set_x2(lnen, bar_index)
            line.set_x2(array.get(P_lnsl, k), bar_index)
            line.set_x2(array.get(P_lntp, k), bar_index)
        closed = false
        if bar_index > array.get(P_bar, k) and barstate.isconfirmed
            plong = array.get(P_long, k)
            psl   = array.get(P_sl, k)
            ptp   = array.get(P_tp, k)
            hit_sl = plong ? low  <= psl : high >= psl
            hit_tp = plong ? high >= ptp : low  <= ptp
            if hit_sl or hit_tp
                res_sl = hit_sl  // SL и TP в одном баре = SL (консервативно, как движок)
                pen = array.get(P_en, k)
                R_ = res_sl ? -1.0 : math.abs(ptp - pen) / math.abs(pen - psl)
                array.push(R_val, R_)
                array.push(R_tim, time)
                array.push(R_ent, array.get(P_tim, k))
                wk_r += R_
                if show_lines and in_line
                    label.new(bar_index, res_sl ? psl : ptp, res_sl ? "SL" : "TP", style=res_sl ? label.style_label_up : label.style_label_down, color=res_sl ? color.new(color.red, 0) : color.new(color.green, 0), textcolor=color.white, size=size.small)
                array.remove(P_long, k)
                array.remove(P_en,   k)
                array.remove(P_sl,   k)
                array.remove(P_tp,   k)
                array.remove(P_bar,  k)
                array.remove(P_tim,  k)
                array.remove(P_lnen, k)
                array.remove(P_lnsl, k)
                array.remove(P_lntp, k)
                closed := true
        if not closed
            k += 1

// неделя для предохранителя считается ПОСЛЕ закрытий этого бара,
// иначе предохранитель отстаёт на бар
if barstate.isconfirmed
    [wsx, wcx] = w_sumR("W")
    wk_r := wsx

// ══════════════ РЕШЕНИЕ НА ТРИГГЕРНОЙ СВЕЧЕ ══════════════
string v5_vd  = na
string v5_dd  = na
float  v5_en  = na
float  v5_sl_ = na
float  v5_tp_ = na
float  v5_rr_ = na
string v5_chk = na

if shape_ok and barstate.isconfirmed
    if use_ws and wk_r <= -ws_r
        v5_vd  := "стоп-неделя"
        v5_dd  := ""
        v5_chk := "СТОП-НЕДЕЛЯ: " + str.tostring(wk_r, "#.#") + "R ≤ -" + str.tostring(ws_r, "#.#") + "R\nновые входы — с понедельника\nИТОГ: стоп-неделя"
    else
        [a1, a2, a3, a4, a5, a6, a7] = f_decide(thr)
        v5_vd  := a1
        v5_dd  := a2
        v5_en  := a3
        v5_sl_ := a4
        v5_tp_ := a5
        v5_rr_ := a6
        v5_chk := a7
        // фильтр режима: лонг в боковике D3 → пропуск (прошёл walk-forward, +26R OOS)
        if use_regfilt and v5_vd == "ВХОД" and v5_dd == "LONG" and d3_state == 0
            v5_vd  := "режим БОК+LONG"
            v5_chk := a7 + "\n─────\nФИЛЬТР РЕЖИМА: лонг в БОКОВИКЕ (D3)\nлонги в боковике на золоте: -33R за 9 лет\nпропуск (walk-forward +26R OOS)\nИТОГ: пропуск по режиму"

// балл качества входа на этом баре — для цвета точки и для алерта
int v9_q = na
if not na(v5_dd) and v5_dd != ""
    [qq, q1_, q2_, q3_] = w_score(v5_dd == "LONG")
    v9_q := qq

// память для таблицы
var string last_chk  = "—"
var int    last_time = na
if not na(v5_vd)
    last_chk  := v5_chk
    last_time := time

// вход
if v5_vd == "ВХОД"
    array.push(P_long, v5_dd == "LONG")
    array.push(P_en,  v5_en)
    array.push(P_sl,  v5_sl_)
    array.push(P_tp,  v5_tp_)
    array.push(P_bar, bar_index)
    array.push(P_tim, time)
    if show_lines and in_line
        array.push(P_lnen, line.new(bar_index, v5_en,  bar_index + 1, v5_en,  color=color.new(color.blue,  0), width=2))
        array.push(P_lnsl, line.new(bar_index, v5_sl_, bar_index + 1, v5_sl_, color=color.new(color.red,   0), width=2))
        array.push(P_lntp, line.new(bar_index, v5_tp_, bar_index + 1, v5_tp_, color=color.new(color.green, 0), width=2))
    else
        array.push(P_lnen, line(na))
        array.push(P_lnsl, line(na))
        array.push(P_lntp, line(na))

// Алерт на вход. alertcondition оставлен для совместимости со старыми
// оповещениями, alert() шлёт живой текст с ценами и баллом качества.
alertcondition(v5_vd == "ВХОД", "Движок: ВХОД", "Движок: валидный вход")
if v5_vd == "ВХОД"
    alert(syminfo.ticker + " " + timeframe.period + "  ВХОД " + v5_dd +
          "\nцена " + str.tostring(v5_en, format.mintick) +
          "  стоп " + str.tostring(v5_sl_, format.mintick) +
          "  цель " + str.tostring(v5_tp_, format.mintick) +
          "\nRR " + str.tostring(v5_rr_, "#.##") + "   качество " + str.tostring(v9_q) + "/3" +
          "\n5/5 " + w_trend(L5) + "   2/2 " + w_trend(L2),
          alert.freq_once_per_bar_close)

// ══════════════ ТОЧКИ ══════════════
// Было девять цветов по причине отказа. Причина всё равно читается в
// тултипе, а девять цветов на графике не читаются. Теперь цвет говорит
// про КАЧЕСТВО входа, а размер — про уверенность.
//   балл 3  крупная ярко-зелёная
//   балл 2  зелёная
//   балл 0-1 приглушённая жёлтая
//   пропуск  одна серая точка, причина в тултипе
gT = "Точки"
col_q3   = input.color(#00e676, "Вход · балл 3", group=gT)
col_q2   = input.color(#00b050, "Вход · балл 2", group=gT)
col_q1   = input.color(#ffd54f, "Вход · балл 0-1", group=gT)
col_skip = input.color(color.new(color.gray, 60), "Пропуск", group=gT)

c_entry = v5_vd == "ВХОД"
c_ban   = not na(v5_vd) and str.startswith(v5_vd, "запрет")
c_trend = v5_vd == "против тренда"
c_knee  = v5_vd == "колена"
c_slom  = v5_vd == "слом"
c_frz   = v5_vd == "заморозка"
c_big   = v5_vd == "бол.свеча"
c_norr  = v5_vd == "нет RR"
c_wsb   = v5_vd == "стоп-неделя"
c_regf  = v5_vd == "режим БОК+LONG"
c_other = not na(v5_vd) and not (c_entry or c_ban or c_trend or c_knee or c_slom or c_frz or c_big or c_norr or c_wsb or c_regf)

f_dotcol() =>
    c_entry ? (v9_q >= 3 ? col_q3 : v9_q == 2 ? col_q2 : col_q1) : col_skip

f_dotsz() =>
    c_entry ? (v9_q >= 3 ? size.normal : v9_q == 2 ? size.small : size.tiny) : size.tiny

if show_tips and in_tip and not na(v5_vd) and ((c_entry and show_entry) or (not c_entry and show_skip))
    label.new(bar_index, na, "", yloc=yloc.belowbar, style=label.style_circle, color=f_dotcol(), size=f_dotsz(), tooltip=v5_chk)

no_tip = not show_tips or not in_tip
q_ok  = c_entry and v9_q >= 3
q_mid = c_entry and v9_q == 2
q_low = c_entry and v9_q <= 1

plotshape(no_tip and show_entry and q_ok,  title="Вход · балл 3",   style=shape.circle, location=location.belowbar, color=col_q3, size=size.normal)
plotshape(no_tip and show_entry and q_mid, title="Вход · балл 2",   style=shape.circle, location=location.belowbar, color=col_q2, size=size.small)
plotshape(no_tip and show_entry and q_low, title="Вход · балл 0-1", style=shape.circle, location=location.belowbar, color=col_q1, size=size.tiny)
plotshape(no_tip and show_skip and not c_entry and not na(v5_vd), title="Пропуск", style=shape.circle, location=location.belowbar, color=col_skip, size=size.tiny)

// старая раскладка по причине — если переключить режим
// ══════════════ УРОВНИ HH/LL: ЖИВЫЕ, N БЛИЖАЙШИХ ══════════════
// Хранилища живых уровней (цена + бар пивота). Пробитый уровень умирает.
var float[] hh1_p = array.new_float()
var int[]   hh1_b = array.new_int()
var float[] ll1_p = array.new_float()
var int[]   ll1_b = array.new_int()

var float[] lh1_p = array.new_float()
var int[]   lh1_b = array.new_int()
var float[] hl1_p = array.new_float()
var int[]   hl1_b = array.new_int()

if not na(higherhigh)
    array.push(hh1_p, ph_value)
    array.push(hh1_b, bar_index - 2)
if not na(lowerlow)
    array.push(ll1_p, pl_value)
    array.push(ll1_b, bar_index - 2)
if not na(lowerhigh)
    array.push(lh1_p, ph_value)
    array.push(lh1_b, bar_index - 2)
if not na(higherlow)
    array.push(hl1_p, pl_value)
    array.push(hl1_b, bar_index - 2)

// 4H и 1D через request.security (как в v7, lookahead_off)
ph4 = request.security(syminfo.tickerid, "240", ta.pivothigh(high, 2, 2), lookahead=barmerge.lookahead_off)
pl4 = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  2, 2), lookahead=barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[2], lookahead=barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[2],  lookahead=barmerge.lookahead_off)
v14 = ta.valuewhen(not na(ph4), ph4v, 1)
v24 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : v14 < v24 ? ph4 : na
lh4 = na(ph4) ? na : v14 > v24 ? ph4 : na
v34 = ta.valuewhen(not na(pl4), pl4v, 1)
v44 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : v34 > v44 ? pl4 : na
hl4 = na(pl4) ? na : v34 < v44 ? pl4 : na

phd = request.security(syminfo.tickerid, "D", ta.pivothigh(high, 2, 2), lookahead=barmerge.lookahead_off)
pld = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  2, 2), lookahead=barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[2], lookahead=barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[2],  lookahead=barmerge.lookahead_off)
v1d = ta.valuewhen(not na(phd), phdv, 1)
v2d = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : v1d < v2d ? phd : na
lhd = na(phd) ? na : v1d > v2d ? phd : na
v3d = ta.valuewhen(not na(pld), pldv, 1)
v4d = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : v3d > v4d ? pld : na
hld = na(pld) ? na : v3d < v4d ? pld : na

var float[] hh4_p = array.new_float()
var int[]   hh4_b = array.new_int()
var float[] ll4_p = array.new_float()
var int[]   ll4_b = array.new_int()
var float[] hhd_p = array.new_float()
var int[]   hhd_b = array.new_int()
var float[] lld_p = array.new_float()
var int[]   lld_b = array.new_int()

var float[] lh4_p = array.new_float()
var int[]   lh4_b = array.new_int()
var float[] hl4_p = array.new_float()
var int[]   hl4_b = array.new_int()
var float[] lhd_p = array.new_float()
var int[]   lhd_b = array.new_int()
var float[] hld_p = array.new_float()
var int[]   hld_b = array.new_int()

if not na(hh4) and hh4 != nz(hh4[1])
    array.push(hh4_p, hh4)
    array.push(hh4_b, bar_index)
if not na(ll4) and ll4 != nz(ll4[1])
    array.push(ll4_p, ll4)
    array.push(ll4_b, bar_index)
if not na(lh4) and lh4 != nz(lh4[1])
    array.push(lh4_p, lh4)
    array.push(lh4_b, bar_index)
if not na(hl4) and hl4 != nz(hl4[1])
    array.push(hl4_p, hl4)
    array.push(hl4_b, bar_index)
if not na(hhd) and hhd != nz(hhd[1])
    array.push(hhd_p, hhd)
    array.push(hhd_b, bar_index)
if not na(lld) and lld != nz(lld[1])
    array.push(lld_p, lld)
    array.push(lld_b, bar_index)
if not na(lhd) and lhd != nz(lhd[1])
    array.push(lhd_p, lhd)
    array.push(lhd_b, bar_index)
if not na(hld) and hld != nz(hld[1])
    array.push(hld_p, hld)
    array.push(hld_b, bar_index)

// смерть пробитых (правило: уровень существует, пока не пробит)
f_purge(_p, _b, _isHH) =>
    i = 0
    while i < array.size(_p)
        if (_isHH and high >= array.get(_p, i)) or (not _isHH and low <= array.get(_p, i))
            array.remove(_p, i)
            array.remove(_b, i)
        else
            i += 1

f_purge(hh1_p, hh1_b, true)
f_purge(ll1_p, ll1_b, false)
f_purge(lh1_p, lh1_b, true)
f_purge(hl1_p, hl1_b, false)
f_purge(hh4_p, hh4_b, true)
f_purge(ll4_p, ll4_b, false)
f_purge(lh4_p, lh4_b, true)
f_purge(hl4_p, hl4_b, false)
f_purge(hhd_p, hhd_b, true)
f_purge(lld_p, lld_b, false)
f_purge(lhd_p, lhd_b, true)
f_purge(hld_p, hld_b, false)

// отрисовка: только на правом крае / курсоре replay, только N ближайших
var line[] lv_lines = array.new<line>()

f_draw_nearest(_p, _b, _col, _w, _style) =>
    if array.size(_p) > 0
        bool[] used = array.new_bool(array.size(_p), false)
        for k = 1 to lv_n
            best = -1
            bestd = 1.0e18
            for i = 0 to array.size(_p) - 1
                if not array.get(used, i)
                    d = math.abs(array.get(_p, i) - close)
                    if d < bestd
                        bestd := d
                        best := i
            if best >= 0
                array.set(used, best, true)
                // левый край не дальше буфера (2900 < max_bars_back 3000) — иначе в симуляторе
                // линия просит бар за пределами истории. Линия всё равно extend.right.
                x1 = math.max(array.get(_b, best), bar_index - 2900)
                array.push(lv_lines, line.new(x1, array.get(_p, best), bar_index, array.get(_p, best), color=color.new(_col, lv_transp), width=_w, style=_style, extend=extend.right))

if barstate.islast
    while array.size(lv_lines) > 0
        line.delete(array.pop(lv_lines))
    if show_lv1h
        f_draw_nearest(hh1_p, hh1_b, col_lvH, 1, line.style_dashed)
        f_draw_nearest(ll1_p, ll1_b, col_lvL, 1, line.style_dashed)
        if show_lvlh
            f_draw_nearest(lh1_p, lh1_b, col_lvH, 1, line.style_dotted)
            f_draw_nearest(hl1_p, hl1_b, col_lvL, 1, line.style_dotted)
    if show_lv4h
        f_draw_nearest(hh4_p, hh4_b, col_lvH, 2, line.style_dashed)
        f_draw_nearest(ll4_p, ll4_b, col_lvL, 2, line.style_dashed)
        if show_lvlh
            f_draw_nearest(lh4_p, lh4_b, col_lvH, 2, line.style_dotted)
            f_draw_nearest(hl4_p, hl4_b, col_lvL, 2, line.style_dotted)
    if show_lv1d
        f_draw_nearest(hhd_p, hhd_b, col_lvH, 3, line.style_dashed)
        f_draw_nearest(lld_p, lld_b, col_lvL, 3, line.style_dashed)
        if show_lvlh
            f_draw_nearest(lhd_p, lhd_b, col_lvH, 3, line.style_dotted)
            f_draw_nearest(hld_p, hld_b, col_lvL, 3, line.style_dotted)

// ══════════════ ТАБЛИЦА-ЧЕКЛИСТ ══════════════
tp_ = tbl_pos == "верх-право" ? position.top_right : tbl_pos == "верх-лево" ? position.top_left : tbl_pos == "низ-право" ? position.bottom_right : position.bottom_left
var table T = table.new(tp_, 3, 22, bgcolor=color.new(#000000, 15), border_width=1, border_color=color.new(color.gray, 70))

f_join(_arr) =>
    s = ""
    n = array.size(_arr)
    if n > 0
        for j = 0 to n - 1
            s := s + (j > 0 ? ">" : "") + array.get(_arr, j)
    s

// кандидат на вход по последней метке (правило движка) — не прогноз рынка:
// HL → лонг отката | LL → лонг дна | LH → шорт отката | HH → шорт вершины
f_dir(_lab) =>
    _lab == "HL" ? " → кандидат: лонг отката" : _lab == "LL" ? " → кандидат: лонг дна" : _lab == "LH" ? " → кандидат: шорт отката" : _lab == "HH" ? " → кандидат: шорт вершины" : ""

f_block(_row, _txt) =>
    table.cell(T, 0, _row, _txt, text_color=color.new(color.silver, 20), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_center, text_size=size.tiny)
    table.cell(T, 1, _row, "", bgcolor=color.new(#1a1a2e, 0), text_size=size.tiny)
    table.cell(T, 2, _row, "", bgcolor=color.new(#1a1a2e, 0), text_size=size.tiny)
    table.merge_cells(T, 0, _row, 2, _row)

// строка на всю ширину: подпись слева, значение через две колонки.
// Возвращает номер строки: merge_cells сам по себе void, и без возврата
// присваивание результата было бы ошибкой компиляции.
f_wide(_row) =>
    table.cell(T, 2, _row, "", text_size=size.small)
    table.merge_cells(T, 1, _row, 2, _row)
    _row

f_rowW(_r, _k, _v5, _c5, _v2, _c2, _tip) =>
    table.cell(T, 0, _r, _k, text_color=color.new(color.silver, 25), text_halign=text.align_left, text_size=size.small, tooltip=_tip)
    table.cell(T, 1, _r, _v5, text_color=_c5, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 2, _r, _v2, text_color=_c2, text_halign=text.align_left, text_size=size.small)
    _r

if show_tbl and barstate.islast
    hdrc = color.new(color.silver, 0)
    // ═══ БЛОК: ГДЕ МЫ v5 — ДВА СЛОЯ ═══
    table.cell(T, 0, 0, "━━  ГДЕ МЫ  ━━", text_color=color.new(color.silver, 5), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.tiny)
    table.cell(T, 1, 0, "5/5  медленный", text_color=color.new(color.aqua, 0), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.tiny)
    table.cell(T, 2, 0, "2/2  быстрый", text_color=color.new(color.aqua, 30), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.tiny)

    wcs5 = w_cstart(L5)
    wcs2 = w_cstart(L2)
    wcd5 = w_cdir(L5, wcs5)
    wcd2 = w_cdir(L2, wcs2)
    wcn5 = array.size(L5.KN) > 0 ? array.get(L5.KN, array.size(L5.KN) - 1) : -1
    wcn2 = array.size(L2.KN) > 0 ? array.get(L2.KN, array.size(L2.KN) - 1) : -1
    wlm5 = array.size(L5.KM) > 0 ? array.get(L5.KM, array.size(L5.KM) - 1) : 1
    wlm2 = array.size(L2.KM) > 0 ? array.get(L2.KM, array.size(L2.KM) - 1) : 1

    q1 = f_rowW(1, "тренд", w_trend(L5), w_trendC(L5), w_trend(L2), w_trendC(L2), "Тренд рождается на двух подряд метках колен одной стороны. Умирает, когда тело закрытого бара уходит за уровень глубже заданной доли импульсного колена.")
    q2 = f_rowW(2, "держится на", w_lvlTxt(L5), L5.inTrans or L5.lvlProv ? color.new(color.orange, 0) : color.white, w_lvlTxt(L2), L2.inTrans or L2.lvlProv ? color.new(color.orange, 0) : color.white, "Последний HL для восходящего, LH для нисходящего. «провиз» — уровень временный, настоящей метки ещё нет: после досрочного подтверждения тренд держится на уровне, пробой которого убил прошлый.")
    q3 = f_rowW(3, "запас", w_roomTxt(L5), w_roomC(L5), w_roomTxt(L2), w_roomC(L2), "Сколько хода осталось от цены до порога смерти, в импульсных коленах, и вероятность смерти тренда за 10 баров. Замер на 9675 барах живого тренда: меньше 0.25 импульса — 73% смертей, больше 2.0 — 1%. В среднем по рынку 16%.")
    q4 = f_rowW(4, "счёт", w_cntTxt(L5, wcn5, wcd5), wcd5 == 0 ? color.gray : w_col(wcd5), w_cntTxt(L2, wcn2, wcd2), wcd2 == 0 ? color.gray : w_col(wcd2), "Номер точки в действующем счёте и куда счёт смотрит. Нечётная точка — импульс, чётная — коррекция.")
    q5 = f_rowW(5, "счёт от", w_zeroTxt(L5, wcs5, wcd5), wcd5 == 0 ? color.gray : w_col(wcd5), w_zeroTxt(L2, wcs2, wcd2), wcd2 == 0 ? color.gray : w_col(wcd2), "Ноль счёта. HH у нисходящего и LL у восходящего — счёт РАЗВОРОТНЫЙ, стартует с вершины прошлого движения. LH или HL — ПРОДОЛЖЕНИЕ, рынок уже шёл в эту сторону. Разворотных примерно половина.")
    q6 = f_rowW(6, "цепочка", w_chainCur(L5, wcs5, 4), wcd5 == 0 ? color.gray : w_col(wcd5), w_chainCur(L2, wcs2, 4), wcd2 == 0 ? color.gray : w_col(wcd2), "Метки колен действующего счёта. Черта отбивает ноль: слева хвост прошлого счёта, справа действующий.")
    q7 = f_rowW(7, "чистота", w_mudTxt(L5, wcs5), wlm5 >= 2 ? color.new(#ff9800, 0) : color.new(color.silver, 30), w_mudTxt(L2, wcs2), wlm2 >= 2 ? color.new(#ff9800, 0) : color.new(color.silver, 30), "Мутное колено собрано из двух и более меток: первая появилась, была перебита, цена сделала второй экстремум. Это и есть манипуляция. Около 21% колен на 5/5 и 23% на 2/2. ВАЖНО: как предсказатель НЕ работает — связь «мутных больше, тренд живёт дольше» оказалась тавтологией и исчезла при нормировке.")
    q8 = f_rowW(8, "пауза", w_pauseTxt(L5), L5.inTrans ? color.new(color.orange, 0) : color.gray, w_pauseTxt(L2), L2.inTrans ? color.new(color.orange, 0) : color.gray, "После смерти тренда ждём две новые метки колен. Второй путь — рывок: цена ушла от уровня смерти дальше заданной доли импульса И структура согласна.")

    // ── СВЯЗЬ СЛОЁВ ──
    // Замер на 172 разворотах 2/2 за два года:
    //   развернулся ПО 5/5     — старший сломался за 10 баров в  1%
    //   развернулся ПРОТИВ 5/5 —                                30%
    // Разделяет ЗАПАС старшего, а не номер точки его счёта:
    //   меньше 0.5 импульса — 54%,  0.5-1.0 — 11%,  больше 1.0 — 0%
    wt5 = L5.inTrans ? 0 : L5.tr
    wt2 = L2.inTrans ? 0 : L2.tr
    wr5 = w_room(L5)
    string wlk = "—"
    color  wlc = color.gray
    if wt5 == 0 or wt2 == 0
        wlk := "слой не определён — ждём"
        wlc := color.new(color.orange, 0)
    else if wt5 == wt2
        wlk := "СОГЛАСНЫ · старший ломается за 10 баров в 1% случаев"
        wlc := w_col(wt5)
    else
        wrisk = na(wr5) ? "запас старшего неизвестен" : wr5 < 0.5 ? "запас старшего " + str.tostring(wr5, "#.##") + " · старший ломается в 54% за 10 баров" : wr5 < 1.0 ? "запас старшего " + str.tostring(wr5, "#.##") + " · 11% за 10 баров" : "запас старшего " + str.tostring(wr5, "#.##") + " · 0% за два года — против старшего это ловушка"
        wlk := "2/2 ПРОТИВ 5/5 · " + wrisk
        wlc := na(wr5) ? color.gray : wr5 < 0.5 ? color.new(color.red, 0) : wr5 < 1.0 ? color.new(color.orange, 0) : color.lime
    table.cell(T, 0, 9, "СВЯЗЬ", text_color=color.new(color.silver, 5), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.small, tooltip="Разворот 2/2 против 5/5 — сильный сигнал: старший ломается за 10 баров в 30% случаев против 1%, когда слои согласны. Разделяет ЗАПАС старшего, а не номер точки его счёта — это проверено, разницы по точкам нет.")
    table.cell(T, 1, 9, wlk, text_color=wlc, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(T, 2, 9, "", bgcolor=color.new(#1a1a2e, 0), text_size=size.small)
    table.merge_cells(T, 1, 9, 2, 9)

    // ═══ БЛОК: ДВИЖОК ═══
    f_block(10, "━━  ДВИЖОК  ━━")
    // 11: быстрые метки (порог свечи — в tooltip)
    t5 = f_tail(5)
    n_f = array.size(q_lab)
    dir_f = n_f > 0 ? f_dir(array.get(q_lab, n_f - 1)) : ""
    table.cell(T, 0, 11, "Метки 2/2 (5)", text_color=hdrc, text_halign=text.align_left, text_size=size.small, tooltip="Решающие метки движка. Порог размера свечи: " + (na(thr) ? "мало данных" : str.tostring(thr, "#.###") + "%"))
    table.cell(T, 1, 11, t5 == "" ? "—" : t5 + dir_f, text_color=color.yellow, text_halign=text.align_left, text_size=size.small)
    // 12: структура — чистая / мутная (мутная = зона хотелок)
    n_q = array.size(q_lab)
    up_t = 0
    dn_t = 0
    slom_t = false
    if n_q > 0
        for j = 0 to n_q - 1
            lb = array.get(q_lab, j)
            up_t += lb == "HH" or lb == "HL" ? 1 : 0
            dn_t += lb == "LH" or lb == "LL" ? 1 : 0
            if j > 0
                a = array.get(q_lab, j - 1)
                if (a == "HH" and lb == "LL") or (a == "LL" and lb == "HL")
                    slom_t := true
    strtxt = slom_t ? "МУТНАЯ (слом в пятёрке) — зона хотелок" : up_t >= 4 ? "чистая: тренд вверх " + str.tostring(up_t) + "/5" : dn_t >= 4 ? "чистая: тренд вниз " + str.tostring(dn_t) + "/5" : "смешанная (вверх " + str.tostring(up_t) + " / вниз " + str.tostring(dn_t) + ")"
    strcol = slom_t ? color.new(color.red, 0) : (up_t >= 4 or dn_t >= 4) ? color.lime : color.new(color.orange, 0)
    table.cell(T, 0, 12, "Структура", text_color=hdrc, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 12, strtxt, text_color=strcol, text_halign=text.align_left, text_size=size.small)
    // 13: запрет сейчас — предупреждение ДО триггера
    bantxt = str.endswith(t5, "LL>HH") ? "…LL>HH → шорт от HH запрещён" : str.endswith(t5, "HH>LH") ? "…HH>LH → шорт от LH запрещён" : str.endswith(t5, "LL>LH>HL") ? "…LL>LH>HL → лонг от HL запрещён" : str.endswith(t5, "HH>LL>LL") ? "…HH>LL>LL → лонг от LL запрещён" : "нет"
    table.cell(T, 0, 13, "Запрет сейчас", text_color=hdrc, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 13, bantxt, text_color=bantxt == "нет" ? color.gray : color.new(color.red, 0), text_halign=text.align_left, text_size=size.small)
    w11 = f_wide(11)
    w12 = f_wide(12)
    w13 = f_wide(13)

    // 14: чек-лист (время триггера — в заголовке)
    chk_hdr = "Чек-лист" + (na(last_time) ? "" : " " + str.format_time(last_time, "dd.MM HH:mm", tbl_tz))
    table.cell(T, 0, 14, chk_hdr, text_color=hdrc, text_halign=text.align_left, text_valign=text.align_top, text_size=size.small)
    table.cell(T, 1, 14, last_chk, text_color=color.new(color.aqua, 0), text_halign=text.align_left, text_size=size.small)
    // 15: позиции
    table.cell(T, 0, 15, "Позиции", text_color=hdrc, text_halign=text.align_left, text_size=size.small)
    np_ = array.size(P_en)
    postxt = np_ == 0 ? "нет" : str.tostring(np_) + " шт | посл: " + (array.get(P_long, np_ - 1) ? "LONG " : "SHORT ") + str.tostring(array.get(P_en, np_ - 1), format.mintick) + " | SL " + str.tostring(array.get(P_sl, np_ - 1), format.mintick) + " | TP " + str.tostring(array.get(P_tp, np_ - 1), format.mintick)
    table.cell(T, 1, 15, postxt, text_color=np_ > 0 ? color.white : color.gray, text_halign=text.align_left, text_size=size.small)
    // ═══ БЛОК: РИСК ═══
    f_block(16, "━━  РИСК  ━━")
    // Все периоды считаются по времени ВХОДА сделки. Ориентиры в тултипах —
    // прогон эталонного движка на 261 сделке за два года, research/risk_check.py.
    [dR, dN] = w_sumR("D")
    [wR, wN] = w_sumR("W")
    [mR, mN] = w_sumR("M")
    ws_hit = use_ws and wR <= -ws_r

    // 17: день
    dtxt = str.tostring(dN) + " сд · " + (dR >= 0 ? "+" : "") + str.tostring(dR, "#.#") + "R"
    table.cell(T, 0, 17, "День", text_color=hdrc, text_halign=text.align_left, text_size=size.small, tooltip="За два года: 174 дня со сделками, медиана 1 сделка в день, максимум 5. Медиана дня −1.0R, в плюсе только 27% дней. Худший день −4.0R, лучший +13.1R. Минусовый день — норма, а не сбой.")
    table.cell(T, 1, 17, dtxt, text_color=dR > 0 ? color.lime : dR < 0 ? color.new(color.orange, 0) : color.gray, text_halign=text.align_left, text_size=size.small)

    // 18: неделя и предохранитель
    wtxt = str.tostring(wN) + " сд · " + (wR >= 0 ? "+" : "") + str.tostring(wR, "#.#") + "R" + (use_ws ? (ws_hit ? "  |  ПРЕДОХРАНИТЕЛЬ — до пн" : "  |  стоп при −" + str.tostring(ws_r, "#.#") + "R") : "  |  предохранитель выкл")
    table.cell(T, 0, 18, "Неделя", text_color=hdrc, text_halign=text.align_left, text_size=size.small, tooltip="За два года: 91 неделя со сделками, медиана 2 сделки. Медиана недели −1.0R, в плюсе 44% недель. Худшая −7.0R, лучшая +13.6R. Пять процентов худших недель ниже −4.0R — на это и настроен предохранитель.")
    table.cell(T, 1, 18, wtxt, text_color=ws_hit ? color.new(color.red, 0) : wR > 0 ? color.lime : wR < 0 ? color.new(color.orange, 0) : color.gray, text_halign=text.align_left, text_size=size.small)

    // 19: месяц
    mtxt = str.tostring(mN) + " сд · " + (mR >= 0 ? "+" : "") + str.tostring(mR, "#.#") + "R"
    table.cell(T, 0, 19, "Месяц", text_color=hdrc, text_halign=text.align_left, text_size=size.small, tooltip="За два года: 26 месяцев, медиана 10 сделок. Медиана месяца +1.2R, в плюсе 58% месяцев. Худший −8.1R, лучший +15.0R. Месяц — первый период, где медиана становится положительной.")
    table.cell(T, 1, 19, mtxt, text_color=mR > 0 ? color.lime : mR < 0 ? color.new(color.orange, 0) : color.gray, text_halign=text.align_left, text_size=size.small)

    // 20: всего и просадка
    float rall = 0.0
    float peak = 0.0
    float cum  = 0.0
    float ddmx = 0.0
    if array.size(R_val) > 0
        for i = 0 to array.size(R_val) - 1
            cum += array.get(R_val, i)
            peak := math.max(peak, cum)
            ddmx := math.max(ddmx, peak - cum)
        rall := cum
    ddnow = peak - cum
    atxt = str.tostring(array.size(R_val)) + " сд · " + (rall >= 0 ? "+" : "") + str.tostring(rall, "#.#") + "R  |  просадка сейчас " + str.tostring(ddnow, "#.#") + "R из " + str.tostring(ddmx, "#.#") + "R макс"
    table.cell(T, 0, 20, "Всего", text_color=hdrc, text_halign=text.align_left, text_size=size.small, tooltip="Вся загруженная история графика. Ориентир за два года: 261 сделка, +29.3R, доля TP 20%, медианный RR у выигрышей 4.05. Максимальная просадка 21.1R. Если текущая просадка близка к максимальной — это не поломка, а рабочий режим системы с долей выигрышей в 20%.")
    table.cell(T, 1, 20, atxt, text_color=rall >= 0 ? color.lime : color.new(color.red, 0), text_halign=text.align_left, text_size=size.small)

    // 21: серия стопов
    int streak = 0
    if array.size(R_val) > 0
        for i = array.size(R_val) - 1 to 0
            if array.get(R_val, i) == -1.0
                streak += 1
            else
                break
    sertxt = str.tostring(streak) + " SL подряд"
    table.cell(T, 0, 21, "Серия", text_color=hdrc, text_halign=text.align_left, text_size=size.small, tooltip="Стопы подряд. За два года: 40 серий, медиана 4, девяностый перцентиль 13, максимум 19. Серия из 13 стопов — обычное дело, а не повод менять систему.")
    table.cell(T, 1, 21, sertxt, text_color=streak >= 13 ? color.new(color.red, 0) : streak >= 8 ? color.new(color.orange, 0) : color.gray, text_halign=text.align_left, text_size=size.small)

    w14 = f_wide(14)
    w15 = f_wide(15)
    w17 = f_wide(17)
    w18 = f_wide(18)
    w19 = f_wide(19)
    w20 = f_wide(20)
    w21 = f_wide(21)

// ══════════════ ЗИГ-ЗАГ (логика v3, окно N баров) ══════════════
to_up_zz = high >= ta.highest(zz_len)
to_dn_zz = low  <= ta.lowest(zz_len)

var int zz_trend = 1
zz_trend := nz(zz_trend[1], 1)
zz_trend := zz_trend == 1 and to_dn_zz ? -1 : zz_trend == -1 and to_up_zz ? 1 : zz_trend

last_up_since = ta.barssince(to_up_zz[1])
last_dn_since = ta.barssince(to_dn_zz[1])

zz_low_val  = ta.lowest (nz(last_up_since > 0 ? last_up_since : 1, 1))
zz_high_val = ta.highest(nz(last_dn_since > 0 ? last_dn_since : 1, 1))

zz_low_bar  = bar_index - ta.barssince(zz_low_val  == low)
zz_high_bar = bar_index - ta.barssince(zz_high_val == high)

var float zz_prev_val = na
var int   zz_prev_bar = na

in_zz = last_bar_index - bar_index <= zz_bars
if ta.change(zz_trend) != 0
    if zz_trend == 1
        if show_zz and not na(zz_prev_val) and in_zz
            line.new(zz_prev_bar, zz_prev_val, zz_low_bar, zz_low_val, color=zz_low_val > zz_prev_val ? color.new(color.green, 0) : color.new(color.red, 0), width=zz_width)
        zz_prev_val := zz_low_val
        zz_prev_bar := zz_low_bar
    if zz_trend == -1
        if show_zz and not na(zz_prev_val) and in_zz
            line.new(zz_prev_bar, zz_prev_val, zz_high_bar, zz_high_val, color=zz_high_val > zz_prev_val ? color.new(color.green, 0) : color.new(color.red, 0), width=zz_width)
        zz_prev_val := zz_high_val
        zz_prev_bar := zz_high_bar
