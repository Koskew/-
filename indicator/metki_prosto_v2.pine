var string[] L2 = array.new_string()
var int[]    M2 = array.new_int()
var float[]  G2 = array.new_float()
var int[]    Y2 = array.new_int()
var bool[]   Z2 = array.new_bool()
var string[] W2 = array.new_string()

// ── ПЕРЕВЁРНУТЫЕ КОЛЕНА ──
// Те же пивоты, поданные в ту же f_push с МИНУС-ЦЕНОЙ и перевёрнутой
// стороной. Пивот-вершина на перевёрнутых это пивот-низ на настоящих,
// тот же бар. Слияние и подписи получаются зеркальными сами: HH здесь
// значит LL там, HL значит LH. Отдельного кода нет и не будет.
var float[]  P5n = array.new_float()
var int[]    B5n = array.new_int()
var bool[]   H5n = array.new_bool()
var string[] L5n = array.new_string()
var int[]    M5n = array.new_int()
var float[]  G5n = array.new_float()
var int[]    Y5n = array.new_int()
var bool[]   Z5n = array.new_bool()
var string[] W5n = array.new_string()

var float[]  P3n = array.new_float()
var int[]    B3n = array.new_int()
var bool[]   H3n = array.new_bool()
var string[] L3n = array.new_string()
var int[]    M3n = array.new_int()
var float[]  G3n = array.new_float()
var int[]    Y3n = array.new_int()
var bool[]   Z3n = array.new_bool()
var string[] W3n = array.new_string()

var float[]  P2n = array.new_float()
var int[]    B2n = array.new_int()
var bool[]   H2n = array.new_bool()
var string[] L2n = array.new_string()
var int[]    M2n = array.new_int()
var float[]  G2n = array.new_float()
var int[]    Y2n = array.new_int()
var bool[]   Z2n = array.new_bool()
var string[] W2n = array.new_string()

// ── КОЛЕНА СЛОЁВ 5/5 и 3/3: свои пивоты ПЛЮС вставки СОСЕДА ──
// Вставки внутри самих колен слоя, и по ним считается всё: счёт,
// уровень, смерть, зиг-заг, справочник. Доза — ручки из ⑧, положение
// «0» в точности воспроизводит прежние колена без вставок.
//
// Запаздывание честное: вставка кладётся в цепочку с ТЕМ ЖЕ лагом, что и
// колено слоя, а не со своим. Иначе колено слоя, случившееся раньше,
// встанет в зиг-заг позже вставки и сломает чередование.
var float[]  PV5 = array.new_float()
var int[]    BV5 = array.new_int()
var bool[]   HV5 = array.new_bool()
var string[] LV5 = array.new_string()
var int[]    MV5 = array.new_int()
var float[]  GV5 = array.new_float()
var int[]    YV5 = array.new_int()
var bool[]   ZV5 = array.new_bool()
var string[] WV5 = array.new_string()

var float[]  PV3 = array.new_float()
var int[]    BV3 = array.new_int()
var bool[]   HV3 = array.new_bool()
var string[] LV3 = array.new_string()
var int[]    MV3 = array.new_int()
var float[]  GV3 = array.new_float()
var int[]    YV3 = array.new_int()
var bool[]   ZV3 = array.new_bool()
var string[] WV3 = array.new_string()

var float[]  PV5n = array.new_float()
var int[]    BV5n = array.new_int()
var bool[]   HV5n = array.new_bool()
var string[] LV5n = array.new_string()
var int[]    MV5n = array.new_int()
var float[]  GV5n = array.new_float()
var int[]    YV5n = array.new_int()
var bool[]   ZV5n = array.new_bool()
var string[] WV5n = array.new_string()

var float[]  PV3n = array.new_float()
var int[]    BV3n = array.new_int()
var bool[]   HV3n = array.new_bool()
var string[] LV3n = array.new_string()
var int[]    MV3n = array.new_int()
var float[]  GV3n = array.new_float()
var int[]    YV3n = array.new_int()
var bool[]   ZV3n = array.new_bool()
var string[] WV3n = array.new_string()

// сколько вставок уже взято в ТЕКУЩЕЙ ноге каждого из четырёх комплектов
var int[] VCN = array.new_int(4, 0)
// сколько вставок реально СТАЛО коленом. 0 — 5/5 настоящий мир,
// 1 — 3/3 настоящий, 2 — 5/5 перевёрнутый, 3 — 3/3 перевёрнутый
var int[] VINS = array.new_int(4, 0)
// ОТКАЗ, правило §33. Слою понадобилась ЛИШНЯЯ чужая метка: донор
// колено дал, чередование позволяет, а доза израсходована. Это не
// нехватка дозы — это сигнал «слой смотрит не на свой тренд».
// Снимается, как только слой поставит СВОЁ колено
var bool[] VREF = array.new_bool(4, false)
// ПРЕДВАРИТЕЛЬНОЕ КОЛЕНО живого края, правило З31. Индекс колена донора
// ПОСЛЕ последнего колена слоя, чередующегося с ним. -1 если нет.
// Порядок тот же: 0 это 5/5, 1 это 3/3, 2 и 3 — перевёрнутые
var int[] VPRE = array.new_int(4, -1)

// З22, 29.09.2026. Вставка, совпадающая по стороне с последним коленом
// цепочки, в счёт идти НЕ должна. f_push такую не добавляет, а ПОГЛОЩАЕТ:
// колено не появляется, счёт не шагает, а цена колена самого слоя может
// ещё и сдвинуться на вставку.
//
// ОШИБКА 29.09.2026, RE10045 на баре 0. Сначала было написано
// `n == 0 or array.get(_H, n - 1) != _hi`. Пайн НЕ обрывает `or`: он
// считает обе половины, и при пустом массиве array.get(_H, -1) падает.
// Сторож пишется только через `if`.
f_altOk(_H, _hi) =>
    n = array.size(_H)
    bool r = true
    if n > 0
        r := array.get(_H, n - 1) != _hi
    r

// ПОЧИНКА ЗЕРКАЛА, З36, 07.10.2026.
//
// У вершины сравнение строгое, у низа — НЕСТРОГОЕ. Это не опечатка и не
// вторая ветка кода: `>` не симметрично при перевороте знака, когда
// значения РАВНЫ. Неравенство переворачивается, равенство — нет.
//
//   настоящий мир:   вершина равна прошлой  →  не перебила  →  LH
//   перевёрнутый:    низ равен прошлому     →  удержал      →  HL
//
// А HL и есть зеркало LH. Поставь один оператор на обе стороны — и
// зеркало сломается с той или с другой: `>` везде даёт LH/LL, `>=`
// везде даёт HH/HL. Нужно, чтобы ничья у ВЕРШИНЫ и ничья у НИЗА
// читались зеркально, а зеркало меняет СТОРОНУ — значит и оператор
// обязан зависеть от стороны. Сторона это не направление, поэтому
// запрет «второй ветки кода» от 01.10.2026 не нарушен.
//
// По-человечески: ничья значит «ничего не произошло». Равная вершина
// НЕ ПЕРЕБИЛА, равный низ УДЕРЖАЛ.
//
// Проверено research/zerkalo_check.py: было 2–5 расхождений на
// 7–11 тысяч колен, стало 0 на всех трёх слоях и на всех данных.
f_lab(_hi, _cur, _prev) =>
    na(_prev) ? "?" : _hi ? (_cur > _prev ? "HH" : "LH") : (_cur >= _prev ? "HL" : "LL")

f_relabel(_P, _H, _L) =>
    array.clear(_L)
    n = array.size(_P)
    if n > 0
        for i = 0 to n - 1
            hi = array.get(_H, i)
            float prev = na
            j = i - 1
            while j >= 0
                if array.get(_H, j) == hi
                    prev := array.get(_P, j)
                    break
                j -= 1
            array.push(_L, f_lab(hi, array.get(_P, i), prev))
    n

// Метка, которая проявилась, не должна пропадать. При слиянии двух
// пивотов одной стороны проигравший уходит в список поглощённых и
// остаётся видимым на своём месте. Подпись считается от ПРЕДЫДУЩЕГО
// колена той же стороны, а не от того, в которое метка влилась.
f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi) =>
    n = array.size(_P)
    float prev = na
    j = n - 2
    while j >= 0
        if array.get(_H, j) == _hi
            prev := array.get(_P, j)
            break
        j -= 1
    array.push(_G, _price)
    array.push(_Y, _bar)
    array.push(_Z, _hi)
    array.push(_W, f_lab(_hi, _price, prev))
    if array.size(_G) > MAXK
        array.shift(_G)
        array.shift(_Y)
        array.shift(_Z)
        array.shift(_W)
    0

f_push(_P, _B, _H, _L, _M, _G, _Y, _Z, _W, _price, _bar, _hi) =>
    n = array.size(_P)
    bool same = false
    if n > 0
        same := array.get(_H, n - 1) == _hi
    if same
        old = array.get(_P, n - 1)
        oldB = array.get(_B, n - 1)
        bool better = _hi ? _price > old : _price < old
        array.set(_M, n - 1, array.get(_M, n - 1) + 1)
        if better
            a1 = f_absorb(_G, _Y, _Z, _W, _P, _H, old, oldB, _hi)
            array.set(_P, n - 1, _price)
            array.set(_B, n - 1, _bar)
        else
            a2 = f_absorb(_G, _Y, _Z, _W, _P, _H, _price, _bar, _hi)
    else
        array.push(_P, _price)
        array.push(_B, _bar)
        array.push(_H, _hi)
        array.push(_M, 1)
        if array.size(_P) > MAXK
            array.shift(_P)
            array.shift(_B)
            array.shift(_H)
            array.shift(_M)
    d = f_relabel(_P, _H, _L)
    not same

// ══════════════ СКОЛЬЗЯЩЕЕ СРЕДНЕЕ КОЛЕНО СЛОЯ ══════════════
// Новая величина, §41. Средняя длина последних LEGWIN ног цепочки слоя.
//
// ЗАЧЕМ. Прежний порог смерти считался от ИМПУЛЬСА — последнего
// выросшего колена. Замер Н29: эта величина нигде не измерялась и гуляла
// в ШЕСТЬ раз, от 0.12 до 0.70 колена. Среднее колено ровнее и честнее.
//
// ПОЧЕМУ СКОЛЬЗЯЩЕЕ. Колено выросло в 10–14 раз за девять лет: 5.4
// пункта в начале, 77 в конце. Фиксированное число в пунктах к концу
// истории перестало бы что-либо значить.
//
// ПОЧЕМУ СВОЁ У КАЖДОГО СЛОЯ. Колена у слоёв разного размера по
// построению: 5/5 видит крупную структуру, 2/2 мелкую.
//
// ЗЕРКАЛО ЦЕЛО: берётся МОДУЛЬ разницы, а у перевёрнутых цен он тот же.
f_avgLeg(_P) =>
    n = array.size(_P)
    float s = 0.0
    int c = 0
    if n >= 2
        int from = math.max(1, n - LEGWIN)
        for i = from to n - 1
            s += math.abs(array.get(_P, i) - array.get(_P, i - 1))
            c += 1
    c > 0 ? s / c : 0.0

// ══════════════ ПРЕДВАРИТЕЛЬНОЕ КОЛЕНО ЖИВОГО КРАЯ ══════════════
// Правило З31, решено владельцем 05.10.2026 «так будет правильно»:
//
//   ЕСЛИ ЗИГ-ЗАГ НАРИСОВАЛ КОЛЕНО — СЧЁТ ЕГО БЕРЁТ.
//
// Жалоба была точная: «появилась сырая метка HL, которую зиг-заг
// правильно определил, а счёт пропустил... в таблице у слоя 5/5 должно
// быть уже 2 из 5, а не 1 из 5».
//
// ПРИЧИНА. Метка стоит ПОСЛЕ последней точки счёта — в ХВОСТЕ. Хвост
// рисует f_subTail, а она по устройству только РИСУЕТ, в цепочку ничего
// не кладёт. Положить туда нельзя: колено донора известно на 2 бара
// раньше, чем колено слоя, и вставка с чужим лагом встанет в зиг-заг
// не на своё место и сломает чередование.
//
// РЕШЕНИЕ. Колено не кладётся в цепочку, а живёт ОТДЕЛЬНО, одним
// слотом, и счёт его читает. Цена этого названа владельцу заранее и
// принята им:
//
//   · СЧЁТ его берёт — в табло и на графике номер появляется сразу;
//   · УРОВЕНЬ ЖДЁТ подтверждения своего слоя (правило У9). Иначе
//     уровень уехал бы на метку, которая имеет право исчезнуть, а
//     смерть по исчезнувшей линии отменить нельзя;
//   · ПОДТВЕРЖДЕНИЕ тоже ждёт: оно переводит штрих-пунктир в сплошную,
//     то есть делает разметку окончательной, а предварительному колену
//     этого делать нельзя по общему правилу показа от 05.10.
//
// Возвращает индекс колена донора или -1.
f_preOne(_B, _H, _fB, _fH) =>
    n = array.size(_B)
    int r = -1
    if n > 0
        xt = array.get(_B, n - 1)
        bool st = array.get(_H, n - 1)
        m = array.size(_fB)
        if m > 0
            for k = 0 to m - 1
                if array.get(_fB, k) > xt
                    if array.get(_fH, k) != st
                        r := k
                        break
    r

// ══════════════ ТРЕНД: ТРИ СЛОЯ, ДВА НАПРАВЛЕНИЯ ══════════════
// Состояние держится ПО СЛОЯМ. Индексы 0-2 — восходящий на 5/5, 3/3,
// 2/2. Индексы 3-5 — НИСХОДЯЩИЙ на тех же слоях, посчитанный ТЕМ ЖЕ
// движком на ПЕРЕВЁРНУТЫХ коленах. Сама f_trend об этом не знает и не
// должна: она работает по индексу, ей всё равно, какой мир ей подали.
//
// ВНИМАНИЕ: цены в ячейках 3-5 ОТРИЦАТЕЛЬНЫЕ — это перевёрнутый мир.
// Всё, что идёт на экран и в табло, переворачивается обратно.
//
// Бары держим числом, -1 значит «нет»: пайн капризен с na в массивах.
var int[]    tTR  = array.new_int(10, 0)        // состояние, ST_*
var int[]    tZB  = array.new_int(10, -1)       // бар колена-нуля
var float[]  tZP  = array.new_float(10, na)     // его цена
var string[] tZL  = array.new_string(10, "")    // его подпись
var float[]  tLVL = array.new_float(10, na)     // уровень — последний HL
var int[]    tLVB = array.new_int(10, -1)
var bool[]   tLHL = array.new_bool(10, false)   // уровень на настоящем HL
var int[]    tCNT = array.new_int(10, -1)       // номер последней точки
var int[]    tMAX = array.new_int(10, -1)       // докуда счёт дошёл
var float[]  tIMP = array.new_float(10, 0.0)    // импульсное колено
var float[]  tLEG = array.new_float(10, 0.0)    // скользящее среднее колено
var int[]    tRST = array.new_int(10, 0)        // полных счётов: сколько раз дошёл до (5) и продолжился
var bool[]   tLL  = array.new_bool(10, false)   // в счёте был низ LL — разбудил запасное подтверждение
var int[]    tEB  = array.new_int(10, -1)       // бар события, которым тренд кончился
// tBEL — закрытий подряд ниже уровня. Правило «N закрытий» отменено
// 06.10.2026 замером Н31: его вклад на одной линии с глубиной РОВНО
// НОЛЬ. Массив оставлен, потому что правило 4 запрещает убирать без
// спроса. Сейчас НЕ ЧИТАЕТСЯ НИГДЕ
var int[]    tBEL = array.new_int(10, 0)
// tPUP и tPMX заводились под правило «продолжение с (3)», которого в
// коде нет и не будет — путь А по З33, слово владельца 06.10.2026.
// Записываются при смерти, НЕ ЧИТАЮТСЯ НИГДЕ. Оставлены по правилу 4
var bool[]   tPUP = array.new_bool(10, false)
var int[]    tPMX = array.new_int(10, -1)
var float[]  tDP  = array.new_float(10, na)     // цена смерти
var int[]    tDB  = array.new_int(10, -1)       // бар смерти
var int[]    tBB  = array.new_int(10, -1)       // бар рождения
var int[]    tPZB = array.new_int(10, -1)       // ноль ПРОШЛОГО счёта
// перебитая вершина — от неё считается ЗАПАСНОЕ подтверждение У7
var float[]  tBP  = array.new_float(10, na)
var int[]    tBB2 = array.new_int(10, -1)
var int[]    tBAB = array.new_int(10, 0)        // закрытий подряд выше вершины

// ИСТОРИЯ СОБЫТИЙ, плоскими списками: бар, цена, слой.
// RD* — СМЕРТЬ. Красная чёрточка ставится ТОЛЬКО сюда: у отмены,
// отказа и архива следа на графике нет (§44, слово владельца «да,
// красная чёрточка только у смерти»).
// GD* — РОЖДЕНИЕ. Цена перебитой вершины. С графика убрана под галочку
// «Показывать рождение тренда», механизм работает всегда
var int[]   RDB = array.new_int()
var float[] RDP = array.new_float()
var int[]   RDL = array.new_int()
var int[]   GDB = array.new_int()
var float[] GDP = array.new_float()
var int[]   GDL = array.new_int()
var bool[]  GOK = array.new_bool()
MAXSL = 600

// ── ПЕРЕКЛЮЧЕНИЯ «АВТО» ──
// Счёт обоих направлений идёт ВСЕГДА, им управляют галочки в ⑦.
// Режим из ① выбирает только, кого НАРИСОВАТЬ. Поэтому тренд, на который
// «авто» переключилось, появляется уже со счётом, набранным пока был
// невидим. Здесь запоминается бар, на котором решение поменялось
var int[]  swB = array.new_int(3, -1)
var bool[] swD = array.new_bool(3, false)
var bool[] swI = array.new_bool(3, false)
// РЕЖИМ, а не флаг: 0 веду восходящий, 1 веду нисходящий, -1 никого.
// -2 значит «ещё не считали ни разу»
var int[]  SWM = array.new_int(3, -2)
var int[]  AWB = array.new_int()
var int[]  AWL = array.new_int()
var bool[] AWD = array.new_bool()
var float[] AWP = array.new_float()

// ══════════════ СПРАВОЧНИК ПОСЛЕДОВАТЕЛЬНОСТЕЙ ══════════════
// Перепись 9 лет часовика. Низы в восходящем всегда HL — иначе это не
// восходящий, — поэтому свободны только вершины и вариантов ровно
// восемь. Ноль пишется первым: LL у рождения, HL у продолжения.
// Индикатор НЕ предсказывает: он узнаёт форму и называет её номером,
// как шаблон триггерной свечи.
var string[] PAT = array.from("LH·HL·HH·HL·HH","LH·HL·HH·HL·LH","HH·HL·HH·HL·HH","HH·HL·HH·HL·LH","HH·HL·LH·HL·HH","LH·HL·LH·HL·HH","HH·HL·LH·HL·LH","LH·HL·LH·HL·LH")
var string[] PNM = array.from("П1","П5","П6","П12","П16","П20","П25","П29")
// [рождения 5/5, 3/3, 2/2, продолжения 5/5, 3/3, 2/2]
var int[] PFR = array.from(100,73,59,44,30,29,12,2, 133,95,96,67,71,38,31,13, 187,116,129,104,96,64,39,26, 51,29,137,92,65,3,15,1, 64,39,157,118,87,7,24,9, 113,60,208,166,135,17,34,3)
// Нумерация нисходящего ЗЕРКАЛЬНАЯ: С1 это зеркало П1. Строки PAT
// подходят как есть — в перевёрнутом мире нисходящий это буквально
// восходящий. Переводится обратно только то, что идёт на экран
var string[] SNM = array.from("С1","С5","С6","С12","С16","С20","С25","С29")
var int[] SFR = array.from(82,62,44,60,42,23,15,4, 97,90,75,76,69,40,28,14, 152,107,109,107,98,59,45,11, 30,28,72,78,48,3,16,0, 50,51,88,100,64,20,23,4, 76,56,123,156,95,18,46,10)

// подпись из перевёрнутого мира в настоящий: HH<->LL, HL<->LH
f_swap1(_x) =>
    _x == "HH" ? "LL" : _x == "LL" ? "HH" : _x == "HL" ? "LH" : _x == "LH" ? "HL" : _x

f_swapSeq(_s) =>
    string r = ""
    arr = str.split(_s, "·")
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            r := r + (i == 0 ? "" : "·") + f_swap1(array.get(arr, i))
    r

var table TBL = table.new(tblPos == "справа вверху" ? position.top_right : tblPos == "справа внизу" ? position.bottom_right : tblPos == "слева вверху" ? position.top_left : position.bottom_left, 4, 24, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 80))
tSz = tblSize == "мелкий" ? size.tiny : size.small

// последнее рождение слоя _i в истории, -1 если нет
f_lastG(_i) =>
    int r = -1
    n = array.size(GDL)
    if n > 0
        for k = n - 1 to 0
            if array.get(GDL, k) == _i
                r := k
                break
    r

// жив ли тренд в ячейке: считает и может дойти до (5)
f_living(_i) =>
    s = array.get(tTR, _i)
    s == ST_MAY or s == ST_LIVE

// ══════════════ УРОВЕНЬ ══════════════
// Уровень считается ОТ НУЛЯ ЗАНОВО на каждом новом колене, а не
// доставляется по шагу. Это и есть правило У1 плюс З0 одной функцией:
//
//   уровень = ПОСЛЕДНИЙ HL в цепочке, начиная с нуля включительно.
//   Такого нет — уровень на самом нуле, и он ВРЕМЕННЫЙ.
//
// Что это даёт даром:
// · У1 — новый HL заменяет прежний безусловно, храповика нет;
// · У2 — при рождении ноль это LL, HL ещё нет, уровень стоит на нуле и
//   помечен временным: тренду надо за что-то держаться с первой минуты,
//   иначе его нечем убить. Бессмертный тренд хуже опоры на LL;
// · У3 и М3 — манипуляционный низ LL уровень не обновляет: он не HL;
// · З0 и У4 — ВОЗВРАТ. Колено было HL, уровень на него переехал, потом
//   пришёл более низкий низ, колена слились, и колено стало LL. По
//   правилу владельца манипуляционное колено НИЧЕГО НЕ ДЕРЖИТ, значит
//   уровень обязан вернуться на предыдущий HL. При пересчёте от нуля
//   это происходит само, без отдельной ветки;
// · У9 — предварительное колено живого края уровнем не становится: его
//   в цепочке нет, он живёт отдельно;
// · У10 — продолжение после (5) получает НАСТОЯЩИЙ уровень сразу: его
//   ноль и есть HL.
//
// Уровень — ЖИВАЯ линия, указатель «держимся здесь», а не запись
// истории. Поэтому он имеет право и вернуться назад.
// Пишет результат прямо в tLVL / tLVB / tLHL, кортеж не возвращает:
// кортеж из тела функции — лишний риск там, где он не нужен.
f_lvlSet(_i, _P, _B, _H, _L, _zb) =>
    n = array.size(_P)
    int zi = -1
    if n > 0
        for k = 0 to n - 1
            if array.get(_B, k) >= _zb and not array.get(_H, k)
                zi := k
                break
    if zi >= 0
        float lp = array.get(_P, zi)
        int   lx = array.get(_B, zi)
        bool  real = array.get(_L, zi) == "HL"
        for k = zi to n - 1
            if not array.get(_H, k)
                if array.get(_L, k) == "HL"
                    lp := array.get(_P, k)
                    lx := array.get(_B, k)
                    real := true
        array.set(tLVL, _i, lp)
        array.set(tLVB, _i, lx)
        array.set(tLHL, _i, real)
        array.set(tBEL, _i, 0)
    zi

// Текущая последовательность слоя _i: подпись нуля и хвост от (1).
// Показывается у живого тренда и у АРХИВА: форма счёта состоялась, её
// номер — итог (§47)
f_seqNow(_P, _B, _H, _L, _i) =>
    string zlab = ""
    string tail = ""
    int np = 0
    s = array.get(tTR, _i)
    if (s == ST_MAY or s == ST_LIVE or s == ST_ARC) and array.get(tZB, _i) >= 0
        n = array.size(_P)
        int zi = -1
        if n > 0
            for k = 0 to n - 1
                // ноль ищется не только по бару, но и ПО СТОРОНЕ. Он всегда
                // НИЗ: LL при рождении, HL при продолжении. Большая свеча
                // умеет сделать и вершину, и низ сразу — тогда два колена
                // сидят на одном баре, и поиск «по бару» хватал вершину
                if array.get(_B, k) >= array.get(tZB, _i) and not array.get(_H, k)
                    zi := k
                    break
        if zi >= 0
            zlab := array.get(_L, zi)
            int last = math.min(zi + 5, n - 1)
            if last >= zi + 1
                for k = zi + 1 to last
                    tail := tail + (np == 0 ? "" : "·") + array.get(_L, k)
                    np += 1
    [zlab, tail, np]

// Сколько эталонов ещё подходят под этот хвост и как они называются
f_match(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(PNM, p)
    [cnt, idx, nms]

// То же, но имена из справочника НИСХОДЯЩЕГО. Строки PAT одни и те же
f_matchS(_tail) =>
    int cnt = 0
    int idx = -1
    string nms = ""
    for p = 0 to 7
        if str.startswith(array.get(PAT, p), _tail)
            cnt += 1
            idx := p
            nms := nms + (cnt == 1 ? "" : "/") + array.get(SNM, p)
    [cnt, idx, nms]

// ══════════════ ОДИН ШАГ ДВИЖКА ДЛЯ СЛОЯ _i ══════════════
// _o и _c — открытие и закрытие. Нисходящий зовёт функцию с -open и
// -close: иначе он на перевёрнутых коленах брал бы настоящую свечу и
// сравнивал её с перевёрнутым уровнем.
// _leg  — скользящее среднее колено ЭТОЙ цепочки.
// _ref  — слою понадобилась лишняя чужая метка (§33).
// _depth, _brk — глубина смерти и запасное подтверждение. У нисходящего
//   это ЗНАЧЕНИЯ, а не вторая ветка кода: движок один.
//
// ПОРЯДОК ВНУТРИ БАРА ВАЖЕН И ЗАДАН НАРОЧНО:
//   отказ → смерть и отмена → запасное подтверждение → колена.
// Смерть проверяется ДО колен, поэтому ничья «смерть или архив на одном
// баре» разрешается в пользу смерти — §36, правило детерминированное.
f_trend(_i, _P, _B, _H, _L, _nw, _fr, _o, _c, _leg, _ref, _depth, _brk) =>
    n = array.size(_P)
    // в ИСТОРИЮ событий цена кладётся НАСТОЯЩЕЙ: ячейки 3-5 живут в
    // перевёрнутом мире, и без этого чёрточки уехали бы под график
    float sg = _i >= 3 ? -1.0 : 1.0
    int st = array.get(tTR, _i)

    // ── 0. ОТКАЗ, §33 ──
    // «Слою разрешена ОДНА одолженная метка (столько, сколько стоит в
    // дозе). Пока она не израсходована — счёт ОБЯЗАН её взять (З31).
    // Как только понадобилась лишняя — слой ПЕРЕСТАЁТ считать этот
    // тренд.» Это НЕ смерть: тренд, возможно, идёт себе дальше, его
    // просто считает другой слой. Красная чёрточка соврала бы.
    if _ref
        // АРХИВ отказом НЕ перезаписывается: у отработавшего счёта
        // считать больше нечего, а «не свой» стёрло бы его результат.
        // Пока доза израсходована, цепочка всё равно не растёт — своё
        // колено её и разморозит, — поэтому архив просто ждёт
        if st == ST_MAY or st == ST_LIVE
            array.set(tTR,  _i, ST_REF)
            array.set(tEB,  _i, bar_index)
            array.set(tCNT, _i, -1)
            array.set(tLVL, _i, na)
            array.set(tRST, _i, 0)
            array.set(tLL,  _i, false)
            st := ST_REF
    else
        // слой поставил СВОЁ колено — возвращается к работе и с него
        // ищет рождение заново
        if st == ST_REF
            array.set(tTR, _i, ST_NO)
            st := ST_NO

    // ── 1. СМЕРТЬ и ОТМЕНА. Каждый бар, а не только на колене ──
    if st == ST_LIVE and not na(array.get(tLVL, _i))
        lv = array.get(tLVL, _i)
        // ПО ТЕЛУ, min(открытие, закрытие). Тень тренд НЕ убивает:
        // замер Н28, тело разделяет исходы в 4–6 раз, тень в 2.3–2.7
        bLo = math.min(_o, _c)
        array.set(tBEL, _i, _c < lv ? array.get(tBEL, _i) + 1 : 0)
        if bLo < lv - _depth * _leg
            array.set(tPUP, _i, true)
            array.set(tPMX, _i, array.get(tMAX, _i))
            array.set(tDP,  _i, lv)
            array.set(tDB,  _i, bar_index)
            array.set(tTR,  _i, ST_DEAD)
            array.set(tEB,  _i, bar_index)
            array.set(tCNT, _i, -1)
            array.set(tLVL, _i, na)
            array.set(tBEL, _i, 0)
            array.set(tBAB, _i, 0)
            array.set(tRST, _i, 0)
            array.set(tLL,  _i, false)
            st := ST_DEAD
            // КРАСНАЯ ЧЁРТОЧКА — только здесь. Метку рождения НЕ гасим:
            // она отмечает событие, которое БЫЛО, а событие не
            // отменяется тем, что тренд потом умер (С8)
            array.push(RDB, bar_index)
            array.push(RDP, lv * sg)
            array.push(RDL, _i)
            if array.size(RDB) > MAXSL
                array.shift(RDB)
                array.shift(RDP)
                array.shift(RDL)
    else if st == ST_MAY and not na(array.get(tLVL, _i))
        // ОТМЕНА — нижний сторож, §15. Пока тренд не подтверждён, опора
        // у него временная, на нуле LL, и нарисована ШТРИХ-ПУНКТИРОМ.
        // Штрих-пунктир — предположение, его стирают легко: буфера здесь
        // нет, хватает закрытия ниже нуля. «Рождения не было».
        //
        // ЭТО МОЁ ПРОЧТЕНИЕ ДВУХ РАЗНЫХ ФОРМУЛИРОВОК ВЛАДЕЛЬЦА, и оно
        // вынесено ему в вопросы: §36 говорит «(1) ещё не пришла, а цена
        // КОСНУЛАСЬ нуля», §15 говорит «пробой ПО ЗАКРЫТИЮ, оба сторожа,
        // тень не считается», а §46 — «КАСАНИЕ на (0) это ОТМЕНА».
        // Взято закрытие, потому что про сторожа сказано прямее всего.
        if _c < array.get(tLVL, _i)
            array.set(tTR,  _i, ST_CAN)
            array.set(tEB,  _i, bar_index)
            array.set(tCNT, _i, -1)
            array.set(tLVL, _i, na)
            array.set(tRST, _i, 0)
            array.set(tLL,  _i, false)
            st := ST_CAN

    // ── 2. ЗАПАСНОЕ ПОДТВЕРЖДЕНИЕ, У7. Тоже каждый бар ──
    // СПИТ, пока в счёте не появился низ с подписью LL. До этого
    // подтверждает только HL, основным правилом.
    if st == ST_MAY and array.get(tLL, _i) and not na(array.get(tBP, _i))
        bp = array.get(tBP, _i)
        array.set(tBAB, _i, _c > bp ? array.get(tBAB, _i) + 1 : 0)
        bool bA = math.max(_o, _c) > bp + _depth * _leg
        bool bB = array.get(tBAB, _i) >= NBAR
        if (_brk == "выше вершины на 0.20 колена" and bA) or (_brk == "4 закрытия выше вершины" and bB)
            array.set(tTR, _i, ST_LIVE)
            st := ST_LIVE
            gi = f_lastG(_i)
            if gi >= 0
                array.set(GOK, gi, true)

    // ── 3. НОВОЕ КОЛЕНО: счёт, уровень, рождение, архив, продолжение ──
    if _fr and n >= 2
        lb  = array.get(_L, n - 1)
        hiK = array.get(_H, n - 1)
        prK = array.get(_P, n - 1)
        bbK = array.get(_B, n - 1)
        ppK = array.get(_P, n - 2)
        // ИМПУЛЬС. В расчёте смерти больше НЕ УЧАСТВУЕТ: отменён
        // 06.10.2026, замер Н29 — нигде не измерялся и гулял в шесть
        // раз. Величина считается и НЕ ЧИТАЕТСЯ НИГДЕ. Оставлена по
        // правилу 4, до слова владельца
        if prK > ppK
            array.set(tIMP, _i, prK - ppK)
        if st == ST_MAY or st == ST_LIVE
            int cnt = array.get(tCNT, _i)
            if _nw and cnt >= 5 and not hiK
                // ── ПОСЛЕ (5): решает ПЕРВЫЙ новый низ, и только он ──
                // Точка (5) всегда ВЕРШИНА — это следует из чередования.
                // Значит следующее колено всегда НИЗ, и он бывает ровно
                // двух видов. Третьего не дано, поэтому строгое и мягкое
                // прочтения З32 оказались одним правилом.
                if lb == "HL"
                    // ПРОДОЛЖЕНИЕ. Единственное, что умеет сделать тренд
                    // долгим: остальные три исхода его заканчивают
                    array.set(tPZB, _i, array.get(tZB, _i))
                    array.set(tZB,  _i, bbK)
                    array.set(tZP,  _i, prK)
                    array.set(tZL,  _i, lb)
                    array.set(tCNT, _i, 0)
                    array.set(tMAX, _i, 0)
                    array.set(tRST, _i, array.get(tRST, _i) + 1)
                    array.set(tBEL, _i, 0)
                    array.set(tLL,  _i, false)
                    // У10: уровень СРАЗУ настоящий, ноль и есть HL, —
                    // поэтому продолжение не проходит через «возможен»
                    array.set(tTR,  _i, ST_LIVE)
                    st := ST_LIVE
                else
                    // АРХИВ. Низы перестали расти, продолжения нет.
                    // Тренд не умер — он ОТРАБОТАЛ, поэтому красной
                    // чёрточки здесь НЕТ, а номера счёта остаются
                    array.set(tTR,  _i, ST_ARC)
                    array.set(tEB,  _i, bar_index)
                    array.set(tLVL, _i, na)
                    array.set(tBEL, _i, 0)
                    st := ST_ARC
            else
                if _nw and cnt < 5
                    array.set(tCNT, _i, cnt + 1)
                    array.set(tMAX, _i, math.max(array.get(tMAX, _i), array.get(tCNT, _i)))
                // ПОДТВЕРЖДЕНИЕ, подраздел 2, одно правило: пришёл HL —
                // тренд подтверждён. СВОЙ или ВСТАВЛЕННЫЙ — разницы нет,
                // движок их не различает и не должен. Важна только
                // подпись: HL, и ничто другое
                if _nw and not hiK
                    if lb == "HL"
                        if st == ST_MAY
                            array.set(tTR, _i, ST_LIVE)
                            st := ST_LIVE
                            gj = f_lastG(_i)
                            if gj >= 0
                                array.set(GOK, gj, true)
                    else
                        // низ пришёл манипуляционным — просыпается
                        // запасное подтверждение У7
                        array.set(tLL, _i, true)
            // УРОВЕНЬ пересчитывается ОТ НУЛЯ на каждом колене. Отсюда
            // даром берутся У1, У2, У3, У9, У10 и возврат по З0.
            //
            // Вызов стоит ПОСЛЕ всей развилки нарочно: продолжение ставит
            // новый ноль HL, и по правилу У10 уровень обязан стать
            // НАСТОЯЩИМ сразу, в тот же бар. Стой вызов только в ветке
            // счёта — продолжение жило бы на уровне прошлого счёта до
            // следующего колена. У АРХИВА этого пересчёта быть не должно:
            // там уровень погашен, держать больше нечего, — поэтому
            // сторож по состоянию, а не безусловно
            if array.get(tTR, _i) == ST_MAY or array.get(tTR, _i) == ST_LIVE
                zq = f_lvlSet(_i, _P, _B, _H, _L, array.get(tZB, _i))
        else if st == ST_NO or st == ST_DEAD or st == ST_CAN or st == ST_ARC
            // ── РОЖДЕНИЕ ОБЪЯВЛЯЕТ (1), §14 ──
            // Любая первая вершина после LL — HH или LH всё равно.
            // Счёт начинается с (1), состояние «возможен». Приход HL на
            // (2) — это уже ПОДТВЕРЖДЕНИЕ, не рождение.
            //
            // Поиск нуля назад (back = 3, до пяти колен, перешагивая HL)
            // был ОБХОДНЫМ ПУТЁМ: его завели 21.09.2026 ровно потому,
            // что рождение объявляла только HH, а ноль к тому времени
            // оказывался далеко позади. Теперь обходить нечего — ноль
            // стоит ВПЛОТНУЮ перед (1) всегда. Проверено на двух
            // цепочках: там, где тренд состоялся, итог ОДИНАКОВЫЙ, а
            // владелец видит счёт по дороге, а не узнаёт задним числом.
            //
            // Колена чередуются, поэтому n-2 — всегда низ. Сторона
            // всё равно проверяется: сторож дешевле отладки
            if _nw and hiK and not array.get(_H, n - 2) and array.get(_L, n - 2) == "LL"
                int j = n - 2
                array.set(tTR,  _i, ST_MAY)
                array.set(tBB,  _i, bar_index)
                array.set(tZB,  _i, array.get(_B, j))
                array.set(tZP,  _i, array.get(_P, j))
                array.set(tZL,  _i, array.get(_L, j))
                array.set(tCNT, _i, 1)
                array.set(tMAX, _i, 1)
                array.set(tPZB, _i, -1)
                array.set(tRST, _i, 0)
                array.set(tLL,  _i, false)
                array.set(tBEL, _i, 0)
                // У2: ноль становится ВРЕМЕННОЙ опорой. Тренду надо за
                // что-то держаться с первой минуты, иначе его нечем
                // убить, а бессмертный тренд хуже опоры на LL. Помечен
                // честно: tLHL = false, на графике штрих-пунктир без
                // подписи
                array.set(tLVL, _i, array.get(_P, j))
                array.set(tLVB, _i, array.get(_B, j))
                array.set(tLHL, _i, false)
                st := ST_MAY
                // ПЕРЕБИТАЯ ВЕРШИНА — та, которую цена взяла по дороге к
                // нулю. От неё считается запасное подтверждение У7.
                // На графике это чёрточка рождения, спрятанная под
                // галочку: механизм работает всегда, видимость — нет
                int v = j - 1
                while v >= 0
                    if array.get(_H, v)
                        break
                    v -= 1
                if v >= 0
                    array.set(tBP,  _i, array.get(_P, v))
                    array.set(tBB2, _i, bar_index)
                    array.set(tBAB, _i, 0)
                    array.push(GDB, bar_index)
                    array.push(GDP, array.get(_P, v) * sg)
                    array.push(GDL, _i)
                    array.push(GOK, false)
                    if array.size(GDB) > MAXSL
                        array.shift(GDB)
                        array.shift(GDP)
                        array.shift(GDL)
                        array.shift(GOK)
                else
                    array.set(tBP,  _i, na)
                    array.set(tBB2, _i, -1)
                    array.set(tBAB, _i, 0)
    0

ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow (low,  5, 5)
ph3 = ta.pivothigh(high, 3, 3)
pl3 = ta.pivotlow (low,  3, 3)
ph2 = ta.pivothigh(high, 2, 2)
pl2 = ta.pivotlow (low,  2, 2)

if barstate.isconfirmed
    // nwN — родилось ли на слое НОВОЕ колено. Счёт двигается по коленам,
    // а не по сырым пивотам: слияние пивота в уже стоящее колено счёт не двигает
    bool nw5 = false
    bool nw3 = false
    bool nw2 = false
    if not na(ph5)
        q1 = f_push(P5, B5, H5, L5, M5, G5, Y5, Z5, W5, high[5], bar_index - 5, true)
        nw5 := nw5 or q1
    if not na(pl5)
        q2 = f_push(P5, B5, H5, L5, M5, G5, Y5, Z5, W5, low[5],  bar_index - 5, false)
        nw5 := nw5 or q2
    if not na(ph3)
        q3 = f_push(P3, B3, H3, L3, M3, G3, Y3, Z3, W3, high[3], bar_index - 3, true)
        nw3 := nw3 or q3
    if not na(pl3)
        q4 = f_push(P3, B3, H3, L3, M3, G3, Y3, Z3, W3, low[3],  bar_index - 3, false)
        nw3 := nw3 or q4
    if not na(ph2)
        q5 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, high[2], bar_index - 2, true)
        nw2 := nw2 or q5
    if not na(pl2)
        q6 = f_push(P2, B2, H2, L2, M2, G2, Y2, Z2, W2, low[2],  bar_index - 2, false)
        nw2 := nw2 or q6

    // ── ПЕРЕВЁРНУТЫЕ КОЛЕНА: та же f_push, минус-цена, сторона наоборот ──
    bool mw5 = false
    bool mw3 = false
    bool mw2 = false
    if not na(ph5)
        r1 = f_push(P5n, B5n, H5n, L5n, M5n, G5n, Y5n, Z5n, W5n, -high[5], bar_index - 5, false)
        mw5 := mw5 or r1
    if not na(pl5)
        r2 = f_push(P5n, B5n, H5n, L5n, M5n, G5n, Y5n, Z5n, W5n, -low[5],  bar_index - 5, true)
        mw5 := mw5 or r2
    if not na(ph3)
        r3 = f_push(P3n, B3n, H3n, L3n, M3n, G3n, Y3n, Z3n, W3n, -high[3], bar_index - 3, false)
        mw3 := mw3 or r3
    if not na(pl3)
        r4 = f_push(P3n, B3n, H3n, L3n, M3n, G3n, Y3n, Z3n, W3n, -low[3],  bar_index - 3, true)
        mw3 := mw3 or r4
    if not na(ph2)
        r5 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -high[2], bar_index - 2, false)
        mw2 := mw2 or r5
    if not na(pl2)
        r6 = f_push(P2n, B2n, H2n, L2n, M2n, G2n, Y2n, Z2n, W2n, -low[2],  bar_index - 2, true)
        mw2 := mw2 or r6

    // ── КОЛЕНА 5/5 и 3/3: свои пивоты ПЛЮС вставки СОСЕДА ──
    // Вставка кладётся с ТЕМ ЖЕ лагом, что колено слоя: у 5/5 это пять
    // баров, поэтому колено 3/3 берётся как ph3[2] — оно с того же бара,
    // что и ph5, и цена у него та же, high[5]. Так зиг-заг остаётся
    // зиг-загом.
    //
    // ЗАПАСНОГО ДОНОРА БОЛЬШЕ НЕТ, 06.10.2026: каждый слой занимает
    // только у СОСЕДА, через слой никогда. Вместе с ним исчезли ветки
    // ph2[3] / pl2[3] у слоя 5/5 и метки `··` с двумя точками.
    //
    // И появился ОТКАЗ: если сосед колено дал, чередование позволяет, а
    // доза израсходована — слой перестаёт считать этот тренд (§33).
    bool vw5 = false
    bool vw3 = false
    bool vm5 = false
    bool vm3 = false
    // ─ 5/5 + вставки с 3/3, мир настоящий ─
    if not na(ph5)
        va1 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, high[5], bar_index - 5, true)
        if va1
            array.set(VCN, 0, 0)
        array.set(VREF, 0, false)
        vw5 := vw5 or va1
    else if not na(ph3[2])
        if f_altOk(HV5, true)
            if array.get(VCN, 0) < vsN5
                va2 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, high[5], bar_index - 5, true)
                if va2
                    array.set(VCN, 0, array.get(VCN, 0) + 1)
                    array.set(VINS, 0, array.get(VINS, 0) + 1)
                vw5 := vw5 or va2
            else
                array.set(VREF, 0, true)
    if not na(pl5)
        va3 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, low[5], bar_index - 5, false)
        if va3
            array.set(VCN, 0, 0)
        array.set(VREF, 0, false)
        vw5 := vw5 or va3
    else if not na(pl3[2])
        if f_altOk(HV5, false)
            if array.get(VCN, 0) < vsN5
                va4 = f_push(PV5, BV5, HV5, LV5, MV5, GV5, YV5, ZV5, WV5, low[5], bar_index - 5, false)
                if va4
                    array.set(VCN, 0, array.get(VCN, 0) + 1)
                    array.set(VINS, 0, array.get(VINS, 0) + 1)
                vw5 := vw5 or va4
            else
                array.set(VREF, 0, true)
    // ─ 3/3 + вставки с 2/2, мир настоящий ─
    if not na(ph3)
        vb1 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, high[3], bar_index - 3, true)
        if vb1
            array.set(VCN, 1, 0)
        array.set(VREF, 1, false)
        vw3 := vw3 or vb1
    else if not na(ph2[1])
        if f_altOk(HV3, true)
            if array.get(VCN, 1) < vsN3
                vb2 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, high[3], bar_index - 3, true)
                if vb2
                    array.set(VCN, 1, array.get(VCN, 1) + 1)
                    array.set(VINS, 1, array.get(VINS, 1) + 1)
                vw3 := vw3 or vb2
            else
                array.set(VREF, 1, true)
    if not na(pl3)
        vb3 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, low[3], bar_index - 3, false)
        if vb3
            array.set(VCN, 1, 0)
        array.set(VREF, 1, false)
        vw3 := vw3 or vb3
    else if not na(pl2[1])
        if f_altOk(HV3, false)
            if array.get(VCN, 1) < vsN3
                vb4 = f_push(PV3, BV3, HV3, LV3, MV3, GV3, YV3, ZV3, WV3, low[3], bar_index - 3, false)
                if vb4
                    array.set(VCN, 1, array.get(VCN, 1) + 1)
                    array.set(VINS, 1, array.get(VINS, 1) + 1)
                vw3 := vw3 or vb4
            else
                array.set(VREF, 1, true)
    // ─ то же ЗЕРКАЛЬНО: минус-цена, сторона наоборот ─
    if not na(ph5)
        vc1 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -high[5], bar_index - 5, false)
        if vc1
            array.set(VCN, 2, 0)
        array.set(VREF, 2, false)
        vm5 := vm5 or vc1
    else if not na(ph3[2])
        if f_altOk(HV5n, false)
            if array.get(VCN, 2) < vsN5
                vc2 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -high[5], bar_index - 5, false)
                if vc2
                    array.set(VCN, 2, array.get(VCN, 2) + 1)
                    array.set(VINS, 2, array.get(VINS, 2) + 1)
                vm5 := vm5 or vc2
            else
                array.set(VREF, 2, true)
    if not na(pl5)
        vc3 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -low[5], bar_index - 5, true)
        if vc3
            array.set(VCN, 2, 0)
        array.set(VREF, 2, false)
        vm5 := vm5 or vc3
    else if not na(pl3[2])
        if f_altOk(HV5n, true)
            if array.get(VCN, 2) < vsN5
                vc4 = f_push(PV5n, BV5n, HV5n, LV5n, MV5n, GV5n, YV5n, ZV5n, WV5n, -low[5], bar_index - 5, true)
                if vc4
                    array.set(VCN, 2, array.get(VCN, 2) + 1)
                    array.set(VINS, 2, array.get(VINS, 2) + 1)
                vm5 := vm5 or vc4
            else
                array.set(VREF, 2, true)
    if not na(ph3)
        vd1 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -high[3], bar_index - 3, false)
        if vd1
            array.set(VCN, 3, 0)
        array.set(VREF, 3, false)
        vm3 := vm3 or vd1
    else if not na(ph2[1])
        if f_altOk(HV3n, false)
            if array.get(VCN, 3) < vsN3
                vd2 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -high[3], bar_index - 3, false)
                if vd2
                    array.set(VCN, 3, array.get(VCN, 3) + 1)
                    array.set(VINS, 3, array.get(VINS, 3) + 1)
                vm3 := vm3 or vd2
            else
                array.set(VREF, 3, true)
    if not na(pl3)
        vd3 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -low[3], bar_index - 3, true)
        if vd3
            array.set(VCN, 3, 0)
        array.set(VREF, 3, false)
        vm3 := vm3 or vd3
    else if not na(pl2[1])
        if f_altOk(HV3n, true)
            if array.get(VCN, 3) < vsN3
                vd4 = f_push(PV3n, BV3n, HV3n, LV3n, MV3n, GV3n, YV3n, ZV3n, WV3n, -low[3], bar_index - 3, true)
                if vd4
                    array.set(VCN, 3, array.get(VCN, 3) + 1)
                    array.set(VINS, 3, array.get(VINS, 3) + 1)
                vm3 := vm3 or vd4
            else
                array.set(VREF, 3, true)

    // ── ПРЕДВАРИТЕЛЬНОЕ КОЛЕНО ЖИВОГО КРАЯ, З31 ──
    // Пересчитывается каждый бар: цепочка соседа растёт быстрее нашей.
    // У слоя 2/2 соседа снизу нет, поэтому у ячеек 2 и 5 этого нет
    array.set(VPRE, 0, f_preOne(BV5,  HV5,  BV3,  HV3))
    array.set(VPRE, 1, f_preOne(BV3,  HV3,  B2,   H2))
    array.set(VPRE, 2, f_preOne(BV5n, HV5n, BV3n, HV3n))
    array.set(VPRE, 3, f_preOne(BV3n, HV3n, B2n,  H2n))

    bool fv5 = not na(ph5) or not na(pl5) or not na(ph3[2]) or not na(pl3[2])
    bool fv3 = not na(ph3) or not na(pl3) or not na(ph2[1]) or not na(pl2[1])
    bool fr2 = not na(ph2) or not na(pl2)

    // ── СКОЛЬЗЯЩЕЕ СРЕДНЕЕ КОЛЕНО: своё у каждой цепочки ──
    float leg5  = f_avgLeg(PV5)
    float leg3  = f_avgLeg(PV3)
    float leg2  = f_avgLeg(P2)
    float leg5n = f_avgLeg(PV5n)
    float leg3n = f_avgLeg(PV3n)
    float leg2n = f_avgLeg(P2n)
    array.set(tLEG, 0, leg5)
    array.set(tLEG, 1, leg3)
    array.set(tLEG, 2, leg2)
    array.set(tLEG, 3, leg5n)
    array.set(tLEG, 4, leg3n)
    array.set(tLEG, 5, leg2n)

    // ── шаг тренда: три слоя, два направления, шесть независимых движков ──
    // У 5/5 и 3/3 колена ОБЪЕДИНЁННЫЕ, со вставками. У 2/2 соседа нет,
    // он считает по своим и отказаться не может — ему нечего не хватать
    if trOn5
        e5 = f_trend(0, PV5, BV5, HV5, LV5, vw5, fv5, open, close, leg5, array.get(VREF, 0), depthU, brkU)
        e3 = f_trend(1, PV3, BV3, HV3, LV3, vw3, fv3, open, close, leg3, array.get(VREF, 1), depthU, brkU)
        e2 = f_trend(2, P2,  B2,  H2,  L2,  nw2, fr2, open, close, leg2, false,              depthU, brkU)
    // тот же движок, перевёрнутый мир. Второго набора правил нет
    if trDn
        n5 = f_trend(3, PV5n, BV5n, HV5n, LV5n, vm5, fv5, -open, -close, leg5n, array.get(VREF, 2), depthD, brkD)
        n3 = f_trend(4, PV3n, BV3n, HV3n, LV3n, vm3, fv3, -open, -close, leg3n, array.get(VREF, 3), depthD, brkD)
        n2 = f_trend(5, P2n,  B2n,  H2n,  L2n,  mw2, fr2, -open, -close, leg2n, false,              depthD, brkD)

    // ── кого «авто» рисует ПРЯМО СЕЙЧАС, по каждому слою ──
    // Правило то же самое, что в блоке отрисовки ниже, слово в слово.
    // Здесь оно считается каждый бар только ради одного: запомнить бар,
    // на котором решение поменялось
    for c = 0 to 2
        int uI = c
        int dI = c + 3
        // РАНГ: подтверждённый тренд сильнее «возможного». Это развязка
        // РИСКА 2 из §14 и ответ В-г из §15: «возможный восходящий не
        // показывается, пока жив подтверждённый нисходящий». Иначе в
        // устойчивом падении восходящий рождался бы на каждом отскоке и
        // «авто» металось бы
        int rU = not trOn5 ? 0 : array.get(tTR, uI) == ST_LIVE ? 2 : array.get(tTR, uI) == ST_MAY ? 1 : 0
        int rD = not trDn  ? 0 : array.get(tTR, dI) == ST_LIVE ? 2 : array.get(tTR, dI) == ST_MAY ? 1 : 0
        int mD = -1
        if trWho == "только восходящий"
            mD := rU > 0 ? 0 : -1
        else if trWho == "только нисходящий"
            mD := rD > 0 ? 1 : -1
        else
            if rU == 0 and rD == 0
                mD := -1
            else if rU > rD
                mD := 0
            else if rD > rU
                mD := 1
            else
                // ранги равны — тот, чей НОЛЬ СВЕЖЕЕ: свежая структура
                // это то, что рынок строит сейчас, старая уже контекст
                mD := array.get(tZB, dI) > array.get(tZB, uI) ? 1 : 0
        bool dD = mD == 1
        if not array.get(swI, c) or mD != array.get(SWM, c)
            array.set(swB, c, bar_index)
            array.set(SWM, c, mD)
            array.set(swD, c, dD)
            // метка ⇄ ставится, только когда переключились НА тренд.
            // Уход в «никого» метки не получает: там и рисовать нечего
            if array.get(swI, c) and mD >= 0
                array.push(AWB, bar_index)
                array.push(AWL, c)
                array.push(AWD, dD)
                array.push(AWP, close)
                if array.size(AWB) > MAXSL
                    array.shift(AWB)
                    array.shift(AWL)
                    array.shift(AWD)
                    array.shift(AWP)
            array.set(swI, c, true)

// ══════════════ ЖИВЫЕ УРОВНИ СЛОЯ ══════════════
// Уровень — СЫРОЙ пивот, лежит в списке, при касании ценой
// ВЫЧЁРКИВАЕТСЯ. Пивоты не переезжают, поэтому пробитый уровень мёртв
// навсегда. Если брать уровень из КОЛЕНА, он при слиянии переезжает на
// новый экстремум, и пробитая линия оживает — так было в первых версиях.
var float[]  V5P = array.new_float()
var int[]    V5B = array.new_int()
var bool[]   V5H = array.new_bool()
var string[] V5L = array.new_string()

var float[]  V3P = array.new_float()
var int[]    V3B = array.new_int()
var bool[]   V3H = array.new_bool()
var string[] V3L = array.new_string()

var float[]  V2P = array.new_float()
var int[]    V2B = array.new_int()
var bool[]   V2H = array.new_bool()
var string[] V2L = array.new_string()

f_lvPush(_p, _b, _h, _l, _v, _off, _isHi, _lab) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_b, bar_index - _off)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

// уровень существует, пока не пробит. Коснулась цена — удаляем совсем
f_purgeL(_p, _b, _h, _l) =>
    i = 0
    while i < array.size(_p)
        pr = array.get(_p, i)
        bool dead = array.get(_h, i) ? high >= pr : low <= pr
        if dead
            array.remove(_p, i)
            array.remove(_b, i)
            array.remove(_h, i)
            array.remove(_l, i)
        else
            i += 1
    0

// жив ли уровень с такой ценой — для линий у сырых меток
f_alive(_p, _v) =>
    bool r = false
    n = array.size(_p)
    if n > 0
        for i = 0 to n - 1
            if math.abs(array.get(_p, i) - _v) <= syminfo.mintick
                r := true
                break
    r

// ══════════════ СЧЁТ ПО СЛОМАМ ══════════════
// Слом = цена взяла ближайший НЕПРОБИТЫЙ пивот слоя. Своего механизма
// это не требует: живые уровни выше уже так и устроены, момент
// вычёркивания и есть слом.
//
// Почему это сильнее колена: колено известно ЗАДНИМ ЧИСЛОМ, на 2/2
// через два бара, на 5/5 через пять. Слом известен ЗАРАНЕЕ — цена, до
// которой надо дойти, уже стоит на графике.
//
// Замер Н14, девять лет часовика: сломы НЕ независимы, они слипаются.
var int[]   sDIR = array.new_int(3, 0)
var int[]   sRUN = array.new_int(3, 0)
var int[]   sLB  = array.new_int(3, -1)
var float[] sLP  = array.new_float(3, na)
var int[]   SB = array.new_int()
var float[] SP = array.new_float()
var int[]   SL = array.new_int()
var int[]   SN = array.new_int()

// Н14: доля случаев, когда следующий слом пошёл в ТУ ЖЕ сторону.
// Порядок: слой 5/5, 3/3, 2/2 × сторона вверх, вниз × длина серии 1..5,
// где пятая клетка значит «пять и больше». Девять лет часовика.
var float[] SFQ = array.from(62.6, 65.5, 71.0, 66.1, 66.4,   57.8, 67.9, 63.6, 63.8, 60.0, 62.6, 59.4, 63.8, 67.7, 68.4,   56.2, 61.8, 64.8, 65.4, 60.6, 61.4, 62.3, 59.1, 64.4, 65.5,   56.8, 59.2, 63.1, 61.6, 62.1)
var int[]   SFN = array.from(842, 527, 345, 245, 479,   841, 486, 330, 210, 335, 1360, 852, 505, 322, 690,   1359, 764, 472, 306, 507, 1893, 1163, 724, 427, 798,   1892, 1074, 636, 401, 651)
var float[] SFB = array.from(52.6, 52.3, 51.8)

f_slomOne(_i, _dir, _price) =>
    if array.get(sDIR, _i) != _dir
        int k = 0
        while k < array.size(SL)
            if array.get(SL, k) == _i
                array.remove(SB, k)
                array.remove(SP, k)
                array.remove(SL, k)
                array.remove(SN, k)
            else
                k += 1
        array.set(sDIR, _i, _dir)
        array.set(sRUN, _i, 1)
    else
        if slNoCap or array.get(sRUN, _i) < 5
            array.set(sRUN, _i, array.get(sRUN, _i) + 1)
    array.set(sLB, _i, bar_index)
    array.set(sLP, _i, _price)
    array.push(SB, bar_index)
    array.push(SP, _price)
    array.push(SL, _i)
    array.push(SN, array.get(sRUN, _i))
    if array.size(SB) > MAXSL
        array.shift(SB)
        array.shift(SP)
        array.shift(SL)
        array.shift(SN)
    0

// Ищет сломы этого бара по живым уровням слоя. Берётся БЛИЖАЙШИЙ
// пробитый с каждой стороны. Вызывается ДО того, как в список попадут
// уровни текущего бара, — ровно так считалось в замере Н14
f_slom(_i, _p, _h) =>
    if slOn
        n = array.size(_p)
        float bu = na
        float bd = na
        if n > 0
            for k = 0 to n - 1
                pr = array.get(_p, k)
                if array.get(_h, k)
                    if high >= pr
                        bu := na(bu) ? pr : math.min(bu, pr)
                else
                    if low <= pr
                        bd := na(bd) ? pr : math.max(bd, pr)
        if not na(bu)
            z1 = f_slomOne(_i, 1, bu)
        if not na(bd)
            z2 = f_slomOne(_i, -1, bd)
    0

// ближайший НЕПРОБИТЫЙ уровень слоя сверху и снизу от цены — это и есть
// две цены, на которых случится следующий слом
f_nearest(_p, _h) =>
    float up = na
    float dn = na
    n = array.size(_p)
    if n > 0
        for k = 0 to n - 1
            pr = array.get(_p, k)
            if array.get(_h, k)
                if pr > close
                    up := na(up) ? pr : math.min(up, pr)
            else
                if pr < close
                    dn := na(dn) ? pr : math.max(dn, pr)
    [up, dn]

// подпись СЫРОГО пивота: сравнение с предыдущим пивотом той же стороны.
//
// ЗДЕСЬ НАРОЧНО НИЧЕГО НЕ ТРОНУТО. Починка зеркала З36 касалась подписи
// КОЛЕНА — строки 305 прежнего файла, то есть f_relabel. Сырые подписи
// ниже на точной ничьей не дают НИ ОДНОЙ метки: оба условия ложны, и
// пивот в список живых уровней не попадает. Так было всегда.
//
// Привести их к тому же правилу я могу, но это ДОБАВИТ линий уровня там,
// где их не было, а правка такого размера владельцем не согласована.
// Вопрос вынесен ему вместе с остальными.
a51 = ta.valuewhen(not na(ph5), high[5], 1)
a52 = ta.valuewhen(not na(ph5), high[5], 0)
hh5 = na(ph5) ? na : a51 < a52 ? ph5 : na
lh5 = na(ph5) ? na : a51 > a52 ? ph5 : na
a53 = ta.valuewhen(not na(pl5), low[5], 1)
a54 = ta.valuewhen(not na(pl5), low[5], 0)
ll5 = na(pl5) ? na : a53 > a54 ? pl5 : na
hl5 = na(pl5) ? na : a53 < a54 ? pl5 : na

a31 = ta.valuewhen(not na(ph3), high[3], 1)
a32 = ta.valuewhen(not na(ph3), high[3], 0)
hh3 = na(ph3) ? na : a31 < a32 ? ph3 : na
lh3 = na(ph3) ? na : a31 > a32 ? ph3 : na
a33 = ta.valuewhen(not na(pl3), low[3], 1)
a34 = ta.valuewhen(not na(pl3), low[3], 0)
ll3 = na(pl3) ? na : a33 > a34 ? pl3 : na
hl3 = na(pl3) ? na : a33 < a34 ? pl3 : na

a21 = ta.valuewhen(not na(ph2), high[2], 1)
a22 = ta.valuewhen(not na(ph2), high[2], 0)
hh2 = na(ph2) ? na : a21 < a22 ? ph2 : na
lh2 = na(ph2) ? na : a21 > a22 ? ph2 : na
a23 = ta.valuewhen(not na(pl2), low[2], 1)
a24 = ta.valuewhen(not na(pl2), low[2], 0)
ll2 = na(pl2) ? na : a23 > a24 ? pl2 : na
hl2 = na(pl2) ? na : a23 < a24 ? pl2 : na

// сломы ищутся ПО ПРОШЛЫМ уровням, до того как добавятся сегодняшние
s01 = f_slom(0, V5P, V5H)
s02 = f_slom(1, V3P, V3H)
s03 = f_slom(2, V2P, V2H)

u01 = f_lvPush(V5P, V5B, V5H, V5L, hh5, 5, true,  "HH")
u02 = f_lvPush(V5P, V5B, V5H, V5L, lh5, 5, true,  "LH")
u03 = f_lvPush(V5P, V5B, V5H, V5L, hl5, 5, false, "HL")
u04 = f_lvPush(V5P, V5B, V5H, V5L, ll5, 5, false, "LL")
u05 = f_lvPush(V3P, V3B, V3H, V3L, hh3, 3, true,  "HH")
u06 = f_lvPush(V3P, V3B, V3H, V3L, lh3, 3, true,  "LH")
u07 = f_lvPush(V3P, V3B, V3H, V3L, hl3, 3, false, "HL")
u08 = f_lvPush(V3P, V3B, V3H, V3L, ll3, 3, false, "LL")
u09 = f_lvPush(V2P, V2B, V2H, V2L, hh2, 2, true,  "HH")
u10 = f_lvPush(V2P, V2B, V2H, V2L, lh2, 2, true,  "LH")
u11 = f_lvPush(V2P, V2B, V2H, V2L, hl2, 2, false, "HL")
u12 = f_lvPush(V2P, V2B, V2H, V2L, ll2, 2, false, "LL")

v01 = f_purgeL(V5P, V5B, V5H, V5L)
v02 = f_purgeL(V3P, V3B, V3H, V3L)
v03 = f_purgeL(V2P, V2B, V2H, V2L)

// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()

f_lvlLayer(_p, _b, _h, _l, _cHi, _cLo) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? _cHi : _cLo, lvTr), width = 1, style = st, extend = extend.right))
    n

// Поглощённые метки: бледная подпись на своём месте плюс короткая точка
// на своём уровне. Линии уровня у них нет — только метка.
f_drawAbs(_G, _Y, _Z, _W, _cHi, _cLo, _tag) =>
    n = array.size(_G)
    if n > 0
        for i = 0 to n - 1
            yb = array.get(_Y, i)
            if last_bar_index - yb <= winBars
                pr = array.get(_G, i)
                hi = array.get(_Z, i)
                lb = array.get(_W, i)
                array.push(LNS, line.new(yb, pr, yb + 3, pr, color = color.new(hi ? _cHi : _cLo, 50), width = 1, style = line.style_dotted))
                array.push(LBS, label.new(yb, pr, lb, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(hi ? _cHi : _cLo, 50), size = size.tiny, tooltip = "ПОГЛОЩЁННАЯ метка слоя " + _tag + "\n" + lb + "  " + str.tostring(pr, format.mintick) + "\nэта метка проявилась, потом цена ушла дальше и колено переехало на новый экстремум. Сама метка никуда не делась.\n\nПереездов стало заметно меньше: при дозе вставок 1 их 36 против 299 на 5/5 и 232 против 487 на 3/3 за два года. Остальные — случаи, где низа между двумя вершинами не увидел НИКТО, брать нечего."))
    n

// Подпуть СОСЕДНЕГО слоя внутри одной ноги.
// Берём только то, что реально ЧЕРЕДУЕТСЯ: цепочка начинается со
// стороны, противоположной началу ноги, и не кончается стороной её
// конца — иначе слой подставит тот же экстремум второй раз.
f_sub(_sB, _sH, _x1, _x2, _s1, _s2) =>
    int[] keep = array.new_int()
    n = array.size(_sB)
    if n > 0
        bool want = not _s1
        for k = 0 to n - 1
            b = array.get(_sB, k)
            if b > _x1 and b < _x2
                if array.get(_sH, k) == want
                    array.push(keep, k)
                    want := not want
    while array.size(keep) > 0
        last = array.get(keep, array.size(keep) - 1)
        if array.get(_sH, last) == _s2
            dummy = array.pop(keep)
        else
            break
    keep

// ХВОСТ: колена соседнего слоя ПОСЛЕ последнего колена нашего слоя.
// Здесь конца ноги ещё нет — слой не подтвердил разворот, а сосед уже
// подтвердил: 3/3 знает через 3 бара, 5/5 только через 5. Это живой
// край, и метки здесь нужны не меньше, чем в истории.
//
// ПЕРВОЕ колено хвоста — это и есть ПРЕДВАРИТЕЛЬНОЕ колено из З31:
// то, которое счёт теперь берёт, а уровень ждёт.
f_subTail(_sB, _sH, _x1, _s1) =>
    int[] keep = array.new_int()
    n = array.size(_sB)
    if n > 0
        bool want = not _s1
        for k = 0 to n - 1
            if array.get(_sB, k) > _x1
                if array.get(_sH, k) == want
                    array.push(keep, k)
                    want := not want
    keep

// _dn   — какой счёт рисуем: false восходящий, true нисходящий.
// _st   — состояние тренда, ST_*. Ноль значит «счёт на графике не
//         показываем», остальное разворачивается в три картинки:
//            ST_MAY  возможен — ноги счёта ТОНКИЕ
//            ST_LIVE подтверждён — ноги ТОЛСТЫЕ
//            ST_ARC  архив — номера БЛЕДНЫЕ
//            ST_REF  отказ — зиг-заг СЕРЫЙ, номеров нет
// _preN — номер ПРЕДВАРИТЕЛЬНОГО колена живого края, -1 если нет.
//
// Колена у восходящего и нисходящего ОДНИ И ТЕ ЖЕ: один зиг-заг, те же
// бары, те же цены. Отличается только прочтение, поэтому никаких
// перевёрнутых цен здесь нет — разворачиваются ЧЕТЫРЕ ветки.
f_draw(_P, _B, _H, _L, _M, _fP, _fB, _fH, _fL, _fV, _hasF, _cHi, _cLo, _tag, _lab, _labK, _tzB, _tpzB, _st, _dn, _swB, _preN) =>
    // _swB — бар, с которого этот тренд стал РИСОВАТЬСЯ. Нужен только
    // настройке «Счёт при переключении». При значении по умолчанию
    // ничего не меняет: swFull гасит всю ветку
    bool swFull = trCntSw == "весь, набранный в фоне"
    bool swPale = trCntSw == "фоновую часть бледнее"
    bool conf   = _st == ST_LIVE
    bool pale   = _st == ST_ARC
    bool gray   = _st == ST_REF
    bool shows  = _st == ST_MAY or _st == ST_LIVE or _st == ST_ARC
    n = array.size(_P)
    // колено-ноль действующего счёта: первый НИЗ, чей бар не раньше нуля.
    //
    // Сторона здесь обязательна. Ноль всегда низ — LL при рождении, HL при
    // продолжении, — а большая свеча умеет сделать и вершину, и низ сразу:
    // 6 янв 2026, 07:00 на 2/2 колена 4474.265 и 4449.510 сели на один бар.
    // Поиск «по бару» хватал вершину, и весь счёт на экране съезжал на
    // единицу: на графике (5), в таблице (4). За два года часовика такая
    // свеча-накрышка встречается 49 раз на 2565 колен 2/2, 21 на 1827 у
    // 3/3, 5 на 1221 у 5/5
    int zi = -1
    if shows and _tzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tzB and array.get(_H, i) == _dn
                zi := i
                break
    // ноль ПРОШЛОГО счёта: его номера и ноги остаются, но бледными
    int pzi = -1
    if shows and _tpzB >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(_B, i) >= _tpzB and array.get(_H, i) == _dn
                pzi := i
                break
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(_B, i - 1)
            x2 = array.get(_B, i)
            p1 = array.get(_P, i - 1)
            p2 = array.get(_P, i)
            if last_bar_index - x1 <= winBars
                s1 = array.get(_H, i - 1)
                s2 = array.get(_H, i)
                int[] keep = array.new_int()
                if fillOn and _hasF
                    keep := f_sub(_fB, _fH, x1, x2, s1, s2)
                nk = array.size(keep)
                bool filled = nk > 0
                // нога ДЕЙСТВУЮЩЕГО счёта. ВОСХОДЯЩИЙ.md §6: цвет по НОГЕ,
                // чередованием (0)-(1) зелёная, (1)-(2) красная и дальше.
                // Колена чередуются вершина/низ, поэтому направление ноги и
                // чётность её номера — одно и то же.
                bool inCnt = zi >= 0 and i > zi and i - zi <= 5
                bool inPrv = not inCnt and pzi >= 0 and i > pzi and i - pzi <= 5
                cOwn = _dn ? cTrDn : cTrLeg
                col0 = gray ? cTrGr : inCnt ? (pale ? color.new(p2 > p1 ? cTrUp : cOwn, 55) : (p2 > p1 ? cTrUp : cOwn)) : inPrv ? color.new(p2 > p1 ? cTrUp : cOwn, 55) : (p2 > p1 ? _cHi : _cLo)
                // §5: точка (5) может быть LH вместо HH. Счёт от этого не
                // ломается, но нога (4)-(5) с такой вершиной рисуется
                // ШТРИХ-ПУНКТИРОМ — зелёным, цвет не меняется
                bool weak5 = (inCnt and i - zi == 5 or inPrv and i - pzi == 5) and array.get(_L, i) == (_dn ? "HL" : "LH")
                // 22.09.2026, слово владельца: то же правило на ЛЮБУЮ
                // встречную подпись в счёте, «чтобы глаз видел — восходящий,
                // но через манипуляцию». Идеал: вершина HH, низ HL. Ноль не
                // проверяется, у него законны и LL, и HL. Счёт не ломается,
                // цвет остаётся зелёным, меняется только стиль ноги.
                //
                // Штрих-пунктир занят дорисовкой, и им рисуются две разные
                // вещи. Отличать на глаз: у дорисовки на пунктире стоят
                // метки с точкой спереди (·LH, ·HL), у манипуляции их нет
                int kLeg = inCnt ? i - zi : inPrv ? i - pzi : -1
                bool manip = kLeg >= 1 and (array.get(_H, i) ? array.get(_L, i) != (_dn ? "LH" : "HH") : array.get(_L, i) != (_dn ? "LL" : "HL"))
                // Пока тренд не ПОДТВЕРЖДЁН, нога счёта ТОНКАЯ. Состояние
                // «возможен» на графике видно именно этим.
                //
                // З29, 02.10.2026. Было «плюс один пиксель»: при толщине
                // зиг-зага 1 это 1 против 2, и владелец за всё время ни разу
                // не сказал, что видит момент подтверждения, — его просто не
                // было видно. Стало ПЛЮС ДВА: 1 против 3, разница втрое.
                //
                // Владелец просил штрих-пунктир против сплошной. ЭТОГО СДЕЛАТЬ
                // НЕЛЬЗЯ: у ноги счёта штрих-пунктир уже занят и означает
                // МАНИПУЛЯЦИЮ — строка ниже, `weak5 or manip`. Совпали бы
                // ровно там, где это больнее всего: нога (0)-(1) и не
                // подтверждена, и может нести слабую вершину LH.
                int wCnt = inCnt and conf ? zzW + 2 : zzW
                if showZZ
                    if filled
                        // участок с дорисовкой остаётся ШТРИХ-ПУНКТИРОМ — это
                        // признак «колено одолжено», — но внутри счёта цвет
                        // берётся от ноги, а не от слоя. Все куски подпути
                        // красятся одинаково: нога одна, ныряния внутри неё
                        // своего цвета не имеют
                        int px = x1
                        float pp = p1
                        for q = 0 to nk - 1
                            k = array.get(keep, q)
                            fx = array.get(_fB, k)
                            fp = array.get(_fP, k)
                            cseg = gray ? cTrGr : inCnt or inPrv ? col0 : (fp > pp ? _cHi : _cLo)
                            array.push(LNS, line.new(px, pp, fx, fp, color = color.new(cseg, inCnt and not pale ? 0 : 15), width = wCnt, style = line.style_dashed))
                            px := fx
                            pp := fp
                        cend = gray ? cTrGr : inCnt or inPrv ? col0 : (p2 > pp ? _cHi : _cLo)
                        array.push(LNS, line.new(px, pp, x2, p2, color = color.new(cend, inCnt and not pale ? 0 : 15), width = wCnt, style = line.style_dashed))
                    else
                        array.push(LNS, line.new(x1, p1, x2, p2, color = color.new(col0, inCnt and not pale ? 0 : 55), width = wCnt, style = weak5 or manip ? line.style_dashed : line.style_solid))
                if _lab
                    if filled and not _labK
                        for q = 0 to nk - 1
                            k = array.get(keep, q)
                            flb = array.get(_fL, k)
                            fpr = array.get(_fP, k)
                            fhi = array.get(_fH, k)
                            fbx = array.get(_fB, k)
                            array.push(LBS, label.new(fbx, fpr, "·" + flb, style = fhi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = fhi ? _cHi : _cLo, size = size.small, tooltip = "СЫРАЯ метка — одна точка спереди. У слоя " + _tag + " колена здесь нет, взято у СОСЕДНЕГО слоя: 5/5 берёт у 3/3, 3/3 у 2/2.\n" + flb + "  " + str.tostring(fpr, format.mintick) + "\nучасток нарисован штрих-пунктиром\n\nЗапасного донора больше нет — метки `··` с двумя точками, которые брались через слой, убраны 06.10.2026."))
                            // линия сырой метки: только пока она ЖИВА в
                            // списке уровней того слоя, откуда одолжена
                            if fillLv and lvOn
                                if f_alive(_fV, fpr)
                                    fst = flb == "HH" or flb == "LL" ? line.style_dashed : line.style_dotted
                                    fxl = math.max(fbx, bar_index - 2900)
                                    array.push(LNS, line.new(fxl, fpr, bar_index, fpr, color = color.new(fhi ? _cHi : _cLo, lvTr), width = 1, style = fst, extend = extend.right))
                    lb = array.get(_L, i)
                    hi = array.get(_H, i)
                    mc = array.get(_M, i)
                    // колено действующего счёта: номер спереди, зелёным
                    int k = -1
                    if zi >= 0 and i >= zi
                        kk = i - zi
                        if kk <= 5
                            k := kk
                    // номер ПРОШЛОГО счёта — остаётся, но бледным
                    int pk = -1
                    if k < 0 and pzi >= 0 and i >= pzi
                        kk2 = i - pzi
                        if kk2 <= 5
                            pk := kk2
                    kk3 = k >= 0 ? k : pk
                    bool ideal = kk3 < 0 ? false : hi ? lb == (_dn ? "LH" : "HH") : (kk3 == 0 ? (_dn ? lb == "HH" or lb == "LH" : lb == "LL" or lb == "HL") : lb == (_dn ? "LL" : "HL"))
                    // колено, чей номер набран ДО переключения «авто».
                    // При настройке по умолчанию swOld всегда false
                    bool swOld  = not swFull and _swB >= 0 and array.get(_B, i) < _swB and kk3 >= 0
                    bool swHide = swOld and not swPale
                    txt = kk3 >= 0 and trNum and not swHide ? "(" + str.tostring(kk3) + ") " + lb : lb
                    cCnt = _dn ? cTrDn : cTrUp
                    col1 = swHide ? (hi ? _cHi : _cLo) : k >= 0 ? (pale or swOld ? color.new(cCnt, pale ? 55 : 70) : cCnt) : pk >= 0 ? color.new(cCnt, 55) : (hi ? _cHi : _cLo)
                    tipK = kk3 < 0 ? "" : "\nточка (" + str.tostring(kk3) + ") из 5 · " + (ideal ? "подпись идеальная" : "подпись встречная — МАНИПУЛЯЦИЯ, счёт продолжается, нога к ней нарисована штрих-пунктиром") + (pk >= 0 ? "\nПРОШЛЫЙ счёт. Он дошёл до (5), после чего пришёл " + (_dn ? "LH" : "HL") + " и начался новый счёт с нуля на нём." : "") + (k == 0 and _tpzB >= 0 ? "\nНОВЫЙ счёт: это первый " + (_dn ? "LH" : "HL") + " после (5) прошлого счёта. Тренд не умирал, он ПРОДОЛЖАЕТСЯ — единственное, что умеет сделать тренд долгим." : "") + (pale ? "\n\nАРХИВ: счёт прошёл весь путь до (5), а следующий низ пришёл " + (_dn ? "HH" : "LL") + " — низы перестали расти, продолжения нет. Тренд не умер, он ОТРАБОТАЛ, поэтому красной чёрточки здесь нет." : "")
                    if not _labK or kk3 >= 0
                        array.push(LBS, label.new(x2, p2, txt, style = hi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = col1, size = size.small, tooltip = "слой " + _tag + ", счёт " + (_dn ? "НИСХОДЯЩЕГО" : "ВОСХОДЯЩЕГО") + "   " + lb + "  " + str.tostring(p2, format.mintick) + "\n" + (hi ? "вершина" : "низ") + tipK + (mc >= 2 ? "\nслилось сырых меток: " + str.tostring(mc) : "") + (swOld ? "\n\nЭтот номер набран, пока тренд НЕ рисовался: «авто» переключилось на него позже, на баре " + str.tostring(_swB) + "." : "")))

    // ── ХВОСТ. Первое колено здесь — ПРЕДВАРИТЕЛЬНОЕ, З31 ──
    if n >= 1 and fillOn and _hasF
        xt = array.get(_B, n - 1)
        pt = array.get(_P, n - 1)
        stt = array.get(_H, n - 1)
        if last_bar_index - xt <= winBars
            int[] kt = f_subTail(_fB, _fH, xt, stt)
            nt = array.size(kt)
            if nt > 0
                if showZZ
                    int px2 = xt
                    float pp2 = pt
                    for q = 0 to nt - 1
                        k = array.get(kt, q)
                        fx = array.get(_fB, k)
                        fp = array.get(_fP, k)
                        array.push(LNS, line.new(px2, pp2, fx, fp, color = color.new(gray ? cTrGr : (fp > pp2 ? _cHi : _cLo), 15), width = zzW, style = line.style_dashed))
                        px2 := fx
                        pp2 := fp
                if _lab
                    for q = 0 to nt - 1
                        k = array.get(kt, q)
                        flb = array.get(_fL, k)
                        fpr = array.get(_fP, k)
                        fhi = array.get(_fH, k)
                        fbx = array.get(_fB, k)
                        // ПЕРВОЕ колено хвоста получает НОМЕР СЧЁТА — это
                        // правило З31 «если зиг-заг нарисовал колено, счёт
                        // его берёт». Номер предварительный, как и само
                        // колено: он имеет право исчезнуть
                        bool isPre = q == 0 and _preN >= 0
                        string txt2 = isPre and trNum ? "(" + str.tostring(_preN) + ") ·" + flb : "·" + flb
                        color cpre = isPre ? (_dn ? cTrDn : cTrUp) : (fhi ? _cHi : _cLo)
                        if not _labK or isPre
                            array.push(LBS, label.new(fbx, fpr, txt2, style = fhi ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cpre, size = size.small, tooltip = (isPre ? "ПРЕДВАРИТЕЛЬНОЕ КОЛЕНО, точка (" + str.tostring(_preN) + ") из 5.\n\nСлой " + _tag + " этот разворот ещё НЕ подтвердил, а сосед уже подтвердил: 3/3 знает через 3 бара, 5/5 только через 5. Счёт его БЕРЁТ СРАЗУ — правило З31, слово владельца 05.10.2026 «так будет правильно».\n\nЧто при этом НЕ происходит:\n· УРОВЕНЬ на него не переезжает — ждёт колена своего слоя. Иначе смерть считалась бы от линии, которая имеет право исчезнуть;\n· ПОДТВЕРЖДЕНИЕ тоже ждёт: оно делает разметку окончательной, а предварительному этого нельзя.\n\nШТРИХ-ПУНКТИР значит предположение. Цена уйдёт обратно — и колено, и этот номер пропадут.\n" : "СЫРАЯ метка в ХВОСТЕ — слой " + _tag + " этот разворот ещё не подтвердил, взято у соседнего слоя.\n") + flb + "  " + str.tostring(fpr, format.mintick)))
                        if fillLv and lvOn
                            if f_alive(_fV, fpr)
                                fst = flb == "HH" or flb == "LL" ? line.style_dashed : line.style_dotted
                                fxl = math.max(fbx, bar_index - 2900)
                                array.push(LNS, line.new(fxl, fpr, bar_index, fpr, color = color.new(fhi ? _cHi : _cLo, lvTr), width = 1, style = fst, extend = extend.right))
    n

// ══════════════ УРОВНИ 4H и 1D — ОБЩИЕ ══════════════
ph4  = request.security(syminfo.tickerid, "240", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pl4  = request.security(syminfo.tickerid, "240", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
ph4v = request.security(syminfo.tickerid, "240", high[hLB], lookahead = barmerge.lookahead_off)
pl4v = request.security(syminfo.tickerid, "240", low[hLB],  lookahead = barmerge.lookahead_off)
b41 = ta.valuewhen(not na(ph4), ph4v, 1)
b42 = ta.valuewhen(not na(ph4), ph4v, 0)
hh4 = na(ph4) ? na : b41 < b42 ? ph4 : na
lh4 = na(ph4) ? na : b41 > b42 ? ph4 : na
b43 = ta.valuewhen(not na(pl4), pl4v, 1)
b44 = ta.valuewhen(not na(pl4), pl4v, 0)
ll4 = na(pl4) ? na : b43 > b44 ? pl4 : na
hl4 = na(pl4) ? na : b43 < b44 ? pl4 : na

phd  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, hLB, hLB), lookahead = barmerge.lookahead_off)
pld  = request.security(syminfo.tickerid, "D", ta.pivotlow (low,  hLB, hLB), lookahead = barmerge.lookahead_off)
phdv = request.security(syminfo.tickerid, "D", high[hLB], lookahead = barmerge.lookahead_off)
pldv = request.security(syminfo.tickerid, "D", low[hLB],  lookahead = barmerge.lookahead_off)
bd1 = ta.valuewhen(not na(phd), phdv, 1)
bd2 = ta.valuewhen(not na(phd), phdv, 0)
hhd = na(phd) ? na : bd1 < bd2 ? phd : na
lhd = na(phd) ? na : bd1 > bd2 ? phd : na
bd3 = ta.valuewhen(not na(pld), pldv, 1)
bd4 = ta.valuewhen(not na(pld), pldv, 0)
lld = na(pld) ? na : bd3 > bd4 ? pld : na
hld = na(pld) ? na : bd3 < bd4 ? pld : na

var float[]  V4P = array.new_float()
var int[]    V4B = array.new_int()
var bool[]   V4H = array.new_bool()
var string[] V4L = array.new_string()
var float[]  VDP = array.new_float()
var int[]    VDB = array.new_int()
var bool[]   VDH = array.new_bool()
var string[] VDL = array.new_string()

f_lvPushHTF(_p, _b, _h, _l, _v, _prev, _isHi, _lab) =>
    if not na(_v) and _v != _prev
        array.push(_p, _v)
        array.push(_b, bar_index)
        array.push(_h, _isHi)
        array.push(_l, _lab)
    0

w01 = f_lvPushHTF(V4P, V4B, V4H, V4L, hh4, nz(hh4[1]), true,  "HH")
w02 = f_lvPushHTF(V4P, V4B, V4H, V4L, lh4, nz(lh4[1]), true,  "LH")
w03 = f_lvPushHTF(V4P, V4B, V4H, V4L, hl4, nz(hl4[1]), false, "HL")
w04 = f_lvPushHTF(V4P, V4B, V4H, V4L, ll4, nz(ll4[1]), false, "LL")
w05 = f_lvPushHTF(VDP, VDB, VDH, VDL, hhd, nz(hhd[1]), true,  "HH")
w06 = f_lvPushHTF(VDP, VDB, VDH, VDL, lhd, nz(lhd[1]), true,  "LH")
w07 = f_lvPushHTF(VDP, VDB, VDH, VDL, hld, nz(hld[1]), false, "HL")
w08 = f_lvPushHTF(VDP, VDB, VDH, VDL, lld, nz(lld[1]), false, "LL")

w09 = f_purgeL(V4P, V4B, V4H, V4L)
w10 = f_purgeL(VDP, VDB, VDH, VDL)

f_lvlHTF(_p, _b, _h, _l, _w) =>
    n = array.size(_p)
    if n > 0
        bool[] used = array.new_bool(n, false)
        for side = 0 to 1
            bool isHi = side == 0
            for k = 1 to lv_n
                int best = -1
                float bestd = 1.0e18
                for i = 0 to n - 1
                    if not array.get(used, i)
                        if array.get(_h, i) == isHi
                            lb = array.get(_l, i)
                            bool want = lb == "HH" or lb == "LL" or (lvLH and (lb == "LH" or lb == "HL"))
                            if want
                                d = math.abs(array.get(_p, i) - close)
                                if d < bestd
                                    bestd := d
                                    best := i
                if best >= 0
                    array.set(used, best, true)
                    lb2 = array.get(_l, best)
                    st = lb2 == "HH" or lb2 == "LL" ? line.style_dashed : line.style_dotted
                    xl = math.max(array.get(_b, best), bar_index - 2900)
                    array.push(LNS, line.new(xl, array.get(_p, best), bar_index, array.get(_p, best), color = color.new(isHi ? cHiH : cLoH, lvTr), width = _w, style = st, extend = extend.right))
    n

// ══════════════ СЛОВО СОСТОЯНИЯ ══════════════
// §48, слово владельца: «да, не вводим "переход", пишем чем кончилось».
// «Идёт переход» не говорит ничего: это слово про время, а не про рынок.
// «Умер» и «не было» — это РАЗНЫЕ рынки, и смотреть на них надо
// по-разному. Одно слово на четыре случая стирало бы ровно ту разницу,
// ради которой весь список концов и выстраивался.
f_stWord(_i, _dn) =>
    s = array.get(tTR, _i)
    bool stale = array.get(tEB, _i) < 0 or last_bar_index - array.get(tEB, _i) > winBars
    s == ST_LIVE ? (_dn ? "НИСХ" : "ВОСХ") : s == ST_MAY ? "возможен" : s == ST_REF ? (stale ? "нет" : "не свой") : s == ST_ARC ? (stale ? "нет" : "архив") : s == ST_CAN ? (stale ? "нет" : "не было") : s == ST_DEAD ? (stale ? "нет" : "умер") : "нет"

f_stColor(_i, _dn) =>
    s = array.get(tTR, _i)
    color cDir = _dn ? cTrDn : cTrUp
    s == ST_LIVE ? cDir : s == ST_MAY ? color.new(cDir, 45) : s == ST_REF ? cTrGr : s == ST_ARC ? color.new(cDir, 45) : s == ST_DEAD ? (_dn ? cTrUp : cTrDie) : color.gray

f_stTip(_i, _dn) =>
    s = array.get(tTR, _i)
    base = "У тренда ЧЕТЫРЕ КОНЦА, и здесь написано, ЧЕМ КОНЧИЛОСЬ. Слова «переход» нет — это слово про время, а не про рынок.\n\n· возможен — есть ноль " + (_dn ? "HH" : "LL") + " и пришла (1). Любая первая вершина после нуля объявляет рождение, HH или LH всё равно. Опора ещё временная, на нуле, ноги счёта тонкие;\n· " + (_dn ? "НИСХ" : "ВОСХ") + " — пришёл " + (_dn ? "LH" : "HL") + ", тренд ПОДТВЕРЖДЁН, ноги толстые;\n· умер — тело свечи ушло ниже порога. Единственный конец с красной чёрточкой;\n· архив — счёт дошёл до (5), а следующий низ пришёл " + (_dn ? "HH" : "LL") + ": низы перестали расти, продолжения нет. Тренд не умер, он ОТРАБОТАЛ;\n· не было — ОТМЕНА: цена закрылась за нулём прежде, чем тренд подтвердился. Штрих-пунктир это предположение, его стирают легко;\n· не свой — ОТКАЗ: слою понадобилась ЛИШНЯЯ чужая метка. Тренд есть, но считает его другой слой. Пустая клетка у медленного слоя при живом счёте у быстрого — не дыра, а подсказка «перейди на другой слой»;\n· нет — всё перечисленное уехало за окно, показывать нечего."
    s == ST_REF ? "НЕ СВОЙ. Слой снял с себя полномочия: ему понадобилась лишняя метка соседа, а доза израсходована. Правило §33, придумано владельцем, когда он поймал себя на подгонке: «начинаю придумывать, что ему нужно брать сырые колена, чтобы ОБЯЗАТЕЛЬНО дойти до 5».\n\nКрасной чёрточки здесь НЕТ: тренд, возможно, идёт себе дальше. Зиг-заг остался серым и без номеров — структура перед глазами, прочтение не навязано.\n\nСлой вернётся к работе, как только поставит СВОЁ колено, и с него будет искать рождение заново.\n\n" + base : s == ST_ARC ? "АРХИВ. Счёт прошёл весь путь от (0) до (5), а следующий низ пришёл " + (_dn ? "HH" : "LL") + ".\n\nСчёт остаётся (5)/5 с галочкой намеренно: архив это не «ничего нет», а «было и закончилось хорошо». Смени его прочерком — и на табло станет не отличить тренд, отработавший полностью, от тренда, которого не было.\n\nУровень и запас гаснут: они отвечают на вопрос «что будет дальше с ЭТИМ трендом», а дальше с ним ничего не будет.\n\nАрхив по подписи СТРОЖЕ, чем смерть по цене: низ мог прийти всего на пункт ниже, уровень цел, запас положительный — и всё равно архив. Это сознательный выбор: после (5) манипуляций больше нет, для них не осталось точки счёта.\n\n" + base : base

// подпись у линии уровня: полная, короткая или никакой (З7)
f_lvTxt(_full, _short) =>
    lvLab == "полные" ? _full : lvLab == "короткие" ? _short : ""

// ══════════════ РИСУЕМ ══════════════
if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))

    if hOn and h_tf4
        e1 = f_lvlHTF(V4P, V4B, V4H, V4L, 2)
    if hOn and h_tfd
        e2 = f_lvlHTF(VDP, VDB, VDH, VDL, 3)

    bool lab5 = labWho != "нет" and (layMain == "5/5" or (labWho == "у обоих" and layOver == "5/5"))
    bool lab3 = labWho != "нет" and (layMain == "3/3" or (labWho == "у обоих" and layOver == "3/3"))
    bool lab2 = labWho != "нет" and (layMain == "2/2" or (labWho == "у обоих" and layOver == "2/2"))
    // наложенный слой показывает всё остальное — линии, поглощённые и
    // сырые метки — только если стоит галочка «У наложенного слоя
    // показывать всё». Рабочий слой показывает всегда
    bool full5 = layMain == "5/5" or trFull
    bool full3 = layMain == "3/3" or trFull
    bool full2 = layMain == "2/2" or trFull

    // ── КАКОЙ ИЗ ДВУХ ТРЕНДОВ РИСУЕМ ──
    // Колена у обоих ОДНИ И ТЕ ЖЕ, поэтому счёт на графике может быть
    // только один: одна нога не бывает двух цветов, одно колено не несёт
    // двух номеров. Замер на девяти годах: оба живы 19.5% баров на 5/5,
    // 21.9% на 3/3, 21.8% на 2/2 — пятая часть времени.
    //
    // РАНГ: подтверждённый сильнее «возможного». Без этого в устойчивом
    // падении восходящий рождался бы на каждом отскоке LH и «авто»
    // металось бы — РИСК 2 из §14, снят ответом В-г из §15.
    int upIdx = mainL
    int dnIdx = mainL + 3
    int rU = not trOn5 ? 0 : array.get(tTR, upIdx) == ST_LIVE ? 2 : array.get(tTR, upIdx) == ST_MAY ? 1 : 0
    int rD = not trDn  ? 0 : array.get(tTR, dnIdx) == ST_LIVE ? 2 : array.get(tTR, dnIdx) == ST_MAY ? 1 : 0
    // Ответ ТРЁХЗНАЧНЫЙ, 30.09.2026:
    //     0  веду восходящий
    //     1  веду нисходящий
    //    -1  не веду никого, счёта на графике нет
    // Прежде здесь стоял один флаг на два значения, и ЛОЖЬ в нём значила
    // «рисуем восходящий». Сказать «не рисую никого» он не умел —
    // отсюда было З23: «только нисходящий» при смерти нисходящего молча
    // показывал восходящий.
    int drawMode = -1
    if trWho == "только восходящий"
        drawMode := rU > 0 ? 0 : -1
    else if trWho == "только нисходящий"
        drawMode := rD > 0 ? 1 : -1
    else
        if rU == 0 and rD == 0
            drawMode := -1
        else if rU > rD
            drawMode := 0
        else if rD > rU
            drawMode := 1
        else
            drawMode := array.get(tZB, dnIdx) > array.get(tZB, upIdx) ? 1 : 0
    bool dnDraw = drawMode == 1
    // чья СТОРОНА на графике, даже когда никого не ведём: иначе в режиме
    // «только нисходящий» чёрточки брались бы у восходящего
    bool dnSide = trWho == "только нисходящий" ? true : trWho == "только восходящий" ? false : dnDraw
    int drawIdx = dnSide ? mainL + 3 : mainL
    int stRaw = array.get(tTR, drawIdx)
    // что из счёта показываем на графике
    int drawSt = 0
    if drawMode >= 0
        drawSt := stRaw
    else if stRaw == ST_REF
        drawSt := ST_REF
    else if stRaw == ST_ARC
        drawSt := ST_ARC
    else if keep5 == "оставлять" and stRaw == ST_DEAD and array.get(tMAX, drawIdx) >= 5
        // З18 и требование владельца 28.09.2026: «когда по любому тренду
        // счёт доходит от 0 до 5, этот тренд, как бы цена себя дальше ни
        // вела, нельзя перерисовывать». Номера остаются бледными
        drawSt := ST_ARC
    // номер ПРЕДВАРИТЕЛЬНОГО колена живого края, З31. У 2/2 соседа нет
    int preCh = mainL <= 1 ? (dnSide ? mainL + 2 : mainL) : -1
    // СТОРОЖ ОБЯЗАТЕЛЬНО ЧЕРЕЗ `if`. Пайн НЕ обрывает `and`: при
    // preCh = -1 правая половина всё равно посчиталась бы и уронила
    // индикатор с RE10045. Ровно так он падал 29.09.2026
    bool hasPre = false
    if preCh >= 0
        hasPre := array.get(VPRE, preCh) >= 0
    int cntNow = array.get(tCNT, drawIdx)
    int preN = -1
    if hasPre and (drawSt == ST_MAY or drawSt == ST_LIVE) and cntNow >= 0 and cntNow < 5
        preN := cntNow + 1

    int zbM  = array.get(tZB,  drawIdx)
    int pzbM = array.get(tPZB, drawIdx)
    int swBM = array.get(swB,  mainL)

    if on5
        if lvOn and full5
            r5 = f_lvlLayer(V5P, V5B, V5H, V5L, c5H, c5L)
        if absOn and lab5 and full5
            g5 = f_drawAbs(GV5, YV5, ZV5, WV5, c5H, c5L, "5/5")
        d5 = f_draw(PV5, BV5, HV5, LV5, MV5, PV3, BV3, HV3, LV3, V3P, true, c5H, c5L, "5/5", lab5 or layOver == "5/5", not lab5 and not trFull, mainL == 0 ? zbM : NOZERO, mainL == 0 ? pzbM : NOZERO, mainL == 0 ? drawSt : 0, dnSide, mainL == 0 ? swBM : NOZERO, mainL == 0 ? preN : -1)
    if on3
        if lvOn and full3
            r3 = f_lvlLayer(V3P, V3B, V3H, V3L, c3H, c3L)
        if absOn and lab3 and full3
            g3 = f_drawAbs(GV3, YV3, ZV3, WV3, c3H, c3L, "3/3")
        d3 = f_draw(PV3, BV3, HV3, LV3, MV3, P2, B2, H2, L2, V2P, true, c3H, c3L, "3/3", lab3 or layOver == "3/3", not lab3 and not trFull, mainL == 1 ? zbM : NOZERO, mainL == 1 ? pzbM : NOZERO, mainL == 1 ? drawSt : 0, dnSide, mainL == 1 ? swBM : NOZERO, mainL == 1 ? preN : -1)
    if on2
        if lvOn and full2
            r2 = f_lvlLayer(V2P, V2B, V2H, V2L, c2H, c2L)
        if absOn and lab2 and full2
            g2 = f_drawAbs(G2, Y2, Z2, W2, c2H, c2L, "2/2")
        d2 = f_draw(P2, B2, H2, L2, M2, P2, B2, H2, L2, V2P, false, c2H, c2L, "2/2", lab2 or layOver == "2/2", not lab2 and not trFull, mainL == 2 ? zbM : NOZERO, mainL == 2 ? pzbM : NOZERO, mainL == 2 ? drawSt : 0, dnSide, mainL == 2 ? swBM : NOZERO, -1)

    // ── УРОВЕНЬ и ЧЁРТОЧКИ, по рабочему слою ──
    if trOn5 or trDn
        // цены ячеек 3-5 живут в перевёрнутом мире — знак назад
        float mSg  = dnSide ? -1.0 : 1.0
        float mLvl = array.get(tLVL, drawIdx) * mSg
        mHL  = array.get(tLHL, drawIdx)
        color cDir = dnSide ? cTrDn : cTrUp
        if (drawSt == ST_MAY or drawSt == ST_LIVE) and not na(mLvl)
            x0 = array.get(tLVB, drawIdx) < 0 ? bar_index - 30 : array.get(tLVB, drawIdx)
            array.push(LNS, line.new(x0, mLvl, bar_index, mLvl, color = cDir, width = mHL ? 2 : 1, style = mHL ? line.style_solid : line.style_dashed, extend = extend.right))
            // подпись только у НАСТОЯЩЕГО уровня. Временный, на нуле, —
            // штрих-пунктир без подписи: он предположение, его стирают
            if mHL and lvLab != "нет"
                array.push(LBS, label.new(bar_index, mLvl, f_lvTxt("держит " + (dnSide ? "LH " : "HL ") + str.tostring(mLvl, format.mintick), str.tostring(mLvl, format.mintick)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cDir, size = size.small, tooltip = "Уровень " + (dnSide ? "нисходящего — последняя появившаяся LH. Новая LH" : "восходящего — последний появившийся HL. Новый HL") + " заменяет его БЕЗУСЛОВНО, ниже тот или выше: храповика здесь нет намеренно. Уровень это «за что держимся сейчас», а не «лучшее, чего достигли».\n\nИ он имеет право ВЕРНУТЬСЯ назад. Колено было " + (dnSide ? "LH" : "HL") + ", уровень на него переехал, потом цена ушла дальше, колена слились, и колено стало " + (dnSide ? "HH" : "LL") + " — манипуляционным. Манипуляционное колено НИЧЕГО НЕ ДЕРЖИТ, значит уровень уходит на предыдущий " + (dnSide ? "LH" : "HL") + ". Решение владельца 06.10.2026, замечание З0.\n\nОт уровня считается смерть: тело свечи ниже уровня на " + str.tostring(dnSide ? depthD : depthU) + " скользящего среднего колена слоя.\n\nСлой: " + layMain))
        // ── СМЕРТЬ: красная чёрточка ──
        // ТОЛЬКО У СМЕРТИ. У отмены, отказа и архива следа на графике
        // нет: §44, слово владельца «да, красная чёрточка только у
        // смерти». Тренда не было, тренд не этого слоя, тренд отработал —
        // три разных случая, и ни один не «кончился».
        //
        // Цвет говорит про НАПРАВЛЕНИЕ движения цены, а не про событие:
        // смерть нисходящего и рождение восходящего — одно и то же
        // движение рынка, прочитанное с двух сторон.
        nR = array.size(RDB)
        if nR > 0
            for k = 0 to nR - 1
                lr = array.get(RDL, k)
                // показываем смерти РИСУЕМОГО слоя плюс 5/5 того же
                // направления как бледный контекст
                bool okShow = lr == drawIdx or lr == (dnSide ? 3 : 0)
                if okShow and last_bar_index - array.get(RDB, k) <= winBars
                    bool isMain = lr == drawIdx
                    rb = array.get(RDB, k)
                    rp = array.get(RDP, k)
                    bool rDn = lr >= 3
                    color cR = rDn ? cTrUp : cTrDie
                    array.push(LNS, line.new(rb - 12, rp, rb + 12, rp, color = color.new(cR, isMain ? 0 : 65), width = isMain ? 2 : 1))
                    if isMain
                        array.push(LBS, label.new(rb, rp, rDn ? "умер ↓" : "умер ↑", style = rDn ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = cR, size = size.tiny, tooltip = (rDn ? "НИСХОДЯЩИЙ умер" : "ВОСХОДЯЩИЙ умер") + " на уровне " + str.tostring(rp, format.mintick) + "\n\nПРАВИЛО СМЕРТИ ОДНО: тело свечи ушло ниже\n   уровень − " + str.tostring(rDn ? depthD : depthU) + " × скользящее среднее колено слоя\nОкно 20 ног. Проверяется КАЖДЫЙ бар. Тень тренд НЕ убивает.\n\nПрежде правил было два — «имп × 0.33» и «4 закрытия ниже» — плюс три настройки. Оба отменены 06.10.2026: Н29 показал, что импульс нигде не измерялся и гулял в шесть раз, Н31 — что вклад правила «4 закрытия» на одной линии с глубиной РОВНО НОЛЬ. По числам не потеряно ничего: связка «оба» давала 81% на 4987 убийствах, простая глубина — 81% на 5132.\n\nСчитается ПО ТЕЛУ: замер Н28 на 11 383 заходах — тело разделяет исходы в 4–6 раз, тень только в 2.3–2.7.\n\nЭто ЕДИНСТВЕННЫЙ конец тренда с чёрточкой. Отмена, отказ и архив следа не оставляют.\n\nСлой: " + (lr % 3 == 0 ? "5/5" : lr % 3 == 1 ? "3/3" : "2/2")))
        // ── РОЖДЕНИЕ: цена перебитой вершины ──
        // С ГРАФИКА УБРАНА под галочку, решение владельца 07.10.2026
        // «да, делаем так». Механизм работает всегда: от этой цены
        // считается запасное подтверждение У7
        if trBirth
            nG = array.size(GDB)
            if nG > 0
                for k = 0 to nG - 1
                    lg = array.get(GDL, k)
                    bool okShowG = lg == drawIdx or lg == (dnSide ? 3 : 0)
                    if okShowG and last_bar_index - array.get(GDB, k) <= winBars
                        bool isMainG = lg == drawIdx
                        gb = array.get(GDB, k)
                        gp = array.get(GDP, k)
                        bool gok = array.get(GOK, k)
                        bool gDn = lg >= 3
                        color cGc = gDn ? cTrDn : cTrUp
                        array.push(LNS, line.new(gb - 12, gp, gb + 12, gp, color = color.new(cGc, isMainG ? 0 : 65), width = isMainG and gok ? 2 : 1))
                        if isMainG
                            array.push(LBS, label.new(gb, gp, (gDn ? "слом ↓" : "слом ↑") + (gok ? "" : " ?"), style = gDn ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cGc, size = size.tiny, tooltip = (gDn ? "РОЖДЕНИЕ НИСХОДЯЩЕГО: сломали восходящую структуру на " : "РОЖДЕНИЕ ВОСХОДЯЩЕГО: сломали нисходящую структуру на ") + str.tostring(gp, format.mintick) + ".\nЦена от нуля перебила " + (gDn ? "этот низ." : "эту вершину.") + "\n" + (gok ? "Тренд ПОДТВЕРЖДЁН." : "Тренд ещё НЕ подтверждён.") + "\n\nЭто ОТМЕТКА СОБЫТИЯ, а не состояние, и она не гаснет: событие было, а событие не отменяется тем, что тренд потом умер.\n\nОт этой цены считается ЗАПАСНОЕ подтверждение У7, когда низ счёта пришёл манипуляционным.\n\nСлой: " + (lg % 3 == 0 ? "5/5" : lg % 3 == 1 ? "3/3" : "2/2")))

    // ── СЛОМЫ: две цены впереди и номера текущей серии ──
    [u5n, d5n] = f_nearest(V5P, V5H)
    [u3n, d3n] = f_nearest(V3P, V3H)
    [u2n, d2n] = f_nearest(V2P, V2H)
    if slOn
        float mUp = mainL == 0 ? u5n : mainL == 1 ? u3n : u2n
        float mDn = mainL == 0 ? d5n : mainL == 1 ? d3n : d2n
        if slLine
            if not na(mUp)
                array.push(LNS, line.new(bar_index - 60, mUp, bar_index, mUp, color = cSlUp, width = 2, extend = extend.right))
                if lvLab != "нет"
                    array.push(LBS, label.new(bar_index, mUp, f_lvTxt("слом ↑ " + str.tostring(mUp, format.mintick) + "   " + str.tostring(100 * (mUp - close) / close, "#.##") + "%", str.tostring(mUp, format.mintick)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlUp, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя " + layMain + " сверху.\nДойдёт сюда цена — будет слом вверх. До него " + str.tostring(100 * (mUp - close) / close, "#.##") + "%.\n\nЭта цена известна ЗАРАНЕЕ, в отличие от колена: колено становится видно только через " + (mainL == 0 ? "пять" : mainL == 1 ? "три" : "два") + " бара после того, как оно случилось.\n\nСлом засчитывается по КАСАНИЮ — хватает тени.\n\nМедиана расстояния за девять лет: 0.61% на 5/5, 0.48% на 3/3, 0.40% на 2/2."))
            if not na(mDn)
                array.push(LNS, line.new(bar_index - 60, mDn, bar_index, mDn, color = cSlDn, width = 2, extend = extend.right))
                if lvLab != "нет"
                    array.push(LBS, label.new(bar_index, mDn, f_lvTxt("слом ↓ " + str.tostring(mDn, format.mintick) + "   " + str.tostring(100 * (close - mDn) / close, "#.##") + "%", str.tostring(mDn, format.mintick)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = cSlDn, size = size.small, tooltip = "Ближайший НЕПРОБИТЫЙ уровень слоя " + layMain + " снизу.\nДойдёт сюда цена — будет слом вниз. До него " + str.tostring(100 * (close - mDn) / close, "#.##") + "%.\n\nМедиана за девять лет: 0.67% на 5/5, 0.53% на 3/3, 0.44% на 2/2."))
        if slNum
            int dirM = array.get(sDIR, mainL)
            nS = array.size(SB)
            if nS > 0
                for k = 0 to nS - 1
                    if array.get(SL, k) == mainL
                        sb = array.get(SB, k)
                        if last_bar_index - sb <= winBars
                            sp = array.get(SP, k)
                            sn = array.get(SN, k)
                            array.push(LBS, label.new(sb, sp, (dirM > 0 ? "↑" : "↓") + str.tostring(sn), style = dirM > 0 ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = dirM > 0 ? cSlUp : cSlDn, size = size.tiny, tooltip = "Слом " + (dirM > 0 ? "ВВЕРХ" : "ВНИЗ") + " номер " + str.tostring(sn) + " в текущей серии.\nЦена взяла непробитый уровень " + str.tostring(sp, format.mintick) + " слоя " + layMain + ".\n\nПоказывается только ТЕКУЩАЯ серия. Сменится направление — эти метки уйдут и счёт начнётся с единицы."))

    // ── ГДЕ «АВТО» ПЕРЕДУМАЛО ──
    if swMark and trWho == "авто"
        nA = array.size(AWB)
        if nA > 0
            for k = 0 to nA - 1
                if array.get(AWL, k) == mainL
                    ab = array.get(AWB, k)
                    if last_bar_index - ab <= winBars
                        bool aDn = array.get(AWD, k)
                        ap = array.get(AWP, k)
                        color cA = aDn ? cTrDn : cTrUp
                        array.push(LBS, label.new(ab, ap, aDn ? "⇄ НИСХ" : "⇄ ВОСХ", style = label.style_label_center, color = color.new(color.black, 100), textcolor = cA, size = size.tiny, tooltip = "Здесь режим «авто» сменил рисуемый тренд на " + (aDn ? "НИСХОДЯЩИЙ" : "ВОСХОДЯЩИЙ") + ".\nСлой " + layMain + ", бар " + str.tostring(ab) + ".\n\nСчёт обоих направлений идёт ВСЕГДА, независимо от того, кто нарисован. Поэтому тренд появляется здесь уже с тем счётом, который набрал, пока был невидим.\n\n«Авто» предпочитает ПОДТВЕРЖДЁННЫЙ тренд «возможному»: иначе в устойчивом падении восходящий рождался бы на каждом отскоке и метка стояла бы через бар."))

    // ══════════════ ТАБЛО ══════════════
    // Это не справка, а рабочий инструмент. Слово владельца 30.09.2026:
    // «работаю на одном слое и посматриваю на таблицу; если вижу в
    // таблице на другом слое интереснее картину, я просто перехожу».
    //
    // Каждый блок слушается СВОЕЙ галочки из ⑤. Прежде всё табло висело
    // на одном условии, и снятая галочка «Считать восходящий тренд»
    // уносила заодно блок нисходящего и блок сломов — замечание З24.
    if trTbl and blkUp
        // строки последовательностей считаем ДО цикла: пайн не умеет
        // тернарник, возвращающий кортеж
        [zlA, tlA, npA] = f_seqNow(PV5, BV5, HV5, LV5, 0)
        [zlB, tlB, npB] = f_seqNow(PV3, BV3, HV3, LV3, 1)
        [zlC, tlC, npC] = f_seqNow(P2,  B2,  H2,  L2,  2)
        table.cell(TBL, 0, 0, "восходящий", text_color = color.gray, text_size = tSz)
        for c = 0 to 2
            nm = c == 0 ? "5/5" : c == 1 ? "3/3" : "2/2"
            bool isMain = c == mainL
            table.cell(TBL, c + 1, 0, isMain ? nm + " ◂" : nm, text_color = isMain ? cTrUp : color.gray, text_size = tSz)
            int    sU  = array.get(tTR, c)
            bool   liv = sU == ST_MAY or sU == ST_LIVE
            float  lv  = array.get(tLVL, c)
            float  leg = array.get(tLEG, c)
            float  thr = na(lv) ? na : lv - depthU * leg
            color  cG  = f_stColor(c, false)
            // ── состояние: ЧЕМ КОНЧИЛОСЬ ──
            table.cell(TBL, c + 1, 1, f_stWord(c, false), text_color = cG, text_size = tSz, tooltip = f_stTip(c, false))
            // ── счёт, с предварительным коленом живого края (З31) ──
            int preU   = c <= 1 ? (array.get(VPRE, c) >= 0 ? 1 : 0) : 0
            int cntRaw = array.get(tCNT, c)
            int cntSh  = liv ? math.min(cntRaw + preU, 5) : cntRaw
            bool hasP  = liv and cntSh > cntRaw
            string cntTxt = sU == ST_ARC ? "(5)/5 ✓" : liv ? "(" + str.tostring(cntSh) + ")/5" + (hasP ? " ⋯" : "") : "—"
            table.cell(TBL, c + 1, 2, cntTxt, text_color = cG, text_size = tSz, tooltip = (sU == ST_ARC ? "АРХИВ. Счёт прошёл весь путь до (5) — галочка про это. Он остаётся на месте намеренно: это РЕЗУЛЬТАТ, а не «ничего нет».\n\n" : "") + "Счёт чередует колена от нуля: нечётная точка вершина, чётная низ. Потолок пять. Встречная подпись счёт НЕ обрывает — она помечает точку как манипуляционную, и нога к ней рисуется штрих-пунктиром.\n\nСчитается по коленам СО ВСТАВКАМИ: доза в ⑧.\n\n" + (hasP ? "⋯ значит, что последняя точка ПРЕДВАРИТЕЛЬНАЯ: колено нарисовал сосед, а наш слой разворот ещё не подтвердил. Счёт его БЕРЁТ СРАЗУ — правило З31. Уровень при этом ждёт своего слоя, а цена может уйти обратно, и точка пропадёт.\n\n" : "") + "После (5) решает ПЕРВЫЙ новый низ, и больше ничего: HL — продолжение, счёт пойдёт с нуля; LL — архив. Одно колено решает судьбу тренда.")
            // ── полных счётов: сколько раз дошёл до (5) и продолжился ──
            table.cell(TBL, c + 1, 3, liv or sU == ST_ARC ? str.tostring(array.get(tRST, c)) : "—", text_color = color.gray, text_size = tSz)
            // ── уровень ──
            table.cell(TBL, c + 1, 4, not liv ? "—" : na(lv) ? "нет" : (array.get(tLHL, c) ? "HL " : "LL ") + str.tostring(lv, format.mintick), text_color = liv and not na(lv) ? (array.get(tLHL, c) ? cTrUp : color.new(cTrUp, 45)) : color.gray, text_size = tSz)
            // ── запас: единственная клетка, смотрящая ВПЕРЁД ──
            float zap = na(thr) ? na : math.min(open, close) - thr
            bool  neg = not na(zap) and zap < 0
            table.cell(TBL, c + 1, 5, na(zap) or not liv ? "—" : str.tostring(zap, format.mintick), text_color = not liv ? color.gray : neg ? cTrDie : color.gray, text_size = tSz)
            // ── возраст счёта ──
            table.cell(TBL, c + 1, 6, liv and array.get(tZB, c) >= 0 ? str.tostring(last_bar_index - array.get(tZB, c)) : "—", text_color = color.gray, text_size = tSz)
            // ── прошлая смерть ──
            db = array.get(tDB, c)
            table.cell(TBL, c + 1, 7, db < 0 ? "—" : str.tostring(last_bar_index - db) + " / " + str.tostring(array.get(tDP, c), format.mintick), text_color = db < 0 ? color.gray : cTrDie, text_size = tSz)
            // ── последовательность: узнаём форму и называем номером ──
            zl = c == 0 ? zlA : c == 1 ? zlB : zlC
            tl = c == 0 ? tlA : c == 1 ? tlB : tlC
            np = c == 0 ? npA : c == 1 ? npB : npC
            [mc, mi, mn] = f_match(tl)
            bool rojd = zl == "LL"
            // индекс считается отдельно и никогда не уходит в минус:
            // при mi = -1 голое выражение дало бы -1 и обращение за
            // границу массива
            int fiU = mi >= 0 ? mi + 8 * c + (rojd ? 0 : 24) : 0
            int fr = mi >= 0 and np >= 5 ? array.get(PFR, fiU) : -1
            // З28: не подошёл НИ ОДИН эталон — в ячейку клалась ПУСТОТА.
            // Самый сильный признак индикатора показывался пустым местом
            string nmU = mc > 0 ? mn : "вне справ."
            bool shows = liv or sU == ST_ARC
            string cell = not shows ? "—" : np < 5 ? (mc <= 3 ? nmU : str.tostring(mc) + " вар.") : nmU
            string tip = not shows ? "Тренда нет." : "Слой " + nm + ", " + (rojd ? "РОЖДЕНИЕ, ноль LL" : "ПРОДОЛЖЕНИЕ, ноль HL") + "\n\nсейчас на графике:  " + zl + (np > 0 ? "·" + tl : "") + "\n" + (mc == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВсе восемь требуют HL на местах (2) и (4) — значит низ оказался LL, была манипуляция.\n\nЗамер Н24 на двух годах часовика: форма ВНЕ справочника доходит до (5) в 46–64% случаев против 71–79% у формы из справочника." : np < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mc) + " из 8 — " + mn : "это " + mn + ", за 9 лет часовика встретилась " + str.tostring(fr) + " раз") + "\n\nПРЕДВАРИТЕЛЬНОЕ колено живого края в эту строку НЕ входит: справочник читает только подтверждённую цепочку.\n\nИндикатор ничего не предсказывает. Он узнаёт форму и называет её номером, как шаблон триггерной свечи."
            table.cell(TBL, c + 1, 8, cell, text_color = shows ? (mc == 0 ? color.orange : np >= 5 ? cTrUp : color.gray) : color.gray, text_size = tSz, tooltip = tip)
        table.cell(TBL, 0, 1, "состояние", text_color = color.gray, text_size = tSz, tooltip = "Чем кончилось: умер · архив · не было · не свой · нет. Плюс два живых: возможен и ВОСХ.\n\nСлова «переход» здесь нет и не будет — решение владельца 07.10.2026.")
        table.cell(TBL, 0, 2, "счёт", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 3, "полных счётов", text_color = color.gray, text_size = tSz, tooltip = "Сколько раз ЭТОТ тренд дошёл до (5) и продолжился, не умирая.\n\n0 — тренд молодой, ни разу не прошёл весь путь. 3 — трижды отработал и жив до сих пор. Такой тренд не просто жив, он СИЛЁН, а по остальным строкам табло отличить его от молодого нельзя.\n\nПродолжение идёт цепочкой: (5) → HL → новый счёт с нуля → (5) → HL → … Это ОДИН тренд, а на графике видно только последний счёт и один бледный перед ним.\n\nОбнуляется вместе с трендом: при смерти, отмене, отказе и архиве.")
        table.cell(TBL, 0, 4, "уровень", text_color = color.gray, text_size = tSz, tooltip = "Последний появившийся HL от нуля. Замена безусловная, храповика нет.\n\nПока HL не пришёл, уровень стоит на НУЛЕ и помечен бледным: он ВРЕМЕННЫЙ, на графике штрих-пунктир без подписи. Тренду надо за что-то держаться с первой минуты, иначе его нечем убить, а бессмертный тренд хуже опоры на LL.\n\nПока уровень временный, тренд отменяется закрытием ниже нуля — без всякого буфера. Штрих-пунктир это предположение, его стирают легко.")
        table.cell(TBL, 0, 5, "запас " + str.tostring(depthU) + " кол.", text_color = color.gray, text_size = tSz, tooltip = "Сколько осталось телу свечи до порога смерти:\n   запас = min(открытие, закрытие) − (уровень − " + str.tostring(depthU) + " × скользящее колено)\n\nМИНУС ЗНАЧИТ РОВНО ОДНО: эта НЕЗАКРЫТАЯ свеча уже за порогом. Закроется так — тренд умрёт.\n\nПоломки здесь нет. Движок проверяет смерть только на ЗАКРЫТЫХ свечах, а табло пересчитывается каждый тик по текущей. Это ЕДИНСТВЕННАЯ клетка табло, которая смотрит ВПЕРЁД — и смотрит честно: говорит не «что будет», а «что уже есть на незакрытой свече». Предсказания здесь нет.\n\nУшла в минус — клетка красится в цвет смерти. Висело открытым как З10 почти три недели: владелец видел минус и читал его как странность, потому что нигде не было написано, что он значит.")
        table.cell(TBL, 0, 6, "баров от (0)", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 7, "прошлая смерть", text_color = color.gray, text_size = tSz, tooltip = "Сколько баров назад умер прошлый тренд этого слоя и на какой цене.\n\nСтрока называлась «прошлый слом». Переименована 07.10.2026: слово «слом» теперь значит ОДНО — цена взяла непробитый пивот слоя, блок ниже. Смерть тренда это другое событие, и путать их в одном табло нельзя (З35).")
        table.cell(TBL, 0, 8, "посл-ть", text_color = color.gray, text_size = tSz, tooltip = "Номер последовательности из справочника на девяти годах часовика.\n\nВосходящий всегда начинается с LL — это ноль (0). Низы в нём всегда HL, иначе это не восходящий. Поэтому свободны только вершины, и вариантов ровно восемь.\n\nПока счёт не дошёл до (5), показано, сколько эталонов ещё подходят. Дошёл — показан номер, в подсказке ячейки написано, сколько раз он встречался.\n\nПродолжение отличается нулём: у него он HL, а не LL, и свои частоты.\n\nЗамер Н24: «вне справ.» доходит до (5) в 46–64% против 71–79% у формы из справочника.")

    // ── НИСХОДЯЩИЙ: те же девять строк, ячейки 3-5 ──
    // Цены в этих ячейках отрицательные — перевёрнутый мир. Всё, что
    // идёт в табло, переворачивается обратно знаком.
    if trTbl and blkDn
        [zlD, tlD, npD] = f_seqNow(PV5n, BV5n, HV5n, LV5n, 3)
        [zlE, tlE, npE] = f_seqNow(PV3n, BV3n, HV3n, LV3n, 4)
        [zlF, tlF, npF] = f_seqNow(P2n,  B2n,  H2n,  L2n,  5)
        table.cell(TBL, 0, 9, "нисходящий", text_color = color.gray, text_size = tSz, tooltip = "Нисходящий считается ТЕМ ЖЕ движком на перевёрнутых свечах. Второго набора правил не существует — зеркало точное по построению." + (mirDiff > 0 ? "\n\nВНИМАНИЕ: у нисходящего заведено ОТЛИЧИЙ от восходящего: " + str.tostring(mirDiff) + ". Зеркало как тождество больше не держится, и бесплатная проверка прогоном на перевёрнутых данных по этим строкам умерла." : "\n\nзеркало: цело — все правила нисходящего стоят на значениях восходящего, и любой замер по нему проверяется прогоном восходящего на перевёрнутых данных."))
        for c = 0 to 2
            nmD = c == 0 ? "5/5" : c == 1 ? "3/3" : "2/2"
            bool isMainD = c == mainL
            table.cell(TBL, c + 1, 9, isMainD ? nmD + " ◂" : nmD, text_color = isMainD ? cTrDn : color.gray, text_size = tSz)
            int    sD  = array.get(tTR, c + 3)
            bool   livD = sD == ST_MAY or sD == ST_LIVE
            float  lvD = array.get(tLVL, c + 3)
            float  legD = array.get(tLEG, c + 3)
            float  thrD = na(lvD) ? na : lvD - depthD * legD
            color  cD  = f_stColor(c + 3, true)
            table.cell(TBL, c + 1, 10, f_stWord(c + 3, true), text_color = cD, text_size = tSz, tooltip = f_stTip(c + 3, true))
            int preD   = c <= 1 ? (array.get(VPRE, c + 2) >= 0 ? 1 : 0) : 0
            int cntRawD = array.get(tCNT, c + 3)
            int cntShD  = livD ? math.min(cntRawD + preD, 5) : cntRawD
            bool hasPD  = livD and cntShD > cntRawD
            table.cell(TBL, c + 1, 11, sD == ST_ARC ? "(5)/5 ✓" : livD ? "(" + str.tostring(cntShD) + ")/5" + (hasPD ? " ⋯" : "") : "—", text_color = cD, text_size = tSz)
            table.cell(TBL, c + 1, 12, livD or sD == ST_ARC ? str.tostring(array.get(tRST, c + 3)) : "—", text_color = color.gray, text_size = tSz)
            table.cell(TBL, c + 1, 13, not livD ? "—" : na(lvD) ? "нет" : (array.get(tLHL, c + 3) ? "LH " : "HH ") + str.tostring(-lvD, format.mintick), text_color = livD and not na(lvD) ? (array.get(tLHL, c + 3) ? cTrDn : color.new(cTrDn, 45)) : color.gray, text_size = tSz)
            float zapD = na(thrD) ? na : math.min(-open, -close) - thrD
            bool  negD = not na(zapD) and zapD < 0
            table.cell(TBL, c + 1, 14, na(zapD) or not livD ? "—" : str.tostring(zapD, format.mintick), text_color = not livD ? color.gray : negD ? cTrDie : color.gray, text_size = tSz)
            table.cell(TBL, c + 1, 15, livD and array.get(tZB, c + 3) >= 0 ? str.tostring(last_bar_index - array.get(tZB, c + 3)) : "—", text_color = color.gray, text_size = tSz)
            dbD = array.get(tDB, c + 3)
            table.cell(TBL, c + 1, 16, dbD < 0 ? "—" : str.tostring(last_bar_index - dbD) + " / " + str.tostring(-array.get(tDP, c + 3), format.mintick), text_color = dbD < 0 ? color.gray : cTrUp, text_size = tSz)
            zlN = c == 0 ? zlD : c == 1 ? zlE : zlF
            tlN = c == 0 ? tlD : c == 1 ? tlE : tlF
            npN = c == 0 ? npD : c == 1 ? npE : npF
            [mcN, miN, mnN] = f_matchS(tlN)
            bool rojdN = zlN == "LL"
            int fiN = miN >= 0 ? miN + 8 * c + (rojdN ? 0 : 24) : 0
            int frN = miN >= 0 and npN >= 5 ? array.get(SFR, fiN) : -1
            string nmD2 = mcN > 0 ? mnN : "вне справ."
            bool showsN = livD or sD == ST_ARC
            string cellN = not showsN ? "—" : npN < 5 ? (mcN <= 3 ? nmD2 : str.tostring(mcN) + " вар.") : nmD2
            string tipN = not showsN ? "Тренда нет." : "Слой " + nmD + ", " + (rojdN ? "РОЖДЕНИЕ, ноль HH" : "ПРОДОЛЖЕНИЕ, ноль LH") + "\n\nсейчас на графике:  " + f_swap1(zlN) + (npN > 0 ? "·" + f_swapSeq(tlN) : "") + "\n" + (mcN == 0 ? "ФОРМА ВЫШЛА ИЗ СПРАВОЧНИКА: ни один из восьми эталонов больше не подходит.\nВ нисходящем все восемь требуют LH на местах (2) и (4) — значит вершина оказалась HH, была манипуляция.\n\nЗамер Н24: форма ВНЕ справочника доходит до (5) в 46–64% случаев против 71–79% у формы из справочника." : npN < 5 ? "счёт не дошёл до (5): подходят ещё " + str.tostring(mcN) + " из 8 — " + mnN : "это " + mnN + ", за 9 лет часовика встретилась " + str.tostring(frN) + " раз") + "\n\nВершины в нисходящем всегда LH — иначе это не нисходящий. Свободны только низы, и вариантов ровно восемь.\n\nНумерация зеркальная: С1 это зеркало П1."
            table.cell(TBL, c + 1, 17, cellN, text_color = showsN ? (mcN == 0 ? color.orange : npN >= 5 ? cTrDn : color.gray) : color.gray, text_size = tSz, tooltip = tipN)
        table.cell(TBL, 0, 10, "состояние", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 11, "счёт", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 12, "полных счётов", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 13, "уровень", text_color = color.gray, text_size = tSz, tooltip = "Уровень нисходящего — последняя появившаяся LH. Новая LH заменяет предыдущую безусловно, ниже она или выше. Бледная подпись значит, что уровень ещё ВРЕМЕННЫЙ и стоит на нуле.")
        table.cell(TBL, 0, 14, "запас " + str.tostring(depthD) + " кол.", text_color = color.gray, text_size = tSz, tooltip = "То же, что у восходящего, зеркально. МИНУС значит: закроется так — тренд умрёт.")
        table.cell(TBL, 0, 15, "баров от (0)", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 16, "прошлая смерть", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 17, "посл-ть", text_color = color.gray, text_size = tSz, tooltip = "Номер последовательности из справочника нисходящего, перепись девяти лет часовика.\n\nНисходящий всегда начинается с HH — это ноль (0). Вершины в нём всегда LH, иначе это не нисходящий. Поэтому свободны только низы, и вариантов ровно восемь.\n\nНумерация ЗЕРКАЛЬНАЯ: С1 это зеркало П1, С5 зеркало П5 и так далее. Так две таблицы кладутся рядом и сравниваются напрямую.\n\nПродолжение отличается нулём: у него он LH, а не HH, и свои частоты.")

    // ── СЛОМЫ В ТАБЛО ──
    if slOn and blkSl
        table.cell(TBL, 0, 18, "сломов подряд", text_color = color.gray, text_size = tSz, tooltip = "Сколько сломов подряд ушло в одну сторону. Слом — цена взяла ближайший непробитый пивот слоя, по касанию.\n\nПотолка у этого счёта нет: за девять лет серии доходили до 16-24 сломов, и потолок на пяти отрезал бы самые длинные десять процентов.")
        table.cell(TBL, 0, 19, "последний слом", text_color = color.gray, text_size = tSz)
        table.cell(TBL, 0, 20, "до слома ↑", text_color = color.gray, text_size = tSz, tooltip = "Ближайший непробитый уровень сверху и расстояние до него в процентах от цены. За девять лет медиана этого расстояния: 0.61% на 5/5, 0.48% на 3/3, 0.40% на 2/2.")
        table.cell(TBL, 0, 21, "до слома ↓", text_color = color.gray, text_size = tSz, tooltip = "Ближайший непробитый уровень снизу. Медиана за девять лет: 0.67% на 5/5, 0.53% на 3/3, 0.44% на 2/2.")
        table.cell(TBL, 0, 22, "раньше шло туда же", text_color = color.gray, text_size = tSz, tooltip = "Замер Н14, девять лет часовика. Доля случаев, когда после такой же серии следующий слом уходил В ТУ ЖЕ сторону.\n\nВ подсказке ячейки — размер выборки и надбавка к собственной базовой доле сломов вверх по этому слою. Надбавка считается не от 50%: на растущем золоте без этой поправки цифра говорила бы про рост, а не про сломы.\n\nЭто НЕ предсказание. Это частота, снятая с истории, — как шаблон триггерной свечи.\n\nВладелец забраковал эту строку словами «он предсказывает, а в торговле это плохо» (З34). Переселение числа в подсказку метки слома идёт ВЫПУСКОМ 2 — убирать строку раньше, чем ей найдено место, значит потерять число.")
        for c = 0 to 2
            int dr = array.get(sDIR, c)
            int rn = array.get(sRUN, c)
            color cS = dr > 0 ? cSlUp : dr < 0 ? cSlDn : color.gray
            table.cell(TBL, c + 1, 18, dr == 0 ? "—" : (dr > 0 ? "↑" : "↓") + str.tostring(rn), text_color = cS, text_size = tSz)
            int lb2 = array.get(sLB, c)
            table.cell(TBL, c + 1, 19, lb2 < 0 ? "—" : str.tostring(last_bar_index - lb2) + " / " + str.tostring(array.get(sLP, c), format.mintick), text_color = color.gray, text_size = tSz)
            float uN = c == 0 ? u5n : c == 1 ? u3n : u2n
            float dN = c == 0 ? d5n : c == 1 ? d3n : d2n
            table.cell(TBL, c + 1, 20, na(uN) ? "—" : str.tostring(uN, format.mintick) + "  " + str.tostring(100 * (uN - close) / close, "#.##") + "%", text_color = cSlUp, text_size = tSz)
            table.cell(TBL, c + 1, 21, na(dN) ? "—" : str.tostring(dN, format.mintick) + "  " + str.tostring(100 * (close - dN) / close, "#.##") + "%", text_color = cSlDn, text_size = tSz)
            string fcell = "—"
            string ftip  = "Серии ещё нет."
            if dr != 0 and rn > 0
                int rk = rn > 5 ? 5 : rn
                int fi = c * 10 + (dr > 0 ? 0 : 5) + rk - 1
                float fq = array.get(SFQ, fi)
                int fn = array.get(SFN, fi)
                float bs = dr > 0 ? array.get(SFB, c) : 100 - array.get(SFB, c)
                fcell := str.tostring(fq, "#.#") + "%"
                ftip  := "После " + str.tostring(rk) + (rn > 5 ? " и более" : "") + " сломов подряд " + (dr > 0 ? "вверх" : "вниз") + " следующий уходил туда же в " + str.tostring(fq, "#.#") + "% случаев.\nВыборка: " + str.tostring(fn) + " случаев.\nБазовая доля по слою: " + str.tostring(bs, "#.#") + "%.\nНадбавка: " + (fq - bs >= 0 ? "+" : "") + str.tostring(fq - bs, "#.#") + " процентных пункта."
            table.cell(TBL, c + 1, 22, fcell, text_color = cS, text_size = tSz, tooltip = ftip)

    // ── ВСТАВКИ В ТАБЛО: одна строка-прибор ──
    if trTbl and blkVs
        table.cell(TBL, 0, 23, "вставок в коленах", text_color = color.gray, text_size = tSz, tooltip = "Сколько сырых вставок РЕАЛЬНО стало коленом слоя за всю историю графика. ↑ считает прямая цепочка, ↓ перевёрнутая.\n\nЧисла ↑ и ↓ ОБЯЗАНЫ совпадать: перевёрнутый мир берёт ровно те же пивоты. Разошлись — сломано зеркало.\n\nСчитаются только те, что СТАЛИ коленом. Вставка, совпавшая по стороне с предыдущим коленом, поглощается и сюда не идёт — З22.\n\nУ слоя 2/2 соседа снизу нет, там прочерк.")
        for c2 = 0 to 1
            table.cell(TBL, c2 + 1, 23, "↑" + str.tostring(array.get(VINS, c2)) + "  ↓" + str.tostring(array.get(VINS, c2 + 2)), text_color = color.gray, text_size = tSz)
        table.cell(TBL, 3, 23, "—", text_color = color.gray, text_size = tSz)
