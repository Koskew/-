g7 = "⑦ ПРАВИЛА ТРЕНДА · ВОСХОДЯЩИЙ"
trOn5   = input.bool(true, "Считать", group = g7, tooltip = "Считается СРАЗУ ПО ТРЁМ слоям, независимо. В табло три колонки. На графике рисуется тот слой, который выбран в ①.\n\nЖИЗНЕННЫЙ ЦИКЛ, девять подразделов:\n\n· РОЖДЕНИЕ — ноль ставится на низ LL, и первая же вершина после него — HH или LH всё равно — объявляет (1). Состояние «возможен»;\n· ПОДТВЕРЖДЕНИЕ — пришёл HL, свой или вставленный. Состояние «ВОСХ», ноги счёта становятся толстыми;\n· СЧЁТ — чередование колен от нуля, нечётная точка вершина, чётная низ, потолок пять. Встречная подпись счёт НЕ обрывает, она помечает точку как манипуляционную;\n· УРОВЕНЬ — последний появившийся HL от нуля. Храповика нет: новый HL заменяет прежний безусловно, выше тот или ниже. Колено, ставшее манипуляционным, уровень теряет — он возвращается на предыдущий HL;\n· СМЕРТЬ — тело свечи ушло ниже уровня на 0.20 скользящего колена слоя;\n· ПОСЛЕ (5) — четыре исхода и ничего больше: продолжение, архив, смерть, отказ.\n\nПРОДОЛЖЕНИЕ требует (5), а НЕ (3), и только у ЖИВОГО тренда. Умерший тренд продолжиться не может — он рождается заново, и ноль у него LL. Прежняя подсказка обещала продолжение с (3): этого правила в коде нет и не будет, замечание З33.")
trDepth = input.float(0.20, "Глубина, долей колена", minval = 0.0, maxval = 2.0, step = 0.01, group = g7, tooltip = "Порог смерти: уровень − ЭТА ДОЛЯ × скользящее среднее колено слоя (окно 20 ног).\n\nЭто ЕДИНСТВЕННАЯ ручка строгости. Прежде их было три — «Чем убивается тренд», «Свечей подряд ниже уровня», «Глубина, импульсов», — и по числам Н30, Н31 связка «оба» давала 81% на 4987 убийствах, а простая глубина 0.30 даёт 81% на 5132. Та же точка, одна ручка вместо трёх.\n\nОТКУДА 0.20. Замер Н28 на 11 383 заходах за девять лет: тело уходило за уровень на 0.04–0.09 колена, когда тренд оправлялся, и на 0.25–0.33, когда слабел. Разделение в 4–6 раз. По тени только 2.3–2.7 раза — поэтому считается ПО ТЕЛУ, min(открытие, закрытие), и тень тренд не убивает.\n\nЦЕНА, Н30: убивает по делу 77%, зря 23%, пропускает 34% слабеющих. Базовая доля ослаблений 63%. ОПТИМУМА НЕТ — кривая монотонная, это размен строгости на терпение, а не настройка «правильного» числа. Больше 0.20 — тренды живут дольше и чаще зря; меньше — умирают быстрее и чаще зря.\n\nОкно 20 зашито: Н30 показал, что при 10, 20 и 50 результат не меняется, разброс ≤ 0.03 в двенадцати парах из двенадцати.")
trBrk   = input.string("выше вершины на 0.20 колена", "Запасное подтверждение, когда низ пришёл манипуляционным", options = ["выше вершины на 0.20 колена", "4 закрытия выше вершины"], group = g7, tooltip = "ОСНОВНОЕ правило подтверждения не меняется и в ручку не входит: пришёл HL — тренд подтверждён, всегда и в первую очередь.\n\nЭта ручка — ЗАПАСНОЕ правило, и оно СПИТ, пока в счёте не появился низ с подписью LL. Задача: если низ пришёл манипуляционным, подтверждения нет и быть не может, пока не придёт следующий низ. Счёт при этом идёт: (1), (2), (3)… Тренд мог дойти до (3) и остаться нарисованным весь штрих-пунктиром, хотя цена ушла далеко вверх.\n\nПроснувшись, запасное подтверждает ПО ЦЕНЕ от перебитой вершины — той самой, что отмечена чёрточкой рождения:\n· «выше вершины на 0.20 колена» — та же мерка, что у смерти. Одно число на весь движок;\n· «4 закрытия выше вершины» — столько закрытий подряд.\n\nПришедший позже HL ничего не отменяет — тренд уже подтверждён.\n\nУРОВЕНЬ при этом НЕ переезжает: манипуляционное колено его не держит. Появляется состояние «тренд подтверждён, но опора у него ещё временная» — сплошные ноги счёта плюс штрих-пунктирный уровень без подписи.")

g8 = "⑦ ПРАВИЛА ТРЕНДА · НИСХОДЯЩИЙ"
trDn    = input.bool(true, "Считать", group = g8, tooltip = "Нисходящий считается ТЕМ ЖЕ движком на ПЕРЕВЁРНУТЫХ свечах. Идея владельца 22.09.2026: не переводить сорок правил руками, а перевернуть цены. Перевёрнутая свеча — знак меняется, максимум и минимум местами. Тогда пивот-вершина на перевёрнутых это пивот-низ на настоящих, HH это LL, HL это LH, а ВОСХОДЯЩИЙ на перевёрнутых это НИСХОДЯЩИЙ на настоящих.\n\nВторого набора правил не существует: зеркало точное ПО ПОСТРОЕНИЮ, а не потому, что я аккуратно переписал условия.\n\nПроверено на девяти годах часовика: 519 трендов на 5/5, 806 на 3/3, 1131 на 2/2. Падений больше числом и короче по жизни, чем ростов, — ровно та форма, которую обязан дать растущий рынок. Покрытие баров хоть каким-то трендом выросло с 60% до 93%.\n\n07.10.2026 зеркало проверено прогоном, research/zerkalo_check.py: бары, цены, стороны и среднее колено совпадают ВЕЗДЕ. Подписи расходились на 2–5 коленах из 7–11 тысяч, причина одна — точное равенство цен. Починено, стало 0.")
dnSame  = input.bool(true, "Правила как у восходящего", group = g8, tooltip = "Пока галочка стоит, нисходящий берёт значения восходящего, и ПРОВЕРКА ЗЕРКАЛА ОСТАЁТСЯ МЕХАНИЧЕСКОЙ: любой замер по нисходящему проверяется прогоном восходящего на перевёрнутых данных.\n\nСнять — у нисходящего заработают свои значения из двух строк ниже.\n\nЧЕСТНАЯ ЦЕНА ОТЛИЧИЙ, названа при фиксации формы 01.10.2026: бесплатная проверка умирает. Поэтому правило — отличие заводится не на всякий случай, а когда владелец УВИДЕЛ разницу на графике или её показал замер.\n\nЗеркало КАК УСТРОЙСТВО не ломается никогда: движок один, ему подают перевёрнутые свечи. Ломается зеркало КАК ТОЖДЕСТВО — оно держится, пока значения равны. Отличие это ЗНАЧЕНИЕ, а не вторая ветка кода.")
dnDepth = input.float(0.20, "Глубина, долей колена (своя)", minval = 0.0, maxval = 2.0, step = 0.01, group = g8, tooltip = "Работает только когда снята галочка «Правила как у восходящего».")
dnBrk   = input.string("выше вершины на 0.20 колена", "Запасное подтверждение (своё)", options = ["выше вершины на 0.20 колена", "4 закрытия выше вершины"], group = g8, tooltip = "Работает только когда снята галочка «Правила как у восходящего». В перевёрнутом мире «выше вершины» читается как «ниже низа» на настоящем графике.")

g9 = "⑧ ВСТАВКИ — общие для обоих направлений"
// 30.09.2026, слово владельца: «не отдельным разделом в настройки, а
// обязательным условием для нисходящего и восходящего тренда».
//
// Колена у восходящего и нисходящего ОДНИ И ТЕ ЖЕ: один зиг-заг, те же
// бары, те же цены. Разведи дозу по направлениям — зеркало поедет сразу,
// ещё до всяких правил смерти. Поэтому раздел общий, НАД состояниями.
// Разделение по СЛОЯМ зеркалу не мешает: слой это не направление.
vsCap5 = input.string("2", "Вставок в одну ногу · 5/5", options = ["0", "1", "2"], group = g9, tooltip = "Сколько ЧУЖИХ колен слой 5/5 терпит в одной ноге, прежде чем ОТКАЗАТЬСЯ от тренда. Донор один — 3/3.\n\nСМЫСЛ РУЧКИ ИЗМЕНИЛСЯ. Прежде она отвечала на вопрос «сколько сырых вставок пускать в колена слоя». Теперь — на вопрос «сколько чужих колен слой терпит». Правило §33, придумано владельцем:\n\n   Слою разрешено занять N колен. Пока доза не израсходована, счёт ОБЯЗАН вставку взять. Как только понадобилась лишняя — слой перестаёт считать этот тренд: в табло «не свой», зиг-заг серый без номеров, уровень гаснет, красной чёрточки НЕТ.\n\nПустая клетка у медленного слоя при живом счёте у быстрого — это не дыра, а подсказка «перейди на другой слой».\n\n· 0 — слой отказывается при ПЕРВОМ же пропущенном колене;\n· 1 — одно колено терпит, на втором отказывается;\n· 2 — ЭТАЛОН для 5/5, решение владельца 06.10.2026 «давай дозу 2 для 5/5 и 1 для 3/3».\n\nПОЧЕМУ 2, числа Н26: при дозе 1 и доноре 3/3+2/2 слой 5/5 отказывался на 68% счётов, брал 1750 колен и доходил до (5) в 24% случаев. При дозе 2 и доноре только 3/3 — отказов 8%, колен 1797, до (5) 29%. Выигрыш по трём меркам сразу.\n\nВарианта «без ограничения» больше нет: слово владельца «убирай без ограничения». Это и было «никогда не сдаваться» — слой со бесконечной дозой становился слоем-донором, 737 трендов против 736 у чистого 3/3.\n\nЧем больше доза, тем ближе 5/5 к 3/3. Это арифметика, а не вкус: пивот 5/5 — всегда и пивот 3/3.")
vsCap3 = input.string("1", "Вставок в одну ногу · 3/3", options = ["0", "1", "2"], group = g9, tooltip = "То же для слоя 3/3. Донор один — 2/2. Эталон 1, решение владельца 06.10.2026.\n\nУ слоя 2/2 этой ручки нет и быть не может: соседа снизу у него нет, занимать не у кого. Отказаться от тренда 2/2 тоже не может — ему нечего не хватать.\n\nЗАПАСНОЙ ДОНОР УБРАН, 06.10.2026: «да, убираем запасного донора». Правило одно, без исключений — каждый слой занимает только у СОСЕДА, через слой никогда. Вместе с ним с графика исчезли метки `··` с двумя точками: их больше не будет вовсе.\n\nЗамер Н19 — «запасных меток на 5/5 больше, чем с 3/3, 1960 против 1790» — уходит в архив. Н26 показал, что эти 170 лишних меток не помогают, а создают СПРОС, который при израсходованной дозе превращается в отказ.")

g10 = "⑨ ПРАВИЛА СЛОМОВ"
slOn    = input.bool(true, "Считать сломы", group = g10, tooltip = "Слом — цена взяла ближайший НЕПРОБИТЫЙ пивот слоя. Это тот самый момент, когда живой уровень из ③ перестаёт быть живым.\n\nКолено становится известно задним числом: на 2/2 через два бара, на 5/5 через пять. Слом известен ЗАРАНЕЕ — цена, которую надо пробить, уже нарисована на графике.\n\nЗамер Н14, девять лет часовика: сломы НЕ независимы, они слипаются. После серии в одну сторону следующий идёт туда же чаще собственной базовой доли на 7-20 процентных пунктов. Тридцать клеток, все положительные, знак держится в обеих половинах выборки, перемешанный контроль садится в ноль.\n\nСчитаются все четыре метки. Слом засчитывается по КАСАНИЮ: хватает тени. Замер сделан по тому же правилу.")
slNoCap = input.bool(true, "Счёт без потолка", group = g10, tooltip = "У счёта по коленам потолок пять. У сломов серии доходят до 16-24, и потолок отрезал бы самые длинные десять процентов. Поэтому счёт растёт, сколько идёт.\n\nЧастота в табло для всего, что длиннее пяти, берётся из клетки «5 и больше».")

g11 = "⑩ СТАРШИЕ ТФ"
hOn    = input.bool(true, "Показывать", inline = "h", group = g11)
h_tf4  = input.bool(true, "4H",         inline = "h", group = g11)
h_tfd  = input.bool(true, "1D",         inline = "h", group = g11)
hLB    = input.int(3, "Глубина пивота старших ТФ", minval = 1, maxval = 8, group = g11, tooltip = "Уровни 4H и 1D общие, один набор на всех слоёв. Цвета — в ⑥.")

// ══════════════ ПРОИЗВОДНЫЕ ОТ НАСТРОЕК ══════════════
// Три галочки слоёв стали одной строкой (П1, 30.09.2026). Чтобы ниже
// ничего не переписывать, восстанавливаем прежние флаги из двух списков:
// слой показан, если он выбран рабочим ИЛИ наложен сверху
bool on5 = layMain == "5/5" or layOver == "5/5"
bool on3 = layMain == "3/3" or layOver == "3/3"
bool on2 = layMain == "2/2" or layOver == "2/2"
// РАБОЧИЙ слой: 0 это 5/5, 1 это 3/3, 2 это 2/2. Только по нему рисуется
// тренд. Понятие «главного слоя» убрано, это просто «что нарисовать»
int mainL = layMain == "5/5" ? 0 : layMain == "3/3" ? 1 : 2
// наложенный слой, -1 если нет
int overL = layOver == "5/5" ? 0 : layOver == "3/3" ? 1 : layOver == "2/2" ? 2 : -1

// доза вставок числом, по слоям
int vsN5 = vsCap5 == "0" ? 0 : vsCap5 == "1" ? 1 : 2
int vsN3 = vsCap3 == "0" ? 0 : vsCap3 == "1" ? 1 : 2

// глубина смерти и запасное подтверждение: у нисходящего либо своё, либо
// как у восходящего. ОТЛИЧИЕ — ЭТО ЗНАЧЕНИЕ, А НЕ ВТОРАЯ ВЕТКА КОДА:
// движок один, ему подаются разные числа. Решение 01.10.2026
float depthU = trDepth
float depthD = dnSame ? trDepth : dnDepth
string brkU  = trBrk
string brkD  = dnSame ? trBrk : dnBrk
// сколько отличий от зеркала завёл владелец — для строки табло
int mirDiff = (dnSame ? 0 : (dnDepth != trDepth ? 1 : 0) + (dnBrk != trBrk ? 1 : 0))

// окно скользящего среднего колена. Зашито: Н30 показал, что при 10, 20
// и 50 результат не меняется — разброс ≤ 0.03 в двенадцати парах из
// двенадцати. Ручку заводить не из чего
LEGWIN = 20
// сколько закрытий подряд для варианта «4 закрытия выше вершины»
NBAR = 4

MAXK = 100
// «нуля счёта нет». Пайн не принимает na в параметр функции, у которого
// тип выводится из вызова, — ни голый, ни через int-переменную. Поэтому
// сторож обычным числом: бар-индекс никогда не бывает отрицательным.
NOZERO = -1

// ── СОСТОЯНИЯ ТРЕНДА. Семь значений вместо двух ──
// §36 и §48: у тренда ЧЕТЫРЕ КОНЦА, и табло пишет, ЧЕМ КОНЧИЛОСЬ.
// Прежде движок знал один конец — смерть — и сваливал в неё всё: не
// дошедший счёт, слепой слой, ложный старт. Отсюда были З18 и З19.
ST_NO   = 0     // нет тренда
ST_MAY  = 1     // ВОЗМОЖЕН: есть (0) LL и пришла (1). Не подтверждён
ST_LIVE = 2     // ВОСХ / НИСХ: пришёл HL, тренд подтверждён
ST_REF  = 3     // НЕ СВОЙ: ОТКАЗ, слою понадобилась лишняя чужая метка
ST_ARC  = 4     // АРХИВ: после (5) пришёл низ LL
ST_CAN  = 5     // НЕ БЫЛО: ОТМЕНА, цена ушла ниже нуля до подтверждения
ST_DEAD = 6     // УМЕР: тело ушло ниже порога

// ══════════════ КОЛЕНА (для зиг-зага и подписей) ══════════════
// Колено — пивот; подряд идущие одной стороны схлопываются в экстремум.
var float[]  P5 = array.new_float()
var int[]    B5 = array.new_int()
var bool[]   H5 = array.new_bool()
var string[] L5 = array.new_string()
var int[]    M5 = array.new_int()
var float[]  G5 = array.new_float()
var int[]    Y5 = array.new_int()
var bool[]   Z5 = array.new_bool()
var string[] W5 = array.new_string()

var float[]  P3 = array.new_float()
var int[]    B3 = array.new_int()
var bool[]   H3 = array.new_bool()
var string[] L3 = array.new_string()
var int[]    M3 = array.new_int()
