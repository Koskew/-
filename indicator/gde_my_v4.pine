//@version=5
// ═══════════════════════════════════════════════════════════════════
// ГДЕ МЫ v3
//
// Против v2:
//   • тренд имеет ДВА состояния — восходящий и нисходящий. Между смертью
//     и подтверждением нового идёт ПЕРЕХОД, но цвет держится старый,
//     чтобы зиг-заг всегда был зелёным или красным.
//   • слом требует ГЛУБИНЫ: тело должно уйти за уровень не меньше чем на
//     заданную долю последнего ИМПУЛЬСНОГО колена. Мелкий прокол не убивает.
//   • защита от повторного слома об один и тот же уровень.
//   • БОКОВИК — отдельный слой поверх трендов. Рамка из свежей пары HH и LL,
//     пришедших в любом порядке, замораживается; коробка живёт, пока цена
//     не закрылась за границей. В счёте и в тренде не участвует.
//   • метки 5/5 в настройках: отдельно сырые, отдельно на коленах.
// ═══════════════════════════════════════════════════════════════════
indicator("ГДЕ МЫ v4", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100, max_bars_back=3000)

gA = "Слой"
useSlow = input.bool(true, "5/5 (иначе 2/2)", group=gA)

gB = "Структура"
drawZZ   = input.bool(true,  "Зиг-заг по коленам", group=gB)
drawRaw  = input.bool(false, "Сырые метки пивотов 5/5", group=gB, tooltip="Как в старом индикаторе: сравнение с предыдущим ПИВОТОМ, без схлопывания.")
labMode  = input.string("номер + мутность", "Что писать у колена", options=["номер + мутность","метка","номер и метка","ничего"], group=gB, tooltip="ОДНА подпись на колено вместо трёх — наложений больше нет. Метка, номер точки, тип колена и данные о мутности видны в тултипе при наведении мыши.")
drawMud  = input.bool(true,  "Помечать мутные колена", group=gB, tooltip="Колено, собранное из двух и более меток: первая метка появилась, была перебита, цена сделала второй экстремум. Это и есть манипуляция. Около 20% колен.")
cMud     = input.color(#ff9800, "Цвет пометки мутного", group=gB)
winBars  = input.int(700, "Рисовать за последние N баров", minval=100, group=gB)

gC = "Слом тренда"
fibDepth = input.float(0.33, "Глубина слома, доля импульсного колена", 0.0, 1.0, 0.01, group=gC, tooltip="0 = любой пробой телом убивает тренд. 0.33 = нужно уйти за уровень на треть последнего импульсного колена.")
drawLvl  = input.bool(true, "Уровень, который держит тренд", group=gC)
drawMSB  = input.bool(true, "Отметка слома", group=gC)
jumpConf = input.float(0.5, "Досрочное подтверждение, импульсов", 0.0, 3.0, 0.25, group=gC, tooltip="Пауза «жду 2 метки» считает КОЛЕНА. В одностороннем обвале каждый новый минимум сливается в то же колено, счётчик стоит, и тренд не подтверждается сколько бы цена ни прошла. Если цена ушла от уровня смерти дальше этой доли импульсного колена И структура согласна — тренд подтверждается не дожидаясь второго колена. 0 выключает. Замер на 2 годах: 0.5 сокращает медиану ПЕРЕХОДА с 19 до 13 баров, долю переходов длиннее 20 баров с 45% до 23%, а ложных стартов становится не больше, а меньше — 6% против 9%.")

gD = "Боковик"
boxOn   = input.bool(true, "Искать боковик", group=gD)
boxN    = input.int(6, "Колен внутри рамки", minval=2, maxval=15, group=gD, tooltip="Сколько колен подряд должны остаться внутри, чтобы это стало боковиком. 6 даёт около 29% времени на золоте, 4 — около 63%.")
boxM    = input.int(3, "Свежесть пары HH/LL, колен", minval=1, maxval=8, group=gD)
boxMaxH = input.float(2.5, "Макс. высота, в коленах", 0.0, 10.0, 0.5, group=gD, tooltip="Коробка выше этого не боковик, а широкий свинг. 0 = без ограничения. При 2.5 покрытие около 18% на обоих ТФ.")
boxKeep = input.int(4, "Держать последних коробок", minval=1, maxval=20, group=gD)

gE = "Цвета"
cUp   = input.color(#00b050, "Восходящий", group=gE)
cDn   = input.color(#e0342c, "Нисходящий", group=gE)
cBox  = input.color(color.new(#9c27b0, 88), "Заливка боковика", group=gE)
cBoxB = input.color(#9c27b0, "Рамка боковика", group=gE)
zzW   = input.int(2, "Толщина зиг-зага", minval=1, maxval=4, group=gE)
zzMode = input.string("по счёту", "Чем красить зиг-заг", options=["по счёту","по ходу ноги","по тренду"], group=gE, tooltip="«по счёту» — цвет говорит, куда считает структура, а толщина отделяет импульс от коррекции: коррекция тоньше и бледнее, поэтому не читается как разворот. «по ходу ноги» — вниз всегда красная, вверх зелёная; честно про цену, но каждая коррекция выглядит началом разворота. «по тренду» — как было в самом начале: цвет действующего тренда, поэтому падение внутри живого восходящего рисуется зелёным.")

gF = "Таблица"
showT = input.bool(true, "Таблица", group=gF)
posT  = input.string("верх-право", "Позиция", options=["верх-право","верх-лево","низ-право","низ-лево"], group=gF)
sizeT = input.string("small", "Размер", options=["tiny","small","normal"], group=gF)

MAXK = 80
LB = useSlow ? 5 : 2

// ══════════════ КОЛЕНА ══════════════
var float[]  KP = array.new_float()
var int[]    KB = array.new_int()
var bool[]   KH = array.new_bool()
var string[] KL = array.new_string()
var int[]    KT = array.new_int()
var int[]    KN = array.new_int()
var int[]    KM = array.new_int()      // сколько сырых меток слилось в колено
var float[]  KA = array.new_float()    // цена первой, поглощённой метки
var bool[]   KX = array.new_bool()      // колено пришло в ПЕРЕХОДЕ — тренд ещё не подтверждён

f_isUp(_l) => _l == "HH" or _l == "HL"

// начало ДЕЙСТВУЮЩЕГО счёта: последнее колено с номером (0)
f_cstart() =>
    n = array.size(KN)
    int o = -1
    if n > 0
        i = n - 1
        while i >= 0
            if array.get(KN, i) == 0
                o := i
                break
            i -= 1
    o

// Куда считает действующий счёт. Обычно видно по первой точке после
// нуля. Но на самой точке (0) следующего колена ещё нет — тогда берём
// сторону нуля: счёт всегда стартует с вершины вниз и с низа вверх,
// это заложено в f_recount (needHi = nd < 0).
f_cdir(_o) =>
    n = array.size(KL)
    int d = 0
    if _o >= 0
        if _o + 1 < n
            d := f_isUp(array.get(KL, _o + 1)) ? 1 : -1
        else if _o < array.size(KH)
            d := array.get(KH, _o) ? -1 : 1
    d

// К какому счёту принадлежит колено: идём назад до ближайшего нуля и
// берём его сторону. Вершина — счёт вниз, низ — счёт вверх. Проверено
// на 464 счётах за 2 года: совпадает с направлением в 464 случаях.
f_kdir(_i) =>
    int z = -1
    j = _i
    while j >= 0
        if array.get(KN, j) == 0
            z := j
            break
        j -= 1
    int d = 0
    if z >= 0
        if z < array.size(KH)
            d := array.get(KH, z) ? -1 : 1
    d

f_lab(_i) =>
    hi = array.get(KH, _i)
    float prev = na
    j = _i - 1
    while j >= 0
        if array.get(KH, j) == hi
            prev := array.get(KP, j)
            break
        j -= 1
    cur = array.get(KP, _i)
    na(prev) ? "?" : hi ? (cur > prev ? "HH" : "LH") : (cur > prev ? "HL" : "LL")

f_relabel() =>
    array.clear(KL)
    n = array.size(KP)
    if n > 0
        for i = 0 to n - 1
            array.push(KL, f_lab(i))
    n

f_recount() =>
    n = array.size(KL)
    array.clear(KN)
    if n > 0
        for i = 0 to n - 1
            array.push(KN, -1)
    if n >= 2
        int o = 0
        int d = f_isUp(array.get(KL, 1)) ? 1 : -1
        int guard = 0
        bool go = true
        while go and guard < 500
            guard += 1
            int pts = 0
            i = o + 1
            while i < n and pts < 5
                lb = array.get(KL, i)
                ok = d > 0 ? f_isUp(lb) : not f_isUp(lb)
                if not ok
                    break
                pts += 1
                i += 1
            for k = 0 to pts
                if o + k < n
                    array.set(KN, o + k, k)
            e = o + pts
            x = e + 1
            if x >= n
                go := false
            else
                nd = pts == 5 ? d : (f_isUp(array.get(KL, x)) ? 1 : -1)
                needHi = nd < 0
                j = x
                while j >= 0
                    if array.get(KH, j) == needHi
                        break
                    j -= 1
                if j <= o
                    j := x
                o := j
                d := nd
    n

// ══════════════ СОСТОЯНИЕ ══════════════
var int   tr      = 0        // +1 / -1, ноль только до первого тренда
var float lvl     = na
var int   trFrom  = na
var bool  inTrans = false    // между сломом и подтверждением
var int   pTr     = 0
var float pDeath  = na
var int   pDeathBar = na
var int   marks   = 0
var float impAmp  = 0.0
var float lastDeathLvl = na

var float[] LEGS = array.new_float()
var int   bxEndPrev = -1
var float[] DXP = array.new_float()
var int[]   DXB = array.new_int()
var int[]   DXT = array.new_int()

// боковик
var float bxTop = na
var float bxBot = na
var int   bxStart = na
var int   bxInside = 0
var bool  bxActive = false
var box[] BOXES = array.new<box>()
var int   iHH = na
var int   iLL = na

f_pushKnee(_price, _bar, _hi) =>
    n = array.size(KP)
    bool same = false
    if n > 0
        same := array.get(KH, n - 1) == _hi
    bool fresh = not same
    int shifted = 0
    if same
        array.set(KM, n - 1, array.get(KM, n - 1) + 1)
        if na(array.get(KA, n - 1))
            array.set(KA, n - 1, array.get(KP, n - 1))
        better = _hi ? _price > array.get(KP, n - 1) : _price < array.get(KP, n - 1)
        if better
            array.set(KP, n - 1, _price)
            array.set(KB, n - 1, _bar)
    else
        array.push(KP, _price)
        array.push(KB, _bar)
        array.push(KH, _hi)
        array.push(KT, tr)
        array.push(KX, inTrans)
        array.push(KM, 1)
        array.push(KA, na)
        if array.size(KP) > MAXK
            array.shift(KP)
            array.shift(KB)
            array.shift(KH)
            array.shift(KT)
            array.shift(KX)
            array.shift(KM)
            array.shift(KA)
            shifted := 1
    d1 = f_relabel()
    d2 = f_recount()
    [fresh, shifted]

pvH = ta.pivothigh(high, LB, LB)
pvL = ta.pivotlow (low,  LB, LB)
bLo = math.min(open, close)
bHi = math.max(open, close)

if barstate.isconfirmed
    // ── 1. слом тренда с фильтром глубины ──
    need = impAmp * fibDepth
    bool died = false
    if tr == 1
        if not na(lvl)
            if bLo < lvl - need
                died := true
    if tr == -1
        if not na(lvl)
            if bHi > lvl + need
                died := true
    // защита от повторного слома об тот же уровень
    if died
        if not na(lastDeathLvl)
            if math.abs(lvl - lastDeathLvl) < syminfo.mintick
                died := false
    if died
        pTr := tr
        pDeath := lvl
        pDeathBar := bar_index
        lastDeathLvl := lvl
        array.push(DXP, lvl)
        array.push(DXB, bar_index)
        array.push(DXT, tr)
        inTrans := true
        marks := 0
        lvl := na

    // ── 1б. досрочное подтверждение по рывку ──
    // Пауза считает КОЛЕНА, а не метки. В одностороннем ходе новый
    // экстремум сливается в то же колено: метка есть, колена нет,
    // счётчик стоит. Индикатор досиживал в ПЕРЕХОДЕ ход в 1200 долларов.
    // Если цена ушла от уровня смерти дальше jumpConf импульсов И две
    // последние метки колен смотрят туда же — подтверждаем сразу.
    if jumpConf > 0 and inTrans and impAmp > 0 and not na(lastDeathLvl)
        nj = array.size(KL)
        if nj >= 2
            j1 = array.get(KL, nj - 1)
            j2 = array.get(KL, nj - 2)
            bool ju = f_isUp(j1) and f_isUp(j2)
            bool jd = (not f_isUp(j1)) and (not f_isUp(j2))
            bool far = false
            if jd
                far := close < lastDeathLvl - impAmp * jumpConf
            if ju
                far := close > lastDeathLvl + impAmp * jumpConf
            if far
                tr := ju ? 1 : -1
                trFrom := bar_index
                inTrans := false
                lastDeathLvl := na
                lvl := na

    // ── 2. новые колена ──
    bool fresh = false
    if not na(pvH)
        [f1, s1] = f_pushKnee(high[LB], bar_index - LB, true)
        if f1
            fresh := true
        if s1 > 0
            iHH := na(iHH) ? na : iHH <= 0 ? na : iHH - 1
            iLL := na(iLL) ? na : iLL <= 0 ? na : iLL - 1
    if not na(pvL)
        [f2, s2] = f_pushKnee(low[LB], bar_index - LB, false)
        if f2
            fresh := true
        if s2 > 0
            iHH := na(iHH) ? na : iHH <= 0 ? na : iHH - 1
            iLL := na(iLL) ? na : iLL <= 0 ? na : iLL - 1
    if fresh
        marks += 1

    n = array.size(KL)
    if n >= 2
        l1 = array.get(KL, n - 1)
        l2 = array.get(KL, n - 2)
        p1 = array.get(KP, n - 1)
        p2 = array.get(KP, n - 2)

        if fresh
            array.push(LEGS, math.abs(p1 - p2))
            if array.size(LEGS) > 20
                array.shift(LEGS)

        // ── 3. импульсное колено: ход по направлению тренда ──
        if fresh and tr != 0
            movedUp = p1 > p2
            if (tr == 1 and movedUp) or (tr == -1 and not movedUp)
                impAmp := math.abs(p1 - p2)

        // ── 4. рождение или подтверждение тренда ──
        if fresh
            bool up2 = f_isUp(l1) and f_isUp(l2)
            bool dn2 = (not f_isUp(l1)) and (not f_isUp(l2))
            if tr == 0
                if up2
                    tr := 1
                    trFrom := bar_index
                    impAmp := math.abs(p1 - p2)
                if dn2
                    tr := -1
                    trFrom := bar_index
                    impAmp := math.abs(p1 - p2)
            else if inTrans
                if marks >= 2
                    if up2
                        tr := 1
                        trFrom := bar_index
                        inTrans := false
                        lastDeathLvl := na
                        impAmp := math.abs(p1 - p2)
                    if dn2
                        tr := -1
                        trFrom := bar_index
                        inTrans := false
                        lastDeathLvl := na
                        impAmp := math.abs(p1 - p2)

        // ── 5. уровень тренда ──
        if tr == 1
            if l1 == "HL"
                lvl := p1
            if na(lvl)
                j = n - 1
                while j >= 0
                    if array.get(KL, j) == "HL"
                        lvl := array.get(KP, j)
                        break
                    j -= 1
        if tr == -1
            if l1 == "LH"
                lvl := p1
            if na(lvl)
                j = n - 1
                while j >= 0
                    if array.get(KL, j) == "LH"
                        lvl := array.get(KP, j)
                        break
                    j -= 1
        // Только на баре появления колена. Раньше это выполнялось КАЖДЫЙ
        // бар, и последнее колено тянуло за собой живое состояние тренда:
        // сплошная нога превращалась в штрих-пунктирную, когда тренд
        // умирал позже. История переписывалась задним числом.
        if fresh and array.size(KT) > 0
            array.set(KT, array.size(KT) - 1, tr)
            array.set(KX, array.size(KX) - 1, inTrans)

        // ── 6. БОКОВИК: отдельный слой ──
        if boxOn and fresh
            if l1 == "HH"
                iHH := n - 1
            if l1 == "LL"
                iLL := n - 1
            if not bxActive
                // рамка замораживается ОДИН раз и дальше не пересобирается.
                // Новый HH или LL внутри рамки — просто ещё одно колено внутри.
                if na(bxTop)
                    bool pairOk = false
                    if not na(iHH)
                        if not na(iLL)
                            if iHH >= 0 and iLL >= 0 and iHH < n and iLL < n
                                if (n - 1 - iHH) <= boxM
                                    if (n - 1 - iLL) <= boxM
                                        if array.get(KP, iHH) > array.get(KP, iLL)
                                            pairOk := true
                    if pairOk
                        bxTop := array.get(KP, iHH)
                        bxBot := array.get(KP, iLL)
                        bxStart := array.get(KB, math.min(iHH, iLL))
                        bxInside := 0
                if not na(bxTop)
                    if p1 <= bxTop and p1 >= bxBot
                        bxInside += 1
                        if bxInside >= boxN
                            bool okH = true
                            if boxMaxH > 0
                                if array.size(LEGS) >= 10
                                    if (bxTop - bxBot) > array.median(LEGS) * boxMaxH
                                        okH := false
                            bool okOv = bxStart > bxEndPrev
                            if okH and okOv
                                bxActive := true
                                array.push(BOXES, box.new(bxStart, bxTop, bar_index + 5, bxBot, bgcolor=cBox, border_color=cBoxB, border_width=1))
                                while array.size(BOXES) > boxKeep
                                    box.delete(array.shift(BOXES))
                            else
                                bxTop := na
                                bxBot := na
                                bxInside := 0
                    else
                        bxTop := na
                        bxBot := na
                        bxInside := 0
    // смерть боковика
    if bxActive
        if close > bxTop or close < bxBot
            bxActive := false
            bxEndPrev := bar_index
            bxTop := na
            bxBot := na
            bxInside := 0
        else if array.size(BOXES) > 0
            box.set_right(array.get(BOXES, array.size(BOXES) - 1), bar_index + 5)

// ══════════════ СЫРЫЕ МЕТКИ ══════════════
pvv = high[LB]
plv = low[LB]
w1 = ta.valuewhen(not na(pvH), pvv, 1)
w2 = ta.valuewhen(not na(pvH), pvv, 0)
rHH = na(pvH) ? na : w1 < w2 ? pvH : na
rLH = na(pvH) ? na : w1 > w2 ? pvH : na
w3 = ta.valuewhen(not na(pvL), plv, 1)
w4 = ta.valuewhen(not na(pvL), plv, 0)
rHL = na(pvL) ? na : w3 < w4 ? pvL : na
rLL = na(pvL) ? na : w3 > w4 ? pvL : na
plotshape(drawRaw and not na(rHH) ? rHH : na, "сырая HH", shape.triangledown, location.abovebar, color.new(cUp, 40), text="HH", textcolor=color.new(cUp, 20), size=size.tiny, offset=-LB)
plotshape(drawRaw and not na(rLH) ? rLH : na, "сырая LH", shape.triangledown, location.abovebar, color.new(cDn, 40), text="LH", textcolor=color.new(cDn, 20), size=size.tiny, offset=-LB)
plotshape(drawRaw and not na(rHL) ? rHL : na, "сырая HL", shape.triangleup,   location.belowbar, color.new(cUp, 40), text="HL", textcolor=color.new(cUp, 20), size=size.tiny, offset=-LB)
plotshape(drawRaw and not na(rLL) ? rLL : na, "сырая LL", shape.triangleup,   location.belowbar, color.new(cDn, 40), text="LL", textcolor=color.new(cDn, 20), size=size.tiny, offset=-LB)

// ══════════════ ОТРИСОВКА ══════════════
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()
f_col(_t) => _t == 1 ? cUp : cDn

if barstate.islast
    while array.size(LNS) > 0
        line.delete(array.pop(LNS))
    while array.size(LBS) > 0
        label.delete(array.pop(LBS))

    n = array.size(KP)
    cs = f_cstart()
    if n >= 2
        for i = 1 to n - 1
            x1 = array.get(KB, i - 1)
            x2 = array.get(KB, i)
            if last_bar_index - x1 <= winBars
                t2  = array.get(KT, i)
                bool trs = array.get(KX, i)
                kd  = f_kdir(i)
                arr = kd == 1 ? "↑" : kd == -1 ? "↓" : ""
                num0 = array.get(KN, i)
                // Нога В НОЛЬ счёта принадлежит ПРЕДЫДУЩЕМУ счёту: это
                // последний ход старой структуры, а не первый ход новой.
                // Иначе рывок вверх, поставивший вершину нового счёта
                // вниз, красился бы красным.
                kdL = (num0 == 0 and i > 0) ? f_kdir(i - 1) : kd
                // Чётная точка — коррекция. Она идёт против своего счёта,
                // и если красить её просто по ходу ноги, каждый откат
                // читается как разворот. Поэтому цвет у коррекции тот же,
                // что у счёта, но линия тоньше и бледнее.
                bool corr = num0 > 0 and num0 % 2 == 0
                bool legUp = array.get(KP, i) > array.get(KP, i - 1)
                cc0 = zzMode == "по ходу ноги" ? (legUp ? cUp : cDn) : zzMode == "по счёту" ? (kdL == 0 ? color.gray : f_col(kdL)) : trs ? (legUp ? cUp : cDn) : t2 == 0 ? color.gray : f_col(t2)
                // действующая цепочка — колена текущего счёта, от его нуля
                bool act = false
                if cs >= 0
                    act := i > cs
                bool thin = corr and zzMode == "по счёту"
                tp = (thin ? 45 : 0) + (act ? 0 : 55)
                cc = color.new(cc0, math.min(85, tp))
                if drawZZ
                    if array.get(KT, i - 1) == t2
                        array.push(LNS, line.new(x1, array.get(KP, i - 1), x2, array.get(KP, i), color=cc, width=thin ? zzW : zzW + 1, style=trs ? line.style_dashed : line.style_solid))
                // ОДНА подпись на колено, детали в тултипе
                num = array.get(KN, i)
                mc  = array.get(KM, i)
                ap  = array.get(KA, i)
                lb  = array.get(KL, i)
                pr  = array.get(KP, i)
                hh  = array.get(KH, i)
                mud = mc >= 2
                if drawMud and mud and not na(ap)
                    array.push(LNS, line.new(x1, ap, x2, ap, color=color.new(cMud, 20), width=1, style=line.style_dotted))
                string txt = na
                if labMode == "номер + мутность"
                    txt := (num >= 0 ? "(" + str.tostring(num) + ")" : "·") + arr + (mud ? "м" : "")
                else if labMode == "метка"
                    txt := lb + arr + (mud ? " м" : "")
                else if labMode == "номер и метка"
                    txt := (num >= 0 ? "(" + str.tostring(num) + ") " : "") + lb + arr + (mud ? " м" : "")
                if not na(txt)
                    lc0 = kd == 0 ? color.gray : f_col(kd)
                    lc  = act ? lc0 : color.new(lc0, 62)
                    kdn = kd == 1 ? "ВОСХОДЯЩИЙ счёт" : kd == -1 ? "НИСХОДЯЩИЙ счёт" : "счёт не определён"
                    trn = trs ? "тренд: ПЕРЕХОД, был " + (t2 == 1 ? "восходящий" : "нисходящий") : t2 == 1 ? "тренд: восходящий" : t2 == -1 ? "тренд: нисходящий" : "тренд: не определён"
                    tip = lb + "  " + str.tostring(pr, format.mintick) + "\n" + (num >= 0 ? "точка (" + str.tostring(num) + ") из 5 · " + (num % 2 == 1 ? "импульсное" : num == 0 ? "начало счёта" : "корректирующее") : "вне счёта") + "\n" + kdn + "\n" + trn + (kd != 0 and t2 != 0 and kd != t2 and not trs ? "   ← счёт против тренда" : "") + "\n" + (mud ? "МУТНОЕ: слилось " + str.tostring(mc) + " меток, поглощена " + str.tostring(ap, format.mintick) : "чистое колено")
                    array.push(LBS, label.new(x2, pr, txt, style=hh ? label.style_label_down : label.style_label_up, color=color.new(color.black, 100), textcolor=mud ? (act ? cMud : color.new(cMud, 62)) : lc, size=size.small, tooltip=tip))

    if drawLvl and not na(lvl) and tr != 0 and not inTrans
        x0 = na(trFrom) ? bar_index - 50 : trFrom
        array.push(LNS, line.new(x0, lvl, bar_index + 8, lvl, color=color.new(f_col(tr), 25), width=2, style=line.style_dashed))
        array.push(LBS, label.new(bar_index + 8, lvl, (tr == 1 ? "HL " : "LH ") + str.tostring(lvl, format.mintick), style=label.style_label_left, color=color.new(f_col(tr), 85), textcolor=f_col(tr), size=size.small))

    if drawMSB and array.size(DXB) > 0
        i0 = math.max(0, array.size(DXB) - 10)
        for i = i0 to array.size(DXB) - 1
            db = array.get(DXB, i)
            if last_bar_index - db <= winBars
                dp = array.get(DXP, i)
                dt = array.get(DXT, i)
                array.push(LNS, line.new(db - 20, dp, db, dp, color=dt == 1 ? cDn : cUp, width=2))
                array.push(LBS, label.new(db, dp, "слом", style=dt == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.black, 100), textcolor=dt == 1 ? cDn : cUp, size=size.tiny))

// ══════════════ ТАБЛИЦА ══════════════
// Цепочка действующего счёта. Ноль отбит чертой; если счёт совсем
// короткий, слева добирается хвост прошлого счёта — иначе на точке (0)
// в строке остаётся одна метка и читать нечего.
f_chainCur(_o, _min) =>
    n = array.size(KL)
    s = ""
    if _o >= 0 and n > 0
        from = math.max(0, math.min(_o, n - _min))
        for j = from to n - 1
            s := s + (j == _o and j > from ? " | " : j > from ? ">" : "") + array.get(KL, j)
    s

f_chain(_k) =>
    n = array.size(KL)
    m = math.min(_k, n)
    s = ""
    if m > 0
        for j = n - m to n - 1
            s := s + (j > n - m ? ">" : "") + array.get(KL, j)
    s

tpp = posT == "верх-право" ? position.top_right : posT == "верх-лево" ? position.top_left : posT == "низ-право" ? position.bottom_right : position.bottom_left
tss = sizeT == "tiny" ? size.tiny : sizeT == "small" ? size.small : size.normal
var table T = table.new(tpp, 2, 12, bgcolor=color.new(#000000, 10), border_width=1, border_color=color.new(color.gray, 75))

f_cell(_r, _k, _v, _c) =>
    table.cell(T, 0, _r, _k, text_color=color.new(color.silver, 25), text_halign=text.align_left, text_size=tss)
    table.cell(T, 1, _r, _v, text_color=_c, text_halign=text.align_left, text_size=tss)
    _r

if showT and barstate.islast
    lay = useSlow ? "5/5" : "2/2"
    table.cell(T, 0, 0, "━━  ГДЕ МЫ · " + lay + "  ━━", text_color=color.new(color.silver, 5), bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_center, text_size=size.tiny)
    table.cell(T, 1, 0, "", bgcolor=color.new(#1a1a2e, 0), text_size=size.tiny)
    table.merge_cells(T, 0, 0, 1, 0)

    nm = tr == 1 ? "ВОСХОДЯЩИЙ" : tr == -1 ? "НИСХОДЯЩИЙ" : "не определён"
    st = inTrans ? "ПЕРЕХОД, был " + (pTr == 1 ? "восходящий" : "нисходящий") : nm + (na(trFrom) ? "" : ", " + str.tostring(bar_index - trFrom) + " бар")
    a1 = f_cell(1, "тренд", st, inTrans ? color.new(color.orange, 0) : tr == 0 ? color.gray : f_col(tr))
    a2 = f_cell(2, "держится на", inTrans ? "— уровень пробит" : na(lvl) ? "—" : (tr == 1 ? "HL " : "LH ") + str.tostring(lvl, format.mintick), inTrans ? color.new(color.orange, 0) : color.white)

    // ЗАПАС — сколько хода осталось от цены до порога смерти, а не сам
    // порог. Меряется в импульсных коленах: величина без размерности,
    // поэтому не плывёт вместе с волатильностью.
    // Замер на 2 годах (research/depth_check.py, 8782 бара в тренде):
    // доля запаса от импульса -> вероятность смерти тренда за 10 баров
    //   < 0.25  — 71%      0.50–1.00 — 16% (среднее по рынку 16%)
    //   0.25–0.50 — 40%    1.00–2.00 —  5%      2.00+ — 1%
    string rsv = "—"
    color  rsc = color.gray
    if not inTrans and not na(lvl) and tr != 0 and impAmp > 0
        thr  = tr == 1 ? lvl - impAmp * fibDepth : lvl + impAmp * fibDepth
        room = math.max(0.0, tr == 1 ? close - thr : thr - close)
        k    = room / impAmp
        risk = "за 10 бар тренд умирает в " + (k < 0.25 ? "71%" : k < 0.5 ? "40%" : k < 1.0 ? "16%, как в среднем" : k < 2.0 ? "5%" : "1%")
        rsc := k < 0.25 ? cDn : k < 0.5 ? color.new(color.orange, 0) : k < 1.0 ? color.new(color.silver, 20) : cUp
        rsv := str.tostring(room, format.mintick) + " = " + str.tostring(k, "#.##") + " импульса  ·  " + risk
    a3 = f_cell(3, "запас", rsv, rsc)

    cn = array.size(KN) > 0 ? array.get(KN, array.size(KN) - 1) : -1
    a4 = f_cell(4, "счёт", cn < 0 ? "вне счёта" : "точка (" + str.tostring(cn) + ") из 5", color.new(color.aqua, 0))
    csT = f_cstart()
    cd = f_cdir(csT)
    cdn = cd == 1 ? " восходящего счёта" : cd == -1 ? " нисходящего счёта" : ""

    // ноль счёта: HH у нисходящего / LL у восходящего = счёт РАЗВОРОТНЫЙ,
    // он стартует с вершины прошлого движения. LH или HL = ПРОДОЛЖЕНИЕ,
    // рынок уже шёл в эту сторону. На золоте разворотных около половины.
    string z0 = "—"
    bool zRev = false
    if csT >= 0
        zl = array.get(KL, csT)
        zRev := cd == 1 ? zl == "LL" : cd == -1 ? zl == "HH" : false
        z0 := zl + " " + str.tostring(array.get(KP, csT), format.mintick) + ",  " + str.tostring(bar_index - array.get(KB, csT)) + " бар назад  ·  " + (zRev ? "разворотный" : "продолжение")
    a5 = f_cell(5, "счёт от", z0, cd == 0 ? color.gray : f_col(cd))

    a6 = f_cell(6, "колено", cn <= 0 ? "—" : (cn % 2 == 1 ? "импульсное" : "корректирующее") + " (" + str.tostring(cn) + ")" + cdn, cd == 0 ? color.new(color.aqua, 0) : f_col(cd))
    ch = f_chainCur(csT, 4)
    a7 = f_cell(7, "цепочка", ch == "" ? f_chain(5) : ch, cd == 0 ? color.gray : f_col(cd))

    bxt = not boxOn ? "выключен" : bxActive ? "ДА  " + str.tostring(bxBot, format.mintick) + " — " + str.tostring(bxTop, format.mintick) : na(bxTop) ? "нет" : "набирается " + str.tostring(bxInside) + " из " + str.tostring(boxN)
    a8 = f_cell(8, "боковик", bxt, bxActive ? cBoxB : color.gray)

    nk = array.size(KM)
    lastMud = nk > 0 ? array.get(KM, nk - 1) : 1
    mudC = 0
    cnt  = 0
    if csT >= 0
        for q = csT to nk - 1
            cnt += 1
            if array.get(KM, q) >= 2
                mudC += 1
    mudTxt = (lastMud >= 2 ? "последнее колено МУТНОЕ, слилось " + str.tostring(lastMud) + " меток  |  " : "последнее чистое  |  ") + "мутных в счёте: " + str.tostring(mudC) + " из " + str.tostring(cnt)
    a9 = f_cell(9, "чистота", mudTxt, lastMud >= 2 ? cMud : color.new(color.silver, 30))

    pt = pTr == 0 ? "—" : (pTr == 1 ? "восходящий" : "нисходящий") + ", слом на " + str.tostring(pDeath, format.mintick) + ", " + str.tostring(bar_index - pDeathBar) + " бар назад"
    a10 = f_cell(10, "прошлый тренд", pt, color.new(color.silver, 30))
    // порог рывка считаем по тем же меткам, что и сама логика, а не по
    // умершему тренду: структура может согласиться и с прежней стороной
    pz = "—"
    if inTrans
        pz := str.tostring(math.min(marks, 2)) + " из 2 колен — ждём"
        nz = array.size(KL)
        if jumpConf > 0 and impAmp > 0 and not na(lastDeathLvl) and nz >= 2
            z1 = array.get(KL, nz - 1)
            z2 = array.get(KL, nz - 2)
            bool zu = f_isUp(z1) and f_isUp(z2)
            bool zd = (not f_isUp(z1)) and (not f_isUp(z2))
            if zu or zd
                pz := pz + "   или рывок " + (zu ? "выше " : "ниже ") + str.tostring(zu ? lastDeathLvl + impAmp * jumpConf : lastDeathLvl - impAmp * jumpConf, format.mintick)
    a11 = f_cell(11, "пауза", pz, inTrans ? color.new(color.orange, 0) : color.gray)
